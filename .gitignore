# Build subdirectories.
/*build*
!/build-aux
!/build_msvc

*.pyc

# Only ignore unexpected patches
*.patch
!contrib/guix/patches/*.patch
!depends/patches/**/*.patch

/CMakeUserPresets.json

# Previous releases
/releases

#build tests
test/lint/test_runner/target/

/guix-build-*

/ci/scratch/

# PCoin: never publish credentials from this public repo
PCOIN-SECRETS.md
# Fleet inventories name SSH accounts, key paths and device IDs. They live on
# D: with the other secrets; these patterns are the net under the tightrope,
# not permission to keep a copy here.
MYMINERS.md
PCOIN-SERVERS.md
*SERVERS.md
*SECRETS*
*credential*
*.key
*.pem
wallet.dat
*wallet-backup*
# Signing material. contrib/android/.gitignore covers the app tree, but a
# keystore dropped anywhere else in the repo would sail straight past it, and
# this repo is public.
*.jks
*.keystore
*.p12
*.pfx
signing.properties
local.properties
# Build chatter, not source.
contrib/windows-tray/build.log


# Icon generator scratch output. The SVG/PNG/ICO that actually ship are tracked
# in contrib/branding/ and contrib/windows-tray/; this is just the working dir.
contrib/branding/out/
