# The BIP39 wordlist is verified at load time against a SHA-256 constant
# (Bip39.WORDLIST_SHA256), so it has to arrive byte-for-byte identical on every
# platform. Without this, a checkout on Windows rewrites its 2048 line endings
# to CRLF, the file grows from 13116 to 15164 bytes, the digest no longer
# matches, and WordList.load throws CorruptWordlist -- an app that can neither
# create nor restore a wallet, from a clean clone, with no local change to blame.
#
# `-text` means never convert in either direction, which is what a digest-checked
# file needs. Marking it `text eol=lf` would be weaker: that still normalises on
# commit and only fixes the checkout side.
contrib/android/app/src/main/assets/bip39/english.txt -text

# Same reasoning, lower stakes: golden vectors are compared literally.
contrib/android/app/src/test/resources/qr_vectors.txt -text

# Anything that RUNS on Linux keeps LF whatever the checkout platform does.
# Not cosmetic: build-deb.sh copies these scripts verbatim into the .deb, and a
# shebang arriving as "#!/bin/sh
" fails with a bare "No such file or
# directory" that names the interpreter rather than the carriage return -- one
# of the least obvious errors in packaging. The extensionless three are the
# wizard, the live view and the miner supervisor.
*.sh                                      text eol=lf
contrib/linux-deb/pcoin-setup             text eol=lf
contrib/linux-deb/pcoin-mine              text eol=lf
contrib/linux-deb/pcoin-miner-supervisor  text eol=lf
contrib/seed-monitoring/pcoin-seed-watch         text eol=lf
contrib/seed-monitoring/pcoin-fork-watch         text eol=lf
contrib/seed-monitoring/pcoin-notify             text eol=lf
contrib/seed-monitoring/pcoin-announce           text eol=lf
contrib/seed-monitoring/pcoin-telegram-log       text eol=lf
# These four were added to the directory after the rule above and each missed
# it -- the same gap, growing one script at a time. Closed together rather than
# left for the next addition to rediscover.
contrib/seed-monitoring/pcoin-bootstrap-watch     text eol=lf
contrib/seed-monitoring/pcoin-fork-day            text eol=lf
contrib/seed-monitoring/pcoin-concentration-watch text eol=lf
contrib/seed-monitoring/pcoin-chain-heartbeat     text eol=lf
# systemd tolerates CRLF, but there is no reason to ship it to a Linux box.
*.service  text eol=lf
*.timer    text eol=lf
# pcoin-seed-vault.mjs carries a shebang and is meant to be runnable on a vault
# host (`verify` is the backup check), so it inherits the same reasoning as the
# .deb scripts above: a CRLF checkout turns `./pcoin-seed-vault.mjs` into "No
# such file or directory" naming the interpreter rather than the stray return.
*.mjs      text eol=lf

# Windows-only sources keep CRLF, which is what the in-box csc and Inno Setup
# expect to see.
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.iss  text eol=crlf

# contrib/ops holds root-owned scripts for the payments host. Two of them carry
# a `#!/bin/bash` shebang and no extension, so none of the rules above reach
# them — a Windows checkout would rewrite them to CRLF and the kernel would then
# refuse to run them, reporting `bad interpreter: /bin/bash^M`: an error that
# names the interpreter rather than the stray carriage return, on a file that
# looks perfectly correct in every editor. These are the caddy watchdog and the
# Cloudflare firewall refresher, so the failure would be a host with no watchdog
# and a stale allowlist, discovered later rather than at deploy time.
contrib/ops/pcoin-caddy-watchdog  text eol=lf
contrib/ops/pcoin-cf-firewall     text eol=lf
contrib/ops/*.conf                text eol=lf
