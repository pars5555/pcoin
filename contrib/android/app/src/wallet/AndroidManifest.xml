<?xml version="1.0" encoding="utf-8"?>
<!--
  Wallet-only additions. Flavour manifests MERGE into src/main's rather than
  replacing it, so everything already declared there (the service, setup, backup,
  permissions) still applies and is not repeated here.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Wallet only. The miner has no scanner and must not ask for a camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- required="false": a device with no camera is a perfectly good wallet,
         it just cannot scan. Marking it required would hide the app from those
         devices in a store listing for a convenience feature. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application>
        <!-- Send is reached from the home screen only, never from outside the
             app: no intent-filter, not exported. A payment screen that any other
             app can launch with extras is a phishing surface. -->
        <!--
          configChanges is load-bearing, not a shortcut. Without it a rotation
          while the broadcast is in flight destroys the activity, and the reply
          carrying the txid arrives at a dead screen: the payment went through
          and the person who made it is looking at a blank compose form. Handling
          the config change keeps one instance alive for the whole send.
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/set_title" />

        <activity
            android:name=".SendActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:label="@string/send_title"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- Read-only, so a rotation costs at most one reload. -->
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:label="@string/history_title" />

        <!-- Not exported, like Send and for a related reason: this screen can
             hand an address straight into the compose step, so an app able to
             launch it could put a destination in front of someone in a UI they
             trust. Everything it holds is local anyway. -->
        <activity
            android:name=".AddressBookActivity"
            android:exported="false"
            android:label="@string/book_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- Not exported: it returns a string that lands in the address field of
             a payment, so no other app may launch it and hand back a result.
             Portrait-locked because a rotation mid-scan tears down the camera
             and rebinds it, which reads as the scanner freezing. -->
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:label="@string/scan_title"
            android:screenOrientation="portrait" />

        <!--
          THE ONLY EXPORTED SCREEN IN THIS APP, and the rule above still holds:
          the SEND screen is not exported and must never be. This one is a
          read-only review that cannot spend. It parses a `pcoin:` URI, shows
          the destination and amount, and its single forward action opens Send
          the ordinary way, where the existing review step and the Keystore
          unlock both still stand between the request and any money moving.

          It exists so the Telegram mini app can compose a payment without ever
          holding a key: the request travels, the key stays in AndroidKeyStore.

          `autoVerify` is deliberately absent: `pcoin:` is our own scheme, not
          an http(s) link, so there is no domain to verify and nothing to claim
          from another app. BROWSABLE is required for a link in a web page or a
          chat to reach it at all.
        -->
        <activity
            android:name=".SignRequestActivity"
            android:exported="true"
            android:label="@string/sr_title"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pcoin" />
            </intent-filter>
        </activity>
    </application>
</manifest>
