<?xml version="1.0" encoding="utf-8"?>
<!--
  Send, in two steps on one screen.

  Step 1 (compose) collects an address and an amount. Step 2 (review) shows what
  the node ACTUALLY built: the amount, the fee, and the total leaving the wallet.
  Nothing is broadcast until the button in step 2 is pressed, and building is
  free because the node is asked with add_to_wallet=false.

  Plain framework views only.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/send_title"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/send_available"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink_muted"
            android:textSize="15sp" />

        <!-- Shown only when this phone cannot put a device unlock in front of
             sending, or could not be asked. Stated here, before anything is
             typed, because it is a property of the phone rather than of the
             payment. -->
        <TextView
            android:id="@+id/send_gate_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/strip_wait"
            android:padding="12dp"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- ========================== compose ========================== -->

        <LinearLayout
            android:id="@+id/compose_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/send_to_label"
                android:textColor="@color/ink_muted"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/address_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_inset"
                android:fontFamily="monospace"
                android:hint="@string/send_to_hint"
                android:inputType="textNoSuggestions"
                android:minHeight="52dp"
                android:padding="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink_muted"
                android:textSize="14sp"
                android:importantForAutofill="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/send_amount_label"
                android:textColor="@color/ink_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/amount_field"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_inset"
                    android:hint="@string/send_amount_hint"
                    android:inputType="numberDecimal"
                    android:minHeight="52dp"
                    android:padding="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_muted"
                    android:textSize="18sp"
                    android:importantForAutofill="no" />

                <Button
                    android:id="@+id/max_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/btn_ghost"
                    android:minHeight="52dp"
                    android:text="@string/send_max"
                    android:textAllCaps="false"
                    android:textColor="@color/brand"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/compose_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/alert"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/review_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_primary"
                android:minHeight="52dp"
                android:text="@string/send_review"
                android:textAllCaps="false"
                android:textColor="@color/on_brand"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ========================== review =========================== -->

        <LinearLayout
            android:id="@+id/review_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/send_check_title"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/send_check_hint"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/review_to"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_inset"
                android:fontFamily="monospace"
                android:padding="14dp"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/review_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/review_fee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ink_muted"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@color/hairline" />

            <TextView
                android:id="@+id/review_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/review_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/alert"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/confirm_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_primary"
                android:minHeight="52dp"
                android:text="@string/send_confirm"
                android:textAllCaps="false"
                android:textColor="@color/on_brand"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/back_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_ghost"
                android:minHeight="48dp"
                android:text="@string/send_back"
                android:textAllCaps="false"
                android:textColor="@color/brand"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- =========================== result =========================== -->

        <LinearLayout
            android:id="@+id/result_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/result_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/result_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ink_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/result_txid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_inset"
                android:fontFamily="monospace"
                android:padding="14dp"
                android:textColor="@color/ink"
                android:textIsSelectable="true"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/done_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_primary"
                android:minHeight="52dp"
                android:text="@string/send_done"
                android:textAllCaps="false"
                android:textColor="@color/on_brand"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
