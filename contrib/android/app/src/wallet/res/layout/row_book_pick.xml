<?xml version="1.0" encoding="utf-8"?>
<!--
  A saved address on the compose step: one tap fills the address in.

  It fills a FIELD. It does not send anything, and it does not skip the review
  step, where the destination the node actually built is shown in full. The name
  is this phone's own note and nothing verifies it, so it can never be the last
  word on where money goes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_inset"
    android:minHeight="52dp"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/pick_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pick_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="middle"
        android:fontFamily="monospace"
        android:singleLine="true"
        android:textColor="@color/ink_muted"
        android:textSize="11sp" />
</LinearLayout>
