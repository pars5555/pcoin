<?xml version="1.0" encoding="utf-8"?>
<!--
  Wallet history.

  The rows are built in code and added to row_container, rather than declared
  here or driven by a RecyclerView adapter: the module depends on core-ktx and
  appcompat only, and a list that is at most a few dozen entries does not need
  view recycling. Plain framework views throughout, same as every other screen.

  No fixed heights on anything holding sp text.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_title"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Never GONE: the list below must not jump when this changes. -->
        <TextView
            android:id="@+id/history_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="20dp"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- =================== search and filter ===================
         Both act on what has been LOADED. History pages in from the node 50
         rows at a time, so a search cannot claim to have looked at rows that
         were never fetched. The empty state says which of the two it is,
         rather than reporting "no matches" for a wallet that simply has not
         scrolled far enough yet. -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="10dp">

        <EditText
            android:id="@+id/history_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_inset"
            android:hint="@string/history_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:minHeight="48dp"
            android:padding="12dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/filter_all"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:minHeight="44dp"
                android:text="@string/history_filter_all"
                android:textAllCaps="false"
                android:textColor="@color/brand"
                android:textSize="14sp" />

            <Button
                android:id="@+id/filter_sent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:minHeight="44dp"
                android:text="@string/history_filter_sent"
                android:textAllCaps="false"
                android:textColor="@color/brand"
                android:textSize="14sp" />

            <Button
                android:id="@+id/filter_received"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:minHeight="44dp"
                android:text="@string/history_filter_received"
                android:textAllCaps="false"
                android:textColor="@color/brand"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/history_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/row_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="20dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingTop="8dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/history_refresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_ghost"
            android:minHeight="52dp"
            android:text="@string/history_refresh"
            android:textAllCaps="false"
            android:textColor="@color/brand"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
