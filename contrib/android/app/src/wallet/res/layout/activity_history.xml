<?xml version="1.0" encoding="utf-8"?>
<!--
  Wallet history.

  The rows are built in code and added to row_container, rather than declared
  here or driven by a RecyclerView adapter: the module depends on core-ktx and
  appcompat only, and a list that is at most a few dozen entries does not need
  view recycling. Plain framework views throughout, same as every other screen.

  No fixed heights on anything holding sp text.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_title"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Never GONE: the list below must not jump when this changes. -->
        <TextView
            android:id="@+id/history_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="20dp"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/history_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/row_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingBottom="20dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingTop="8dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/history_refresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_ghost"
            android:minHeight="52dp"
            android:text="@string/history_refresh"
            android:textAllCaps="false"
            android:textColor="@color/brand"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
