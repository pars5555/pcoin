<?xml version="1.0" encoding="utf-8"?>
<!--
  PCoin Wallet home.

  Deliberately NOT a flavour override of activity_main.xml. A flavour layout
  REPLACES main's file rather than merging, so omitting the mining ids would
  delete them from this variant's R class and fail compilation of any shared
  code that names them. A separate filename cannot collide.

  Plain framework views only: no Material, no CardView, no ConstraintLayout, no
  Compose. The module depends on core-ktx and appcompat and nothing else.

  No fixed heights on anything containing sp text – wrap_content plus minHeight
  throughout, so a large font scale expands rather than clips.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wallet_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wallet_title"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Node state, in words. Never "Paused: switched off": that string comes
             from the mining gate, which is permanently false here. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/node_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/node_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textColor="@color/ink_muted"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- ============================ money ============================ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wallet_available"
                android:textColor="@color/ink_muted"
                android:textSize="15sp" />

            <!--
              autoSize, not maxLines alone. Fmt.coins always renders eight
              decimals plus " PCN", which overflows a 360dp phone at 38sp and
              clipped the least-significant end with no ellipsis - the decimals
              and the unit simply vanished, and it got worse with the system
              font scale. Shrinking to fit keeps the whole figure legible; the
              floor of 20sp is still a headline.
            -->
            <TextView
                android:id="@+id/balance_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:autoSizeMaxTextSize="38sp"
                android:autoSizeMinTextSize="20sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="38sp"
                android:textStyle="bold" />

            <!-- Only shown when there is genuinely something pending or
                 maturing. Maturity is stated in BLOCKS, never as a time: block
                 spacing on this chain is not constant and an ETA would be a
                 confident guess. -->
            <TextView
                android:id="@+id/balance_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/ink_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Never GONE: nothing below it may jump when it changes. -->
            <TextView
                android:id="@+id/balance_checked_at"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="18dp"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/send_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/btn_primary"
                    android:minHeight="52dp"
                    android:text="@string/wallet_send"
                    android:textAllCaps="false"
                    android:textColor="@color/on_brand"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/refresh_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_ghost"
                    android:minHeight="52dp"
                    android:text="@string/wallet_refresh"
                    android:textAllCaps="false"
                    android:textColor="@color/brand"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/history_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/btn_ghost"
                    android:minHeight="52dp"
                    android:text="@string/wallet_history"
                    android:textAllCaps="false"
                    android:textColor="@color/brand"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/addresses_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_ghost"
                    android:minHeight="52dp"
                    android:text="@string/wallet_addresses"
                    android:textAllCaps="false"
                    android:textColor="@color/brand"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- =========================== receive =========================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wallet_receive_title"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wallet_receive_hint"
                android:textColor="@color/ink_muted"
                android:textSize="14sp" />

            <!--
              Width-capped and centred rather than match_parent: a QR the full
              width of a modern phone is needlessly huge, and the view draws
              whole-pixel modules on a white plate with its own quiet zone, so
              it must not be stretched or themed.
            -->
            <org.pcoin.miner.QrView
                android:id="@+id/receive_qr"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:contentDescription="@string/wallet_qr_description" />

            <TextView
                android:id="@+id/receive_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_inset"
                android:fontFamily="monospace"
                android:padding="14dp"
                android:textColor="@color/ink"
                android:textIsSelectable="true"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/copy_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/btn_ghost"
                    android:minHeight="48dp"
                    android:text="@string/wallet_copy"
                    android:textAllCaps="false"
                    android:textColor="@color/brand"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/share_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_ghost"
                    android:minHeight="48dp"
                    android:text="@string/wallet_share"
                    android:textAllCaps="false"
                    android:textColor="@color/brand"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ======================= backup reminder ======================= -->

        <LinearLayout
            android:id="@+id/backup_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/strip_wait"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/backup_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wallet_backup_title"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/backup_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wallet_backup_body"
                android:textColor="@color/ink_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/backup_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_ghost"
                android:minHeight="48dp"
                android:text="@string/wallet_backup_action"
                android:textAllCaps="false"
                android:textColor="@color/brand"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Transaction history is the next block of work. It is deliberately
             absent rather than present-and-dead. -->

        <TextView
            android:id="@+id/chain_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textColor="@color/ink_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>


