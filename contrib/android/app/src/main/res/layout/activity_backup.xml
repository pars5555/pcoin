<?xml version="1.0" encoding="utf-8"?>
<!--
  Recovery phrase, behind a device unlock. There is deliberately no copy button
  and no share action anywhere on this screen.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/backup_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#33FF4444"
            android:padding="12dp"
            android:text="@string/backup_warning"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/backup_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/backup_hidden"
            android:textSize="14sp" />

        <Button
            android:id="@+id/backup_reveal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/backup_reveal" />

        <LinearLayout
            android:id="@+id/backup_words"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/backup_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="10dp"
            android:background="#22FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/backup_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:text="@string/backup_close" />

    </LinearLayout>
</ScrollView>
