<?xml version="1.0" encoding="utf-8"?>
<!--
  Wallet setup. One layout, six step containers, exactly one visible at a time.
  Plain framework widgets only, matching the rest of the app: nothing here can
  fail to resolve offline.

  The word grids are filled in code rather than declared here, because the
  number of fields depends on whether the phrase is 12 or 24 words.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ============================ choice ============================ -->

        <LinearLayout
            android:id="@+id/step_choice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_title"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/setup_intro"
                android:textSize="15sp" />

            <Button
                android:id="@+id/choice_create"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/setup_create" />

            <CheckBox
                android:id="@+id/use_24_words"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/setup_24_words"
                android:textSize="13sp" />

            <Button
                android:id="@+id/choice_restore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/setup_restore" />
        </LinearLayout>

        <!-- ============================ resume ============================ -->
        <!--
          Shown when a recovery phrase is stored but no wallet was ever confirmed
          for it: setup was interrupted between storing the words and building
          the wallet. The words are real and must not be thrown away, so the only
          offer is to finish the job from them.
        -->

        <LinearLayout
            android:id="@+id/step_resume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/resume_title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#33FF8800"
                android:padding="12dp"
                android:text="@string/resume_intro"
                android:textSize="14sp" />

            <Button
                android:id="@+id/resume_finish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/resume_finish" />

            <Button
                android:id="@+id/resume_view"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/resume_view" />
        </LinearLayout>

        <!-- ========================== show phrase ========================= -->

        <LinearLayout
            android:id="@+id/step_show"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/show_title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#33FF4444"
                android:padding="12dp"
                android:text="@string/show_warning"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/word_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/show_no_copy"
                android:textSize="13sp" />

            <Button
                android:id="@+id/show_continue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/show_continue" />
        </LinearLayout>

        <!-- ============================ confirm =========================== -->

        <LinearLayout
            android:id="@+id/step_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/confirm_title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/confirm_intro"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/confirm_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/confirm_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#33FF4444"
                android:padding="10dp"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/confirm_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/confirm_button" />

            <Button
                android:id="@+id/confirm_back"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/confirm_show_again" />
        </LinearLayout>

        <!-- ============================ restore =========================== -->

        <LinearLayout
            android:id="@+id/step_restore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/restore_title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/restore_intro"
                android:textSize="14sp" />

            <!--
              How many words the user actually wrote down. Without this the
              restore step was hard-wired to twelve fields, so somebody who
              chose a 24-word phrase, wrote it on paper and later restored on a
              new phone could type only the first twelve and was told the phrase
              was wrong, with no hint that the word count was the problem.
            -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/restore_count_prompt"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/restore_count_12"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/restore_count_12" />

                <Button
                    android:id="@+id/restore_count_24"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/restore_count_24" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/restore_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/restore_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/restore_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:enabled="false"
                android:text="@string/restore_button" />
        </LinearLayout>

        <!-- ============================ progress ========================== -->

        <LinearLayout
            android:id="@+id/step_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/progress_title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:indeterminate="true"
                android:max="100" />

            <TextView
                android:id="@+id/progress_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/progress_note"
                android:textSize="13sp" />

            <Button
                android:id="@+id/progress_back"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/progress_start_over"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ============================== done ============================ -->

        <LinearLayout
            android:id="@+id/step_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/done_title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/done_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textIsSelectable="true"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/storage_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#3300CC66"
                android:padding="10dp"
                android:textSize="13sp" />

            <Button
                android:id="@+id/done_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/done_button" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
