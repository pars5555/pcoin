<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy launcher icon for API 24-25, which predate adaptive icons.
  minSdk is 24, so this file is not optional: without it `@mipmap/ic_launcher`
  fails to resolve on those two levels and the app will not install.

  Same monogram, drawn with its own rounded background because there is no
  adaptive mask to supply one. Kept inside a 108 viewport so the geometry
  matches the v26 version exactly.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="@color/ic_launcher_background"
        android:pathData="M20,4 h68 a16,16 0 0 1 16,16 v68 a16,16 0 0 1 -16,16 h-68 a16,16 0 0 1 -16,-16 v-68 a16,16 0 0 1 16,-16 z" />

    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M34,26 h24 a15,15 0 0 1 0,30 h-10 v26 h-14 z M48,36 h9 a5.5,5.5 0 0 1 0,11 h-9 z" />
</vector>
