# /etc/systemd/system/pcnaibot.service -- the Telegram bot.
#
# OnFailure= lives IN THE UNIT, not in a host-only drop-in. That line once
# existed only in an untracked drop-in on two of three seeds, and the third's
# check had been failing silently for weeks.
[Unit]
Description=PCoin AI bot
Documentation=https://github.com/pars5555/pcoin/tree/main/contrib/pcnaibot
After=network-online.target
Wants=network-online.target
OnFailure=pcoin-alert@%n.service

StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
# A container stopped by systemd exits 143 (128 + SIGTERM). That is a CLEAN
# shutdown, but a non-zero code, so without this line systemd calls every
# ordinary restart a failure and fires OnFailure= -- paging a human for a
# deploy. Observed on 2026-09-11: each redeploy alerted the ops channel.
#
# 143 only. A real crash still has its own exit code and still alerts, which is
# the whole point of OnFailure= being here.
SuccessExitStatus=143 SIGTERM
Type=simple
User=pcnaibot
Group=pcnaibot
# ONLY THE PATH. The three secrets are read from the file BY THE PROCESS, so
# that `process.env` is not a secrets file. This bot accepts arbitrary text from
# strangers and makes outbound calls with Authorization: Bearer -- one
# console.error(err) on a fetch rejection, one crash dump, one
# /proc/self/environ, and this project has a sixth credential leak.
Environment=PCNAIBOT_CONF=/etc/pcoin/pcnaibot.conf
ExecStart=/usr/bin/node /opt/pcnaibot/bot.mjs
Restart=always
RestartSec=5
StateDirectory=pcnaibot
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/pcnaibot /var/log/pcnaibot
MemoryMax=512M

[Install]
WantedBy=multi-user.target
