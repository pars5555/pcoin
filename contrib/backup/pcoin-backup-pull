#!/bin/bash
# Nightly PULL backup (exchange DB, admin data, wrapdesk, price state) of the state that cannot be rebuilt from the chain.
# Runs on 152.53.171.190 (largest disk, already holds the fleet key), so no
# production host gets a new key or a new outbound path.
# The market DB and pool are backed up by their own existing encrypted jobs on this host.
#
#   pcoin-backup-pull run     take every backup, verify each, prune, alert on failure
#   pcoin-backup-pull check   alert if any target's newest good backup is too old
#
# A backup is only counted if it was VERIFIED after it arrived here:
#   sqlite -> PRAGMA integrity_check == ok and the accounts table is not empty
#   tar -> gzip -t and tar -t both pass
# "The command returned" proves nothing (CLAUDE.md 7.6, 7.12).
set -u
umask 077
DEST="${DEST:-/var/backups/pcoin}"
KEY=/root/.ssh/pcam-panel
SSH="ssh -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 -i $KEY"
KEEP=30
MAX_AGE_H=27
NOTIFY=/usr/local/bin/pcoin-notify
STAMP=$(date -u +%Y%m%dT%H%M%SZ)
EXCH=152.53.36.236
H351=178.105.3.51
H178=178.105.178.27
mkdir -p "$DEST"
FAILED=""

# One job at a time. A wedged remote used to leave this running forever and the
# next timer tick would start a second copy into the same files.
#
# A MISSING flock must not look like "already running": that would skip a night
# of backups and print a sentence that reads like a healthy no-op. If the tool is
# unavailable, run without the lock and say so -- losing the lock is not a reason
# to lose the backup (CLAUDE.md 7.1: a failed read resolves nothing, and never
# into a comfortable answer).
if command -v flock >/dev/null 2>&1; then
    exec 9>"$DEST/.lock"
    if ! flock -n 9; then
        echo "another pcoin-backup-pull is still running; nothing done"
        exit 0
    fi
else
    echo "WARN: flock unavailable; running without the single-instance lock"
fi

alert() { [ -x "$NOTIFY" ] && "$NOTIFY" "PCoin backup problem" "$1" || true; }

keep_newest() { # dir
    # Visible names only: those are the FINISHED backups. Work files and partial
    # downloads are dot/`.part` names and are swept by sweep_tmp instead.
    ls -1t "$1" 2>/dev/null | tail -n +$((KEEP + 1)) | while read -r f; do rm -f "$1/$f"; done
}

sweep_tmp() { # dir
    # Leftovers from a run that died mid-flight. `.work-*.sqlite` is a FULL
    # decompressed copy of the exchange database, and `*.part` is an unverified
    # download; neither is a backup, neither is listed by `ls` (so keep_newest
    # never saw them), and the first one is also a copy of everybody's balance
    # sitting on disk indefinitely. Anything older than an hour is safe to drop
    # -- a live run's files are younger than that.
    find "$1" -maxdepth 1 -mmin +60 \( -name '.work-*' -o -name '*.part' \) -delete 2>/dev/null
    true
}

# finish name file verified  -- `verified` is 0 when the check PASSED (it is
# captured from `$?`). The name is misleading; the value is "exit status".
finish() {
    local name="$1" f="$2" ok="$3"
    if [ "$ok" = 0 ]; then
        echo "OK   $name $(du -h "$f" | cut -f1) $f"
        keep_newest "$DEST/$name"
    else
        echo "FAIL $name (verification failed, file removed)"
        rm -f "$f" "$f.part"
        FAILED="$FAILED $name"
    fi
}

backup_exchange() {
    local d="$DEST/exchange"; mkdir -p "$d"; sweep_tmp "$d"
    local f="$d/exchange-$STAMP.sqlite.gz" part="$f.part" t="$d/.work-$STAMP.sqlite"
    : > "$d/.err"
    # VACUUM INTO gives a consistent copy of a live WAL database; a plain file copy would not.
    # The path comes from the app's own config, not from this script: a hardcoded
    # path that the exchange does not actually use would back up the wrong file
    # (or nothing), and the failure would read as "backup broken" rather than
    # "backing up the wrong file". Falls back to the default if config cannot be
    # read, so this can never be worse than the hardcoded path it replaces.
    $SSH root@$EXCH 'docker exec -i pcoin-exchange node --input-type=module -' <<'JS' >/dev/null 2>>"$d/.err" || { FAILED="$FAILED exchange(dump)"; cat "$d/.err"; return; }
import { openDb } from 'file:///app/lib/db.mjs';
import { loadConfig } from 'file:///app/lib/config.mjs';
import { unlinkSync, existsSync } from 'node:fs';
let dbPath = '/data/exchange.sqlite';
try { dbPath = loadConfig().dbPath || dbPath; } catch { /* keep the default */ }
const p = '/data/.backup-work.sqlite';
if (existsSync(p)) unlinkSync(p);
openDb(dbPath).exec(`VACUUM INTO '${p}'`);
JS
    $SSH root@$EXCH 'gzip -c /var/lib/pcoin-exchange/data/.backup-work.sqlite; rm -f /var/lib/pcoin-exchange/data/.backup-work.sqlite' > "$part" 2>>"$d/.err"
    gzip -dc "$part" > "$t" 2>/dev/null
    local ic n ok=1
    ic=$(sqlite3 "$t" 'PRAGMA integrity_check' 2>&1); n=$(sqlite3 "$t" 'SELECT COUNT(*) FROM accounts' 2>&1)
    rm -f "$t"
    [ "$ic" = ok ] && [ "${n:-0}" -gt 0 ] 2>/dev/null && ok=0
    # Rename ONLY on success. A finished name therefore means "verified", which
    # is the whole contract `check` relies on -- see the comment there.
    [ "$ok" = 0 ] && mv -f "$part" "$f"
    finish exchange "$f" "$ok"
}

backup_tar() { # name host "tar args" ; stdout of remote tar, gzip'd
    local name="$1" host="$2" args="$3"; local d="$DEST/$name"; mkdir -p "$d"; sweep_tmp "$d"
    local f="$d/$name-$STAMP.tar.gz" part="$f.part"
    $SSH root@$host "tar czf - $args 2>/dev/null" > "$part" 2>/dev/null
    local ok=1
    gzip -t "$part" 2>/dev/null && [ "$(tar tzf "$part" 2>/dev/null | wc -l)" -gt 0 ] && ok=0
    [ "$ok" = 0 ] && mv -f "$part" "$f"
    finish "$name" "$f" "$ok"
}

case "${1:-}" in
run)
    backup_exchange
    backup_tar admin-data "$H351" "-C /opt/pcoin-admin --exclude='*.bak*' data credential.json allowed-ips.json"
    backup_tar wrapdesk "$H351" "-C /var/lib wrapdesk"
    backup_tar price-state "$H178" "-C /opt/pcoin-price state.json"
    date -u +%s > "$DEST/.last-run"
    if [ -n "$FAILED" ]; then alert "Nightly backup FAILED for:$FAILED. The previous good copies are still in $DEST on 152.53.171.190."; exit 1; fi
    echo "all backups verified"
    ;;
check)
    now=$(date +%s); bad=""
    for name in exchange admin-data wrapdesk price-state; do
        # Only a FINISHED name counts as a backup. `run` downloads to `<name>.part`
        # and renames after verification passes, so a file that reached its final
        # name is verified by construction -- and a run that died mid-download or
        # mid-verify leaves only a `.part` or a `.work-*`, which `ls` either hides
        # or this filter drops.
        #
        # That was the bug: `check` used to take the newest file by mtime whatever
        # it was, so a killed run's unverified download read as "the newest good
        # copy", `check` printed "backups fresh", and the staleness alert stayed
        # silent at exactly the moment there was no good copy at all. The old
        # `grep -v '^\.'` never did anything -- plain `ls` does not list dotfiles.
        newest=$(ls -1t "$DEST/$name" 2>/dev/null | grep -v '\.part$' | head -1)
        if [ -z "$newest" ]; then bad="$bad $name(none)"; continue; fi
        age=$(( (now - $(stat -c %Y "$DEST/$name/$newest")) / 3600 ))
        [ "$age" -gt "$MAX_AGE_H" ] && bad="$bad $name(${age}h)"
    done
    if [ -n "$bad" ]; then alert "Backup is STALE (newest verified copy older than ${MAX_AGE_H}h):$bad"; echo "STALE:$bad"; exit 1; fi
    echo "backups fresh"
    ;;
*) echo "usage: $0 run|check"; exit 2 ;;
esac
