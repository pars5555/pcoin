#!/usr/bin/env python3
"""pcoin-admin-allow -- who may reach admin.pc.am (the unified PCoin admin).

    pcoin-admin-allow list
    pcoin-admin-allow add <ip> <label...>
    pcoin-admin-allow remove <ip>
    pcoin-admin-allow sync        # rewrite Caddy's copy from the JSON and reload

Owner, 2026-09-24: "only my ip addresses should have access to that page".

TWO COPIES, CHECKED INDEPENDENTLY, and this tool is the only thing that writes
either of them:
  * /opt/pcoin-admin/allowed-ips.json -- read by the panel itself on every
    request (10 s cache). An unreadable file refuses everyone.
  * /etc/caddy/admin-allow.caddy -- a matcher Caddy applies before the panel
    sees the request at all.
Both compare against CF-Connecting-IP, which Cloudflare sets and a client
cannot choose; Caddy's cf_only guard refuses every peer that is not Cloudflare,
so nobody can hand the origin a header of their own.

THE WAY BACK IN, decided before it is needed: a home address changes when the
lease renews. SSH to this box (178.105.3.51) still works from anywhere with the
key, and `pcoin-admin-allow add <new ip> home` is the whole fix. Caddy is
RELOADED (graceful), never restarted -- other sites live on this Caddy.
"""
import ipaddress
import json
import re
import os
import subprocess
import sys
import tempfile
import time

# The panel's host keeps the list beside the panel, which reads it; any other
# host (the market's) keeps its own copy under /etc/pcoin.
JSON_PATH = os.environ.get('ADMIN_ALLOW_FILE', '/opt/pcoin-admin/allowed-ips.json'
                           if os.path.isdir('/opt/pcoin-admin') else '/etc/pcoin/admin-allowed-ips.json')
CADDY_PATH = os.environ.get('ADMIN_ALLOW_CADDY', '/etc/caddy/admin-allow.caddy')
# @not_owner: the negation, for admin screens on a site other people also use
# (the ops dashboard under explorer.pc.am/admin, market.pc.am/admin). Proved on
# a throwaway Caddy (2026-09-24): two `not header` lines in one matcher mean
# "neither address".
NOT_OWNER_PATH = os.environ.get('ADMIN_ALLOW_NOT_OWNER', '/etc/caddy/owner-ip.caddy')
# No host can SSH to another, so every host that locks an admin screen keeps
# its own copy of the list. Change it on ALL of them.
HOSTS = '178.105.3.51 (admin.pc.am, ops dashboard) and 178.105.178.27 (market admin)'
CADDYFILE = '/etc/caddy/Caddyfile'
NEVER = 'none.invalid'  # an address that can never match: an empty list locks everyone out


def load():
    try:
        with open(JSON_PATH, encoding='utf-8') as f:
            j = json.load(f)
    except FileNotFoundError:
        j = {'ips': []}
    if not isinstance(j.get('ips'), list):
        sys.exit(f'{JSON_PATH}: "ips" is not a list; refusing to guess')
    return j


def atomic_write(path, text, mode=0o644):
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix='.allow-')
    with os.fdopen(fd, 'w', encoding='utf-8') as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def not_owner_text(ips):
    lines = ''.join('\tnot header Cf-Connecting-Ip %s\n' % ip for ip in (ips or [NEVER]))
    return ('# GENERATED by pcoin-admin-allow from %s -- do not edit by hand.\n'
            '# @not_owner: a request whose CF-Connecting-IP is NOT on the owner list.\n'
            '@not_owner {\n%s}\n') % (JSON_PATH, lines)


def caddy_text(ips):
    # One line per address in a block: the inline form `@m header F v1 v2`
    # is rejected ("malformed header matcher"). Repeated values for the SAME
    # field inside one matcher are OR-ed by Caddy, which is what a list means.
    lines = ''.join('\theader Cf-Connecting-Ip %s\n' % ip for ip in (ips or [NEVER]))
    return ('# GENERATED by pcoin-admin-allow from %s -- do not edit by hand.\n'
            '# Imported inside the admin.pc.am site block.\n'
            '@admin_owner {\n%s}\n') % (JSON_PATH, lines)


def sync(j):
    ips = [x['ip'] for x in j['ips']]
    old = {}
    for path in (CADDY_PATH, NOT_OWNER_PATH):
        try:
            with open(path, encoding='utf-8') as f:
                old[path] = f.read()
        except FileNotFoundError:
            pass
    atomic_write(CADDY_PATH, caddy_text(ips))
    atomic_write(NOT_OWNER_PATH, not_owner_text(ips))
    # Validate AS THE caddy USER. `caddy validate` opens every log writer the
    # config names; run as root it CREATES a missing log file owned by root, the
    # running Caddy (user caddy) then cannot open it, and the reload fails. That
    # is exactly what happened on 2026-09-24 with /var/log/caddy/admin.pc.am.log.
    v = subprocess.run(['runuser', '-u', 'caddy', '--', 'caddy', 'validate', '--config', CADDYFILE,
                        '--adapter', 'caddyfile'], capture_output=True, text=True)
    if v.returncode != 0:
        for path, text in old.items():
            atomic_write(path, text)
        sys.exit('caddy validate FAILED, previous copies restored:\n' + (v.stderr or v.stdout)[-800:])
    # Straight to Caddy's admin API, the same command the unit's ExecReload
    # runs, with a timeout. A failed `systemctl reload` left the unit stuck in
    # "reloading" for minutes, and every later reload queued behind it.
    # Some hosts run Caddy with `admin off` (the market's, on purpose: no local
    # process can rewrite its config). There a reload is impossible and a
    # RESTART is the only way to apply -- a second or two for that host's sites.
    with open(CADDYFILE, encoding='utf-8') as f:
        admin_off = re.search(r'^\s*admin\s+off\b', f.read(), re.M) is not None
    cmd = (['systemctl', 'restart', 'caddy'] if admin_off
           else ['caddy', 'reload', '--config', CADDYFILE, '--adapter', 'caddyfile', '--force'])
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    except subprocess.TimeoutExpired:
        sys.exit('caddy reload timed out; the old list is still in force in Caddy (the panel reads the new one)')
    if r.returncode != 0:
        sys.exit('caddy reload failed (the old list is still in force in Caddy): ' + (r.stderr or r.stdout)[-500:])
    print('caddy %s; allowed:' % ('RESTARTED (admin API is off on this host)' if admin_off else 'reloaded'),
          ', '.join(ips) or '(nobody)')
    print('REMEMBER: set the same list on every host that locks an admin screen: ' + HOSTS)


def main(argv):
    if len(argv) < 2 or argv[1] not in ('list', 'add', 'remove', 'sync'):
        sys.exit(__doc__)
    cmd = argv[1]
    j = load()
    if cmd == 'list':
        for x in j['ips']:
            print(f"{x['ip']:<40} {x.get('label', '')}  (added {x.get('added', '?')})")
        if not j['ips']:
            print('(empty: nobody can reach the panel)')
        return
    if cmd == 'sync':
        return sync(j)
    if len(argv) < 3:
        sys.exit(__doc__)
    try:
        ip = str(ipaddress.ip_address(argv[2]))
    except ValueError:
        sys.exit(f'{argv[2]!r} is not a single IP address (ranges are not supported: '
                 'Caddy matches the exact CF-Connecting-IP string)')
    if cmd == 'add':
        label = ' '.join(argv[3:]).strip()
        if not label:
            sys.exit('give the address a label, e.g. "home"')
        if any(x['ip'] == ip for x in j['ips']):
            sys.exit(f'{ip} is already on the list')
        j['ips'].append({'ip': ip, 'label': label, 'added': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())})
    else:
        before = len(j['ips'])
        j['ips'] = [x for x in j['ips'] if x['ip'] != ip]
        if len(j['ips']) == before:
            sys.exit(f'{ip} is not on the list')
        if not j['ips']:
            print('WARNING: the list is now EMPTY -- nobody can reach the panel until an address is added.')
    atomic_write(JSON_PATH, json.dumps(j, indent=2) + '\n', 0o644)
    sync(j)


if __name__ == '__main__':
    main(sys.argv)
