[Unit]
Description=Run the PCoin seed health check every 10 minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=10min

# Without this the three seeds, all installed the same afternoon, would fire in
# lockstep. Spreading them means a transient network blip cannot fail all three
# checks in the same second and look like a network-wide outage.
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
