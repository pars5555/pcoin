#!/bin/bash
# Send one alert somewhere a human will actually see it.
#
# Kept separate from the checks on purpose. pcoin-seed-watch and
# pcoin-fork-watch decide WHAT is wrong; this decides WHERE that goes, and it
# reads the destination from a config file that is not in the repository. No
# script that detects a problem should also contain a credential.
#
#   /etc/pcoin/alert.conf   (0600 root)
#     TELEGRAM_TOKEN=123456:ABC...
#     ALERT_CHAT=-1001234567890
#
# ALERT_CHAT MUST BE PRIVATE. This was once pointed at the public announcement
# channel and subscribers received "Main process exited, code=exited,
# status=3/NOTIMPLEMENTED" plus the internal hostname. An operational alert is
# addressed to whoever fixes it. Announcements are a separate act, written by a
# person; nothing on a ten-minute timer should ever reach an audience.
#
# If that file is absent this exits 0 after logging. A missing notifier must
# never turn into a failing check -- the check already failed, and burying its
# exit code under a delivery problem is how the original failure gets lost.
#
# DEDUPE IS THE POINT. These run from a ten-minute timer. A condition that
# persists -- and a chain split persists by definition -- would otherwise post
# 144 identical messages a day, and a channel that does that gets muted, taking
# the one message that mattered with it. The same text is sent at most once
# every REPEAT_HOURS.
set -u

CONF=/etc/pcoin/alert.conf
SEEN_DIR=/var/lib/pcoin-monitor/sent
REPEAT_HOURS="${REPEAT_HOURS:-6}"
TGLOG=/usr/local/bin/pcoin-telegram-log

SUBJECT="${1:-PCoin alert}"
BODY="${2:-}"

log() { logger -t pcoin-notify -- "$*" 2>/dev/null || printf '%s\n' "$*"; }
# The journal rotates off this box in days; this survives. Same rule as the
# alert itself: a logging failure must never look like anything else going
# wrong, so this is silent-on-error by construction (pcoin-telegram-log
# swallows its own exceptions) and never affects this script's exit code.
tglog() { [ -x "$TGLOG" ] && "$TGLOG" record --channel alert --chat "${ALERT_CHAT:-unknown}" "$@" >/dev/null 2>&1 || true; }

if [ ! -r "$CONF" ]; then
    log "no $CONF -- alert not delivered: $SUBJECT"
    tglog --status failed --subject "$SUBJECT" --body "$BODY" --error "no $CONF on this host"
    exit 0
fi
# shellcheck disable=SC1090
. "$CONF"

if [ -z "${TELEGRAM_TOKEN:-}" ] || [ -z "${ALERT_CHAT:-}" ]; then
    log "$CONF has no TELEGRAM_TOKEN/ALERT_CHAT -- alert not delivered: $SUBJECT"
    tglog --status failed --subject "$SUBJECT" --body "$BODY" --error "$CONF missing TELEGRAM_TOKEN/ALERT_CHAT"
    exit 0
fi

mkdir -p "$SEEN_DIR" 2>/dev/null
KEY=$(printf '%s' "$SUBJECT$BODY" | sha256sum | cut -c1-32)
STAMP="$SEEN_DIR/$KEY"
NOW=$(date +%s)
if [ -f "$STAMP" ]; then
    LAST=$(cat "$STAMP" 2>/dev/null || echo 0)
    if [ $((NOW - LAST)) -lt $((REPEAT_HOURS * 3600)) ]; then
        log "suppressed (sent $(( (NOW-LAST)/60 )) min ago): $SUBJECT"
        tglog --status suppressed --subject "$SUBJECT" --body "$BODY"
        exit 0
    fi
fi

HOST=$(hostname)
FOOTER="$HOST — $(date -u '+%Y-%m-%d %H:%M UTC')"

# --data-urlencode so a message containing & or = cannot truncate itself.
send() {
    curl -s --max-time 25 \
        -X POST "https://api.telegram.org/bot${TELEGRAM_TOKEN}/sendMessage" \
        --data-urlencode "chat_id=${ALERT_CHAT}" \
        --data-urlencode "disable_web_page_preview=true" "$@" 2>&1
}

# TELEGRAM CAPS ONE MESSAGE AT 4096 CHARACTERS, AND PAST IT THE ALERT IS LOST.
#
# The API answers 400 "message is too long", which this script used to treat as
# an ordinary delivery failure: log, record failed, exit 1. Nothing retries a
# message that will be exactly as long next time. On 2026-09-18 10:25:42 UTC
# "wrap desk: 34 thing(s) need you" was rejected that way and never arrived --
# thirty-four items needing a human, and no trace of them in the channel.
#
# The doctrine below, written after the Markdown incident, applies here too:
# formatting is decoration, DELIVERY IS THE JOB. So a long body is split on line
# boundaries and sent as numbered parts. A split alert is worse than one short
# message; a MISSING alert is worse than both.
MAXCHARS="${ALERT_MAX_CHARS:-3500}"

PARTDIR=$(mktemp -d /tmp/pcoin-notify.XXXXXX) || PARTDIR=""
cleanup() { [ -n "$PARTDIR" ] && rm -rf "$PARTDIR"; }
trap cleanup EXIT

# Break on newlines so a line is never cut in half. A single line longer than
# MAXCHARS is emitted alone rather than dropped -- Telegram still takes it while
# it is under 4096, and dropping it would be the very bug this fixes.
if [ -n "$PARTDIR" ]; then
    printf '%s' "$BODY" | awk -v max="$MAXCHARS" -v dir="$PARTDIR" '
      function flush(b,   f) { f = sprintf("%s/part.%03d", dir, n); print b > f; close(f); n++ }
      BEGIN { n = 1; buf = "" }
      {
        # A SINGLE LINE CAN ITSELF BE TOO LONG, and breaking only on newlines
        # left that case failing exactly as before. Proved on 2026-09-22: a
        # 6,840-character one-line body was still rejected "message is too
        # long" on a host that had the split fix, while a 7,019-character
        # multi-line body went out fine. Anything that builds a body by
        # joining with ", " rather than newlines lands here -- so an
        # over-long line is hard-wrapped rather than passed through whole.
        line = $0
        while (length(line) > max) { flush(substr(line, 1, max)); line = substr(line, max + 1) }
        if (length(buf) > 0 && length(buf) + length(line) + 1 > max) { flush(buf); buf = line }
        else { buf = (length(buf) ? buf "\n" line : line) }
      }
      END { if (length(buf) > 0) flush(buf) }
    '
fi

set -- "$PARTDIR"/part.*
if [ -z "$PARTDIR" ] || [ ! -f "$1" ]; then
    # No split was possible (mktemp failed, or the body is empty). Send it whole
    # -- degraded, but never silent.
    PARTS_TOTAL=1
    SINGLE=1
else
    PARTS_TOTAL=$#
    SINGLE=0
fi

ALL_OK=1
LAST_RESP=""
MIDS=""
IDX=0

send_one() {   # $1 = subject to show, $2 = body chunk
    local subj="$1" chunk="$2" text plain resp
    text=$(printf '*%s*\n%s\n\n_%s_' "$subj" "$chunk" "$FOOTER")
    resp=$(send --data-urlencode "text=${text}" --data-urlencode "parse_mode=Markdown")

    # The body is written by the checks and is NOT escaped for Markdown. A single
    # unpaired _ or * in it -- "<bsc_txhash>", "*** EXHAUSTED ***", a txid -- makes
    # Telegram reject the whole message with "can't parse entities", and the
    # wrap-desk nag was lost that way 22 times in a row (2026-08-31 20:12 to
    # 2026-09-01 18:39 UTC) while the log said "failed" and nothing else noticed.
    # On a parse rejection send it again as plain text, losing the bold subject
    # and nothing else.
    case "$resp" in
        *"can't parse entities"*)
            log "Markdown rejected, resending as plain text: $subj"
            plain=$(printf '%s\n%s\n\n%s' "$subj" "$chunk" "$FOOTER")
            resp=$(send --data-urlencode "text=${plain}")
            ;;
    esac
    printf '%s' "$resp"
}

if [ "$SINGLE" -eq 1 ]; then
    RESP=$(send_one "$SUBJECT" "$BODY")
    case "$RESP" in
        *'"ok":true'*) MIDS=$(printf '%s' "$RESP" | grep -oE '"message_id":[0-9]+' | head -1 | cut -d: -f2) ;;
        *) ALL_OK=0; LAST_RESP="$RESP" ;;
    esac
else
    for p in "$@"; do
        IDX=$((IDX + 1))
        if [ "$PARTS_TOTAL" -gt 1 ]; then
            SUBJ="$SUBJECT ($IDX/$PARTS_TOTAL)"
        else
            SUBJ="$SUBJECT"
        fi
        RESP=$(send_one "$SUBJ" "$(cat "$p")")
        case "$RESP" in
            *'"ok":true'*)
                MIDS="$MIDS $(printf '%s' "$RESP" | grep -oE '"message_id":[0-9]+' | head -1 | cut -d: -f2)"
                ;;
            *) ALL_OK=0; LAST_RESP="$RESP" ;;
        esac
    done
fi

if [ "$ALL_OK" -eq 1 ]; then
    # Only now is the message actually in the channel. A PARTIAL send does not
    # earn a stamp: half an alert delivered is a reason to retry, not a reason
    # to suppress the rest for six hours.
    printf '%s' "$NOW" > "$STAMP"
    log "sent: $SUBJECT${PARTS_TOTAL:+ (${PARTS_TOTAL} part(s))}"
    tglog --status sent --subject "$SUBJECT" --body "$BODY" \
          --message-id "$(printf '%s' "${MIDS# }" | tr ' ' ',')"
else
    # Deliberately do NOT write the stamp: an undelivered message must be
    # retried on the next run, not suppressed as though it had arrived.
    log "delivery FAILED: $(printf '%s' "$LAST_RESP" | head -c 200)"
    tglog --status failed --subject "$SUBJECT" --body "$BODY" --error "$(printf '%s' "$LAST_RESP" | head -c 200)"
    exit 1
fi
