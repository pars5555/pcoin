#!/usr/bin/env python3
"""Watch @PCoinPCNChat and tell the operator what people are saying.

    pcoin-group-watch              one pass; run it from a timer
    pcoin-group-watch --dry-run    read and print, send nothing, advance nothing
    pcoin-group-watch --status     what it knows, without touching Telegram

WHY THIS EXISTS. The discussion group is where a bug report will arrive, and
nobody is watching a chat at 3am. This relays every message to the private ops
channel, and shouts louder when a message looks like somebody is stuck.

THREE THINGS THAT WOULD BREAK IT, EACH GUARDED:

  ONE POLLER ONLY. `getUpdates` is exclusive: two consumers steal each other's
  updates and each sees half a conversation. Nothing else on this estate polls
  it (checked: no webhook, no other consumer), and nothing else may start.
  A 409 from Telegram means somebody did, and that is reported loudly rather
  than retried, because retrying is what makes the two of you fight.

  A FAILED READ ADVANCES NOTHING. The offset is only written after the messages
  it covers have been delivered. A crash or a network failure re-reads; it never
  silently drops a report. Duplicates are cheap, a lost bug report is not.

  IT NEVER POSTS TO THE PUBLIC CHANNEL. It only ever writes to ALERT_CHAT, and
  the public channel id is not in this file at all. Operational text reaching
  subscribers has happened once on this project and it is not happening again.
"""
import html
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

CONF = os.environ.get("PCOIN_ALERT_CONF", "/etc/pcoin/alert.conf")
STATE = os.environ.get("GROUP_WATCH_STATE", "/var/lib/pcoin-group-watch/state.json")
def _groups_conf(path="/etc/pcoin/groups.conf"):
    """Chat ids from a file the PROGRAM reads, not only from systemd.

    CLAUDE.md 7.14: a script configured by its unit file is a different program
    when run by hand. Set through an EnvironmentFile alone, `--status` reported
    the test group as unconfigured while the service had it -- the same shape as
    the false 50,000 PCN wrap alert that came from a bare run losing its floor.
    The environment still wins where it is set, so a one-off override works.
    """
    out = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return out


_G = _groups_conf()

GROUP_ID = int(os.environ.get("GROUP_CHAT_ID") or _G.get("GROUP_CHAT_ID")
                or "-1003975107618")

# A second, PRIVATE group the owner uses to try the bot out. 0 means there is
# none, and then nothing about this file's behaviour changes.
TEST_GROUP_ID = int(os.environ.get("GROUP_TEST_CHAT_ID")
                    or _G.get("GROUP_TEST_CHAT_ID") or "0")
WATCHED = {GROUP_ID} | ({TEST_GROUP_ID} if TEST_GROUP_ID else set())
LOG = os.environ.get("GROUP_WATCH_LOG", "/var/log/pcoin-group-watch.log")
# Every group message, one JSON object per line, for pcoin-group-answer to read.
# It exists because getUpdates is EXCLUSIVE: anything else that wants to see the
# group must read what this poller already fetched, not poll it again. Two
# pollers were live on two hosts until 2026-09-13 and each saw half the room.
SPOOL = os.environ.get("GROUP_SPOOL", "/var/lib/pcoin-group-watch/spool.jsonl")
SPOOL_MAX_BYTES = 2_000_000

# Words that turn a relay into something worth waking up for. Deliberately about
# a person being STUCK, not about sentiment -- "this is great" needs no operator.
TRIGGERS = re.compile(
    r"\b(bug|broken|not working|doesn'?t work|does not work|can'?t|cannot|fail(ed|ing|s)?|"
    r"error|stuck|missing|lost|scam|stolen|hack(ed)?|refund|didn'?t receive|no reply|"
    r"help|support|問題)\b", re.I)

DRY = "--dry-run" in sys.argv


def conf():
    out = {}
    try:
        with open(CONF, encoding="utf-8") as fh:
            for line in fh:
                m = re.match(r"^\s*([A-Z_]+)\s*=\s*(.*?)\s*$", line)
                if m:
                    out[m.group(1)] = m.group(2).strip().strip('"').strip("'")
    except OSError as e:
        sys.exit("cannot read %s: %s" % (CONF, e))
    return out


def load_state():
    """Missing or damaged state must normalise, not raise. A first install that
    dies on a KeyError is a watcher nobody ever gets working."""
    try:
        with open(STATE, encoding="utf-8") as fh:
            s = json.load(fh)
        if not isinstance(s, dict):
            s = {}
    except (OSError, ValueError):
        s = {}
    s.setdefault("offset", 0)
    s.setdefault("seen", 0)
    s.setdefault("last_run", 0)
    return s


def save_state(s):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(s, fh, indent=2)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, STATE)


def api(token, method, params=None, timeout=40):
    url = "https://api.telegram.org/bot%s/%s" % (token, method)
    data = urllib.parse.urlencode(params or {}).encode()
    req = urllib.request.Request(url, data=data)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def send(token, chat, text):
    if DRY:
        print("  [dry-run] would send to %s:\n%s\n" % (chat, re.sub(r"<[^>]+>", "", text)))
        return True
    try:
        j = api(token, "sendMessage", {
            "chat_id": chat, "parse_mode": "HTML",
            "disable_web_page_preview": "true", "text": text})
        if not j.get("ok"):
            print("  telegram refused: %s" % j.get("description"), file=sys.stderr)
        return bool(j.get("ok"))
    except Exception as e:
        # A relay that cannot be delivered must NOT advance the offset, or the
        # message is gone for good.
        print("  send failed: %s" % e, file=sys.stderr)
        return False


# How long Telegram may hold the getUpdates request open. Kept below the
# systemd timer interval so a request is open most of the time, and well below
# TimeoutStartSec so systemd never kills a healthy wait.
POLL_SECONDS = int(os.environ.get("GROUP_WATCH_POLL_SECONDS", "20"))

# How long the Telegram API must be unreachable before a failed poll is treated
# as a fault rather than weather. The timer re-runs this every 25 s, so anything
# shorter pages a human about a condition that fixes itself before they can read
# it -- and on 2026-09-13 the alert about exactly that could not be delivered,
# because the network it was complaining about was the one it needed.
NET_QUIET_SECONDS = int(os.environ.get("GROUP_WATCH_NET_QUIET_SECONDS", "900"))

APPROVE = "/usr/local/bin/pcoin-approve"
# The owner's Telegram user id. The only account whose press counts; pcoin-approve
# checks this again on its own side, deliberately, because a check that exists in
# one place is a check that moves when somebody refactors the other place.
APPROVE_OWNER = int(os.environ.get("APPROVE_OWNER", "508669931"))


def handle_callback(token, cb):
    """Carry one approval button press to pcoin-approve.

    This function decides NOTHING. It parses, checks who pressed, shells out, and
    reports back to Telegram. The queue, the allow-listed destinations and the
    content hash all live in pcoin-approve, so the poller cannot be talked into
    publishing anything by a malformed update.

    Every path answers the callback. An unanswered callback leaves a spinner
    turning on the owner's phone for ever, which reads as "it is working" when
    nothing is.

    Returns True if this update may be CONSUMED -- either it was acted on, or it
    can never succeed. Returns False only for a transient failure, which keeps
    the press in Telegram's queue so the next poll retries it.
    """
    cid = cb.get("id")
    data = cb.get("data") or ""
    frm = (cb.get("from") or {}).get("id")

    def answer(text, alert=False):
        try:
            api(token, "answerCallbackQuery",
                {"callback_query_id": cid, "text": text[:200],
                 "show_alert": "true" if alert else "false"})
        except Exception as e:
            print("  answerCallbackQuery failed (%s)" % type(e).__name__, file=sys.stderr)

    if not data.startswith("pa:"):
        answer("not an approval button")
        return True          # permanent: nothing to retry
    parts = data.split(":")
    if len(parts) != 3 or parts[2] not in ("c", "x"):
        answer("malformed button")
        return True          # permanent: nothing to retry
    item_id, decision = parts[1], ("confirm" if parts[2] == "c" else "cancel")

    if frm != APPROVE_OWNER:
        # These buttons only ever exist in a private DM to the owner, so this
        # should be unreachable. "Should be unreachable" is why it is checked.
        answer("You are not authorised to approve PCoin publications.", alert=True)
        print("  IGNORED approval press from user %s" % frm, file=sys.stderr)
        return True          # permanent: this account will never be allowed

    if DRY:
        print("  [dry-run] would %s approval item %s" % (decision, item_id))
        answer("dry run - nothing changed")
        return True

    # ANSWER FIRST. The press is genuine and from the right account; everything
    # after this point is work the owner should not have to watch a loader for.
    # The wording says what is ABOUT to happen rather than what has happened,
    # because it has not happened yet -- and if it then fails, the follow-up
    # below says so in a message. A spinner that stops on a lie is worse than a
    # spinner that spins.
    verdict = ("Confirmed - publishing now." if decision == "confirm"
               else "Cancelled. Nothing will be published.")
    answer(verdict)

    def tell(msg):
        """Say what went wrong AFTER the callback has already been answered."""
        try:
            api(token, "sendMessage", {"chat_id": str(frm), "text": msg})
        except Exception:
            pass

    try:
        r = subprocess.run([APPROVE, "decide", "--id", item_id,
                            "--decision", decision, "--by", str(frm), "--no-prompt"],
                           capture_output=True, text=True, timeout=60)
    except Exception as e:
        # A TIMEOUT RESOLVES NOTHING. `decide` writes the decision early and the
        # child was merely killed at 30s, so the press may well have landed --
        # it had, the one time this fired in anger, while this branch told the
        # owner "NOTHING was published".
        #
        # So do not guess in the reassuring direction: ask the queue what state
        # the item is actually in, and say that. Only claim nothing happened
        # when the queue still says it is awaiting a decision.
        state = None
        try:
            q = subprocess.run([APPROVE, "show", item_id],
                               capture_output=True, text=True, timeout=15)
            if q.returncode == 0:
                import json as _json
                state = (_json.loads(q.stdout) or {}).get("state")
        except Exception:
            state = None

        if state in ("published", "confirmed"):
            tell("Your %s DID register despite a %s -- the item is now '%s'. "
                 "Do NOT press again." % (decision, type(e).__name__, state))
        elif state == "cancelled":
            tell("Your cancel DID register despite a %s. Nothing will be "
                 "published. No need to press again." % type(e).__name__)
        elif state == "awaiting":
            tell("That press could not be recorded (%s) and the item is still "
                 "awaiting a decision. The button still works; press it again. "
                 "NOTHING was published." % type(e).__name__)
        else:
            # Could not read the state either. Say exactly that rather than
            # inventing an outcome in either direction.
            tell("That press timed out (%s) and I could not confirm whether it "
                 "registered. Check with: pcoin-approve show %s -- do not press "
                 "again until you have." % (type(e).__name__, item_id))
        print("  approval decide could not run (%s); item state=%s"
              % (type(e).__name__, state), file=sys.stderr)
        if state in ("published", "confirmed", "cancelled"):
            # It LANDED. Take the buttons away and consume the press; retrying
            # it only repeats this message and leaves a live Confirm under a
            # decision already taken.
            try:
                api(token, "editMessageText", {
                    "chat_id": str(frm),
                    "message_id": str((cb.get("message") or {}).get("message_id") or ""),
                    "text": "APPROVAL %s\nitem %s is now %s" % (decision.upper(), item_id, state),
                })
            except Exception:
                pass
            return True
        return False
    out = (r.stdout or r.stderr or "").strip().splitlines()
    out = out[-1] if out else ""
    if r.returncode != 0:
        tell("That press was refused: %s\nNOTHING was published." % out)
        print("  approval decide FAILED for %s: %s" % (item_id, out), file=sys.stderr)
        # The decision did NOT land. Do not consume the press: a read-only
        # filesystem, a locked queue or a full disk are all things that get
        # fixed, and when they are the owner should not have to press again.
        return False

    print("  approval %s: %s" % (item_id, decision))

    # KICK THE GATE NOW rather than leaving it for its next timer tick. This is
    # the single biggest saving in the whole path: without it a confirmed item
    # waits out a full gate interval before anything is published, which is most
    # of the delay the owner actually feels.
    #
    # `--no-block` because this handler is inside the poll loop: waiting on
    # another unit here would hold up every message queued behind this press, and
    # the gate publishing a moment later is fine. If the start fails the timer
    # still catches it, so this is an optimisation that cannot lose a message.
    if decision == "confirm":
        try:
            subprocess.run(["systemctl", "start", "--no-block", "pcoin-approve.service"],
                           capture_output=True, timeout=15)
        except Exception as e:
            print("  could not kick the gate (%s); the timer will pick it up"
                  % type(e).__name__, file=sys.stderr)

    # Replace the buttons with the outcome. Leaving a live Confirm button under a
    # decision already taken invites a second press days later against a queue
    # entry that has moved on.
    try:
        api(token, "editMessageText", {
            "chat_id": str(frm),
            "message_id": str((cb.get("message") or {}).get("message_id") or ""),
            "text": ("APPROVAL %s\n%s\nitem %s"
                     % (decision.upper(), verdict, item_id)),
        })
    except Exception as e:
        # Cosmetic only. The decision is already recorded, so this does not
        # affect whether the press is consumed.
        print("  could not edit the approval message (%s)" % type(e).__name__, file=sys.stderr)
    return True


def who(msg):
    f = msg.get("from") or {}
    name = " ".join(x for x in (f.get("first_name"), f.get("last_name")) if x) or "someone"
    if f.get("username"):
        name += " (@%s)" % f["username"]
    if (msg.get("sender_chat") or {}).get("title"):
        name = msg["sender_chat"]["title"]
    return name


def describe(msg):
    """What was said, in words, including the non-text kinds."""
    if msg.get("text"):
        return msg["text"]
    for k, label in (("photo", "a photo"), ("document", "a file"), ("video", "a video"),
                     ("voice", "a voice message"), ("sticker", "a sticker"),
                     ("animation", "a GIF"), ("audio", "audio")):
        if msg.get(k):
            cap = msg.get("caption")
            return ("%s: %s" % (label, cap)) if cap else label
    if msg.get("new_chat_members"):
        return "[joined the group]"
    if msg.get("left_chat_member"):
        return "[left the group]"
    return "[a message this watcher does not render]"



# ── moderation: outside links and adverts ─────────────────────────────────────
OWNER_ID = 508669931
ADMIN_TTL = 3600
# Our own Telegram handles. A t.me link to any of these is fine; to anything else
# it is somebody advertising their group.
OUR_TG = {"pcoinpcn", "pcoinpcnchat", "pcoinpcnbot", "pcoinaibot", "mywebsitebuilderbot"}


def link_allowed(url):
    u = url.strip().lower()
    for pre in ("https://", "http://"):
        if u.startswith(pre):
            u = u[len(pre):]
    if u.startswith("www."):
        u = u[4:]
    host, _, path = u.partition("/")
    host = host.split(":")[0].rstrip(".")
    first = path.split("/")[0].split("?")[0]
    if host == "pc.am" or host.endswith(".pc.am"):
        return True
    if host in ("t.me", "telegram.me"):
        return first in OUR_TG
    if host == "github.com":
        return first == "pars5555"
    if host == "discord.gg":
        return first == "dgmdwjkb9f"
    if host == "play.google.com":
        return "am.pc.pcoin" in u
    if host == "webcrafterai.com" or host.endswith(".webcrafterai.com"):
        return True
    # wPCN lives on BSC; people legitimately paste a transaction or the pool.
    if host in ("bscscan.com", "pancakeswap.finance"):
        return True
    return False


def moderation_reason(msg):
    """Why this message must be removed, or None. Deterministic only."""
    fo = msg.get("forward_origin") or {}
    fchat = fo.get("chat") or msg.get("forward_from_chat") or {}
    if (fo.get("type") == "channel" or fchat.get("type") == "channel") and \
            (fchat.get("username") or "").lower() not in OUR_TG:
        return "forwarded from another channel (%s)" % (fchat.get("title") or fchat.get("username") or "unknown")
    for text_key, ent_key in (("text", "entities"), ("caption", "caption_entities")):
        text = msg.get(text_key) or ""
        for e in msg.get(ent_key) or []:
            if e.get("type") == "text_link":
                url = e.get("url") or ""
            elif e.get("type") == "url":
                # Offsets are UTF-16 code units, not Python characters.
                b = text.encode("utf-16-le")
                url = b[2 * e.get("offset", 0): 2 * (e.get("offset", 0) + e.get("length", 0))].decode("utf-16-le", "replace")
            else:
                continue
            if url and not link_allowed(url):
                return "outside link: %s" % url[:120]
    return None


def group_admins(token, chat, st):
    """Administrators of `chat`, cached for an hour. An unreadable list returns
    None and NOTHING is moderated that run: removing an admin's message because
    the list could not be read is the unknown-collapses-into-no mistake."""
    cache = st.setdefault("admins", {})
    ent = cache.get(str(chat)) or {}
    if ent and time.time() - ent.get("at", 0) < ADMIN_TTL:
        return set(ent.get("ids") or [])
    try:
        j = api(token, "getChatAdministrators", {"chat_id": chat}, timeout=20)
    except Exception as e:
        print("  admin list unreadable (%s) -- moderation skipped this run" % type(e).__name__, file=sys.stderr)
        return None
    if not j.get("ok"):
        return None
    ids = [((m.get("user") or {}).get("id")) for m in j.get("result") or []]
    cache[str(chat)] = {"at": int(time.time()), "ids": [i for i in ids if i]}
    return set(cache[str(chat)]["ids"])


def remove_and_report(token, alert_to, chat, msg, reason):
    """Delete, then tell the owner. Returns True once the REPORT is delivered --
    the report is what may not be lost; a failed delete is reported as such."""
    mid = msg.get("message_id")
    deleted, why_not = False, ""
    if DRY:
        why_not = "dry run"
    else:
        try:
            r = api(token, "deleteMessage", {"chat_id": chat, "message_id": mid}, timeout=20)
            deleted = bool(r.get("ok"))
            why_not = "" if deleted else (r.get("description") or "not ok")
        except urllib.error.HTTPError as e:
            try:
                why_not = json.loads(e.read().decode("utf-8", "replace")).get("description") or "HTTP %d" % e.code
            except Exception:
                why_not = "HTTP %d" % e.code
        except Exception as e:
            why_not = type(e).__name__
    f = msg.get("from") or {}
    head = ("🧹 <b>PCoin Chat — message removed</b>" if deleted
            else "⚠️ <b>PCoin Chat — advert/link NOT removed</b> (%s)" % html.escape(why_not))
    body = ("%s\n<b>Who:</b> %s (id %s)\n<b>Why:</b> %s\n<b>Text:</b>\n%s"
            % (head, html.escape(who(msg)), f.get("id", "?"), html.escape(reason),
               html.escape(describe(msg)[:1500])))
    return send(token, alert_to, body)


def main():
    c = conf()
    token = c.get("TELEGRAM_TOKEN")
    alert_to = c.get("ALERT_CHAT") or c.get("MARKET_CHAT")
    if not token:
        sys.exit("no TELEGRAM_TOKEN in %s" % CONF)
    if not alert_to:
        sys.exit("no ALERT_CHAT in %s -- refusing to guess a destination" % CONF)

    st = load_state()
    if "--status" in sys.argv:
        print("  offset      : %d" % st["offset"])
        print("  messages seen: %d" % st["seen"])
        print("  last run    : %s" % (time.strftime("%Y-%m-%d %H:%M:%SZ", time.gmtime(st["last_run"]))
                                      if st["last_run"] else "never"))
        print("  group       : %d" % GROUP_ID)
        print("  test group  : %s" % (TEST_GROUP_ID or "not configured"))
        return 0

    # RETRY THE TRANSPORT, NEVER THE 409. This runs every sixty seconds behind
    # OnFailure=, so without a retry one reset connection pages the ops channel --
    # which happened at 2026-09-11 03:23 UTC, "[Errno 104] Connection reset by
    # peer", on a run that had nothing to report. An alert that fires on a dropped
    # packet is an alert people stop reading. A 409 is the opposite: it means a
    # SECOND consumer is stealing updates, each of you seeing half a conversation,
    # and retrying is what makes the two of you fight. That one is fatal, loudly.
    j = None
    for attempt in range(3):
        try:
            # LONG POLL. timeout=0 meant "tell me what is already waiting and
            # hang up", so with a 15s timer a button press could sit unseen for
            # 15 seconds while the owner watched the loader spin. Telegram holds
            # this request open instead and answers the moment anything arrives.
            #
            # The HTTP read timeout must exceed the long-poll timeout or urllib
            # aborts the very request it is waiting on -- that mistake turns a
            # working long poll into a retry loop that looks like a flaky
            # network.
            j = api(token, "getUpdates", {
                "offset": st["offset"], "timeout": POLL_SECONDS, "limit": 100,
                "allowed_updates": json.dumps(
                    ["message", "edited_message", "callback_query"])},
                timeout=POLL_SECONDS + 15)
            break
        except urllib.error.HTTPError as e:
            if e.code == 409:
                sys.exit("CONFLICT (409): something else is polling getUpdates for this bot. "
                         "Only one consumer may. Find it and stop it -- do not retry.")
            if e.code >= 500 and attempt < 2:
                time.sleep(2 ** attempt)
                continue
            sys.exit("getUpdates failed: HTTP %d" % e.code)
        except (urllib.error.URLError, OSError) as e:
            # Transport only. Report the TYPE, never the exception object: a URL
            # error can carry the request URL, and the URL carries the bot token.
            if attempt < 2:
                time.sleep(2 ** attempt)
                continue
            # Transport has been down for this whole run. Whether that is worth
            # waking anybody depends on HOW LONG, not on this one run failing:
            # the timer fires again in 25 seconds.
            now = time.time()
            since = st.get("net_down_since")
            if not isinstance(since, (int, float)) or since <= 0:
                since = now
                st["net_down_since"] = since
                save_state(st)
            down_for = now - since
            if down_for < NET_QUIET_SECONDS:
                # Quiet: log it and exit CLEANLY, so OnFailure= does not fire.
                # Not silent -- the journal carries it, and the next run decides
                # again with a longer elapsed time.
                # This file has no log() helper; it prints to stderr, which
                # systemd puts in the journal. Match the surrounding style
                # rather than introduce a second one.
                print("  getUpdates unreachable (%s); down %.0fs, staying quiet until %ds"
                      % (type(e).__name__, down_for, NET_QUIET_SECONDS), file=sys.stderr)
                return 0
            sys.exit("getUpdates unreachable for %.0f minutes (%s) -- this is no longer "
                     "a blip. Check this host's network and DNS."
                     % (down_for / 60.0, type(e).__name__))
        except Exception as e:
            sys.exit("getUpdates failed (%s)" % type(e).__name__)

    if not j.get("ok"):
        sys.exit("getUpdates said: %s" % j.get("description"))

    # Reached Telegram. Any run of transport failures is over, so forget it --
    # otherwise a link that blips once an hour would eventually cross the
    # fifteen-minute threshold while actually being fine.
    if st.pop("net_down_since", None) is not None:
        save_state(st)

    ups = j.get("result", [])
    if not ups:
        st["last_run"] = int(time.time())
        if not DRY:
            save_state(st)
        print("  nothing new")
        return 0

    highest = st["offset"]
    relayed = 0
    delivered_through = st["offset"]

    for u in ups:
        uid = u.get("update_id", 0)
        highest = max(highest, uid)
        # ---- the approval gate's buttons ---------------------------------
        # A press on Confirm/Cancel in the owner's DM arrives here as a
        # callback_query, and this is the only process that can see it.
        cb = u.get("callback_query")
        if cb:
            # Advance past it ONLY if it was actually acted on -- same rule this
            # file already applies to relays, and the first version of this
            # handler broke it.
            if handle_callback(token, cb):
                delivered_through = uid
            continue

        msg = u.get("message") or u.get("edited_message") or {}
        chat = (msg.get("chat") or {}).get("id")

        # Everything not from OUR group is consumed and ignored on purpose: this
        # is the only poller, so leaving them unconsumed would stall the offset
        # for ever behind traffic from the bot's other chats.
        if chat not in WATCHED:
            delivered_through = uid
            continue
        if (msg.get("from") or {}).get("is_bot"):
            delivered_through = uid
            continue
        # Telegram copies every channel post into its linked discussion group and
        # marks the copy `is_automatic_forward`. Relaying those means the operator
        # is told about announcements they wrote themselves, and an edit produces
        # a second one -- noise that trains people to ignore the channel this
        # writes to, which is the failure mode that matters.
        if msg.get("is_automatic_forward") or (msg.get("sender_chat") or {}).get("type") == "channel":
            delivered_through = uid
            continue

        # ---- moderation, BEFORE relay and spool ----------------------------
        uid_from = (msg.get("from") or {}).get("id")
        if uid_from != OWNER_ID:
            reason = moderation_reason(msg)
            if reason:
                admins = group_admins(token, chat, st)
                if admins is not None and uid_from not in admins:
                    if remove_and_report(token, alert_to, chat, msg, reason):
                        delivered_through = uid
                        continue
                    print("  removal report failed at update %d -- offset held" % uid, file=sys.stderr)
                    break

        text = describe(msg)
        urgent = bool(msg.get("text") and TRIGGERS.search(msg["text"]))
        head = "🆘 <b>PCoin Chat — someone needs help</b>" if urgent else "💬 <b>PCoin Chat</b>"
        body = ("%s\n<b>%s</b>\n%s\n\n<a href=\"https://t.me/PCoinPCNChat/%d\">open the message</a>"
                % (head, html.escape(who(msg)), html.escape(text[:1200]), msg.get("message_id", 0)))

        try:
            with open(LOG, "a", encoding="utf-8") as fh:
                fh.write("%s\t%s\t%s\t%s\n" % (
                    time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(msg.get("date", time.time()))),
                    who(msg), text.replace("\n", " ")[:600], msg.get("message_id", 0)))
        except OSError as e:
            print("  log write failed: %s" % e, file=sys.stderr)

        # Wrapped like the log write above, and for the same reason: the relay is
        # the load-bearing path and must survive anything that goes wrong here.
        if not DRY:
            try:
                os.makedirs(os.path.dirname(SPOOL), exist_ok=True)
                with open(SPOOL, "a", encoding="utf-8") as fh:
                    fh.write(json.dumps({
                        "update_id": uid,
                        # WHICH CHAT. Absent until there were two of them, and a
                        # row that does not say where it came from is a row that
                        # can be answered into the wrong group.
                        "chat": chat,
                        "message_id": msg.get("message_id"),
                        "date": msg.get("date", int(time.time())),
                        "from": who(msg),
                        "from_id": (msg.get("from") or {}).get("id"),
                        "text": msg.get("text") or "",
                        "described": text,
                        "urgent": urgent,
                    }, ensure_ascii=False) + "\n")
                # Trim by SIZE, not on every run: rewriting the file each minute to
                # keep it tidy costs more than the file ever will.
                if os.path.getsize(SPOOL) > SPOOL_MAX_BYTES:
                    with open(SPOOL, encoding="utf-8") as fh:
                        keep = fh.readlines()[-1000:]
                    tmp = SPOOL + ".tmp"
                    with open(tmp, "w", encoding="utf-8") as fh:
                        fh.writelines(keep)
                    os.replace(tmp, SPOOL)
            except OSError as e:
                print("  spool write failed: %s" % e, file=sys.stderr)

        if not send(token, alert_to, body):
            # Stop here. Everything before this update was delivered; everything
            # from here on will be re-read next run.
            print("  delivery failed at update %d -- offset held at %d"
                  % (uid, delivered_through + 1), file=sys.stderr)
            break
        relayed += 1
        delivered_through = uid
        st["seen"] += 1

    st["offset"] = delivered_through + 1
    st["last_run"] = int(time.time())
    if not DRY:
        save_state(st)
    print("  %d update(s) read, %d relayed, offset now %d%s"
          % (len(ups), relayed, st["offset"], " (dry run, nothing saved)" if DRY else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
