#!/bin/bash
# Can a BRAND NEW node still join the PCoin network?
#
# This is the one question no seed can answer about itself. Each seed runs
# pcoin-seed-watch, which checks its own container, peers, tip and listener from
# the inside -- all four can pass on all three seeds while a new node still
# cannot bootstrap, because bootstrapping depends on things that live outside
# any of them:
#
#   * seed.pc.am resolving, and resolving to the RIGHT hosts. The name is a
#     plain unproxied A record set; a DNS edit, an expired record or a
#     Cloudflare orange-cloud toggle breaks bootstrap without touching a single
#     server. An orange cloud is the nasty one: 9444 is not HTTP, so proxying
#     that record silently makes every A record useless while every seed stays
#     perfectly healthy.
#   * 9444 being reachable ACROSS the internet, not just bound locally. A
#     provider firewall, a ufw rule or a dropped Docker port publish all look
#     like health from inside the box.
#
# So this runs from the webbuilderbot host -- the only box in the fleet that is
# NOT a seed -- and looks in from where a stranger stands.
#
# Alerts only on a real loss of capability. seed.pc.am has three A records
# precisely so losing one is survivable, so one dead seed is a WARNING and all
# three dead is the emergency. Paging for a single seed would train the reader
# to ignore it, and the message that matters would go with it.
#
# Exit is always 0: a detected problem is an alert, not a cron mail as well.

set -u
NOTIFY="${NOTIFY:-/usr/local/bin/pcoin-notify}"
NAME="${NAME:-seed.pc.am}"
PORT="${PORT:-9444}"
# A fourth seed was removed 2026-08-22: that box was destroyed on purpose. Leaving
# it here made the check alert on every run, which is how a real alert gets
# tuned out before the next seed actually fails.
EXPECTED="${EXPECTED:-35.239.156.16 178.105.3.51 152.53.171.190}"

log()   { logger -t pcoin-bootstrap-watch -- "$*" 2>/dev/null || printf '%s\n' "$*"; }
alert() { log "ALERT: $1 -- $2"; [ -x "$NOTIFY" ] && "$NOTIFY" "$1" "$2" >/dev/null 2>&1; }

# ── 1. does the name resolve at all? ──
IPS=$(dig +short A "$NAME" @1.1.1.1 2>/dev/null | grep -E '^[0-9]+\.' | sort)
if [ -z "$IPS" ]; then
    IPS=$(dig +short A "$NAME" @8.8.8.8 2>/dev/null | grep -E '^[0-9]+\.' | sort)
    [ -n "$IPS" ] && log "note: 1.1.1.1 returned nothing, 8.8.8.8 did"
fi
if [ -z "$IPS" ]; then
    alert "🔴 New nodes cannot find the network: $NAME does not resolve" \
          "Two independent DNS resolvers (1.1.1.1 and 8.8.8.8) returned no address for $NAME, the name every new PCoin node looks up first.
Customers affected: new users installing a node or wallet may not connect. Everyone already running keeps working, so nothing else will look wrong.
What to do: check the $NAME record in Cloudflare DNS (it must exist and be DNS-only, grey cloud).
—
tech: PCoin BOOTSTRAP DOWN, no A record for $NAME"
    exit 0
fi

# ── 2. is it pointing where we think? ──
# Catches an orange-cloud toggle (9444 is not HTTP, so proxying kills bootstrap
# while every seed stays green) and any stale or unexpected record.
for ip in $IPS; do
    case "$ip" in
        104.2*|172.6[4-9].*|172.7[01].*|188.114.*|162.159.*|104.1[6-9].*)
            alert "🔴 New nodes cannot find the network: $NAME is behind the Cloudflare proxy" \
                  "$NAME points at a Cloudflare address ($ip). Nodes talk on port $PORT, which Cloudflare's proxy cannot carry, so new nodes cannot connect -- while every seed still reports healthy.
What to do: set the $NAME record back to DNS-only (grey cloud) in Cloudflare.
—
tech: PCoin BOOTSTRAP BROKEN: proxied record"
            exit 0 ;;
    esac
done

MISSING=""
for want in $EXPECTED; do
    echo "$IPS" | grep -qx "$want" || MISSING="$MISSING $want"
done
EXTRA=""
for got in $IPS; do
    echo "$EXPECTED" | tr ' ' '\n' | grep -qx "$got" || EXTRA="$EXTRA $got"
done
[ -n "$MISSING" ] && alert "🟡 A seed server dropped out of $NAME" \
    "$NAME no longer lists:$MISSING . It lists: $(echo $IPS). New nodes still find the network while one seed answers, but there is less spare capacity.
What to do: add the missing address back to the $NAME record if the server is still meant to be a seed.
—
tech: PCoin seed DNS changed: records missing"
[ -n "$EXTRA" ] && alert "🟡 $NAME lists an unexpected server" \
    "$NAME now includes an address that is not one of our seeds:$EXTRA . It lists: $(echo $IPS).
What to do: if you added it on purpose, add it to EXPECTED in $0; if not, remove it from DNS.
—
tech: PCoin seed DNS changed: unexpected record"

# ── 3. can a stranger actually open 9444? ──
# The real test. `listening` inside the box proves the socket is bound; only a
# connection from off-box proves the path.
UP=0; DOWN=""
for ip in $EXPECTED; do
    if timeout 12 bash -c "exec 3<>/dev/tcp/$ip/$PORT" 2>/dev/null; then
        UP=$((UP+1))
    else
        DOWN="$DOWN $ip"
    fi
done

TOTAL=$(echo $EXPECTED | wc -w)
if [ "$UP" -eq 0 ]; then
    alert "🔴 New nodes cannot join: no seed server accepts connections" \
          "All $TOTAL seed servers refused a connection on port $PORT from outside:$DOWN . No new node can join the network. Nodes already running are unaffected, and each seed's own check may still look fine.
What to do: check the PCoin node and the firewall on the seed servers named above.
—
tech: PCoin BOOTSTRAP DOWN: no seed accepts $PORT"
elif [ -n "$DOWN" ]; then
    alert "🟡 A seed server is unreachable ($UP of $TOTAL still answer)" \
          "$UP of $TOTAL seed servers still accept new nodes on port $PORT. Unreachable from outside:$DOWN . New nodes can still join.
What to do: check the PCoin node and firewall on that server before another one goes.
—
tech: PCoin seed unreachable on $PORT (redundancy reduced)"
else
    log "bootstrap ok: $NAME -> $(echo $IPS | tr '\n' ' '), $UP/$TOTAL seeds accept $PORT"
fi
exit 0
