#!/usr/bin/env python3
"""Alert when one party is finding too many of the blocks.

WHY THIS EXISTS. On 2026-08-20 a single outside address went from mining
nothing to finding ~70% of blocks in about a day, and it was found BY HAND,
days late, and only because somebody went back to re-check a figure that had
already been published wrongly. Nothing on any box was watching the one number
that decides whether the chain can be reorganised at will.

Deposit crediting on every PCN service gates on confirmations, and confirmations
are worthless against a majority miner -- they buy time, not safety. So the
thing worth alerting on is not "was there a reorg" (by then the money is gone)
but "is somebody in a position to cause one".

HOW IT MEASURES. Read straight off the chain from the node this runs on -- no
explorer, no third party, nothing to be lied to by. `getblock <hash> 2` carries
the coinbase outputs, so one RPC per block. Every block lands in one of three
buckets, and each bucket names the PARTY that found it:

  * OURS -- the coinbase pays one of OUR pools' own fee addresses (OUR_POOLS)
    and has the pool shape (2+ paying outputs).
  * OUTSIDE POOL -- any other pool-shaped coinbase. The party is the pool's fee
    address: the output that is a round percentage of the coinbase (see
    fee_address()).
  * SOLO -- one paying output (or two that are not a pool). The party is the
    payout address.

UNTIL 2026-09-27 "3+ outputs" MEANT "OUR POOL", and that was wrong as soon as
outside pools appeared, because they pay many outputs too. For heights
9417-9716 it said our pool had 84.3% [80-88]; matching block hashes against
both pool ledgers gave pool.pc.am 182 + pool2.pc.am 14 = 65.3%. The owner was
paged "our pool found 74% -> 85%" all day on a figure 19 points too high.

TWO ALERTS, and together they cover every single party:
  * OUR share, against --crit (the "pool" state). The pool server picks what
    every one of its miners builds on, so this is the share one operator -- us
    -- steers.
  * The LARGEST OTHER party -- one outside pool (by fee address) or one solo
    address -- against --warn/--crit on the confidence interval (the "solo"
    state, named before outside pools existed).
Ours is not a candidate in the second alert on purpose: it has its own text,
and a 65% pool made of many independent miners must not read "one miner has
65%, hold deposits".

A STALE OUR_POOLS LIST FAILS LOUD, NOT QUIET. If our pools' fee address ever
changes and nobody updates the list, our blocks do not vanish: fee_address()
finds our 2% output, and our whole share arrives in the second alert as one
"outside pool" above 50% -- CRITICAL, with our own address in the text.

WINDOW SIZE IS THE WHOLE GAME. A 60-block window at p=0.5 has a standard error
of ~6.5 points, so single readings swing +/-13 points at 95% confidence and look
like trends when they are noise. Four consecutive 60-block readings taken during
the incident read 50.0, 56.7, 41.7 and 53.3 -- all the same number. The default
here is 300 blocks and it should not be lowered to make the script faster.

The alert text always carries the window and the confidence interval, because a
bare percentage invites exactly the over-reading that caused the original
mistake.

RE-ALERTING IS GATED ON CHANGE, NOT ON TIME. On 2026-08-21 this script sent the
same 66% twenty-four times in eight hours from two hosts, because every timer
tick that found the condition true announced it again. Nobody needs the same
fact every thirty minutes; they need to know when it CHANGES. State lives in
STATE_PATH and a re-alert now requires one of: a different top address, a level
transition (including clearing), a move of >=5 percentage points, or
--remind-hours elapsed since the last send (the condition staying true deserves
an occasional reminder, not a drumbeat). The measurement itself still runs and
still prints every tick, so the journal shows the monitor alive either way.
--dry-run never touches state.

Usage:
    pcoin-concentration-watch [--window N] [--warn PCT] [--crit PCT]
                              [--remind-hours H] [--state PATH] [--dry-run]
                              [--ours ADDR[=LABEL] ...] [--end-height H]

--end-height judges a past window (an audit: it implies --dry-run).

Exits 0 even when it alerts: this is a monitor, and a monitor that fails a
timer unit just buries its own message.
"""

import argparse
import collections
import json
import math
import os
import shutil
import subprocess
import sys
import time

CLI_CANDIDATES = [
    ["/opt/pcoin/bin/bitcoin-cli", "-conf=/etc/pcoin/pcoin.conf"],
    ["docker", "exec", "pcoin-seed", "bitcoin-cli"],
    ["bitcoin-cli"],
]
NOTIFY = "/usr/local/bin/pcoin-notify"
STATE_PATH = "/var/lib/pcoin-concentration-watch.json"

# OUR pools' own fee addresses -> how to name them. pool.pc.am and pool2.pc.am
# pay the SAME address (the treasury: `poolAddress` in both pool.config.json
# files) and their coinbases carry no pool tag, so the chain cannot split them
# and they are one line here. The address is public -- it is on-chain and in
# contrib/pool/pool.config.json -- so it lives in this file, not in the unit: a
# bare run must give the same answer as the timer (CLAUDE.md 7.14). --ours
# REPLACES this list.
#
# A single-output coinbase to this address is NOT ours-by-pool: no pool found
# it, a fleet PC mined it solo to the treasury. It is reported with the solo
# miners, marked as ours, which is what makes this figure match the two pool
# ledgers block for block.
OUR_POOLS = {
    "pc1qlvw6kx8wkcz8f6p0d6kswv69fjt33ll079f64e": "pool.pc.am + pool2.pc.am",
}

# How a pool's fee output is recognised: a round percentage of the coinbase
# (0.5% steps up to 10%) give or take FEE_SLACK_SATS of rounding.
FEE_STEPS = range(1, 21)          # k/200 of the coinbase: 0.5% .. 10%
FEE_SLACK_SATS = 1000             # a PPLNS split leaves < 1 sat per miner over
# Pool-shaped blocks whose fee output cannot be found. They are counted as ONE
# party, which can only overstate any single one of them -- the safe direction
# for an alarm. Plain words: this string reaches Telegram, and an underscore or
# asterisk would break its Markdown.
UNIDENTIFIED = "(outside pools with no recognisable fee output, counted together)"


def find_cli():
    """Pick whichever way this box talks to its node.

    Seeds are inconsistent on purpose -- some run the node natively under
    systemd, some in a container -- and hard-coding one shape is how a monitor
    silently stops covering half the fleet.
    """
    for cand in CLI_CANDIDATES:
        exe = cand[0]
        if exe == "docker":
            if not shutil.which("docker"):
                continue
        elif not (os.path.isfile(exe) or shutil.which(exe)):
            continue
        try:
            subprocess.run(cand + ["getblockcount"], capture_output=True,
                           timeout=20, check=True)
            return cand
        except Exception:
            continue
    return None


def rpc(cli, *args):
    r = subprocess.run(cli + list(args), capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        raise RuntimeError((r.stderr or r.stdout).strip()[:200])
    out = r.stdout.strip()
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return out


POOL_APIS = [("pool.pc.am", "https://pool.pc.am/api/pools/pcoin"),
             ("pool2.pc.am", "https://pool2.pc.am/api/pools/pcoin")]


def pool_miner_counts(timeout=12):
    """[(pool, connected miners or None for UNKNOWN)] for each of our pools.

    Public endpoints, no credential. None must render as "unknown" and never as
    a number -- "the pool has no miners" and "I could not ask" are opposite
    facts and this alert is read by someone deciding whether to worry.
    """
    import urllib.request as _u
    out = []
    for name, url in POOL_APIS:
        try:
            with _u.urlopen(url, timeout=timeout) as r:
                d = json.load(r)
            p = d.get("pool") or d
            n = (p.get("poolStats") or {}).get("connectedMiners")
            out.append((name, int(n) if n is not None else None))
        except Exception:
            out.append((name, None))
    return out


def fee_address(paying):
    """The address a pool pays its fee to, or None.

    A PPLNS pool takes a fixed percentage of the block and pays it -- plus a few
    satoshis of rounding -- to its own address, while miners get arbitrary
    amounts. Height 9495: 50000032 sat of a 5000002918-sat coinbase went to
    pc1qdjd0...; 1% is 50000029, plus a 3-sat remainder. Ours pays 2% plus ~40
    sat. So the output within FEE_SLACK_SATS of a round percentage is the fee,
    and the closest one wins. On heights 9417-9716 this named the fee address of
    all 254 pool-shaped blocks, ours and outside, and no miner.

    `paying` is [(satoshis, address)]. The chance of a miner's share landing on
    a round percentage by accident is ~1e-6 per output.
    """
    total = sum(v for v, _ in paying)
    best = None
    for v, a in paying:
        for k in FEE_STEPS:
            d = abs(v - total * k // 200)
            if d <= FEE_SLACK_SATS and (best is None or d < best[0]):
                best = (d, a)
    return best[1] if best else None


def classify(block, ours):
    """-> (kind, key), kind 'ours' | 'outside' | 'solo', or (None, None).

    key is who found it: our pool's label, an outside pool's fee address (or
    UNIDENTIFIED), or a solo miner's payout address.

    An unreadable block resolves NOTHING. It is not a solo block and it is not a
    pool block; it is dropped from the denominator. Counting it either way would
    move the very number this alert fires on.
    """
    txs = block.get("tx") or []
    if not txs:
        return None, None
    cb = txs[0]
    paying = []
    for o in cb.get("vout") or []:
        if float(o.get("value") or 0) <= 0:
            continue  # the witness commitment is a zero-value OP_RETURN
        spk = o.get("scriptPubKey") or {}
        addr = spk.get("address")
        if not addr:
            addrs = spk.get("addresses") or []
            addr = addrs[0] if addrs else None
        # Amounts arrive as bare JSON numbers: round to satoshis explicitly.
        paying.append((int(round(float(o["value"]) * 1e8)), addr))
    if not paying:
        return None, None
    if len(paying) >= 2:
        for _, a in paying:
            if a in ours:
                return "ours", ours[a]
        fee = fee_address(paying)
        if fee:
            return "outside", fee
        if len(paying) >= 3:
            return "outside", UNIDENTIFIED
    return "solo", paying[0][1]


def ci95(k, n):
    if not n:
        return 0.0, 0.0, 0.0
    p = k / float(n)
    se = math.sqrt(p * (1 - p) / n)
    return 100 * p, 100 * max(0.0, p - 1.96 * se), 100 * min(1.0, p + 1.96 * se)


def notify(subject, body, dry):
    if dry or not os.path.isfile(NOTIFY):
        print("--- would alert ---\n%s\n%s" % (subject, body))
        return
    try:
        subprocess.run([NOTIFY, subject, body], timeout=60)
    except Exception as e:
        print("notify failed: %s" % e, file=sys.stderr)


def load_state(path):
    """Missing or corrupt state means 'never alerted', which errs toward
    alerting once more -- the safe direction for a monitor."""
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return {}


def save_state(path, state):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, indent=1)
    os.replace(tmp, path)  # atomic: a killed run can never leave half a file


def send_decision(prev, level, addr, value, remind_s, now):
    """Why this send should happen, or None to suppress.

    The question is never "is the condition true" -- the measurement already
    decided that. The question is "does the reader learn anything new".
    """
    if not prev:
        return "new condition"
    if prev.get("level") != level:
        return "level changed %s -> %s" % (prev.get("level"), level)
    if addr is not None and prev.get("addr") != addr:
        return "top address changed"
    if abs(value - prev.get("value", 0.0)) >= 5.0:
        return "moved %.1f -> %.1f points" % (prev.get("value", 0.0), value)
    if now - prev.get("at", 0) >= remind_s:
        return "reminder: condition persists"
    return None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--window", type=int, default=300)
    ap.add_argument("--warn", type=float, default=40.0)
    ap.add_argument("--crit", type=float, default=50.0)
    ap.add_argument("--remind-hours", type=float, default=6.0)
    ap.add_argument("--state", default=STATE_PATH)
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--ours", action="append", metavar="ADDR[=LABEL]",
                    help="our pools' fee address; repeatable; REPLACES the built-in list")
    ap.add_argument("--end-height", type=int,
                    help="judge the window ending here instead of at the tip (implies --dry-run)")
    a = ap.parse_args()

    ours = OUR_POOLS
    if a.ours:
        ours = {}
        for item in a.ours:
            addr, _, label = item.partition("=")
            ours[addr.strip()] = label.strip() or addr.strip()
    if a.end_height is not None and not a.dry_run:
        # A past window is an audit. Alerting on it, or recording it as the
        # last thing said, would page someone about history.
        print("--end-height implies --dry-run: nothing will be sent or saved")
        a.dry_run = True

    cli = find_cli()
    if not cli:
        # A monitor that cannot read the chain must say so, not report 0%.
        print("no usable bitcoin-cli on this host", file=sys.stderr)
        return 0

    tip = int(rpc(cli, "getblockcount"))
    if a.end_height is not None:
        tip = min(tip, a.end_height)
    lo = max(1, tip - a.window + 1)

    mine = collections.Counter()      # our pool label -> blocks
    outside = collections.Counter()   # outside pool fee address -> blocks
    solo = collections.Counter()      # solo payout address -> blocks
    unreadable = 0
    for h in range(lo, tip + 1):
        try:
            bh = rpc(cli, "getblockhash", str(h))
            kind, key = classify(rpc(cli, "getblock", bh, "2"), ours)
        except Exception:
            kind, key = None, None
        if kind == "ours":
            mine[key] += 1
        elif kind == "outside":
            outside[key] += 1
        elif kind == "solo":
            solo[key] += 1
        else:
            unreadable += 1

    pool = sum(mine.values())
    n = pool + sum(outside.values()) + sum(solo.values())
    if n < a.window * 0.8:
        print("only %d/%d blocks readable -- refusing to judge" % (n, a.window),
              file=sys.stderr)
        return 0

    # The largest party that is not our pools: one outside pool or one solo
    # address. Keyed by address, so a pool operator who also mines solo to its
    # own fee address is one party, not two.
    parties = outside + solo
    top_addr, top_n = (parties.most_common(1) or [(None, 0)])[0]
    if top_addr == UNIDENTIFIED:
        top_word, top_kind = "group of outside pools", "Outside pools we cannot tell apart"
    elif top_addr in outside and top_addr in solo:
        top_word, top_kind = "outside pool", "One outside pool (fee address, also mining solo)"
    elif top_addr in outside:
        top_word, top_kind = "outside pool", "One outside pool (a single fee address)"
    else:
        top_word, top_kind = "miner", "One miner (a single payout address)"
    if top_addr in ours:
        top_kind += ", which is OURS"
    tp, tlo, thi = ci95(top_n, n)
    pp, plo, phi = ci95(pool, n)
    op = 100.0 * sum(outside.values()) / n
    sp = 100.0 * sum(solo.values()) / n
    ours_solo = sum(c for addr, c in solo.items() if addr in ours)

    line = ("window %d-%d (%d blocks): ours %.1f%% [%.0f-%.0f] (%s)%s"
            " | outside pools %.1f%% (%d fee addresses) | solo %.1f%% (%d addresses)"
            " | largest other party %.1f%% [%.0f-%.0f] %s%s"
            % (lo, tip, n, pp, plo, phi,
               ", ".join("%s %d" % kv for kv in mine.most_common()) or "none",
               (" +%d solo to our address" % ours_solo) if ours_solo else "",
               op, len(outside), sp, len(solo),
               tp, tlo, thi, (top_addr or "-"),
               " (pool)" if top_addr in outside else ""))
    print(line)

    state = load_state(a.state)
    now = time.time()
    remind_s = a.remind_hours * 3600
    dirty = False

    # Alert on the CONFIDENCE INTERVAL, not the point estimate. Waiting for the
    # midpoint to cross 50 means waiting until it is already comfortably past.
    level = None
    if tp >= a.crit or thi >= a.crit:
        level = "CRITICAL" if tp >= a.crit else "WARNING"
    elif tp >= a.warn:
        level = "WARNING"

    # The "solo" state holds the LARGEST OTHER PARTY -- an outside pool or a solo
    # address. The key keeps its old name so a state file written before outside
    # pools were told apart still gates correctly.
    if level:
        reason = send_decision(state.get("solo"), level, top_addr, tp, remind_s, now)
        if reason:
            body = (
                "%s found %.1f%% of the last %d blocks\n"
                "(heights %d-%d; 95%% range %.0f-%.0f%%). Our pools found %.1f%% in the same blocks.\n"
                "Why it matters: one party above 50%% can rewrite recent blocks and reverse a\n"
                "payment that already looked settled. Waiting for more confirmations buys\n"
                "time, not safety.\n"
                "What to do: %s\n"
                "\u2014\n"
                "tech: address %s. Re-alert because: %s. Next reminder in %.0fh unless it\n"
                "changes. https://explorer.pc.am"
                % (top_kind, tp, n, lo, tip, tlo, thi, pp,
                   ("hold large PCN credits for extra confirmations until it drops, and "
                    "look at who owns that address." if level == "CRITICAL" else
                    "nothing yet -- watch it. At 50% it becomes a real risk."),
                   top_addr or "?", reason, a.remind_hours)
            )
            notify("%s One %s has %.0f%% of recent blocks (%s)"
                   % ("\U0001F534" if level == "CRITICAL" else "\U0001F7E1",
                      top_word, tp, "above 50%" if level == "CRITICAL" else "watch"),
                   body, a.dry_run)
            state["solo"] = {"level": level, "addr": top_addr, "value": tp, "at": now}
            dirty = True
        else:
            nxt = (state["solo"].get("at", 0) + remind_s - now) / 3600
            print("suppressed: unchanged (%.1f%% vs %.1f%% last sent); reminder in %.1fh"
                  % (tp, state["solo"].get("value", 0.0), max(0, nxt)))
    elif state.get("solo"):
        # The all-clear is a state change too, and the one people stop watching
        # for. It is sent exactly once, because the state that caused it is
        # deleted in the same breath.
        notify("\U0001F7E2 No single outside miner or pool dominates any more",
               "The biggest one outside our pools now has %.1f%% of the last %d blocks (95%% range\n"
               "%.0f-%.0f%%) -- below the %.0f%% warning line. It was %s at %.1f%%.\n"
               "What to do: nothing."
               % (tp, n, tlo, thi, a.warn,
                  state["solo"].get("level"), state["solo"].get("value", 0.0)), a.dry_run)
        del state["solo"]
        dirty = True

    # pp, not pool: `pool` is a COUNT of blocks and a.crit is a PERCENTAGE.
    # Comparing them fired this alert at 32.7% -- caught only because the alert
    # body printed the real figure next to the word "majority" and the two
    # disagreed. An alert that cries wolf gets muted, taking the real one with it.
    if pp >= a.crit:
        reason = send_decision(state.get("pool"), "WARNING", None, pp, remind_s, now)
        if reason:
            who = ", ".join("%s on %s" % ("unknown" if c is None else c, name)
                            for name, c in pool_miner_counts())
            notify("\U0001F7E1 Our pools found %.0f%% of recent blocks" % pp,
                   "Our pools (%s) found *%.1f%%* of the last %d blocks (95%% range %.0f-%.0f%%).\n"
                   "Miners connected right now: %s.\n"
                   "Those are many independent miners, the biggest a few percent -- but the pool\n"
                   "server decides what all of them build on, so %.0f%% of the network follows one\n"
                   "operator (us), and if the pools go down that mining stops at once.\n"
                   "Outside pools found %.1f%% and solo miners %.1f%% of the same blocks.\n"
                   "What to do: nothing today. Only more mining outside our pools lowers this --\n"
                   "there is a 500 PCN bounty for another pool.\n"
                   "\u2014\n"
                   "tech: blocks are ours when the coinbase pays our pools' fee address. "
                   "Re-alert because: %s."
                   % (", ".join(mine) or "none", pp, n, plo, phi, who, pp, op, sp, reason),
                   a.dry_run)
            state["pool"] = {"level": "WARNING", "addr": None, "value": pp, "at": now}
            dirty = True
        else:
            nxt = (state["pool"].get("at", 0) + remind_s - now) / 3600
            print("ours: suppressed: unchanged (%.1f%% vs %.1f%% last sent); reminder in %.1fh"
                  % (pp, state["pool"].get("value", 0.0), max(0, nxt)))
    elif state.get("pool"):
        notify("\U0001F7E2 Our pools are back under half of the blocks",
               "Our pools now find *%.1f%%* of the last %d blocks (95%% range %.0f-%.0f%%).\n"
               "More of the network is mined outside our pools -- the direction we want.\n"
               "What to do: nothing."
               % (pp, n, plo, phi), a.dry_run)
        del state["pool"]
        dirty = True

    if dirty and not a.dry_run:
        save_state(a.state, state)

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:
        print("concentration-watch failed: %s" % e, file=sys.stderr)
        sys.exit(0)
