[Unit]
Description=Deliver a PCoin monitor failure to the alert channel (%i)

[Service]
Type=oneshot
# %i is the failing unit's name, passed in by OnFailure=pcoin-alert@%n.service.
#
# This used to be an inline `sh -c` that piped journalctl straight into
# pcoin-notify. It is a script now so the alert can carry the unit's Result and
# exit code -- "died on its first line" and "ran and exited 3" are different
# faults and the journal tail alone does not distinguish them -- and so the
# body is stripped of Markdown-breaking characters before it is sent rather
# than relying on pcoin-notify's plain-text fallback to rescue it.
ExecStart=/usr/local/bin/pcoin-unit-failed %i
Nice=10
MemoryMax=64M
TimeoutStartSec=60
