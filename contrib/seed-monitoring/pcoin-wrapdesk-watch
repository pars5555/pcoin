def get(url, timeout=25):
    """JSON GET, or None. None is UNKNOWN and must never be treated as a value."""
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return json.load(r)
    except Exception:
        return None


def index_from_price(price):
    """The PCN index from a price.pc.am body of EITHER shape -> a dict (maybe
    empty, never None) with usd / state / stale. Pure; main() judges it.

    Owner, 2026-09-25: "simplify the price.pc.am json response". While the
    `index` block is published it IS the index -- with the rails rolled back
    ({"useIndex":0}) the top-level creditRateUsd is the pool-follow rate, not
    the index -- so the block wins, and a top-level `stale` that is present and
    not literally False marks it stale too (every published flag counts). In
    the minimal body the index is the top level: creditRateUsd, state, stale.
    """
    if not isinstance(price, dict):
        return {}
    ix = price.get("index")
    if isinstance(ix, dict):
        if "stale" in price and price.get("stale") is not False:
            ix = dict(ix, stale=True)
        return ix
    if isinstance(price.get("state"), str):
        return {"usd": price.get("creditRateUsd"), "state": price.get("state"),
                "stale": price.get("stale")}
    return {}


def explorer_get(path, timeout=25):
    """GET <explorer><path>, trying each base in EXPLORERS -- loopback first.

    None means every base failed, which is UNKNOWN. It is emphatically not
    "no deposits": the caller keeps every existing task open on a None.
    """
    for base in EXPLORERS:
        d = get(f"{base}{path}", timeout=timeout)
        if d is not None:
            return d
    return None


def load_state():
    # NORMALISE, do not just parse. The skeleton used to be returned only when
    # the file was unreadable, so a file that parsed but lacked a key -- a fresh
    # "{}", or one written by an older version -- crashed with KeyError: 'seen'
    # on the first wrap it looked at. A first install is the worst possible
    # moment for a traceback, and the failure looked like a broken watcher
    # rather than a missing key.
    try:
        with open(STATE) as f:
            st = json.load(f)
        if not isinstance(st, dict):
            st = {}
    except Exception:
        st = {}
    for k in ("seen", "nagged", "outstanding"):
        if not isinstance(st.get(k), dict):
            st[k] = {}
    # REFUSE TO RUN ON AN UN-MIGRATED LEDGER. Keys changed from wrap:<txid> to
    # wrap:<txid>:<address> on 2026-09-05. An old-format key would simply never
    # match the new lookup, so every already-released wrap would be reported
    # again as an ACTION and an operator could pay it twice. That is the exact
    # opposite of the bug the new key fixes, and silently tolerating the old
    # format would hide a half-done migration behind a working-looking run.
    # Refusing loudly is the only outcome that cannot cost money.
    stale = [k for k in list(st["seen"]) + list(st["nagged"])
             if k.startswith("wrap:") and k.count(":") == 1]
    if stale:
        msg = ("REFUSING TO RUN: %d ledger key(s) are in the old wrap:<txid> format:\n  %s\n"
               "Migrate them first (verifies each against the chain):\n"
               "  python3 /usr/local/bin/migrate_wrap_keys.py --apply\n"
               % (len(stale), "\n  ".join(stale)))
        sys.stderr.write(msg)
        # stderr alone reaches nobody: this unit runs from a timer every 15 min,
        # exit 3 is a plain systemd failure with no OnFailure wiring of its own,
        # and while it refuses NO wrap is reported -- a new deposit in that window
        # would sit unannounced indefinitely. So say it where the operator looks.
        # It repeats every run until fixed, which is correct for this state.
        if not DRY_RUN:
            try:
                notify("wrap desk: REFUSING TO RUN -- un-migrated ledger", msg)
            except Exception:
                pass
        sys.exit(3)
    return st


_LOCK_FH = None


def take_state_lock():
    """Serialise everyone who intends to WRITE the ledger.

    load -> modify -> save is a read-modify-write, and there are now two
    writers: this timer every ~16 minutes, and the admin panel's "Mark as
    sent" button whenever an operator presses it. Without a lock the two can
    interleave and the later save silently discards the earlier one -- and the
    update most likely to be lost is the button's, because the timer's run is
    the long one. The operator would be told "recorded as sent" and then watch
    the same wrap reappear an hour later, which is precisely the kind of
    confident-but-wrong that costs a second payment.

    Readers do NOT take this: a --dry-run holds no lock, so rendering the
    admin page can never block the timer or be blocked by it.

    The handle is parked in a module global on purpose -- closing it drops the
    lock, so it must outlive this function and die with the process.
    """
    global _LOCK_FH
    if DRY_RUN or _LOCK_FH is not None:
        return
    try:
        import fcntl
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        _LOCK_FH = open(STATE + ".lock", "w")
        fcntl.flock(_LOCK_FH, fcntl.LOCK_EX)
    except Exception as e:
        # Not fatal. A missing lock is the behaviour we had until 2026-09-20,
        # and refusing to run would turn a small race into a dead watcher.
        _LOCK_FH = None
        sys.stderr.write(f"[warn] could not lock the ledger ({e}); "
                         f"continuing without it\n")


def save_state(s):
    # A DRY RUN IS A READ. It must not write, and until 2026-09-20 it did.
    #
    # Two things fell out of that, both found the same afternoon. The admin
    # panel runs this to render /wrapdesk, and its sandbox makes /var/lib
    # read-only, so every page load ended in an OSError traceback in the
    # journal -- harmless only because the output was already complete by then.
    # Worse, had the write SUCCEEDED it would have stamped `nagged` for every
    # item it reported, and the next real Telegram alert would have been
    # silenced for an hour by somebody merely LOOKING at the page.
    #
    # "Show me what you would do" must never change what happens next.
    if DRY_RUN:
        return
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(s, f, indent=1)
    os.replace(tmp, STATE)          # atomic; a torn state file loses the queue


def notify(subject, body):
    if not os.path.exists(NOTIFY):
        print(f"[no notifier] {subject}\n{body}")
        return
    subprocess.run([NOTIFY, subject, body], timeout=60)


def pool_price():
    """{'price': float} from the pair contract, or None if unreadable.

    Read from getReserves() rather than any API: it is the source of truth and
    cannot be stale. None means UNKNOWN and the caller must not assume a side.
    """
    try:
        # Installed to /usr/local/bin, but deploy.py lives with the deployment
        # in /opt/wpcn. Inserting the script's own directory finds nothing.
        sys.path.insert(0, os.environ.get("WPCN_DIR", "/opt/wpcn"))
        sys.path.insert(1, os.path.dirname(os.path.abspath(__file__)))
        from web3 import Web3
        from deploy import load, connect
        cfg = load()
        w3, _ = connect(cfg)
        abi = [{"constant": True, "inputs": [], "name": "getReserves",
                "outputs": [{"name": "_r0", "type": "uint112"},
                            {"name": "_r1", "type": "uint112"},
                            {"name": "_t", "type": "uint32"}], "type": "function"},
               {"constant": True, "inputs": [], "name": "token0",
                "outputs": [{"name": "", "type": "address"}], "type": "function"}]
        pair = w3.eth.contract(address=Web3.to_checksum_address(cfg["PAIR"]), abi=abi)
        r0, r1, _ = pair.functions.getReserves().call()
        t0 = pair.functions.token0().call()
        tok = Web3.to_checksum_address(cfg["TOKEN"])
        wp, us = (r0 / 1e8, r1 / 1e18) if t0 == tok else (r1 / 1e8, r0 / 1e18)
        return {"price": us / wp, "wpcn": wp, "usdt": us}
    except Exception:
        return None


# keccak256("Transfer(address,address,uint256)"), the BEP-20 event every token
# emits. Hardcoded because it is a constant of the standard, not of our token.
TRANSFER_TOPIC = ("ddf252ad1be2c89b69c2b068fc378daa"
                  "952ba7f163c4a11628f55a4df523b3ef")
WPCN_DECIMALS = 8       # matches pool_price()'s r/1e8 on the wPCN side


def verify_wpcn_sent(txhash, to_addr, expect_wpcn):
    """Did this BSC transaction really put expect_wpcn of wPCN into to_addr?

        (True,  detail)   the receipt says so
        (False, why)      the receipt says something else -- a real NO
        (None,  why)      UNKNOWN: nothing could be read. Not a no, and
                          emphatically not a yes (CLAUDE.md 7.1 / 7.2)

    ONE RECEIPT IS THE ONE BSC READ THAT IS FREE EVERYWHERE. eth_getLogs is
    refused at every range by the public endpoints -- measured 2026-09-08 at
    spans of 1, 50, 500 and 5000 blocks -- which is why this asks about a hash
    the operator hands it instead of scanning for the payment itself. It is also
    why the whole wPCN payment path is keyed on hashes.

    It checks the three things that could be wrong independently: the right
    token (not some other BEP-20 of the same name), the right recipient (not the
    previous customer, whose address is one line up in the alert), and at least
    the right amount. A transaction that reverted emits no Transfer at all, and
    status is checked first anyway.
    """
    try:
        sys.path.insert(0, os.environ.get("WPCN_DIR", "/opt/wpcn"))
        sys.path.insert(1, os.path.dirname(os.path.abspath(__file__)))
        from web3 import Web3
        from web3.exceptions import TransactionNotFound
        from deploy import load, connect
        cfg = load()
        w3, _ = connect(cfg)
        token = str(cfg["TOKEN"]).lower()
    except Exception as e:
        return None, f"the BSC connection could not be set up: {e}"

    try:
        rcpt = w3.eth.get_transaction_receipt(txhash)
    except TransactionNotFound:
        # Deliberately a NO rather than an UNKNOWN. A payment we cannot find on
        # the chain is a payment we must not write down as made; if it is merely
        # unmined, the answer becomes yes in a few seconds and the operator can
        # press it again.
        return False, ("BNB Smart Chain has no receipt for that hash -- it is not "
                       "mined, or it is not a hash on this chain")
    except Exception as e:
        return None, f"the BSC RPC could not be read: {e}"

    if getattr(rcpt, "status", 1) != 1:
        return False, "that transaction REVERTED on chain, so nothing was sent"

    want = str(to_addr).lower()
    got = 0
    for log in (rcpt.get("logs") or []):
        try:
            if str(log["address"]).lower() != token:
                continue
            topics = log["topics"]
            if len(topics) < 3:
                continue
            t0 = topics[0]
            t0 = t0.hex() if hasattr(t0, "hex") else str(t0)
            if t0.lower().removeprefix("0x") != TRANSFER_TOPIC:
                continue
            t2 = topics[2]
            t2 = t2.hex() if hasattr(t2, "hex") else str(t2)
            if "0x" + t2.lower().removeprefix("0x")[-40:] != want:
                continue
            data = log["data"]
            got += (int.from_bytes(data, "big") if isinstance(data, (bytes, bytearray))
                    else int(str(data), 16))
        except Exception:
            continue                    # a log we cannot parse is not a payment

    sent = got / (10 ** WPCN_DECIMALS)
    # Half a hundredth: the instruction is printed to 2dp, so an operator who
    # types what they were told is not an underpayment.
    if sent + 0.005 < expect_wpcn:
        if got == 0:
            return False, (f"that transaction moved no wPCN to {to_addr} at all "
                           f"(expected {expect_wpcn:.2f})")
        return False, (f"that transaction moved only {sent:.8f} wPCN to {to_addr}, "
                       f"less than the {expect_wpcn:.2f} owed")
    more = "" if sent <= expect_wpcn + 0.005 else "  MORE THAN OWED -- check this was deliberate."
    return True, (f"{sent:.8f} wPCN reached {to_addr} in {txhash} "
                  f"(block {rcpt.get('blockNumber')}).{more}")


