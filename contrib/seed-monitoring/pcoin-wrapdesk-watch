# SENDING, not just asking. Everything below is the --send path.
#
# Until 2026-09-22 this script only ever ALERTED: it worked out who was owed
# what and a human sent the wPCN by hand from MetaMask. That is safe and it is
# slow, and "slow" here means a customer waits while the operator is asleep.
#
# The keeper already holds a server-side key (/etc/pcoin/keeper.conf) and
# already signs BSC transactions every day to arbitrage the pool, so paying a
# wrap from it adds NO custody that was not already taken -- the same key, the
# same host, the same blast radius. What it adds is the ability to spend that
# float without a person, which is why every guard below refuses rather than
# assumes, and why the operator still presses the button.
KEEPER_CONF = os.environ.get("KEEPER_CONF", "/etc/pcoin/keeper.conf")
# A bug that sends one payout twice is recoverable. A bug that sends a hundred
# is not, so there is a ceiling on a day's total regardless of what is owed.
SEND_DAILY_CAP = float(os.environ.get("WRAP_SEND_DAILY_CAP", "1000"))
# The plumbing test (--send-test) may only ever move a trivial amount.
SEND_TEST_MAX = float(os.environ.get("WRAP_SEND_TEST_MAX", "5"))
