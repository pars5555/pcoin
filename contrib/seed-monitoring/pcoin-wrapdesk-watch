def read_conf(path):
    """KEY=VALUE config, as every tool here writes it. Values are never logged."""
    out = {}
    with open(path) as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            out[k.strip()] = v.strip()
    return out


def keeper_connect():
    """(w3, acct, token) signing as the KEEPER. Raises with a readable reason.

    Deliberately NOT deploy.load()/connect(): that pair signs as the DEPLOYER,
    whose key is burned and whose address must stay empty for ever. Same
    connect logic, different identity -- and the chain id is re-checked here
    because signing on the wrong chain is unrecoverable.
    """
    wpcn_dir = os.environ.get("WPCN_DIR", "/opt/wpcn")
    sys.path.insert(0, wpcn_dir)
    from web3 import Web3
    from web3.middleware import ExtraDataToPOAMiddleware
    # THE IDENTITY AND THE ENDPOINT LIVE IN DIFFERENT FILES, on purpose:
    # /etc/pcoin/keeper.conf holds ONLY the keeper's key (0600 root), while
    # /opt/wpcn/wpcn.conf holds the RPC and the contract addresses and is not
    # a secret at all. Reading both is not a wart -- it is why the key file has
    # exactly one line in it, so anything that reads it can be seen to want
    # only that.
    key = read_conf(KEEPER_CONF).get("KEEPER_PRIVATE_KEY")
    if not key:
        raise RuntimeError(f"no KEEPER_PRIVATE_KEY in {KEEPER_CONF}")
    cfg = read_conf(os.path.join(wpcn_dir, "wpcn.conf"))
    if not cfg.get("RPC") or not cfg.get("TOKEN"):
        raise RuntimeError(f"{wpcn_dir}/wpcn.conf has no RPC or TOKEN")
    w3 = Web3(Web3.HTTPProvider(cfg["RPC"], request_kwargs={"timeout": 60}))
    # BSC is proof-of-authority and its extraData is longer than Ethereum's.
    w3.middleware_onion.inject(ExtraDataToPOAMiddleware, layer=0)
    if not w3.is_connected():
        raise RuntimeError(f"cannot reach {cfg['RPC']}")
    if w3.eth.chain_id != 56:
        raise RuntimeError(f"WRONG CHAIN: chain_id {w3.eth.chain_id}, expected 56")
    acct = w3.eth.account.from_key(key)
    abi = [{"constant": False,
            "inputs": [{"name": "to", "type": "address"},
                       {"name": "value", "type": "uint256"}],
            "name": "transfer", "outputs": [{"name": "", "type": "bool"}],
            "type": "function"},
           {"constant": True, "inputs": [{"name": "a", "type": "address"}],
            "name": "balanceOf", "outputs": [{"name": "", "type": "uint256"}],
            "type": "function"}]
    token = w3.eth.contract(address=Web3.to_checksum_address(cfg["TOKEN"]), abi=abi)
    return w3, acct, token


def sent_today(s):
    """wPCN this script has broadcast today, from its own record."""
    day = time.strftime("%Y-%m-%d", time.gmtime())
    tot = 0.0
    for rec in (s.get("sends") or {}).values():
        if rec.get("day") == day and rec.get("broadcast"):
            try:
                tot += float(rec.get("wpcn") or 0)
            except (TypeError, ValueError):
                pass
    return tot


def broadcast_wpcn(w3, acct, token, to_addr, amount_wpcn, label, on_broadcast=None):
    """Sign, send, wait. Returns (txhash, receipt). Raises on refusal.

    `on_broadcast` is called with the hash THE MOMENT it is known and before
    the receipt is waited for. That callback is what writes the hash to disk,
    and it is the difference between a lost connection costing a retry and a
    lost connection costing a double payment.
    """
    from web3 import Web3
    to_addr = Web3.to_checksum_address(to_addr)
    units = int(round(amount_wpcn * (10 ** WPCN_DECIMALS)))
    if units <= 0:
        raise RuntimeError(f"refusing to send {amount_wpcn} wPCN")
    have = token.functions.balanceOf(acct.address).call()
    if have < units:
        raise RuntimeError(
            f"the keeper holds {have / 10 ** WPCN_DECIMALS:,.8f} wPCN and this needs "
            f"{amount_wpcn:,.8f}. Top it up; nothing was sent.")
    bnb = w3.eth.get_balance(acct.address)
    if bnb <= 0:
        raise RuntimeError("the keeper has no BNB for gas; nothing was sent.")
    tx = token.functions.transfer(to_addr, units).build_transaction(
        {"from": acct.address})
    tx["nonce"] = w3.eth.get_transaction_count(acct.address)
    tx["chainId"] = 56
    # Pick ONE fee model: BSC rejects a transaction carrying both gasPrice and
    # the EIP-1559 pair, and legacy gasPrice is what its validators price on.
    tx.pop("maxFeePerGas", None)
    tx.pop("maxPriorityFeePerGas", None)
    tx.setdefault("gasPrice", w3.eth.gas_price)
    tx["gas"] = int(w3.eth.estimate_gas(tx) * 1.25)
    signed = acct.sign_transaction(tx)
    h = w3.eth.send_raw_transaction(signed.raw_transaction).hex()
    if not h.startswith("0x"):
        h = "0x" + h
    print(f"  {label}: broadcast {h}")
    if on_broadcast:
        on_broadcast(h)
    r = w3.eth.wait_for_transaction_receipt(h, timeout=300)
    if r.status != 1:
        raise RuntimeError(f"the transaction REVERTED in block {r.blockNumber} ({h})")
    print(f"  {label}: mined in block {r.blockNumber}, {r.gasUsed:,} gas")
    return h, r


def reconcile():
    """Every deposit address, netted, as JSON. The money view nothing else gives.

    WHY THIS EXISTS, AND WHY IT IS NOT A SCRIPT SOMEBODY RUNS.
    On 2026-09-22 an audit compared each address's GROSS PCN received against
    the 250 cap and called the difference "over". It reported 2,000 PCN owed
    across two customers. The real figure was 250 across one: the arithmetic
    had never subtracted refunds that had already been paid, so a customer
    settled in full back in September still looked like an open debt.
    Nothing in the system disagreed, because nothing in the system was doing
    this sum at all -- it lived in a throwaway script, and a throwaway script
    is where an error like that survives.

    So the sum lives here now, in the tool that owns the state, and the panel
    renders it. The shape that matters is:

        held = received - refunded - backing_for_wPCN_already_issued

    where backing = wPCN issued / 0.95, because 250 PCN backs 237.50 wPCN. A
    positive `held` is PCN sitting with us that nobody was entitled to wrap;
    zero means the address is square. Read `held`, never `received`.

    An address the explorer cannot answer for is reported with readable=false
    and NO figures, because an unreadable address is not a settled one.
    """
    s = load_state()
    alloc = ((s.get("allocation") or {}).get("per_address") or {})
    seen = (s.get("seen") or {})
    try:
        with open(REQUESTS) as f:
            reqs = (json.load(f).get("requests") or {})
    except Exception as e:
        return {"ok": False, "why": f"cannot read {REQUESTS}: {e}"}

    rows, unreadable = [], 0
    for r in reqs.values():
        a = r.get("address")
        if not a:
            continue
        d = explorer_get(f"/api/address/{a}?limit=100")
        hist = ((d or {}).get("history") or {})
        if d is None or "items" not in hist:
            unreadable += 1
            rows.append({"address": a, "bsc": r.get("bsc"), "readable": False})
            continue
        if hist.get("has_more"):
            # More than 100 transactions on one deposit address. Refuse to
            # report a total that is knowably partial.
            unreadable += 1
            rows.append({"address": a, "bsc": r.get("bsc"), "readable": False,
                         "why": "more than 100 transactions; totals would be partial"})
            continue
        recv = sum(int(i["received_sat"]) for i in hist["items"]) / 1e8
        sent = sum(int(i["sent_sat"]) for i in hist["items"]) / 1e8
        wpcn = float(alloc.get(a) or 0)
        backing = wpcn / 0.95 if wpcn else 0.0
        releases = sum(1 for k, v in seen.items()
                       if v.get("released") and k.endswith(":" + a))
        # A REFUND PAID FROM SOMEWHERE ELSE IS STILL A REFUND.
        #
        # `sent` only sees PCN leaving the DEPOSIT ADDRESS. The runbook says
        # the right way to settle an over-deposit is to pay the customer from
        # a personal wallet first and reimburse afterwards -- it takes them
        # off the critical path of a vault ceremony -- and money repaid that
        # way never touches the deposit address at all. So on 2026-09-22 this
        # reported 250 PCN "held" for a customer who had been paid in full on
        # 9 September, and it was about to be paid a second time.
        #
        # The ledger knows. Every settlement is recorded here as `refunded`
        # (with the txid) or `not_a_deposit`, so those are read and shown in
        # their own column instead of being silently absent from the sum.
        settled = [v for k, v in seen.items()
                   if k.endswith(":" + a) and (v.get("refunded") or v.get("not_a_deposit"))]
        settled_n = len(settled)
        settled_why = ("our own, not a customer deposit"
                       if any(v.get("not_a_deposit") for v in settled)
                       else ("recorded refunded" if settled_n else ""))
        settled_txids = [str(v.get("refund_txid")) for v in settled if v.get("refund_txid")]
        rows.append({
            "address": a, "bsc": r.get("bsc"),
            "readable": True,
            "asked_pcn": float(r.get("amount") or 0),
            "received_pcn": round(recv, 8),
            "refunded_pcn": round(sent, 8),
            "wpcn_issued": round(wpcn, 8),
            "backing_pcn": round(backing, 8),
            "held_pcn": round(recv - sent - backing, 8),
            "releases": releases,
            "settled": settled_n,
            "settled_why": settled_why,
            "settled_txids": settled_txids,
        })
    rows.sort(key=lambda x: -(x.get("held_pcn") or 0))
    # Two totals, never one. "Held" that is already settled is not a debt, and
    # adding the two together is how a paid customer looked unpaid.
    open_held = sum(r["held_pcn"] for r in rows
                    if r.get("readable") and r["held_pcn"] > 1e-9 and not r.get("settled"))
    settled_held = sum(r["held_pcn"] for r in rows
                       if r.get("readable") and r["held_pcn"] > 1e-9 and r.get("settled"))
    return {"ok": True, "at": int(time.time()), "rows": rows,
            "addresses": len(rows), "unreadable": unreadable,
            "square": sum(1 for r in rows
                          if r.get("readable") and abs(r["held_pcn"]) < 1e-9),
            "total_held_pcn": round(open_held + settled_held, 8),
            "open_held_pcn": round(open_held, 8),
            "settled_held_pcn": round(settled_held, 8),
            "ceiling_wpcn": PER_ADDRESS_CEILING}


def main() -> int:
    take_state_lock()               # a real run WRITES; hold it from load to save
    st = load_state()
    now = int(time.time())
    tasks = []          # (key, urgency, text)
    # The Telegram digest's words for a task, keyed like the task. The task TEXT
    # above is what the admin panel's wrap desk page parses ("ACTION: send",
    # "TO :", "--released ...") and is printed unchanged; this is only what the
    # OWNER reads in the channel: what happened, in plain words, with the
    # numbers, and no customer address -- the page has the address and the
    # button. A task with no entry here falls back to its first line.
    tg = {}

    # ---- 1. incoming wraps, and how far along they are --------------------
    #
    # WATCH THE ALLOCATED ADDRESSES, NOT JUST THE RESERVE.
    #
    # wrapdesk.pc.am hands every requester their own deposit address derived
    # from the reserve xpub. Those deposits land in the reserve WALLET, so the
    # backing is never at risk -- but they do NOT land on the reserve's index-0
    # address. A watcher looking only at index 0 sees nothing, and a customer
    # who paid is never paid back. The money is safe and the person is not.
    #
    # So: read the desk's own request file and check every address it has
    # handed out, plus index 0 for anyone who sent there directly.
    watch = {RESERVE: None}                 # address -> requester BSC address
    try:
        with open(REQUESTS) as f:
            for r in (json.load(f).get("requests") or {}).values():
                if r.get("address"):
                    watch[r["address"]] = r.get("bsc")
    except FileNotFoundError:
        pass                                # desk not deployed here; reserve only
    except Exception as e:
        # The file exists and could not be read. That is NOT "no requests" --
        # every allocated address becomes invisible, which is the exact failure
        # this block exists to prevent.
        tasks.append(("requests_unreadable", "warn",
                      f"Could not read the wrap desk request file ({REQUESTS}): {e}\n"
                      f"Deposits to allocated addresses cannot be seen right now. "
                      f"This is UNKNOWN, not 'nothing pending'."))
        tg["requests_unreadable"] = ("Could not read the wrap desk's request file, so new wrap "
                                     "deposits cannot be matched to customers right now. Unknown, "
                                     "not 'nothing pending'.")

    # EVERY setting lives in the systemd unit's Environment= lines, so running
    # this script by hand gets none of them. The one that matters is the floor:
    # without it the reserve's own founding deposit -- the PCN the whole wPCN
    # supply was sized against -- is re-read as a customer owed wPCN, and the
    # alert is indistinguishable from a real one. Say so rather than quietly
    # producing a confident wrong answer.
    if CLOSED_AT_HEIGHT > 0:
        print("the wrap desk is CLOSED at height %d: deposits above it are "
              "reported for REFUND, not wrapped." % CLOSED_AT_HEIGHT)
    if OPENED_AT_HEIGHT <= 0:
        print("WARNING: WRAP_OPENED_AT_HEIGHT is unset, so there is NO floor and "
              "deposits that pre-date the desk (the reserve's own funding) will "
              "be reported as wrap requests. The production value lives in "
              "pcoin-wrapdesk-watch.service; run via systemd, or pass it "
              "explicitly.", file=sys.stderr)

    used_total = 0.0        # allocation consumed, summed across ALL addresses
    # THE SAME OBLIGATION, ONE BLOCK EARLIER. A deposit sitting in the mempool
    # has already been paid by the customer and already owes them wPCN, but it
    # has no height and so never reached used_total -- the ceiling read as more
    # headroom than the desk had, for as long as the deposit took to confirm.
    # That is the one direction a cap must never be wrong in, and it is how the
    # desk reached 9181.05 against a 9000 allocation on 2026-09-21.
    #
    # Counted separately rather than folded in, because they answer different
    # questions: used_total is money the desk is committed to and cannot take
    # back; this is money it expects to be committed to shortly. Both are
    # rebuilt from the chain every run, so a deposit that is replaced or
    # dropped stops being counted by itself -- over-counting for an hour
    # refuses too EARLY, which is the safe direction.
    pending_total = 0.0
    # Same figure, broken down BY DEPOSIT ADDRESS. The desk maps a deposit
    # address back to the account that requested it, so a per-account quota
    # can be summed from this without the desk ever seeing the chain itself.
    # These entries sum to used_total exactly -- same arithmetic, same refund
    # exclusion -- so the two can never disagree about the same deposits.
    per_addr = {}
    # What has ALREADY gone out, read from the ledger rather than recomputed, plus
    # what this run has instructed. A send is only instructed if it fits inside
    # TOTAL_ALLOC once both are counted -- otherwise the desk re-promises the same
    # allocation once per run, forever.
    released_wpcn = 0.0
    unknown_released = 0
    for _k, _v in (st.get("seen") or {}).items():
        if isinstance(_v, dict) and _v.get("released") and not _v.get("refunded"):
            try:
                _amt = float(_v.get("send_wpcn") or 0)
            except (TypeError, ValueError):
                _amt = 0.0
            if _amt > 0:
                released_wpcn += _amt
            else:
                # A release recorded before this field existed. Its amount is NOT
                # zero, it is UNKNOWN -- and counting unknown as zero makes the
                # allocation ceiling read as more headroom than the desk has, which
                # is the one direction a safety limit must never err in. Charge it
                # the maximum a single release could have been.
                unknown_released += 1
                released_wpcn += PER_PERSON * (1 - FEE_PCT / 100.0)
    pledged_wpcn = 0.0      # instructed by THIS run
    per_addr_wpcn = {}      # cumulative per depositor, across all their deposits
    # Rebuilt from the chain every run, never accumulated -- it is what
    # --released resolves an abbreviated txid against.
    #
    # TEST ENTRIES SURVIVE THE REBUILD, and nothing else does. A test wrap is
    # not on the chain, so a plain rebuild erases it within the hour -- which
    # would mean the operator's rehearsal of the Send and Refund buttons
    # quietly vanished mid-rehearsal. They are kept, and they are the ONLY
    # thing carried over, so a real wrap can never be resurrected from a stale
    # state file by this path. `--clear-test-wraps` removes them.
    # ONLY THE ONES STILL OWED. A test wrap that has been PAID must drop off
    # the page like any other: keeping it would re-offer a Send button for
    # money that already went out. The --send guard refuses a second payment
    # (it checks `released` before signing), so this was never a double-spend
    # -- but a row that offers to pay and then refuses is exactly the kind of
    # control that teaches an operator to ignore what the page says.
    _seen_now = st.get("seen") or {}
    _kept_tests = {
        k: v for k, v in (st.get("outstanding") or {}).items()
        if isinstance(v, dict) and v.get("test")
        and not (_seen_now.get(f"wrap:{k}") or {}).get("released")
        and not (_seen_now.get(f"wrap:{k}") or {}).get("refunded")
    }
    st["outstanding"] = dict(_kept_tests)
    for watch_addr, requester in watch.items():
        addr = explorer_get(f"/api/address/{watch_addr}")
        who = (f"\nRequester BSC address: {requester}" if requester
               else "\n(sent to the main reserve address directly)")
        if addr is None:
            # Cannot read this address. That is not "no wraps pending" -- say so
            # and keep every existing task open.
            tasks.append((f"unreadable:{watch_addr}", "warn",
                          f"Could not read {watch_addr} on any explorer "
                          f"({', '.join(EXPLORERS)}). "
                          f"Wrap deposits there cannot be checked right now. "
                          f"This is UNKNOWN, not 'nothing pending'.{who}"))
            tg[f"unreadable:{watch_addr}"] = ("Could not read one wrap deposit address on any "
                                              "explorer, so deposits there cannot be checked right "
                                              "now. Unknown, not 'nothing pending'.")
            continue
        conf_items = (addr.get("history") or {}).get("items") or []
        pend_items = (addr.get("unconfirmed_history") or {}).get("items") or []

        for it in pend_items:
            txid = it.get("txid", "?")
            amt = it.get("received_pcn", "?")
            tasks.append((f"pending:{txid}", "info",
                          f"WRAP REQUEST arriving: {amt} PCN, tx {txid[:16]}...\n"
                          f"Unconfirmed. Nothing to do yet -- needs {CONFIRMATIONS} "
                          f"confirmations before any wPCN is released."))

        for it in conf_items:
            txid = it.get("txid", "?")
            confs = it.get("confirmations", 0)
            amt = float(it.get("received_pcn") or 0)
            if amt <= 0:
                continue
            h = it.get("height")
            if not isinstance(h, int) or h <= OPENED_AT_HEIGHT:
                continue          # pre-dates the desk: reserve funding, not a wrap
            # Keyed on (txid, address), never txid alone. One PCoin transaction
            # can pay several deposit addresses at once -- that is what a batch
            # payout from an exchange looks like -- and this loop visits each
            # address in turn. Keyed on txid alone, the first address's release
            # marked the WHOLE transaction seen and the second customer's PCN
            # arrived, was skipped in silence, and was never paid. CLAUDE.md 8c
            # rule 1: every live rail shipped this wrong first, and so did this.
            key = f"wrap:{txid}:{watch_addr}"
            # A REFUNDED deposit is closed too, but it is not a release.
            #
            # The PCN went back to the sender and no wPCN was ever issued against it, so
            # recording it as `released` would silence the alert correctly and corrupt the
            # allocation at the same time -- the ceiling below counts released deposits as
            # wPCN that went out. It is its own state.
            if st["seen"].get(key, {}).get("released") or st["seen"].get(key, {}).get("refunded"):
                continue
            if CLOSED_AT_HEIGHT > 0 and h > CLOSED_AT_HEIGHT:
                # Arrived after the desk shut. No wPCN is owed and none may be
                # sent -- but the PCN is real and it is ours to give back. This
                # is deliberately an ACTION, not an info line: a refund somebody
                # has to make is not a thing to notice, it is a thing to do.
                tasks.append((key, "action",
                              "ARRIVED AFTER THE DESK CLOSED -- do NOT send wPCN\n"
                              "%.2f PCN, tx %s...\n"
                              "  TO REFUND  : %.2f PCN\n"
                              "  depositor  : %s\n"
                              "The desk closed at height %d; this landed at %d. Nothing is\n"
                              "owed in wPCN. Send the PCN back to the address that sent it.\n"
                              "WHEN REFUNDED, close it out or this repeats hourly forever:\n"
                              "  pcoin-wrapdesk-watch --refunded %s:%s <pcoin_txid>"
                              % (amt, txid[:16], amt,
                                 requester or "(no request on file)",
                                 CLOSED_AT_HEIGHT, h, txid, watch_addr)))
                tg[key] = ("Refund %.2f PCN (tx %s) -- it arrived after the wrap desk closed, so no "
                           "wPCN is owed. Send the PCN back to whoever sent it." % (amt, txid[:8]))
                continue
            if confs < CONFIRMATIONS:
                tasks.append((key, "info",
                              f"WRAP {amt:.2f} PCN, tx {txid[:16]}...\n"
                              f"{confs}/{CONFIRMATIONS} confirmations. "
                              f"Do NOT release wPCN yet -- the depth is the whole "
                              f"defence against a reorg."))
            else:
                over = ""
                eligible = amt
                if amt > PER_PERSON:
                    eligible = PER_PERSON
                    over = (f"\n*** {amt:.0f} PCN EXCEEDS the {PER_PERSON:.0f} per-person "
                            f"limit. Wrap only {PER_PERSON:.0f} and return the rest, "
                            f"or decide deliberately to exceed it. ***")
                # The fee is taken in wPCN NOT SENT, never in PCN returned. The
                # reserve keeps the full deposit while fewer wPCN go out, so
                # backing moves ABOVE 1:1 -- the only direction it may ever move.
                fee = eligible * FEE_PCT / 100.0
                net = eligible - fee
                # ---- THE CEILING. Three independent checks; any one withholds the instruction.
                # None of them trusts the arithmetic above.
                #
                #   1. per DEPOSITOR, not per deposit -- `eligible` caps a single payment, which
                #      is what splitting 1500 into six 250s walked straight past.
                #   2. against the WHOLE desk allocation, counting what already went out.
                #   3. an absolute ceiling on any single instruction, derived from nothing.
                #
                # A breach does not quietly reduce the amount and send anyway: paying a customer
                # less than they expect without saying so is its own incident. It withholds the
                # instruction and names the limit, because deciding to exceed one belongs to a
                # person who can see the whole picture.
                prior_addr = per_addr_wpcn.get(watch_addr, 0.0)
                hard_cap = PER_PERSON * (1 - FEE_PCT / 100.0)
                breach = None
                if prior_addr + net > hard_cap + 1e-9:
                    breach = ("this depositor would reach %.2f wPCN across their deposits, over "
                              "the %.2f a single person may receive (%.0f PCN less the %.0f%% fee)"
                              % (prior_addr + net, hard_cap, PER_PERSON, FEE_PCT))
                elif released_wpcn + pledged_wpcn + net > TOTAL_ALLOC + 1e-9:
                    breach = ("the desk would reach %.2f wPCN against a %.0f wPCN allocation "
                              "(%.2f already sent, %.2f pending earlier in this run)"
                              % (released_wpcn + pledged_wpcn + net, TOTAL_ALLOC,
                                 released_wpcn, pledged_wpcn))
                elif net > MAX_SEND + 1e-9:
                    breach = ("%.2f wPCN exceeds the %.2f ceiling on any single instruction"
                              % (net, MAX_SEND))

                if breach:
                    tasks.append((key, "action",
                                  "WITHHELD -- do NOT send wPCN for this deposit\n"
                                  "%.2f PCN, tx %s...\n"
                                  "  would send : %.2f wPCN\n"
                                  "  TO         : %s\n"
                                  "REASON: %s.\n"
                                  "The PCN is safe in the reserve and nothing is lost by waiting. "
                                  "Decide deliberately -- raise the limit, refund the excess, or "
                                  "pay it and record why. Do not just follow the number above.\n"
                                  "WHEN REFUNDED, close it out or this repeats hourly forever:\n"
                                  "  pcoin-wrapdesk-watch --refunded %s:%s <pcoin_txid>"
                                  % (amt, txid[:16], net,
                                     requester or "(no request on file)", breach,
                                     txid, watch_addr)))
                    tg[key] = ("Do NOT send yet: a customer sent %.2f PCN (tx %s), which would get "
                               "%.2f wPCN, but that breaks a limit -- %s. Their PCN is safe in the "
                               "reserve. Decide on the Wrap desk page: raise the limit, refund the "
                               "extra, or pay it and note why." % (amt, txid[:8], net, breach))
                    per_addr_wpcn[watch_addr] = prior_addr + net
                    continue
                per_addr_wpcn[watch_addr] = prior_addr + net
                pledged_wpcn += net
                # Computed outside the f-string: nesting quotes inside an
                # f-string expression is a syntax error before Python 3.12.
                pay_to = requester or ("(NO REQUEST ON FILE -- sent straight to "
                                       "the reserve. Find out who before paying.)")
                # Same composite key as `seen`, so --released's prefix match on
                # the txid resolves to a key that already carries the address.
                st["outstanding"][f"{txid}:{watch_addr}"] = {"pcn": amt, "send_wpcn": net,
                                                             "to": requester, "address": watch_addr}
                tasks.append((key, "action",
                              f"ACTION: send {net:.2f} wPCN\n"
                              f"{amt:.2f} PCN confirmed ({confs} confs), tx {txid[:16]}...\n"
                              f"  eligible : {eligible:.2f} PCN\n"
                              f"  fee {FEE_PCT:g}%  : {fee:.2f} wPCN (kept, not sent)\n"
                              f"  SEND     : {net:.2f} wPCN\n"
                              f"  TO       : {pay_to}\n"
                              # The panel can pay this now. Saying "send from
                              # the inventory wallet" was true until
                              # 2026-09-22 and is now the slower of two
                              # routes -- and it sat directly above a button
                              # that does the whole thing, which reads as a
                              # contradiction rather than a choice.
                              f"PAY IT FROM THE ADMIN PANEL -- the wrap desk page has a "
                              f"'Send {net:.2f} wPCN now' button that pays from the keeper "
                              f"and closes this in one step. Sending by hand from the "
                              f"inventory wallet still works; then paste the BSC hash into "
                              f"'Mark as sent'.{over}\n"
                              f"{cycle_advice(amt)}"
                              f"WHEN SENT, close it out or this repeats hourly forever.\n"
                              f"Easiest: the wrap desk page in the admin panel has a "
                              f"'Mark as sent' box -- paste the BSC hash, it checks the "
                              f"chain and closes this. Or on the host:\n"
                              f"  pcoin-wrapdesk-watch --released {txid}:{watch_addr} <bsc_txhash>"))
                # The confirmation count stays in: it is what makes this line
                # change hour to hour, and pcoin-notify suppresses an identical
                # text for hours -- dropping it would quietly turn the hourly
                # reminder into a six-hourly one.
                tg[key] = (f"Send {net:.2f} wPCN -- a customer sent {amt:.2f} PCN, confirmed "
                           f"({confs} confirmations, tx {txid[:8]}). The {FEE_PCT:g}% fee ({fee:.2f} wPCN) is kept."
                           + (f" They sent more than the {PER_PERSON:.0f} PCN per-person limit: "
                              f"wrap {PER_PERSON:.0f} and return the rest, or decide to exceed it."
                              if amt > PER_PERSON else "")
                           + ("" if requester else " No request is on file for this deposit -- "
                              "find out who sent it before paying."))

        # accumulate this address's share of the allocation; reported once,
        # after every address has been read, or the figure would be partial.
        for it in conf_items:
            h = it.get("height")
            a = float(it.get("received_pcn") or 0)
            if (isinstance(h, int) and h > OPENED_AT_HEIGHT and a > 0
                    and not (CLOSED_AT_HEIGHT > 0 and h > CLOSED_AT_HEIGHT)):
                # A REFUNDED deposit issued nothing, so it consumes no allocation.
                # Counting it did the opposite of what an allocation ceiling is for: after
                # five over-limit deposits were returned, this still read "1862.00 of 1500
                # used, THE ALLOCATION IS EXHAUSTED" -- and the send ceiling reads the same
                # idea, so the desk would have refused the next genuine customer on the
                # strength of money it had already given back.
                _k = f"wrap:{it.get('txid','?')}:{watch_addr}"
                if not (st["seen"].get(_k, {}) or {}).get("refunded"):
                    used_total += min(a, PER_PERSON) * (1 - FEE_PCT / 100.0)
                    per_addr[watch_addr] = round(
                        per_addr.get(watch_addr, 0.0)
                        + min(a, PER_PERSON) * (1 - FEE_PCT / 100.0), 8)

        # ... and the same for deposits that have ARRIVED but not yet been
        # mined. See pending_total above for why these count.
        #
        # Two guards this needs and the confirmed loop does not:
        #   * a txid already in conf_items is skipped. Some explorers keep a
        #     transaction in unconfirmed_history for a tick after it is mined,
        #     and counting it twice would refuse a customer on money that does
        #     not exist.
        #   * a mempool entry has NO HEIGHT, so neither the OPENED_AT_HEIGHT
        #     floor nor the CLOSED_AT_HEIGHT ceiling can be evaluated on it.
        #     The floor is safe to skip -- nothing in the mempool can pre-date
        #     the desk -- but the closed case is not, so while the desk is
        #     shut nothing arriving owes wPCN and none of this is counted.
        if not (CLOSED_AT_HEIGHT > 0):
            _conf_txids = {it.get("txid") for it in conf_items}
            for it in pend_items:
                _t = it.get("txid")
                a = float(it.get("received_pcn") or 0)
                if a <= 0 or (_t and _t in _conf_txids):
                    continue
                _k = f"wrap:{_t or '?'}:{watch_addr}"
                if (st["seen"].get(_k, {}) or {}).get("refunded"):
                    continue
                pending_total += min(a, PER_PERSON) * (1 - FEE_PCT / 100.0)

    # REHEARSAL ROWS. A test wrap has no deposit on the chain, so the scan
    # above cannot produce a row for it -- and a row is the whole point, since
    # the buttons live on rows. Emitted here, labelled TEST in the title so it
    # can never be read as a customer on the page, and only ever present
    # because somebody ran --make-test-wrap.
    for _k, _v in sorted(_kept_tests.items()):
        _amt = float(_v.get("send_wpcn") or 0)
        tasks.append((_k, "action",
                      f"ACTION: send {_amt:.2f} wPCN   [TEST WRAP -- not a customer]\n"
                      f"  SEND     : {_amt:.2f} wPCN\n"
                      f"  TO       : {_v.get('to')}\n"
                      f"Created by --make-test-wrap so the Send and Refund buttons can be "
                      f"rehearsed before they are used on a customer. The wPCN and PCN that "
                      f"move are REAL; only the obligation is invented. There is no deposit "
                      f"behind this, so the refund box needs an address typed into it.\n"
                      f"Remove every one of these with --clear-test-wraps.\n"
                      f"  pcoin-wrapdesk-watch --released {_k} <bsc_txhash>"))
        tg[_k] = (f"Send {_amt:.2f} wPCN -- TEST wrap made with --make-test-wrap, not a "
                  f"customer. Real coins move if you press Send; --clear-test-wraps removes it.")

    if used_total > 0 or pending_total > 0:
        left = TOTAL_ALLOC - used_total
        # TWO figures, and the operator needs the smaller one to plan against.
        #
        #   used_total     rebuilt from the chain each run: what actually went out
        #                  and stayed out. Refunds are excluded, which is the point --
        #                  see above, where returned money once read as EXHAUSTED and
        #                  would have refused a real customer.
        #
        #   released_wpcn  what the SEND GATE below actually tests. A release recorded
        #                  before send_wpcn existed has an unknown amount, and unknown
        #                  is charged the maximum a release could have been, so this
        #                  is always >= used_total.
        #
        # Reporting only the first told the operator 825.50 left while the gate would
        # refuse past ~360. Neither number is wrong; showing only one of them was.
        gate_left = TOTAL_ALLOC - released_wpcn
        # The third figure, and the one that predicts a breach rather than
        # reporting one: what is left once every deposit already on the chain
        # -- confirmed or not -- has been paid.
        committed_left = TOTAL_ALLOC - (used_total + pending_total)
        gap = ""
        if released_wpcn > used_total + 0.01:
            gap = ("\n  The send gate is stricter: %.2f used, %.2f left,"
                   " because %d earlier release(s) predate the amount being recorded"
                   " and are charged at the maximum. PLAN AGAINST THAT NUMBER -- it is"
                   " the one that refuses."
                   % (released_wpcn, gate_left, unknown_released))
        # Deposits in the mempool are an obligation the desk has already taken
        # on, so they are named on the same line rather than left to surface an
        # hour later as a ceiling that moved on its own.
        if pending_total > 0:
            gap += ("\n  Plus %.2f wPCN against deposits still UNCONFIRMED, which"
                    " leaves %.2f once they land. They are already owed -- the"
                    " customer has paid." % (pending_total, committed_left))
        tasks.append(("allocation",
                      "action" if (left <= 0 or gate_left <= 0 or committed_left <= 0)
                      else "info",
                      f"Allocation: {used_total:.2f} of {TOTAL_ALLOC:.0f} wPCN used, "
                      f"{left:.2f} left." + gap
                      + ("\n*** THE ALLOCATION IS EXHAUSTED. Do not wrap more "
                         "without deciding deliberately to raise it. ***"
                         if min(left, committed_left) <= 0 else "")))
        tg["allocation"] = ("The wrap allocation is used up: %.2f of %.0f wPCN already promised "
                            "to customers. New wraps cannot be paid until you decide to raise it."
                            % (used_total + pending_total, TOTAL_ALLOC))

    # ---- PUBLISH the allocation figure so the DESK can refuse on it -------
    #
    # The desk used to compute its own "committed" from REQUESTED amounts while
    # this script computed "used" from what was actually DEPOSITED. Two numbers
    # for one quantity, and they drifted the moment anyone sent more than they
    # asked for: on 2026-09-09 the desk said 2000.00 and this said 2152.00,
    # because one depositor sent 500 against a 250 request and another asked for
    # 100 but sent 10. The desk was the more permissive of the two, which is the
    # wrong way round for a ceiling.
    #
    # Deposits are what create the obligation, and only this script sees them, so
    # it is the one that must publish the number. The desk reads it and refuses
    # against it. Both figures are written because they answer different
    # questions and the SMALLER headroom is the one to plan against:
    #   used_wpcn      what actually went out and stayed out (refunds excluded)
    #   released_wpcn  what the send gate tests; >= used_wpcn, because a release
    #                  recorded before send_wpcn existed is charged at maximum
    #   pending_wpcn   owed against deposits that have arrived but are not yet
    #                  mined. Invisible to the two figures above, which is how
    #                  the desk reached 9181.05 against a 9000 allocation: a
    #                  deposit in the mempool is already paid for and already
    #                  owed, and for the hour it took to confirm the ceiling
    #                  read as having room it did not have.
    #   committed_wpcn used + pending. THE FIGURE THE DESK MUST REFUSE ON.
    #                  Published as its own key rather than folded into
    #                  used_wpcn so that a desk running older code keeps the
    #                  behaviour it has instead of silently changing meaning.
    st["allocation"] = {
        "per_address": per_addr,
        "used_wpcn": round(used_total, 8),
        "released_wpcn": round(released_wpcn, 8),
        "pending_wpcn": round(pending_total, 8),
        "committed_wpcn": round(used_total + pending_total, 8),
        "total_alloc": TOTAL_ALLOC,
        "at": int(time.time()),
    }

    # ---- 2. the pool against the PCN index ---------------------------------
    # Since 2026-09-25 the keeper holds the pool to the PCN INDEX in both
    # directions, every minute, within its daily budget. There is no manual
    # buy-back cycle: this line is the peg's temperature, never an instruction.
    # The index is read from price.pc.am and counts only when it is fresh and
    # priced (held is a price; unknown is not). Either body shape since
    # 2026-09-25 -- the `index` block or the minimal top level; see
    # index_from_price().
    price = get("https://price.pc.am")
    pool = pool_price()
    ix = index_from_price(price)
    ixv = (ix.get("usd") if ix.get("stale") is False
           and ix.get("state") in ("live", "held", "frozen") else None)
    if ixv is None:
        tasks.append(("index_unreadable", "warn",
                      "Could not read a usable PCN index from price.pc.am (state %s, stale %s). "
                      "Cannot tell how far the pool is from it, and while it is unknown "
                      "the keeper does not trade and the rails hold. Do not trade the pool "
                      "by hand -- check exchange.pc.am/api/index and the keeper's journal."
                      % (ix.get("state"), ix.get("stale"))))
        tg["index_unreadable"] = ("Could not read the PCN price (index) from price.pc.am, so the "
                                  "keeper is not trading and the payment rails are holding. Do not "
                                  "trade the pool by hand.")
    elif pool and pool.get("price") is not None:
        pp, iv = float(pool["price"]), float(ixv)
        gap = (pp / iv - 1.0) * 100.0
        inside = abs(gap) <= KEEPER_BAND_PCT
        where = "within" if inside else "OUTSIDE"
        tasks.append(("pool_vs_index", "info",
                      f"Pool ${pp:.6f} is {gap:+.2f}% against the PCN index ${iv:.6f} -- "
                      f"{where} the keeper's {KEEPER_BAND_PCT:g}% "
                      f"band. The keeper holds the pool to the index in both directions on "
                      f"its own; nothing to do by hand."
                      + ("" if inside else
                         " If it is still outside on the next run, read the keeper's journal: "
                         "it may be out of daily budget, out of float, or refusing.")))
    else:
        # THIS BRANCH IS LOAD-BEARING. Without it, a readable index plus an
        # unreadable pool appended NOTHING -- the script printed only "nothing
        # outstanding" and looked perfectly healthy while it was blind. That is
        # exactly the failure this project has a rule against: unknown must be
        # its own state, never silence that reads as fine.
        tasks.append(("pool_unreadable", "warn",
                      "Could not read the PancakeSwap pair reserves, so the pool "
                      "price is UNKNOWN and so is its distance from the PCN index. "
                      "Do not assume either direction; do not trade the pool by hand."))
        tg["pool_unreadable"] = ("Could not read the PancakeSwap pool, so its price and its "
                                 "distance from the PCN price are unknown. Do not trade the pool "
                                 "by hand.")

    # ---- 3. report, nagging only what is actionable -----------------------
    actions = [t for t in tasks if t[1] == "action"]
    warns = [t for t in tasks if t[1] == "warn"]

    for key, urgency, text in tasks:
        print(f"[{urgency}] {text}\n")

    due = []
    for key, urgency, text in actions + warns:
        last = st["nagged"].get(key, 0)
        if now - last >= NAG_SECONDS:
            due.append((key, text))

    if due:
        # THE OWNER'S VERSION. Each item is one numbered plain line (tg, above),
        # then who is affected and what to do, then the housekeeping. WHICH items
        # are due, the hourly nag and the size bound are unchanged -- this is
        # wording. The full task text still goes to stdout and to the admin page.
        #
        # TELEGRAM REFUSES A MESSAGE OVER 4,096 CHARACTERS, AND REFUSING IS
        # SILENT FROM HERE. On 2026-09-18 a backlog of 34 items built an
        # 8,005-character digest; it was rejected three hours running with
        # {"error_code":400,"description":"Bad Request: message is too long"}
        # and the operator was told nothing at all. The one alert whose whole
        # job is to say "somebody is owed money" was the one that could not be
        # delivered, and it failed BECAUSE there was a lot to say.
        #
        # So the digest is bounded: full detail while it fits, then a line per
        # item, then a count. It always ends with how to see the rest, because
        # a truncated alert that does not say it was truncated is a lie.
        def _tg(key, text):
            return tg.get(key) or text.splitlines()[0]

        kinds = set()
        for key, text in due:
            first = text.splitlines()[0]
            if first.startswith("ACTION: send"):
                kinds.add("test" if "TEST WRAP" in first else "send")
            elif first.startswith("WITHHELD"):
                kinds.add("withheld")
            elif first.startswith("ARRIVED AFTER"):
                kinds.add("refund")
            elif key == "allocation":
                kinds.add("allocation")
            else:
                kinds.add("warn")
        todo = []
        if kinds & {"send", "test"}:
            todo.append("open admin.pc.am, Wrap desk, and press Send on each one -- it pays "
                        "from the keeper and closes the item in one step")
        if "withheld" in kinds:
            todo.append("decide each withheld one on the Wrap desk page")
        if "refund" in kinds:
            todo.append("refund the PCN from the Wrap desk page")
        if "allocation" in kinds:
            todo.append("decide whether to raise the wrap allocation before paying more")
        if "warn" in kinds:
            todo.append("for the ones that could not be checked, nothing if the next hourly "
                        "run reads them; if it repeats, check explorer.pc.am and price.pc.am")
        owed = kinds & {"send", "withheld", "refund"}
        who = ("Customers affected: yes -- each one has paid and is waiting."
               if owed else "Customers affected: not directly.")
        n_send = sum(1 for _, t in due if t.startswith("ACTION: send")
                     and "TEST WRAP" not in t.splitlines()[0])
        if kinds == {"send"}:
            subject = "\U0001F534 Wrap desk: %d customer(s) waiting for wPCN" % n_send
        elif owed or kinds & {"allocation", "test"}:
            subject = "\U0001F534 Wrap desk: %d thing(s) need you" % len(due)
        else:
            subject = "\U0001F7E1 Wrap desk: %d thing(s) could not be checked" % len(due)
        what = "What to do: " + "; ".join(todo) + "."
        footer = ("\n—\nRepeats every %d minutes until the chain shows it done; nothing "
                  "here is marked complete by hand. Full detail and the close-out commands: "
                  "the Wrap desk page, or journalctl -u pcoin-wrapdesk-watch." % (NAG_SECONDS // 60))
        full = "\n".join("%d. %s" % (i + 1, _tg(k, t)) for i, (k, t) in enumerate(due))
        if len(full) + len(who) + len(what) + len(footer) <= 3600:
            body = full + "\n" + who + "\n" + what + footer
        else:
            # One line each: the first line of every item is its headline.
            lines = ["%d. %s" % (i + 1, t.splitlines()[0]) for i, (_, t) in enumerate(due)]
            brief = "\n".join(lines)
            if len(brief) > 3000:
                brief = "\n".join(lines[:20]) + f"\n... and {len(lines)-20} more"
            body = (f"{len(due)} items -- too many to show in full here.\n{brief}\n"
                    + who + "\n" + what + footer)
        notify(subject, body)
        for key, _ in due:
            st["nagged"][key] = now

    save_state(st)

    if actions:
        print(f"UNHEALTHY: {len(actions)} wrap action(s) outstanding")
        return 1
    if warns:
        print(f"UNVERIFIED: {len(warns)} thing(s) could not be checked")
        return 2
    # "Nothing outstanding" means no ACTION is due -- but a wrap still
    # confirming is very much something happening, and a summary line that
    # reads as "all quiet" while a customer is mid-wrap invites an operator to
    # skim past it. Say what is in flight.
    inflight = [t for t in tasks if t[1] == "info" and t[0].startswith(("wrap:", "pending:"))]
    if inflight:
        print(f"wrap desk: no action due, {len(inflight)} wrap(s) still confirming")
    else:
        print("wrap desk: nothing outstanding")
    return 0


if __name__ == "__main__":
    # --released is the ONE manual override, and it has to exist.
    #
    # The docstring above says nothing is marked done by a human saying so, and
    # for every step that a chain can answer, that holds. This step it cannot:
    # the wPCN goes out on BNB Smart Chain from a wallet this script has no
    # view of, and even seeing that balance fall would not prove WHICH wrap it
    # settled. So a person records it -- with the BSC transaction hash, so the
    # claim stays checkable afterwards.
    #
    # Without this the loop never closes: a confirmed wrap is re-reported every
    # hour forever, including after it is paid. That is how pcoin-concentration
    # -watch taught everyone to ignore the channel, and an alert nobody reads is
    # worse than no alert, because it looks like coverage.
    # --refunded closes a deposit that was PAID BACK rather than wrapped.
    #
    # Over-limit deposits are returned, not wrapped -- the desk's own FAQ has always
    # said so. But the watcher reads RECEIVE history, not the current balance, so
    # sending the PCN back does not make the deposit stop appearing: it would be
    # re-reported every hour forever, exactly like an unpaid one. Refunding without
    # this leaves five permanent alerts behind.
    #
    # Deliberately not --released. That marks wPCN as issued, which would then count
    # against the allocation ceiling for tokens that were never minted.
    if len(sys.argv) >= 3 and sys.argv[1] == "--refunded":
        take_state_lock()
        s = load_state()
        txid = sys.argv[2]
        if txid.startswith("wrap:"):
            txid = txid[5:]
        if ":" not in txid:
            print(f"REFUSED: {txid!r} has no address part. Use <txid>:<deposit-address>, "
                  f"copied from the WITHHELD alert.")
            sys.exit(2)
        key = f"wrap:{txid}"
        s.setdefault("seen", {}).setdefault(key, {})
        s["seen"][key]["refunded"] = True
        s["seen"][key]["at"] = int(time.time())
        s["seen"][key]["refund_txid"] = sys.argv[3] if len(sys.argv) > 3 else None
        # The PCN given back, when the caller knows it (the panel's Refund does).
        # The Send ceiling charges a refund against its address; without the
        # amount it has to assume the whole allowance, which is the safe side.
        if len(sys.argv) > 4:
            try:
                s["seen"][key]["refund_pcn"] = round(float(sys.argv[4]), 8)
            except ValueError:
                print(f"REFUSED: {sys.argv[4]!r} is not an amount of PCN; nothing recorded.")
                sys.exit(2)
        save_state(s)
        print(f"marked refunded: {key}")
        if len(sys.argv) <= 3:
            print("NOTE: no PCoin txid recorded. Re-run with it so the refund stays "
                  "checkable against the chain later.")
        sys.exit(0)


    # --not-a-deposit closes out money that arrived at a watched address without
    # anybody having deposited it.
    #
    # The desk reads RECEIVE history, so ANY credit to the reserve looks like a
    # customer. On 2026-09-18 the surplus withdrawal returned its change to the
    # main reserve address on purpose -- the proof page sums that address, so
    # change sent to a derived one would have read as a 42,836 PCN shortfall --
    # and the watcher then reported that change as a wrap deposit "arrived after
    # the desk closed", to be refunded to a depositor who does not exist.
    #
    # Deliberately NOT --refunded. It has the same effect on the ledger, and
    # using it would have been quicker, but it would leave a permanent record
    # saying money was paid back that was never paid back. The state file is the
    # only account of what happened here; a wrong reason in it is worse than a
    # missing flag, because the next person reads it as fact.
    if len(sys.argv) >= 3 and sys.argv[1] == "--not-a-deposit":
        take_state_lock()
        s_ = load_state()
        txid = sys.argv[2]
        if txid.startswith("wrap:"):
            txid = txid[5:]
        if ":" not in txid:
            print(f"REFUSED: {txid!r} has no address part. Use <txid>:<address>, "
                  f"copied from the alert.")
            sys.exit(2)
        key = f"wrap:{txid}"
        s_.setdefault("seen", {}).setdefault(key, {})
        # `refunded` is what the allocation maths and the report filter read, so
        # it is set for the effect; `not_a_deposit` and `reason` record the truth
        # alongside it, so the state never claims a refund that did not happen.
        s_["seen"][key]["refunded"] = True
        s_["seen"][key]["not_a_deposit"] = True
        s_["seen"][key]["reason"] = (sys.argv[3] if len(sys.argv) > 3
                                     else "our own change, not a customer deposit")
        s_["seen"][key]["at"] = int(time.time())
        save_state(s_)
        print(f"marked not-a-deposit: {key}")
        print(f"  reason: {s_['seen'][key]['reason']}")
        sys.exit(0)


    # A REHEARSAL RECORD, so the buttons can be pressed before real money is.
    #
    # The operator's rule, and it is a good one: prove the Send and Refund
    # buttons move a trivial amount before using them on a customer. That needs
    # a row on the page, and a real one cannot be conjured -- a genuine wrap
    # needs a deposit and 100 confirmations, which is most of a day.
    #
    # So this injects one, marked `test`, which is the flag that (a) keeps it
    # across the hourly rebuild and (b) makes it obvious in the state file that
    # it is not a customer. The txid is random and pays nothing on its own: the
    # amounts are whatever is passed, the buttons are the real ones, and the
    # wPCN and PCN that move are real. Only the OBLIGATION is invented.
    if len(sys.argv) >= 3 and sys.argv[1] == "--make-test-wrap":
        import secrets
        try:
            wpcn = float(sys.argv[2])
        except ValueError:
            print(f"REFUSED: {sys.argv[2]!r} is not a number of wPCN.")
            sys.exit(2)
        to = sys.argv[3] if len(sys.argv) > 3 else None
        if not to or not re.fullmatch(r"0x[0-9a-fA-F]{40}", to):
            print("usage: --make-test-wrap <wpcn> <bsc-address> [pcoin-address]")
            sys.exit(2)
        if not 0 < wpcn <= SEND_TEST_MAX:
            print(f"REFUSED: a test wrap may be at most {SEND_TEST_MAX} wPCN.")
            sys.exit(2)
        addr = sys.argv[4] if len(sys.argv) > 4 else RESERVE
        take_state_lock()
        s_ = load_state()
        txid = secrets.token_hex(32)
        key = f"{txid}:{addr}"
        s_.setdefault("outstanding", {})[key] = {
            "pcn": round(wpcn / 0.95, 8), "send_wpcn": wpcn, "to": to,
            "address": addr, "test": True, "at": int(time.time())}
        save_state(s_)
        print(f"test wrap created: {key}")
        print(f"  it will offer to send {wpcn} wPCN to {to}")
        print(f"  and to refund PCN to whoever the deposit came from "
              f"(there is none, so type an address into the refund box)")
        print("  remove every test wrap with: --clear-test-wraps")
        sys.exit(0)

    if len(sys.argv) >= 2 and sys.argv[1] == "--clear-test-wraps":
        take_state_lock()
        s_ = load_state()
        out = s_.get("outstanding") or {}
        gone = [k for k, v in out.items() if isinstance(v, dict) and v.get("test")]
        for k in gone:
            del out[k]
        # Their `seen` records go too, or a closed test wrap would sit in the
        # ledger for ever looking like a customer who was paid.
        #
        # SCAN `seen` ON ITS OWN MERITS, not just the keys still in
        # `outstanding`. A test wrap that was PAID is filtered out of the
        # rebuild (see the note there), so iterating `outstanding` alone could
        # never find it -- and its `seen` record survived, was picked up by the
        # announcement feed, and HELD every tick for ever because a random
        # txid can never be verified against the explorer. Silent, harmless,
        # and permanent: the worst combination. Both halves are cleaned now.
        seen = s_.get("seen") or {}
        for k in list(seen):
            if not k.startswith("wrap:"):
                continue
            if any(k == f"wrap:{g}" for g in gone) or (seen[k] or {}).get("test"):
                del seen[k]
                if k not in [f"wrap:{g}" for g in gone]:
                    gone.append(k[5:])
        save_state(s_)
        print(f"removed {len(gone)} test wrap(s).")
        for k in gone:
            print(f"  {k}")
        sys.exit(0)

    # READ-ONLY. Takes no lock, writes nothing, and is safe to run at any time.
    if len(sys.argv) >= 2 and sys.argv[1] == "--reconcile":
        rec = reconcile()
        if "--json" in sys.argv:
            print(json.dumps(rec, indent=1))
            sys.exit(0 if rec.get("ok") else 3)
        if not rec.get("ok"):
            print(f"COULD NOT RECONCILE: {rec.get('why')}")
            sys.exit(3)
        print(f"{'deposit address':<44} {'recv':>10} {'refunded':>10} "
              f"{'wPCN out':>10} {'backing':>10} {'HELD':>10}")
        print("-" * 98)
        for r in rec["rows"]:
            if not r.get("readable"):
                print(f"{r['address']:<44} {'UNREADABLE -- resolves nothing':>54}")
                continue
            if abs(r["held_pcn"]) < 1e-9:
                continue
            print(f"{r['address']:<44} {r['received_pcn']:>10.2f} "
                  f"{r['refunded_pcn']:>10.2f} {r['wpcn_issued']:>10.2f} "
                  f"{r['backing_pcn']:>10.2f} {r['held_pcn']:>10.2f}")
        print("-" * 98)
        print(f"{rec['square']} of {rec['addresses']} addresses are square; "
              f"{rec['unreadable']} unreadable")
        print(f"PCN held beyond backing and refunds: {rec['total_held_pcn']:,.2f}")
        sys.exit(0)

    # PLUMBING TEST. Moves a trivial amount to an address you name, touches no
    # wrap and closes nothing. It exists so the signing path can be proven end
    # to end -- key, RPC, gas, nonce, receipt -- WITHOUT a customer's payout
    # being the first thing this code ever sends. Capped hard, because a test
    # that can move real money is not a test.
    if len(sys.argv) >= 4 and sys.argv[1] == "--send-test":
        dry = "--dry-run" in sys.argv
        to_addr = sys.argv[2]
        try:
            amount = float(sys.argv[3])
        except ValueError:
            print(f"REFUSED: {sys.argv[3]!r} is not a number.")
            sys.exit(2)
        if not re.fullmatch(r"0x[0-9a-fA-F]{40}", to_addr or ""):
            print(f"REFUSED: {to_addr!r} is not a BSC address.")
            sys.exit(2)
        if not 0 < amount <= SEND_TEST_MAX:
            print(f"REFUSED: --send-test may move at most {SEND_TEST_MAX} wPCN, "
                  f"and got {amount}. Use --send for a real payout.")
            sys.exit(2)
        try:
            w3, acct, token = keeper_connect()
        except Exception as e:
            print(f"COULD NOT CONNECT: {e}\nNothing was sent.")
            sys.exit(3)
        bal = token.functions.balanceOf(acct.address).call() / 10 ** WPCN_DECIMALS
        bnb = w3.eth.get_balance(acct.address) / 1e18
        print(f"keeper {acct.address}")
        print(f"  holds {bal:,.8f} wPCN, {bnb:.6f} BNB")
        print(f"  would send {amount:,.8f} wPCN -> {to_addr}")
        if dry:
            print("DRY RUN: nothing was sent.")
            sys.exit(0)
        take_state_lock()
        s_ = load_state()
        try:
            h, _r = broadcast_wpcn(w3, acct, token, to_addr, amount, "send-test")
        except Exception as e:
            print(f"FAILED: {e}")
            sys.exit(2)
        s_.setdefault("sends", {})[f"test:{h}"] = {
            "day": time.strftime("%Y-%m-%d", time.gmtime()),
            "wpcn": amount, "to": to_addr, "broadcast": h, "test": True,
            "at": int(time.time())}
        save_state(s_)
        ok, why = verify_wpcn_sent(h, to_addr, amount)
        print(f"verification: {why}" if ok else f"VERIFY SAID: {why}")
        print(f"tx {h}")
        sys.exit(0 if ok else 2)

    # PAY AN OUTSTANDING WRAP, FOR REAL.
    if len(sys.argv) >= 3 and sys.argv[1] == "--send":
        dry = "--dry-run" in sys.argv
        take_state_lock()
        s = load_state()
        txid = sys.argv[2]
        if txid.startswith("wrap:"):
            txid = txid[5:]
        outstanding = list((s.get("outstanding") or {}).keys())
        hits = [t for t in outstanding if t.startswith(txid)]
        if len(hits) == 1:
            txid = hits[0]
        elif len(hits) > 1:
            print(f"AMBIGUOUS: {txid!r} matches {len(hits)} outstanding wraps.")
            for t in hits:
                print(f"  {t}")
            sys.exit(2)
        elif txid not in outstanding:
            print(f"NO MATCH: {txid!r} is not an outstanding wrap. Nothing sent.")
            for t in outstanding:
                print(f"  {t}")
            sys.exit(2)

        out = (s.get("outstanding") or {}).get(txid) or {}
        to_addr, addr = out.get("to"), out.get("address")
        try:
            amount = float(out.get("send_wpcn") or 0)
        except (TypeError, ValueError):
            amount = 0.0
        key = f"wrap:{txid}"

        # ---- every refusal below is a refusal, not a smaller send -----------
        if not to_addr or amount <= 0:
            print(f"REFUSED: {txid} has no recipient and amount on file.")
            sys.exit(2)
        if (s.get("seen") or {}).get(key, {}).get("released"):
            print(f"REFUSED: {key} is already marked released. Nothing sent.")
            sys.exit(2)
        if amount > PER_ADDRESS_CEILING + 1e-9:
            print(f"REFUSED: {amount:,.8f} wPCN is above the {PER_ADDRESS_CEILING:,.2f} "
                  f"per-address ceiling. Nothing sent.")
            sys.exit(2)

        # THE CROSS-RUN CEILING, WHICH THE ALERTING PATH DOES NOT APPLY.
        # `per_addr_wpcn` is rebuilt empty each run and already-released
        # deposits are skipped before the gate, so the ceiling is real within
        # one pass and absent across time -- that is how one deposit address
        # was paid 475.00, twice its ceiling, in two releases six days apart.
        # A button that can repeat that on a click is worse than the bug.
        #
        # AND A REFUND USES THE ADDRESS UP TOO (owner, 2026-09-23: one allowance
        # per person, and no wrapping past a limit). Counting only releases let a
        # fully refunded address read as empty: the farmers whose extra wraps were
        # returned that day could have sent 250 PCN to the same addresses again
        # and been paid for it. An address takes PER_PERSON PCN in its whole life,
        # paid or returned. A refund with no recorded amount is charged the whole
        # allowance -- unknown is the maximum, the same rule as a release with no
        # send_wpcn above. `not_a_deposit` is our own money and counts for nothing.
        prior = 0.0
        for k, rec in (s.get("seen") or {}).items():
            if not k.endswith(":" + str(addr)) or not isinstance(rec, dict):
                continue
            if rec.get("released"):
                try:
                    prior += float(rec.get("send_wpcn") or 0)
                except (TypeError, ValueError):
                    pass
            elif rec.get("refunded") and not rec.get("not_a_deposit"):
                try:
                    back = float(rec.get("refund_pcn"))
                    prior += min(back, PER_PERSON) * (1 - FEE_PCT / 100.0)
                except (TypeError, ValueError):
                    prior += PER_ADDRESS_CEILING
        if prior + amount > PER_ADDRESS_CEILING + 1e-9:
            print(f"REFUSED: {addr} has already used {prior:,.8f} wPCN of its allowance "
                  f"(paid, or refunded); another {amount:,.8f} would total "
                  f"{prior + amount:,.8f}, over the {PER_ADDRESS_CEILING:,.2f} ceiling. "
                  f"Nothing sent -- refund this deposit instead.")
            sys.exit(2)

        already = sent_today(s)
        if already + amount > SEND_DAILY_CAP + 1e-9:
            print(f"REFUSED: {already:,.2f} wPCN already went out today and this would "
                  f"take it to {already + amount:,.2f}, over the {SEND_DAILY_CAP:,.2f} "
                  f"daily cap. Nothing sent.")
            sys.exit(2)

        # A BROADCAST THAT WAS NEVER CONFIRMED IS NOT A BROADCAST TO REPEAT.
        # If the previous attempt wrote a hash and then died before the
        # receipt, the coins may well be gone. Sending again is how one payout
        # becomes two, so this stops and makes a person look at the chain.
        pending = (s.get("sends") or {}).get(key)
        if pending and pending.get("broadcast") and not pending.get("confirmed"):
            print(f"REFUSED: a previous --send for {key} broadcast "
                  f"{pending['broadcast']} and never recorded a receipt.\n"
                  f"Check that hash on BscScan FIRST. If it succeeded, close the wrap "
                  f"with --released; if it never made it, clear the 'sends' entry by "
                  f"hand. This will not send again on its own.")
            sys.exit(3)

        print(f"wrap    {txid}")
        print(f"  pay   {amount:,.8f} wPCN -> {to_addr}")
        print(f"  from  deposit address {addr}")
        print(f"  today {already:,.2f} of {SEND_DAILY_CAP:,.2f} wPCN cap used")
        try:
            w3, acct, token = keeper_connect()
        except Exception as e:
            print(f"COULD NOT CONNECT: {e}\nNothing was sent.")
            sys.exit(3)
        bal = token.functions.balanceOf(acct.address).call() / 10 ** WPCN_DECIMALS
        print(f"  keeper {acct.address} holds {bal:,.8f} wPCN")
        if dry:
            print("DRY RUN: nothing was sent.")
            sys.exit(0)

        def _remember(h):
            s.setdefault("sends", {})[key] = {
                "day": time.strftime("%Y-%m-%d", time.gmtime()),
                "wpcn": amount, "to": to_addr, "broadcast": h,
                "confirmed": False, "at": int(time.time())}
            save_state(s)

        try:
            h, _r = broadcast_wpcn(w3, acct, token, to_addr, amount,
                                   f"wrap {txid[:12]}", on_broadcast=_remember)
        except Exception as e:
            print(f"FAILED: {e}")
            sys.exit(2)

        # Same check --released performs, against the chain, before recording.
        ok, why = verify_wpcn_sent(h, to_addr, amount)
        if ok is not True:
            print(f"SENT BUT NOT VERIFIED: {why}\n"
                  f"The hash is {h} and it is recorded under 'sends'. Check it and "
                  f"close with --released {txid} {h} if it is good.")
            sys.exit(3)
        s["sends"][key]["confirmed"] = True
        s.setdefault("seen", {}).setdefault(key, {})
        s["seen"][key].update({"released": True, "at": int(time.time()),
                               "bsc_txhash": h, "verified": why,
                               "send_wpcn": amount})
        # Carry the rehearsal flag into the ledger. Without it a PAID test wrap
        # is indistinguishable from a customer once it leaves `outstanding`,
        # and --clear-test-wraps has nothing left to match on.
        if out.get("test"):
            s["seen"][key]["test"] = True
        save_state(s)
        print(f"verified on BSC: {why}")
        print(f"PAID and closed: {key}")
        notify("wrap desk: paid automatically",
               f"Sent {amount:,.8f} wPCN to {to_addr} for wrap {txid}.\n"
               f"tx {h}\nVerified: {why}")
        sys.exit(0)

    if len(sys.argv) >= 3 and sys.argv[1] == "--released":
        take_state_lock()
        s = load_state()
        txid = sys.argv[2]
        if txid.startswith("wrap:"):
            txid = txid[5:]

        # RESOLVE A PREFIX, AND REFUSE WHAT DOES NOT MATCH.
        #
        # The alert header abbreviates the txid ("tx 9727cf9b4ecdf5e8..."), so
        # an operator copying from the wrong line records a key that matches no
        # wrap at all. That writes cleanly, prints success, and changes nothing
        # -- the wrap keeps being reported hourly and the operator believes it
        # is closed. A silent no-op that looks like success is the worst of the
        # available failures, so this resolves prefixes and refuses the rest.
        outstanding = list((s.get("outstanding") or {}).keys())
        hits = [t for t in outstanding if t.startswith(txid)]
        if len(hits) == 1:
            txid = hits[0]
        elif len(hits) > 1:
            print(f"AMBIGUOUS: {txid!r} matches {len(hits)} outstanding wraps.")
            for t in hits:
                print(f"  {t}")
            sys.exit(2)
        elif outstanding and txid not in outstanding:
            print(f"NO MATCH: {txid!r} is not an outstanding wrap. Nothing changed.")
            print("Outstanding right now:")
            for t in outstanding:
                print(f"  {t}")
            sys.exit(2)

        # The resolved value is now "<txid>:<address>" (taken from outstanding),
        # never a bare txid. If outstanding was empty and the operator typed a
        # bare txid, it falls through to here unresolved -- refuse rather than
        # write an old-format key, which load_state would then refuse on the
        # next run and which could never match a real deposit again.
        if ":" not in txid:
            print(f"REFUSED: {txid!r} has no address part. A released wrap is recorded "
                  f"as <txid>:<deposit-address>; copy the key from the ACTION alert, "
                  f"or give a txid prefix that resolves against an outstanding wrap.")
            sys.exit(2)
        # ---- CHECK THE CHAIN BEFORE WRITING ANYTHING DOWN -------------------
        #
        # This used to accept whatever it was handed: any string as a txhash, or
        # no txhash at all (it printed a NOTE and carried on). So the only thing
        # standing between a customer and being marked paid while unpaid was the
        # operator's attention at the end of a long manual job.
        #
        # Now the hash is checked against BNB Smart Chain: right token, right
        # recipient, at least the right amount, and the transaction did not
        # revert. A wrong hash, a reverted send, a send to the PREVIOUS
        # customer -- each is refused with the reason, and nothing is written.
        #
        # --force exists only for the case the doctrine demands: the RPC is
        # UNREACHABLE. Unknown must not silently become yes, but neither may it
        # block a real payout for ever, so the operator can override an unknown
        # -- in writing, recorded in the state file, never by accident.
        _positional = [a for a in sys.argv[2:] if not a.startswith("--")]
        _force = "--force" in sys.argv
        _txhash = _positional[1] if len(_positional) > 1 else None
        _out = (s.get("outstanding") or {}).get(txid) or {}
        _to = _out.get("to")
        try:
            _expect = float(_out.get("send_wpcn") or 0)
        except (TypeError, ValueError):
            _expect = 0.0

        _verdict = "not checked (--force)"
        if not _force:
            if not _txhash:
                print("REFUSED: give the BSC transaction hash of the send.\n"
                      "  pcoin-wrapdesk-watch --released <txid>:<address> <bsc_txhash>\n"
                      "It is checked against the chain before anything is recorded.")
                sys.exit(2)
            if not _to or _expect <= 0:
                print(f"REFUSED: there is no recipient and amount on file for {txid!r}, "
                      f"so the payment cannot be checked. This wrap went straight to the "
                      f"reserve with no request behind it -- find out who is owed it, then "
                      f"re-run with --force to record it anyway.")
                sys.exit(2)
            _ok, _why = verify_wpcn_sent(_txhash, _to, _expect)
            if _ok is None:
                print(f"COULD NOT CHECK: {_why}\n"
                      f"Nothing was changed. Unknown is not done. Try again, or "
                      f"--force if you are certain and the RPC is the problem.")
                sys.exit(3)
            if _ok is False:
                print(f"REFUSED: {_why}\nNothing was changed.")
                sys.exit(2)
            print(f"verified on BSC: {_why}")
            _verdict = _why

        key = f"wrap:{txid}"
        s.setdefault("seen", {}).setdefault(key, {})
        s["seen"][key]["released"] = True
        s["seen"][key]["at"] = int(time.time())
        s["seen"][key]["bsc_txhash"] = _txhash
        # Keep the EVIDENCE beside the claim, not just the claim. A state file
        # that says "released: true" and nothing else cannot be audited later.
        s["seen"][key]["verified"] = _verdict
        # Also record the AMOUNT that went out. Without it the allocation ceiling has
        # no idea what the desk has already committed, and a missing figure is read as
        # the maximum rather than as zero -- correct, but needlessly pessimistic once
        # the real number is knowable. `outstanding` is rebuilt from the chain each run
        # and is keyed exactly like this, so the figure comes from the same place the
        # operator was told to send.
        _out = (s.get("outstanding") or {}).get(txid) or {}
        try:
            _sent = float(_out.get("send_wpcn") or 0)
        except (TypeError, ValueError):
            _sent = 0.0
        if _sent > 0:
            s["seen"][key]["send_wpcn"] = _sent
        save_state(s)
        print(f"marked released: {key}")
        if not _txhash:
            print("NOTE: forced, with no BSC txhash recorded. This is the one "
                  "state here that cannot be checked against the chain later.")
        sys.exit(0)
    sys.exit(main())
