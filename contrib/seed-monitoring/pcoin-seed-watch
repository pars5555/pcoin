#!/bin/bash
# Watch this PCoin seed and say something when it stops being useful.
#
# "The container is running" is not the question. A node can be up, listening,
# and answering RPC while its chain has been stuck for hours or it has lost
# every peer -- and from the outside that looks identical to health. Each check
# below is a separate way of being useless:
#
#   rpc        the node answers at all
#   peers      somebody is connected; a seed with no peers seeds nothing
#   progress   the tip moved since last run, OR is younger than the stall limit
#   listening  9444 accepts connections, which is the entire job of a seed
#   supply     the money supply still equals the emission schedule
#
# Deliberately no alerting integration: it writes state and exits non-zero.
# systemd records the failure, and OnFailure can carry it wherever it needs to
# go later. Inventing a notification channel nobody agreed to is how monitoring
# ends up muted.
set -u

CONTAINER=${CONTAINER:-pcoin-seed}
STATE=/var/lib/pcoin-seed-watch/state
STALL_SECONDS=${STALL_SECONDS:-3600}   # 1 h = 6x the 600 s target. Was 7200,
                                       # which left the chain dead for 2h04m30s
                                       # on 2026-09-05 before anything said so.
                                       # Gaps are ~Poisson, so a healthy gap
                                       # exceeds this about exp(-6) = 0.25% of
                                       # the time -- rare enough not to train
                                       # people to ignore it. Do not drop to
                                       # 1800: that is exp(-3) = 5%, several
                                       # false alarms a day.

# How to reach the node. NOT every seed runs it in Docker: one runs pcoind
# natively under systemd, and this script's hardcoded `docker exec` meant the
# first check there failed with "container pcoin-seed is not running" -- a
# permanent false UNHEALTHY. So that host simply never ran the check, and the
# largest node in the estate went unmonitored because the monitor could not
# start. A check that cannot run on a host is indistinguishable from one that
# passes: nobody sees either.
#
# Set PCOIN_CLI in /etc/default/pcoin-seed-watch on a native host, e.g.
#   PCOIN_CLI="sudo -u pcoin /opt/pcoin/bin/bitcoin-cli -conf=/etc/pcoin/pcoin.conf"
# Leave it unset on a Docker host and nothing changes.
PCOIN_CLI=${PCOIN_CLI:-}

mkdir -p "$(dirname "$STATE")"

fail() { echo "UNHEALTHY: $*"; exit 1; }
say()  { echo "$*"; }

if [ -n "$PCOIN_CLI" ]; then
  cli() { $PCOIN_CLI "$@" 2>/dev/null; }
  # There is no container to inspect; the RPC probe below is the liveness test,
  # and it is a better one -- a running container with a wedged node passes the
  # inspect and fails this.
else
  docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q true \
    || fail "container $CONTAINER is not running"
  cli() { docker exec "$CONTAINER" bitcoin-cli "$@" 2>/dev/null; }
fi

INFO=$(cli getblockchaininfo) || fail "RPC did not answer"
[ -n "$INFO" ] || fail "RPC returned nothing"

HEIGHT=$(echo "$INFO"    | sed -n 's/.*"blocks": *\([0-9]*\).*/\1/p' | head -1)
TIPTIME=$(echo "$INFO"   | sed -n 's/.*"time": *\([0-9]*\).*/\1/p'   | head -1)
PEERS=$(cli getconnectioncount)

[ -n "$HEIGHT" ] || fail "could not read height from getblockchaininfo"
[ -n "$PEERS" ]  || fail "could not read peer count"
[ "$PEERS" -gt 0 ] 2>/dev/null || fail "zero peers -- this seed is seeding nothing"

# ── supply ──────────────────────────────────────────────────────────────────
# Every block pays exactly the scheduled subsidy, so total supply is a pure
# function of height until the first halving: 50 PCN x height. If that ever
# stops being true, a block has issued coins it was not entitled to -- the one
# failure that cannot be undone by a reorg and that no other check here would
# notice, because an over-issuing chain looks perfectly healthy from outside.
#
# Consensus already enforces it (bad-cb-amount in ConnectBlock, on every connect
# path). This is the independent second opinion: consensus asserts the rule, and
# this asserts the OUTCOME. A bug that weakened the rule would leave this the
# only thing still watching.
#
# gettxoutsetinfo is O(entire UTXO set), so it runs on a sampled basis rather
# than every tick. Skipping is NOT a pass: SUPPLY_EVERY=1 forces it.
SUPPLY_EVERY=${SUPPLY_EVERY:-12}
if [ "$SUPPLY_EVERY" = "1" ] || [ $(( HEIGHT % SUPPLY_EVERY )) -eq 0 ]; then
  UTXO=$(cli gettxoutsetinfo)
  if [ -z "$UTXO" ]; then
    say "supply: gettxoutsetinfo did not answer -- NOT CHECKED (unknown, not ok)"
  else
    # Integer satoshis throughout. The RPC prints PCN with 8 decimals; a float
    # comparison here would invent a mismatch out of rounding.
    ACTUAL_SAT=$(echo "$UTXO" | sed -n 's/.*"total_amount": *\([0-9]*\)\.\([0-9]*\).*/\1\2/p' | head -1)

    # COMPARE AGAINST THE HEIGHT THE SNAPSHOT WAS TAKEN AT, never $HEIGHT.
    #
    # gettxoutsetinfo is O(entire UTXO set) and takes seconds. $HEIGHT was read
    # before it started, so a block landing DURING the scan leaves the returned
    # set exactly one subsidy ahead of $HEIGHT -- which is bit-for-bit the shape
    # of real over-issuance. This fired for real at height 3624 on 15 Aug 2026:
    # chain 18125000000000 vs schedule 18120000000000, a delta of exactly
    # 5000000000 sat, and the chain was perfectly healthy.
    #
    # That failure mode is worse than no check. A supply alarm that cries wolf
    # gets muted, and this is the one alarm that must never be ignored. The
    # response carries its own height; use it and the race cannot happen.
    SNAP_HEIGHT=$(echo "$UTXO" | sed -n 's/.*"height": *\([0-9]*\).*/\1/p' | head -1)
    if [ -z "$SNAP_HEIGHT" ]; then
      say "supply: gettxoutsetinfo returned no height -- NOT CHECKED (unknown, not ok)"
      SNAP_HEIGHT=""
    fi

    HALVING=210000
    if [ -n "$SNAP_HEIGHT" ] && [ "$SNAP_HEIGHT" -lt "$HALVING" ] && [ -n "$ACTUAL_SAT" ]; then
      EXPECT_SAT=$(( SNAP_HEIGHT * 50 * 100000000 ))
      if [ "$ACTUAL_SAT" != "$EXPECT_SAT" ]; then
        fail "SUPPLY MISMATCH at height $SNAP_HEIGHT: chain holds ${ACTUAL_SAT} sat, schedule says ${EXPECT_SAT} sat"
      fi
      say "supply: ${ACTUAL_SAT} sat == 50 x ${SNAP_HEIGHT} PCN, exact"
    else
      # Past the first halving the closed form needs the full sum; do not
      # guess, and do not report a guess as a pass.
      say "supply: height $HEIGHT is at/after the first halving -- closed form no longer applies, NOT CHECKED"
    fi
  fi
fi

# Is the tip stale? Block timestamps on this chain are not monotonic in height,
# so a tip can legitimately read slightly ahead of the clock; a negative age is
# treated as zero rather than as an error.
NOW=$(date +%s)
AGE=$(( NOW - ${TIPTIME:-$NOW} ))
[ "$AGE" -lt 0 ] && AGE=0

PREV_HEIGHT=0
[ -f "$STATE" ] && PREV_HEIGHT=$(cut -d' ' -f1 "$STATE" 2>/dev/null || echo 0)
echo "$HEIGHT $NOW" > "$STATE"

if [ "$AGE" -gt "$STALL_SECONDS" ] && [ "$HEIGHT" = "$PREV_HEIGHT" ]; then
  fail "chain stalled: height $HEIGHT unchanged and tip is ${AGE}s old (limit ${STALL_SECONDS}s), $PEERS peers"
fi

# The seed's actual job. RPC health says nothing about whether the P2P port
# accepts anyone.
if command -v nc >/dev/null 2>&1; then
  nc -z -w 5 127.0.0.1 9444 || fail "P2P port 9444 is not accepting connections"
fi

say "ok: height $HEIGHT, tip ${AGE}s old, $PEERS peers"
exit 0
