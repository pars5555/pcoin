#!/bin/bash
# Post a PUBLIC announcement to @PCoinPCN.
#
#   pcoin-announce "<title>" "<body>"          post it
#   pcoin-announce --dry-run "<title>" "<body>" show exactly what would be sent
#   pcoin-announce --photo card.png "<title>" "<body>"
#                                               post it under a picture (sendPhoto;
#                                               the text becomes the caption, which
#                                               Telegram caps at 1024 characters)
#   pcoin-announce --list                       what has already been announced
#
# This is the ONLY sanctioned path to the public channel, and it is deliberately
# not the same tool as pcoin-notify. They have opposite jobs and opposite
# audiences, and conflating them has already cost this project once: operational
# alerts were pointed at @PCoinPCN and subscribers received
# "status=3/NOTIMPLEMENTED" plus an internal hostname. An alert is addressed to
# whoever fixes it. An announcement is addressed to people who own PCN.
#
# Three properties, each because the alternative has a failure mode:
#
#   LEAK GUARD    Refuses text that looks operational -- hostnames, private IPs,
#                 exit codes, stack traces, systemd unit names, absolute server
#                 paths, tokens. The failure this prevents is not "someone types
#                 the wrong thing"; it is a well-meaning script piping a status
#                 line straight through. Override needs --force AND an explicit
#                 reason, so it cannot happen by accident or by habit.
#
#   IDEMPOTENT    Every announcement is keyed. Re-running with the same key is a
#                 no-op that exits 0. A cron that announces a release must be
#                 safe to run every five minutes forever; without this, the
#                 first flaky network call turns into a channel full of
#                 duplicates and people mute it.
#
#   NO SILENT WIN Telegram failing is a non-zero exit and a log line. A
#                 publisher that cannot publish must not report success.
#
# Config: /etc/pcoin/alert.conf (0600 root) -- TELEGRAM_TOKEN.
# The channel id is hardcoded below ON PURPOSE: it is public and permanent, and
# reading it from the same file as ALERT_CHAT is exactly how the two get swapped.

set -u

ANNOUNCE_CHAT="-1003712285504"          # @PCoinPCN, public. NOT the ops channel.
CONF=/etc/pcoin/alert.conf
SEEN=/var/lib/pcoin-monitor/announced
TGLOG=/usr/local/bin/pcoin-telegram-log
DRY=0; FORCE=0; REASON=""; KEY=""; PHOTO=""

log() { logger -t pcoin-announce -- "$*" 2>/dev/null || printf '%s\n' "$*" >&2; }
die() { log "$*"; printf 'pcoin-announce: %s\n' "$*" >&2; exit 1; }
# Same durable record pcoin-notify keeps for the private channel, so "what has
# this project told the public" is answerable from disk too, not just from
# --list (title + timestamp only, no body) or a journal that rotates in days.
# --dry-run and --list are never logged here: neither is a real send attempt.
tglog() { [ -x "$TGLOG" ] && "$TGLOG" record --channel announce --chat "$ANNOUNCE_CHAT" "$@" >/dev/null 2>&1 || true; }

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1; shift ;;
    --force)   FORCE=1; REASON="${2:-}"; shift 2 ;;
    --key)     KEY="${2:-}"; shift 2 ;;
    --photo)   PHOTO="${2:-}"; shift 2 ;;
    --list)    for f in $(ls -1t "$SEEN" 2>/dev/null | head -40); do
                 printf '%-26s %s\n' "$f" "$(cat "$SEEN/$f" 2>/dev/null)"; done; exit 0 ;;
    --help|-h) sed -n '2,36p' "$0"; exit 0 ;;
    *) break ;;
  esac
done

TITLE="${1:-}"; BODY="${2:-}"
[ -n "$TITLE" ] || die "usage: pcoin-announce [--dry-run] [--key K] [--photo FILE] \"<title>\" \"<body>\""

TEXT="$TITLE"
[ -n "$BODY" ] && TEXT="$TITLE

$BODY"

# ── picture ───────────────────────────────────────────────────────────────
# With --photo the text rides along as the caption of a sendPhoto call, and a
# caption has a hard 1024-character limit where a message has 4096. Telegram
# counts UTF-16 code units of the text AFTER the Markdown is parsed: '*' and
# backticks are gone, a [label](url) is just its label, and every character
# outside the BMP (the emoji) is two units. Reproduce that count here so the
# refusal happens on the operator's screen, not at Telegram with nothing posted.
if [ -n "$PHOTO" ]; then
  [ -r "$PHOTO" ] || die "--photo: cannot read $PHOTO"
  case "$(head -c 4 "$PHOTO" | od -An -tx1 | tr -d ' \n')" in
    89504e47|ffd8ff*) ;;
    *) die "--photo: $PHOTO is not a PNG or JPEG" ;;
  esac
  PBYTES=$(wc -c < "$PHOTO")
  [ "$PBYTES" -le 10485760 ] || die "--photo: $PHOTO is $PBYTES bytes; sendPhoto stops at 10 MB"
  PLAIN=$(printf '%s' "$TEXT" | sed -E 's/\[([^]]*)\]\([^)]*\)/\1/g' | tr -d '*`')
  CAPLEN=$(( $(printf '%s' "$PLAIN" | LC_ALL=C.UTF-8 wc -m) + $(printf '%s' "$PLAIN" | LC_ALL=C tr -cd '\360-\367' | wc -c) ))
  [ "$CAPLEN" -le 1024 ] || die "caption is $CAPLEN characters; a photo caption stops at 1024 — shorten it, or post the text without --photo"
fi

# ── leak guard ────────────────────────────────────────────────────────────
# Patterns chosen from things that have ACTUALLY been leaked or nearly leaked,
# not from a generic list.
BAD=""
check() { printf '%s' "$TEXT" | grep -qiE "$1" && BAD="$BAD
  - $2"; }

check '\b(status|exit)=[0-9]+|/NOTIMPLEMENTED|\bexit code\b' 'a process exit status'
check '\b(10|127|172|192)\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\b' 'a private IP address'
check '\b(35\.23[89]|178\.105|116\.203|167\.233)\.[0-9]{1,3}\.[0-9]{1,3}\b' 'one of our server IPs'
check '\b[a-z0-9-]+\.service\b|systemctl|journalctl|pm2 ' 'a systemd/pm2 unit or command'
check '(^|[^a-z])/(var|opt|etc|root|home)/' 'an absolute server path'
check 'debian-[0-9]|ubuntu-[0-9]|ai-bots|tbots|nbg1|fsn1' 'an internal hostname'
check 'Traceback|at [A-Za-z]+\.[a-z]+ \(|\bstack trace\b' 'a stack trace'
check '[0-9]{8,10}:[A-Za-z0-9_-]{30,}|xprv[a-zA-Z0-9]{20,}|-----BEGIN' 'something that looks like a secret'
check 'UNHEALTHY|stale watcher|deposit stuck|REORG FLAG' 'operational alert wording'

if [ -n "$BAD" ]; then
  if [ "$FORCE" != "1" ] || [ -z "$REASON" ]; then
    printf 'REFUSING to announce — this reads like an operational alert, not an announcement:%s\n\n' "$BAD" >&2
    printf 'Public subscribers do not want it and it has leaked before.\n' >&2
    printf 'Ops alerts belong in the private channel via pcoin-notify.\n' >&2
    printf 'If this really is public copy: --force "<why>"\n' >&2
    tglog --status refused --subject "$TITLE" --body "$BODY" --error "${BAD# }"
    exit 2
  fi
  log "leak guard overridden: $REASON"
fi

# ── idempotency ───────────────────────────────────────────────────────────
[ -n "$KEY" ] || KEY=$(printf '%s' "$TITLE" | sha256sum | cut -c1-24)
mkdir -p "$SEEN" 2>/dev/null
if [ -f "$SEEN/$KEY" ]; then
  log "already announced ($KEY): $TITLE"
  tglog --status suppressed --subject "$TITLE" --body "$BODY"
  echo "already announced on $(cat "$SEEN/$KEY") — nothing sent"
  exit 0
fi

if [ "$DRY" = "1" ]; then
  echo "--- would post to @PCoinPCN ($ANNOUNCE_CHAT), key=$KEY ---"
  [ -n "$PHOTO" ] && echo "[photo: $PHOTO, $PBYTES bytes; caption $CAPLEN/1024 characters]"
  printf '%s\n' "$TEXT"
  echo "--- end (nothing sent) ---"
  exit 0
fi

if [ ! -r "$CONF" ]; then
  tglog --status failed --subject "$TITLE" --body "$BODY" --error "no $CONF on this host"
  die "no $CONF — cannot authenticate"
fi
# shellcheck disable=SC1090
. "$CONF"
if [ -z "${TELEGRAM_TOKEN:-}" ]; then
  tglog --status failed --subject "$TITLE" --body "$BODY" --error "$CONF has no TELEGRAM_TOKEN"
  die "$CONF has no TELEGRAM_TOKEN"
fi

if [ -n "$PHOTO" ]; then
  # --form-string, not -F, for the text fields: -F gives a leading '@' or '<'
  # and an embedded ';type=' special meaning inside the value, so a caption
  # is not something -F can be trusted with. -F stays for the file itself.
  RESP=$(curl -s --max-time 60 -X POST \
    "https://api.telegram.org/bot${TELEGRAM_TOKEN}/sendPhoto" \
    --form-string "chat_id=${ANNOUNCE_CHAT}" \
    -F "photo=@${PHOTO}" \
    --form-string "caption=${TEXT}" \
    --form-string "parse_mode=Markdown" 2>&1)
else
  RESP=$(curl -s --max-time 25 -X POST \
    "https://api.telegram.org/bot${TELEGRAM_TOKEN}/sendMessage" \
    --data-urlencode "chat_id=${ANNOUNCE_CHAT}" \
    --data-urlencode "text=${TEXT}" \
    --data-urlencode "parse_mode=Markdown" \
    --data-urlencode "disable_web_page_preview=false" 2>&1)
fi

case "$RESP" in
  *'"ok":true'*)
      # Record the message_id, not just the timestamp. Without it there is no
      # way to correct a post later: the Bot API cannot read channel history,
      # so an announcement with a mistake in it can only be identified by
      # probing ids one at a time and hoping. That happened once already, over
      # a missing link, and the fix had to become a second post because
      # overwriting the wrong public message was the worse risk.
      MID=$(printf '%s' "$RESP" | grep -oE '"message_id":[0-9]+' | head -1 | cut -d: -f2)
      printf '%s\tmessage_id=%s\t%s\n'         "$(date -u '+%Y-%m-%d %H:%M UTC')" "${MID:-unknown}" "$TITLE" > "$SEEN/$KEY"
      log "announced ($KEY, message_id=${MID:-unknown}${PHOTO:+, photo=$(basename "$PHOTO")}): $TITLE"
      tglog --status sent --subject "$TITLE" --body "$BODY" --message-id "${MID:-unknown}"
      echo "posted to @PCoinPCN (message_id=${MID:-unknown})"
      ;;
  *)  # No stamp on failure: an undelivered announcement must be retried, not
      # remembered as sent.
      tglog --status failed --subject "$TITLE" --body "$BODY" --error "$(printf '%s' "$RESP" | head -c 300)"
      die "delivery FAILED: $(printf '%s' "$RESP" | head -c 300)"
      ;;
esac
