def _tg_call(tg_token, method, fields):
    data = urllib.parse.urlencode(fields).encode()
    try:
        with urllib.request.urlopen(urllib.request.Request(
                "https://api.telegram.org/bot%s/%s" % (tg_token, method), data=data), timeout=20) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            return json.loads(e.read().decode("utf-8", "replace"))
        except Exception:
            return {"ok": False, "description": "HTTP %d" % e.code}
    except Exception as e:
        return {"ok": False, "description": type(e).__name__}


def _discord_gone(e):
    """True when a DELETE failed because the message no longer exists.

    Discord answers 404 with code 10008 (Unknown Message) once the author,
    another moderator or Discord's own filter has removed it first. That is
    the outcome a removal wanted -- reporting it as "It is still visible."
    sent a false alarm on 2026-09-20. Any OTHER 404 (a wrong channel, say)
    still counts as a failure.
    """
    if getattr(e, "code", None) != 404:
        return False
    try:
        return json.loads(e.read().decode("utf-8", "replace")).get("code") == 10008
    except Exception:
        return False


def remove_advert(tg_token, row, author, text, model):
    """Report to the private channel FIRST, then delete.

    Returns True if deleted, False if reported but the delete failed, and None if
    the report could not be delivered -- in which case NOTHING was deleted and the
    caller must leave the message unhandled so the next run tries again.
    """
    import html as _html
    esc = _html.escape
    chat = str(row.get("chat") or "")
    mid = str(row.get("message_id"))
    discord = chat.startswith("discord:")
    where = "PCoin Discord" if discord else "PCoin Chat"
    link = ("https://discord.com/channels/1547398066313891890/%s/%s" % (chat.split(":", 1)[1], mid)
            if discord else "https://t.me/PCoinPCNChat/%s" % mid)
    when = time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(float(row.get("date") or time.time())))
    user_id = str(row.get("from_id") or "?")
    alert = conf(ALERT_CONF).get("ALERT_CHAT", "")
    if DRY or not alert:
        print("  (would report, then remove advert %s)" % mid)
        return None

    forwarded = False
    if not discord:
        fw = _tg_call(tg_token, "forwardMessage", {"chat_id": alert, "from_chat_id": chat or str(GROUP_ID),
                                                   "message_id": mid, "disable_notification": "true"})
        forwarded = bool(fw.get("ok"))
    body = ("🧹 <b>%s — removing a message</b> (the AI judged it an advert)\n"
            "<b>Who:</b> %s\n<b>User id:</b> <code>%s</code>\n<b>Sent:</b> %s\n"
            "<b>Message:</b> %s\n<b>Model:</b> %s\n<b>Text:</b>\n%s%s"
            % (where, esc(author), esc(user_id), when, link, esc(model or "?"), esc(text[:2500]),
               "\n\n<i>The original is forwarded just above.</i>" if forwarded else ""))
    rep = _tg_call(tg_token, "sendMessage", {"chat_id": alert, "parse_mode": "HTML", "text": body[:4000],
                                             "disable_web_page_preview": "true"})
    if not rep.get("ok"):
        print("  removal report for %s failed (%s) -- NOT deleting this run"
              % (mid, rep.get("description")), file=sys.stderr)
        return None

    deleted, gone, why_not = False, False, ""
    try:
        if discord:
            tok = ""
            try:
                for line in open("/etc/pcoin/discord.conf", encoding="utf-8"):
                    k, _, v = line.strip().partition("=")
                    if k.strip() == "DISCORD_BOT_TOKEN":
                        tok = v.strip().strip('"').strip("'")
            except OSError:
                pass
            if not tok:
                raise RuntimeError("no Discord bot token")
            req = urllib.request.Request(
                "https://discord.com/api/v10/channels/%s/messages/%s" % (chat.split(":", 1)[1], mid),
                method="DELETE", headers={"Authorization": "Bot " + tok,
                                          "User-Agent": "DiscordBot (https://pc.am, 1.0) pcoin-group-answer"})
            with urllib.request.urlopen(req, timeout=20) as resp:
                deleted = resp.status in (200, 204)
        else:
            d = _tg_call(tg_token, "deleteMessage", {"chat_id": chat or str(GROUP_ID), "message_id": mid})
            deleted = bool(d.get("ok"))
            why_not = "" if deleted else (d.get("description") or "not ok")
    except urllib.error.HTTPError as e:
        why_not = "HTTP %d" % e.code
        if discord and _discord_gone(e):
            gone, why_not = True, "already gone (HTTP 404, Unknown Message)"
    except Exception as e:
        why_not = type(e).__name__

    removed_log({"at": int(time.time()), "by": "pcoin-group-answer", "platform": "discord" if discord else "telegram",
                 "chat": chat, "message_id": mid, "sent": when, "who": author, "user_id": user_id,
                 "reason": "advert (AI)", "model": model, "text": text, "forwarded": forwarded,
                 "deleted": deleted, "delete_error": why_not})
    if not deleted and not gone:
        _tg_call(tg_token, "sendMessage", {"chat_id": alert, "text":
                 "⚠️ Could NOT delete message %s in %s (%s). It is still visible." % (mid, where, why_not or "unknown")})
    # Not visible is what the caller asks about: gone counts, and removed.jsonl
    # still records deleted=False with the reason, so nobody is credited with
    # a delete that somebody else did.
    return deleted or gone


def reply(token, message_id, text, dest="group"):
    """QUEUE a reply for the owner's approval. This function no longer publishes.

    It used to POST straight into the public group. It does not any more, and the
    distinction is the whole point: a model now composes text that a human sees
    before anyone else does. The return value means "accepted into the queue",
    NOT "visible in the group", and every caller of this function had to be
    reviewed for that difference -- a queued draft counted as an answer would be
    an unresolved outcome recorded as a resolved one, which is the single most
    expensive class of bug in this project.

    The destination is a NAME, not a chat id. pcoin-approve maps "group" to the
    one permitted chat from its own allow-list, so this script cannot address any
    other chat even if something rewrites this line -- which is a stronger
    guarantee than the hardcoded GROUP_ID it replaces.

    The token argument is now unused and kept only so the call sites read the
    same. This program holding a bot token at all is now unnecessary, and
    removing it is the obvious next hardening step.
    """
    if not os.access(APPROVE, os.X_OK):
        # FAIL CLOSED. No gate means no publishing -- never a fallback to
        # posting directly. A fallback here would quietly restore exactly the
        # behaviour the gate exists to remove, on the day the gate breaks.
        print("  %s is missing -- REFUSING to post. Nothing was sent." % APPROVE,
              file=sys.stderr)
        return False
    try:
        r = subprocess.run(
            [APPROVE, "submit", "--dest", dest,
             "--reply-to", str(message_id),
             "--source", "pcoin-group-answer",
             "--key", "answer-%s" % message_id,
             "--text", text],
            capture_output=True, text=True, timeout=60)
    except Exception as e:
        print("  could not reach the approval gate (%s)" % type(e).__name__, file=sys.stderr)
        return False
    if r.returncode != 0:
        print("  approval gate refused: %s"
              % (r.stderr or r.stdout or "").strip().splitlines()[-1:], file=sys.stderr)
        return False
    print("  queued for approval: %s" % (r.stdout or "").strip())
    return True


