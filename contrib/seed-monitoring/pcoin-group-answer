REMOVED_LOG = "/var/lib/pcoin-group-watch/removed.jsonl"


def removed_log(entry):
    """The durable history of removals, one JSON object per line."""
    try:
        with open(REMOVED_LOG, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(entry, ensure_ascii=False) + "\n")
    except OSError as e:
        print("  removal log write failed: %s" % e, file=sys.stderr)


def _tg_call(tg_token, method, fields):
    data = urllib.parse.urlencode(fields).encode()
    try:
        with urllib.request.urlopen(urllib.request.Request(
                "https://api.telegram.org/bot%s/%s" % (tg_token, method), data=data), timeout=20) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            return json.loads(e.read().decode("utf-8", "replace"))
        except Exception:
            return {"ok": False, "description": "HTTP %d" % e.code}
    except Exception as e:
        return {"ok": False, "description": type(e).__name__}


def remove_advert(tg_token, row, author, text, model):
    """Report to the private channel FIRST, then delete.

    Returns True if deleted, False if reported but the delete failed, and None if
    the report could not be delivered -- in which case NOTHING was deleted and the
    caller must leave the message unhandled so the next run tries again.
    """
    import html as _html
    esc = _html.escape
    chat = str(row.get("chat") or "")
    mid = str(row.get("message_id"))
    discord = chat.startswith("discord:")
    where = "PCoin Discord" if discord else "PCoin Chat"
    link = ("https://discord.com/channels/1547398066313891890/%s/%s" % (chat.split(":", 1)[1], mid)
            if discord else "https://t.me/PCoinPCNChat/%s" % mid)
    when = time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(float(row.get("date") or time.time())))
    user_id = str(row.get("from_id") or "?")
    alert = conf(ALERT_CONF).get("ALERT_CHAT", "")
    if DRY or not alert:
        print("  (would report, then remove advert %s)" % mid)
        return None

    forwarded = False
    if not discord:
        fw = _tg_call(tg_token, "forwardMessage", {"chat_id": alert, "from_chat_id": chat or str(GROUP_ID),
                                                   "message_id": mid, "disable_notification": "true"})
        forwarded = bool(fw.get("ok"))
    body = ("🧹 <b>%s — removing a message</b> (the AI judged it an advert)\n"
            "<b>Who:</b> %s\n<b>User id:</b> <code>%s</code>\n<b>Sent:</b> %s\n"
            "<b>Message:</b> %s\n<b>Model:</b> %s\n<b>Text:</b>\n%s%s"
            % (where, esc(author), esc(user_id), when, link, esc(model or "?"), esc(text[:2500]),
               "\n\n<i>The original is forwarded just above.</i>" if forwarded else ""))
    rep = _tg_call(tg_token, "sendMessage", {"chat_id": alert, "parse_mode": "HTML", "text": body[:4000],
                                             "disable_web_page_preview": "true"})
    if not rep.get("ok"):
        print("  removal report for %s failed (%s) -- NOT deleting this run"
              % (mid, rep.get("description")), file=sys.stderr)
        return None

    deleted, why_not = False, ""
    try:
        if discord:
            tok = ""
            try:
                for line in open("/etc/pcoin/discord.conf", encoding="utf-8"):
                    k, _, v = line.strip().partition("=")
                    if k.strip() == "DISCORD_BOT_TOKEN":
                        tok = v.strip().strip('"').strip("'")
            except OSError:
                pass
            if not tok:
                raise RuntimeError("no Discord bot token")
            req = urllib.request.Request(
                "https://discord.com/api/v10/channels/%s/messages/%s" % (chat.split(":", 1)[1], mid),
                method="DELETE", headers={"Authorization": "Bot " + tok,
                                          "User-Agent": "DiscordBot (https://pc.am, 1.0) pcoin-group-answer"})
            with urllib.request.urlopen(req, timeout=20) as resp:
                deleted = resp.status in (200, 204)
        else:
            d = _tg_call(tg_token, "deleteMessage", {"chat_id": chat or str(GROUP_ID), "message_id": mid})
            deleted = bool(d.get("ok"))
            why_not = "" if deleted else (d.get("description") or "not ok")
    except urllib.error.HTTPError as e:
        why_not = "HTTP %d" % e.code
    except Exception as e:
        why_not = type(e).__name__

    removed_log({"at": int(time.time()), "by": "pcoin-group-answer", "platform": "discord" if discord else "telegram",
                 "chat": chat, "message_id": mid, "sent": when, "who": author, "user_id": user_id,
                 "reason": "advert (AI)", "model": model, "text": text, "forwarded": forwarded,
                 "deleted": deleted, "delete_error": why_not})
    if not deleted:
        _tg_call(tg_token, "sendMessage", {"chat_id": alert, "text":
                 "⚠️ Could NOT delete message %s in %s (%s). It is still visible." % (mid, where, why_not or "unknown")})
    return deleted


def reply(token, message_id, text, dest="group"):
    """QUEUE a reply for the owner's approval. This function no longer publishes.

    It used to POST straight into the public group. It does not any more, and the
    distinction is the whole point: a model now composes text that a human sees
    before anyone else does. The return value means "accepted into the queue",
    NOT "visible in the group", and every caller of this function had to be
    reviewed for that difference -- a queued draft counted as an answer would be
    an unresolved outcome recorded as a resolved one, which is the single most
    expensive class of bug in this project.

    The destination is a NAME, not a chat id. pcoin-approve maps "group" to the
    one permitted chat from its own allow-list, so this script cannot address any
    other chat even if something rewrites this line -- which is a stronger
    guarantee than the hardcoded GROUP_ID it replaces.

    The token argument is now unused and kept only so the call sites read the
    same. This program holding a bot token at all is now unnecessary, and
    removing it is the obvious next hardening step.
    """
    if not os.access(APPROVE, os.X_OK):
        # FAIL CLOSED. No gate means no publishing -- never a fallback to
        # posting directly. A fallback here would quietly restore exactly the
        # behaviour the gate exists to remove, on the day the gate breaks.
        print("  %s is missing -- REFUSING to post. Nothing was sent." % APPROVE,
              file=sys.stderr)
        return False
    try:
        r = subprocess.run(
            [APPROVE, "submit", "--dest", dest,
             "--reply-to", str(message_id),
             "--source", "pcoin-group-answer",
             "--key", "answer-%s" % message_id,
             "--text", text],
            capture_output=True, text=True, timeout=60)
    except Exception as e:
        print("  could not reach the approval gate (%s)" % type(e).__name__, file=sys.stderr)
        return False
    if r.returncode != 0:
        print("  approval gate refused: %s"
              % (r.stderr or r.stdout or "").strip().splitlines()[-1:], file=sys.stderr)
        return False
    print("  queued for approval: %s" % (r.stdout or "").strip())
    return True


def file_reports(cfg, reports):
    if not reports:
        return
    url = cfg.get("REPORTS_URL", "")
    token = cfg.get("REPORTS_TOKEN", "")
    if not url or not token:
        print("  REPORTS_URL/TOKEN unset -- %d report(s) NOT filed" % len(reports),
              file=sys.stderr)
        return
    req = urllib.request.Request(
        url, data=json.dumps({"reports": reports}).encode(),
        headers={"content-type": "application/json", "authorization": "Bearer " + token},
        method="POST")
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            print("  filed: " + r.read().decode().strip())
    except Exception as e:
        print("  filing failed (%s)" % type(e).__name__, file=sys.stderr)


def read_spool():
    rows = []
    try:
        with open(SPOOL, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    rows.append(json.loads(line))
                except Exception:
                    continue
    except FileNotFoundError:
        pass
    return rows


def main():
    # FIRST. Before the config, before the spool, before any network call.
    if os.path.exists(DISABLED):
        try:
            with open(DISABLED, encoding="utf-8") as fh:
                why = fh.read().strip()
        except OSError:
            why = ""
        print("DISABLED from the admin panel -- doing nothing. %s" % why)
        # Exit 0, not an error. A deliberately switched-off agent is not a
        # failure, and exiting non-zero here would fire OnFailure= and page the
        # ops channel every minute for as long as it stayed off.
        return 0

    cfg = conf(CONF)
    st = load_state()

    if "--status" in sys.argv:
        print("  mode        : %s" % cfg.get("ANSWER_MODE", "shadow"))
        print("  models      : %s" % " then ".join(models_for(cfg)))
        print("  spool       : %d message(s)" % len(read_spool()))
        print("  handled     : %d" % len(st["handled"]))
        print("  answered    : %d posted, %d held" % (st["answered"], st["held"]))
        print("  last run    : %s" % (time.strftime("%Y-%m-%d %H:%M:%SZ",
              time.gmtime(st["last_run"])) if st["last_run"] else "never"))
        return 0

    # ENVIRONMENT WINS. This read the config file only, so
    # `ANSWER_MODE=shadow ./pcoin-group-answer` looked like it was
    # disabling posting and was not -- a rate-limit test run that way
    # queued two real answers for the public group. That is CLAUDE.md
    # 7.14 from the other direction: "I set something that looks like a
    # kill switch" is not evidence, and the only fix is to make the
    # switch real.
    mode = (os.environ.get("ANSWER_MODE")
            or cfg.get("ANSWER_MODE", "shadow")).lower()
    live = (mode == "live") and not DRY

    try:
        with open(PROMPT, encoding="utf-8") as fh:
            system = fh.read()
    except OSError as e:
        sys.exit("cannot read the prompt at %s: %s" % (PROMPT, e))

    tg = conf(ALERT_CONF).get("TELEGRAM_TOKEN", "")
    if live and not tg:
        sys.exit("ANSWER_MODE=live but there is no TELEGRAM_TOKEN -- refusing to pretend")

    now = time.time()
    rows = [r for r in read_spool()
            if str(r.get("message_id")) not in st["handled"]
            and now - float(r.get("date", 0)) <= MAX_AGE_SECONDS]
    # Oldest first: a conversation answered out of order reads as nonsense.
    rows.sort(key=lambda r: r.get("date", 0))

    if not rows:
        st["last_run"] = int(now)
        if not DRY:
            save_state(st)
        print("  nothing to answer")
        return 0

    # For the per-user cap below: each person's NEWEST still-unhandled message.
    # rows is oldest-first, so the last write per user wins.
    newest_pending = {}
    for r in rows:
        newest_pending[str(r.get("from_id") or "?")] = str(r.get("message_id"))

    reports, posted = [], 0
    for r in rows:
        mid = str(r.get("message_id"))
        uid = str(r.get("from_id") or "?")
        text = askable_text(r)
        author = r.get("from") or "someone"
        if not text:
            st["handled"][mid] = int(now)
            continue
        # RE-CHECK INSIDE THE LOOP. group-watch re-reads a batch whose relay
        # failed, so the spool deliberately holds duplicates -- "duplicates are
        # cheap, a lost bug report is not". The filter that built `rows` ran
        # once, before any of this, so without this second check the same
        # message_id is processed twice in one pass. Not theoretical: message
        # 104 was HELD as low-confidence and then ANSWERED from its own
        # duplicate, seconds apart, in the same run.
        if mid in st["handled"]:
            continue
        if posted >= MAX_PER_RUN:
            break                                   # the rest wait for the next run
        if now - float(st["last_user_answer"].get(uid, 0)) < USER_COOLDOWN:
            continue                                # not marked handled: try again later

        # --- sliding windows ------------------------------------------------
        st["all_window"] = [t for t in st.get("all_window", []) if now - t < WINDOW]
        uw = [t for t in (st.get("user_window", {}).get(uid) or []) if now - t < WINDOW]
        st.setdefault("user_window", {})[uid] = uw

        if len(st["all_window"]) >= PER_HOUR:
            # NOT marked handled. A quiet person who asked during somebody
            # else's flood did nothing wrong and must still get an answer once
            # the window clears -- otherwise one spammer silences the group,
            # which is worse than the spam.
            print("  global cap reached (%d/h) -- %s left for later" % (PER_HOUR, mid))
            continue

        if len(uw) >= PER_USER_HOUR:
            # DEFER. DO NOT DISCARD.
            #
            # This used to mark the message handled, which threw the question
            # away for good -- not answered, not retried once the window
            # cleared, not filed for anybody. On 2026-09-16 a member asked
            # "What if i sell token worth 9$ then how i get the withdraw" and
            # got nothing. That question needed answering BEFORE he sold,
            # because the minimum withdrawal is $30 and $9 cannot be withdrawn
            # at all. From his side the bot replied twice and then ignored him,
            # and nothing anywhere said a question had been dropped.
            #
            # The cap itself is right: it stops one person monopolising the bot.
            # What was wrong was what it did with the message it refused. The
            # window is an hour (WINDOW) and the spool holds six (MAX_AGE_
            # SECONDS), so holding costs nothing and the question gets answered
            # late instead of never.
            #
            # Only that person's NEWEST pending question is held. Otherwise a
            # flood would arrive in full an hour later, which is the exact
            # failure the original marking was written to prevent -- so keep
            # both properties rather than trading one for the other.
            if newest_pending.get(uid) not in (None, mid):
                st["handled"][mid] = int(now)
                act(action="superseded", message_id=mid, who=author,
                    asked=text[:300],
                    reason="over the per-user cap (%d/h) and followed by a newer "
                           "question from the same person" % PER_USER_HOUR)
                print("  superseded %s (%s: over the cap, newer question pending)"
                      % (mid, author))
            else:
                act(action="deferred", message_id=mid, who=author,
                    asked=text[:300],
                    reason="%s has had %d answers this hour; holding until the "
                           "window clears" % (author, len(uw)))
                print("  per-user cap (%d/h) -- %s HELD for later, not dropped"
                      % (PER_USER_HOUR, mid))
            continue

        try:
            out, used_model = ask_model_with_fallback(cfg, system, text, author)
        except Exception as e:
            # A RuntimeError we raised says something useful and carries no URL. A
            # transport error can carry the request URL, and the URL carries the
            # key -- those stay reported by TYPE only.
            detail = str(e) if isinstance(e, (RuntimeError, ValueError)) else type(e).__name__
            print("  model failed on %s: %s" % (mid, detail), file=sys.stderr)
            continue                                # NOT handled -- a failure resolves nothing

        if out.get("listing_offer") is True and str(r.get("from_id")) not in OWNER_IDS:
            report_listing_offer(tg, r, author, text, used_model)
            act(action="listing-offer-reported", message_id=mid, who=author,
                asked=text[:300], model=used_model)
            st["handled"][mid] = int(now)
            print("  listing offer %s reported, message left in place" % mid)
            continue

        if out.get("spam") is True and str(r.get("from_id")) not in OWNER_IDS:
            ok_removed = remove_advert(tg, r, author, text, used_model)
            if ok_removed is None:
                continue        # the report did not go out, so nothing was deleted: retry next run
            act(action="removed-advert" if ok_removed else "advert-not-removed",
                message_id=mid, who=author, asked=text[:300], model=used_model)
            st["handled"][mid] = int(now)
            print("  advert %s %s" % (mid, "removed" if ok_removed else "NOT removed"))
            continue

        answer = (out.get("answer") or "").strip() or None
        conf_level = str(out.get("confidence") or "low").lower()
        rep = out.get("report") or None

        held_why = None
        if answer:
            held_why = guard(answer)
            if not held_why and conf_level == "low":
                held_why = "the model was not confident"
            if not held_why and not live:
                held_why = "shadow mode — nothing is posted yet"

        send_failed = False
        if answer and not held_why:
            dest = dest_for(r.get("chat"))
            if dest is None:
                # Relayed from a chat this bot is not allowed to answer. Say so
                # loudly rather than silently dropping it: it means the poller
                # and this script disagree about which chats exist.
                held_why = ("it arrived from a chat this bot has no destination for "
                            "(chat %s) -- NOT answered" % r.get("chat"))
                st["held"] += 1
                print("  held %s: %s" % (mid, held_why), file=sys.stderr)
            elif reply(tg, r.get("message_id"), answer, dest):
                act(action="queued-for-approval", message_id=mid, who=author,
                    asked=text[:300], answer=answer[:600],
                    model=used_model, confidence=conf_level)
                posted += 1
                # QUEUED, not answered. At this moment the words are in the
                # approval queue and may never be published. `answered` is left
                # for what the gate actually publishes; conflating the two would
                # make the panel claim the group was answered when it was not.
                st["queued"] = st.get("queued", 0) + 1
                # The cooldown DOES advance: it exists to stop the bot replying
                # to one person over and over, and a queued draft has already
                # used that person's turn.
                st["last_user_answer"][uid] = int(now)
                st.setdefault("user_window", {}).setdefault(uid, []).append(int(now))
                st.setdefault("all_window", []).append(int(now))
                print("  queued %s for approval" % mid)
            else:
                # A send failure here is almost never a blip -- it is the bot not
                # being allowed to post in the group. That was visible only in a
                # journal nobody reads, which is the exact shape of failure this
                # estate keeps getting caught by. File it so it shows on the panel,
                # AND keep retrying: the ingest route dedupes on the report id, so
                # re-filing the same one every run costs nothing.
                send_failed = True
                held_why = ("the reply could NOT be queued for approval -- check that "
                            "/usr/local/bin/pcoin-approve exists and that the approval "
                            "queue is readable. NOTHING was posted")
                st["held"] += 1
                print("  send failed for %s -- filed, left unhandled for retry" % mid,
                      file=sys.stderr)
        elif answer:
            act(action="held", message_id=mid, who=author, asked=text[:300],
                answer=answer[:600], model=used_model, confidence=conf_level,
                reason=held_why)
            st["held"] += 1
            print("  held %s: %s" % (mid, held_why))

        # File whenever the model asked for it, AND whenever a draft was held --
        # ALSO file whenever something was actually POSTED. Not optional:
        # without it, an answer the model saw no reason to flag went into a
        # public group with no record anywhere of what it said, and the bot
        # could not be audited afterwards. Two answers went out that way
        # before this line existed.
        # a held answer is precisely the case a person needs to see.
        if rep or held_why or (answer and not held_why):
            # Say plainly, in the record itself, whether this went out. The
            # operator reading /user-reports needs to tell an answer that was
            # POSTED from a draft that was held.
            # It says QUEUED because that is what happened. It is not in the
            # group yet and may never be; /approvals is where its fate is.
            posted_note = ("QUEUED FOR YOUR APPROVAL -- not yet public\n\n"
                           if (answer and not held_why) else "")
            detail = posted_note + "They said:\n" + text[:1500]
            if answer:
                detail += ("\n\nDraft reply (%s):\n%s"
                           % ("QUEUED for approval" if not held_why
                              else "NOT queued — " + held_why, answer[:1500]))
            reports.append({
                "id": "tg-%s" % mid,
                "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(r.get("date", now))),
                "kind": "bug" if send_failed else ((rep or {}).get("kind") or "question"),
                "summary": ((rep or {}).get("summary")
                            or (text[:120] + ("…" if len(text) > 120 else ""))),
                "detail": detail,
                "from": author,
                "link": "https://t.me/PCoinPCNChat/%s" % mid,
                # QUEUED, not answered. This said `answered: True` the moment a
                # draft was handed to the approval gate -- but a queued draft can
                # still be cancelled, and one already had been, so the panel was
                # claiming a group question had been answered when nothing had
                # been posted. Same error as the counter this file already fixed:
                # an unresolved outcome recorded as a resolved one.
                #
                # `answered` now means what it says. Whether the queued draft
                # ever reached the group is a fact the approval queue owns, and
                # it is on /approvals.
                "answered": False,
                "queued_for_approval": bool(answer and not held_why),
                "model": used_model,
            })

        # A message whose reply could not be sent stays unhandled, so the next
        # run tries again until it ages out of the window.
        if not send_failed:
            st["handled"][mid] = int(now)

    # Keep the handled map from growing without bound: a week is far longer than
    # MAX_AGE_SECONDS, so nothing can be re-answered because it was forgotten.
    cutoff = now - 7 * 86400
    st["handled"] = {k: v for k, v in st["handled"].items() if v >= cutoff}
    st["last_run"] = int(now)

    if DRY:
        print(json.dumps(reports, indent=2)[:4000])
        print("\n  DRY RUN: %d would be posted, %d filed, nothing saved" % (posted, len(reports)))
        return 0

    file_reports(cfg, reports)
    save_state(st)
    print("  %d message(s) considered, %d posted, %d filed (mode=%s)"
          % (len(rows), posted, len(reports), mode))
    return 0


if __name__ == "__main__":
    sys.exit(main())
