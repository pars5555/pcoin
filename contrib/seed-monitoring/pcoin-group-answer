def conf(path):
    out = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                m = re.match(r"^\s*([A-Z_]+)\s*=\s*(.*?)\s*$", line)
                if m:
                    out[m.group(1)] = m.group(2).strip().strip('"').strip("'")
    except FileNotFoundError:
        pass
    return out


def load_state():
    try:
        with open(STATE, encoding="utf-8") as fh:
            st = json.load(fh)
    except Exception:
        st = {}
    # Normalise rather than only handling "unreadable". A state file that parses
    # but lacks a key is what crashed a sibling script on its first real run.
    st.setdefault("handled", {})
    st.setdefault("last_user_answer", {})
    # Timestamps of answers given, per user and overall, trimmed to the window.
    # Lists rather than counters: a counter cannot expire, so it would either
    # reset on a boundary (letting a burst straddle two hours) or never reset.
    st.setdefault("user_window", {})
    st.setdefault("all_window", [])
    st.setdefault("last_run", 0)
    st.setdefault("answered", 0)
    st.setdefault("held", 0)
    return st


def save_state(st):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(st, fh, indent=2)
    os.replace(tmp, STATE)


# ---- the output guard ----------------------------------------------------
# Defence in depth behind the prompt. Each pattern is here because saying it in
# a public group would be a real leak or a real promise, not because it is rude.
# Telegram refuses a message over 4,096 characters outright. HOLD well below
# that: an answer of this length has ignored its instructions, and the
# interesting question is why, which is a thing for a person to look at rather
# than something to trim and post.
MAX_ANSWER_CHARS = int(os.environ.get("ANSWER_MAX_CHARS", "2000"))

# PUBLISHED endpoints that are ALLOWED to appear even though they look like a
# leak. This is an allow-list, not a loosened pattern, for the same reason the
# rate guard became one: the rule stays absolute and the exceptions are named.
#
# WHY IT EXISTS. pcoin-facts instructs the bot, in as many words, to hand out
# the independent pool's stratum address when a miner asks for an alternative
# -- and the IP rule below then silently held every answer that obeyed. On
# 2026-09-21, during the seven-hour pool stall, that killed BOTH replies to the
# one miner who was actively leaving: he asked twice why pool2 would not answer
# and got silence, then left for another pool. The feed and the guard
# contradicted each other and the guard won without saying so.
#
# Only add an address here that is already public on pc.am or in the docs.
PUBLIC_ENDPOINTS = [
    "198.244.169.49",   # the independent pool's stratum, given out by pcoin-facts
]


def _strip_public(text):
    """Remove the allow-listed endpoints before the IP rule looks at the text."""
    for a in PUBLIC_ENDPOINTS:
        text = text.replace(a, "")
    return text


FORBIDDEN = [
    (re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}\b"), "an IP address", _strip_public),
    (re.compile(r"(?i)(?<![\w/])(?:/opt/|/etc/|/var/lib/|/usr/local/|/var/www/)"), "a server path"),  # \b NEVER MATCHED HERE: there is no word boundary between a space and a slash, so this rule only ever fired on the useless case (a/opt/x) and missed every real one (it is in /opt/x). Broken in all 11 backups; found 2026-09-17 by a test that asserted the rule FIRES, rather than one that asserted an answer passed.
    (re.compile(r"(?i)\b(systemctl|journalctl|ssh\s+root|sudo\s|crontab|docker\s|pm2\s)"), "a server command"),
    (re.compile(r"(?i)\b(bearer\s+[\w\-.]{12,}|api[_-]?key\s*[:=]|token\s*[:=])"), "a credential"),
    (re.compile(r"(?i)\b(seed phrase|recovery phrase)\b.{0,40}\b(is|:)\s*\w+\s+\w+\s+\w+"), "a phrase"),

    # --- added 2026-09-13, rule 7: never describe how any of this is run ---
    # A PCN address handed out by a chat bot is the oldest scam in the business,
    # and a wrong one is money gone for ever. The same argument applies exactly
    # to a BEP-20 contract address, so both are blocked and the bot points at the
    # page that issues the address instead.
    (re.compile(r"\bpc1[02-9ac-hj-np-z]{20,}\b"), "a PCN address"),
    (re.compile(r"\b0x[a-fA-F0-9]{40}\b"), "a BSC address or contract"),
    # Ports that name our own services. A bare four-digit number is far too
    # common to block, so this lists the ones that actually identify something.
    # 3333 is deliberately ABSENT: it is the public stratum port, published on
    # pc.am and in the pool docs. Blocking it silently killed every mining
    # answer this bot drafted. Do not re-add it.
    (re.compile(r"(?<![\d.])(?:9443|9444|9445|9543|8787|8788|8789|8790|8791|8792|8795|50001|2019)\b"),
     "a service port"),
    (re.compile(r"(?i)\b(nginx|apache2|caddy|mariadb|mysql|postgres|sqlite|redis|"
                r"systemd|cron\b|docker|kubernetes|pm2|supervisor)\b"), "infrastructure detail"),
    (re.compile(r"(?i)\b(hetzner|netcup|contabo|digitalocean|linode|vultr|"
                r"google cloud|gcp|aws|oracle cloud)\b"), "a hosting provider"),
    (re.compile(r"(?i)\b(private key|wallet\.dat|keystore|cold wallet|hot wallet|"
                r"multisig|backup server|vault)\b"), "how funds are held"),
]


# Rates that are TRUE RIGHT NOW, filled in from pcoin-facts at the start of a
# run. Empty means we could not read them -- and then no rate may be quoted.
NL = chr(10)
LIVE_RATES = []
# The measured age of the chain tip (pcoin-facts --json, derived.last_block),
# filled in at the start of a run; None when it could not be read.
LAST_BLOCK = None
# A message that is about the chain producing blocks. Deliberately broad: a
# false match only matters during a real gap, and then it files one report.
CHAIN_WORDS = re.compile(r"\b(blocks?|stuck|stall(ed)?|halt(ed)?|frozen|no new|not moving|since last|chain (is )?(down|dead))\b", re.I)


def rate_is_live(found):
    """Is this dollar figure one we actually read from a live source just now?

    THE OLD RULE BANNED EVERY RATE, and it had to: the bot was quoting numbers
    out of its prompt, and the prompt went stale the moment an admin changed a
    setting. Now the bot is GIVEN the live figures, so the useful question is
    no longer "is this a rate" but "is this THE rate". An invented or
    remembered price is still held; the true one goes out.

    Tolerance is relative, because a model legitimately renders 0.03150784 as
    0.0315 and both are honest. It is deliberately tight -- a wrong price that
    happens to be close is still a wrong price.
    """
    if not LIVE_RATES:
        return False
    try:
        v = float(found.replace("$", "").strip())
    except ValueError:
        return False
    for good in LIVE_RATES:
        if good and abs(v - good) <= max(good * 0.02, 1e-9):
            return True
    return False


RATE_RE = re.compile(r"\$\s?0\.0\d{3,}")


def guard(text):
    """Return the reason this draft must not be posted, or None.

    THIS IS THE ENFORCEMENT, not the prompt. The prompt asks a model to behave;
    this decides what a group actually sees. Every rule that matters is stated in
    both places on purpose -- a model having a bad minute is precisely the case
    these exist for, and a rule that lives only in a prompt is a rule that holds
    right up until it is needed.
    """
    t = text or ""
    if len(t) > MAX_ANSWER_CHARS:
        # Not truncated. A reply cut off mid-sentence is worse than no reply:
        # it looks like an answer and is not one.
        return ("it ran to %d characters, over the %d-character limit for one "
                "message" % (len(t), MAX_ANSWER_CHARS))
    for found in RATE_RE.findall(text):
        if not rate_is_live(found):
            return 'a PCN rate we did not read live (%s)' % found.strip()
    for rule in FORBIDDEN:
        # A rule may carry a third element: a function that removes the
        # ALLOWED spellings before the pattern is applied. Blanking them is
        # deliberately not the same as weakening the pattern -- the rule still
        # catches every address that is not on the published list.
        rx, why = rule[0], rule[1]
        subject = rule[2](t) if len(rule) > 2 else t
        if rx.search(subject):
            return why
    return None


# ---- the model -----------------------------------------------------------
def models_for(cfg):
    """The model to try, then the one to fall back to.

    A fallback exists because this is a gateway in front of several upstream
    providers, and any one of them can be down, rate-limited or temporarily
    refusing a model while the others are fine. A bot that goes silent for a day
    because one upstream had an afternoon is worse than one that answers in a
    slightly different voice.

    Both must be models this API key can actually serve. Every Anthropic model is
    NOT one of them: the account's Claude is connected as a consumer
    subscription, which by design never passes through the gateway, so
    claude-sonnet-5 returns HTTP 400 no matter what the key is.
    """
    primary = cfg.get("OONA_MODEL", "deepseek-v4-flash").strip()
    fallback = cfg.get("OONA_MODEL_FALLBACK", "qwen3.8-flash").strip()
    out = [m for m in (primary, fallback) if m]
    return out or ["deepseek-v4-flash"]


# HOW MUCH OF THE CONVERSATION THE MODEL GETS TO SEE.
#
# It used to be one message, plus the one it formally replied to. That is not
# how a group works, and on 2026-09-20 it published the proof: somebody wrote
# "The hashrate is not displaying", then "windows11 1.4.34", then posted a
# screenshot -- and the bot answered the screenshot by asking which program and
# which version, both of which were already on the screen two messages earlier.
# It reads as not listening, because it was not.
#
# Six messages is enough for a support exchange and short enough that the
# question stays the thing being answered rather than one line in a transcript.
THREAD_CONTEXT = 6
THREAD_CONTEXT_CHARS = 220
THREAD_CONTEXT_MAX_AGE = 6 * 3600     # older than this is a different conversation


def recent_thread(row, spool=None, limit=THREAD_CONTEXT):
    """The few messages posted just before this one, in the SAME chat.

    Same chat only, and only what came before: the rule that keeps this from
    carrying one group's conversation into another, or a later message into an
    answer that could not have seen it. A gap in time ends the thread, because
    yesterday's exchange is background nobody was thinking about.
    """
    rows = spool if spool is not None else read_spool()
    chat, mid = row.get("chat"), row.get("message_id")
    date = int(row.get("date") or 0)
    out = []
    for r in rows[-400:]:
        if r.get("chat") != chat or r.get("message_id") == mid:
            continue
        rd = int(r.get("date") or 0)
        if rd > date or (date and rd and date - rd > THREAD_CONTEXT_MAX_AGE):
            continue
        body = (r.get("text") or r.get("described") or "").strip()
        if not body:
            continue
        if len(body) > THREAD_CONTEXT_CHARS:
            body = body[:THREAD_CONTEXT_CHARS].rstrip() + "..."
        out.append("%s: %s" % ((r.get("from") or "someone"), body))
    return out[-limit:]


def with_context(row, text):
    """The question, plus whatever it leans on and does not contain.

    A one-line reply and an attached screenshot are the two ways a message
    arrives incomplete while reading as though it were finished. Handing the
    model the fragment alone is what produced a confident answer about the
    wrong mining program on 2026-09-17. Absent context is stated as absent --
    never quietly omitted, because a gap the model cannot see is a gap it fills.
    """
    out = []
    thread = recent_thread(row)
    if thread:
        out.append("WHAT WAS SAID IN THIS CHAT JUST BEFORE, oldest first. This is "
                   "background, not the question -- the question is the message at the "
                   "top. Read it before you ask for anything: if the program, the "
                   "version, the platform or the address is already here, you have it "
                   "and asking again reads as not listening." + NL + NL + NL.join(thread))
    if row.get("reply_to_text"):
        out.append("This is a REPLY to an earlier message, from %s:\n%s"
                   % (row.get("reply_to_from") or "someone", row["reply_to_text"]))
    if row.get("has_image"):
        out.append("The message carries an IMAGE." if row.get("_image") else
                   "The message carries an IMAGE, and you COULD NOT BE SHOWN IT (it did "
                   "not download, or it is not a picture). Do not guess what it shows, "
                   "what software it proves they are running, or what the numbers on it "
                   "are. Ask them what it says, or say a person will look at it -- those "
                   "are both good answers. Inventing the contents is not.")
    # A TRANSACTION ID IS A QUESTION WITH AN ANSWER, so look it up rather than
    # letting the model reason about it. "Did my withdrawal fail" is the one
    # support question where guessing does the most damage: telling somebody
    # their money is gone when it is not, or that it arrived when it did not,
    # are both harm a confident sentence can do in a single line.
    #
    # The lookup is read-only and keyed on the id itself -- see pcoin-facts. It
    # cannot see who the person is and cannot reach anybody else's payout.
    for t in list(dict.fromkeys(re.findall(r"(?:0x)?[0-9a-fA-F]{64}", text or "")))[:4]:
        try:
            r = subprocess.run(["/usr/local/bin/pcoin-facts", "--txid", t],
                               capture_output=True, text=True, timeout=45)
            line = r.stdout.strip()
        except Exception:
            line = ""
        # An unreadable lookup must never become a confident answer, and must
        # not stop the rest of the reply either.
        out.append(("They mentioned transaction %s. Checked just now:" + NL + "%s") % (t, line)
                   if line else
                   "They mentioned transaction %s and it could NOT be checked just now. "
                   "Say it will be checked; do not say whether it worked." % t)

    if not out:
        return text
    return text + "\n\n--- context you did not ask for but need ---\n" + "\n\n".join(out)


def ask_model_with_fallback(cfg, system, message, author, image=None):
    """Try each model in turn. Returns (parsed, model_used).

    A model that answers with something unparseable is a FAILURE, not an answer:
    falling through to the next one is the whole point. The last error is raised
    if every model fails, so the caller still records the message as unhandled
    and retries it next run rather than losing it.
    """
    last = None
    for i, model in enumerate(models_for(cfg)):
        try:
            return ask_model(cfg, system, message, author, model, image=image), model
        except Exception as e:
            last = e
            detail = str(e) if isinstance(e, (RuntimeError, ValueError)) else type(e).__name__
            print("  model %s failed (%s)%s" % (model, detail,
                  "; falling back" if i == 0 else ""), file=sys.stderr)
    raise last if last else RuntimeError("no model configured")


def ask_model(cfg, system, message, author, model=None, image=None):
    url = cfg.get("OONA_API_URL", "https://api.oonacode.oonak.ai/v1/messages")
    key = cfg.get("OONA_API_KEY", "")
    model = model or cfg.get("OONA_MODEL", "deepseek-v4-flash")
    if not key:
        raise RuntimeError("OONA_API_KEY is not set")

    body = {
        "model": model,
        # Reasoning models spend this budget on THINKING before they emit a
        # word. At 900 the first real question came back stop_reason=max_tokens
        # with no content blocks at all -- not a malformed answer, no answer,
        # which then read as a parse failure and hid the cause entirely.
        "max_tokens": MAX_TOKENS,
        "system": system,
        "messages": [{
            "role": "user",
            # The picture goes FIRST, then the words about it: the image is part
            # of the question, not an afterthought bolted on behind the ask.
            "content": ([{"type": "image", "source": {"type": "base64",
                                                      "media_type": image[0], "data": image[1]}}] if image else []) + [
                {"type": "text", "text": (
                    "A message was just posted in the PCoin Telegram group.\n\n"
                    f"From: {author}\n"
                    f"Message: {message}\n\n"
                    + ("The image above is what they attached. Read it carefully and answer "
                       "from what is ACTUALLY visible in it; say so plainly if it is too "
                       "small, cropped or blurry to read.\n\n" if image else "")
                    + "Decide whether to answer it. Reply with the JSON object described "
                      "in your instructions and nothing else.")},
            ],
        }],
    }
    req = urllib.request.Request(
        url, data=json.dumps(body).encode(),
        headers={"content-type": "application/json",
                 "x-api-key": key,
                 "anthropic-version": "2023-06-01"},
        method="POST")
    with urllib.request.urlopen(req, timeout=120) as r:
        j = json.loads(r.read().decode())

    parts = [b.get("text", "") for b in j.get("content", []) if b.get("type") == "text"]
    raw = "\n".join(parts).strip()
    if not raw:
        raise RuntimeError(
            "model returned no text (stop_reason=%s, output_tokens=%s) -- raise "
            "ANSWER_MAX_TOKENS" % (j.get("stop_reason"),
                                   (j.get("usage") or {}).get("output_tokens")))
    # The model is asked for bare JSON but may fence it. Take the first object.
    m = re.search(r"\{.*\}", raw, re.S)
    if not m:
        raise RuntimeError("model did not return JSON: " + raw[:200])
    return json.loads(m.group(0))


