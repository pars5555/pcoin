ACTIONS_MAX = 400


def act(**row):
    """Append one action. Best-effort: failing to RECORD what happened must never
    change what happens."""
    try:
        row["at"] = int(time.time())
        os.makedirs(os.path.dirname(ACTIONS), exist_ok=True)
        lines = []
        if os.path.exists(ACTIONS):
            with open(ACTIONS, encoding="utf-8") as fh:
                lines = fh.readlines()[-(ACTIONS_MAX - 1):]
        lines.append(json.dumps(row, ensure_ascii=False) + "\n")
        tmp = ACTIONS + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.writelines(lines)
        os.replace(tmp, ACTIONS)
    except Exception:
        pass
def _groups_conf(path="/etc/pcoin/groups.conf"):
    """Chat ids from a file the PROGRAM reads, not only from systemd.

    CLAUDE.md 7.14: a script configured by its unit file is a different program
    when run by hand. Set through an EnvironmentFile alone, `--status` reported
    the test group as unconfigured while the service had it -- the same shape as
    the false 50,000 PCN wrap alert that came from a bare run losing its floor.
    The environment still wins where it is set, so a one-off override works.
    """
    out = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return out


