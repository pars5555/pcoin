def discord_channel_ids(path="/etc/pcoin/discord.conf"):
    """Only the two channel ids. The token in the same file is not read here:
    this program never posts to Discord, the gate does."""
    out = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                k, _, v = line.strip().partition("=")
                if k.strip() in ("DISCORD_CHAT_CHANNEL_ID", "DISCORD_TEST_CHANNEL_ID"):
                    out[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return out


# ── LOOKING AT WHAT PEOPLE SEND ───────────────────────────────────────────────
#
# Owner, 2026-09-20: "fix the agent capability to see the users images ... but
# never run any file on the server, only view images."
#
# So this FETCHES BYTES AND LOOKS AT THEM, and does nothing else with them:
#   * only two hosts are allowed -- Telegram's file API and Discord's CDN. A URL
#     from anywhere else is refused, so nothing here can be pointed at an
#     internal address;
#   * the type is decided by the file's OWN FIRST BYTES, never by its name, its
#     extension or the content_type the sender supplied;
#   * anything that is not a PNG, JPEG, GIF or WebP is dropped;
#   * there is a hard size cap and a short timeout;
#   * the bytes stay in memory and are base64'd straight into the model request.
#     Nothing is written to disk, so there is nothing to execute, and no code
#     path here runs a file under any circumstances.
IMAGE_MAX_BYTES = 5 * 1024 * 1024
IMAGE_HOSTS = ("api.telegram.org", "cdn.discordapp.com", "media.discordapp.net")


def sniff_image(b):
    """The media type from the bytes themselves, or None. A .png that is really
    something else is not an image, whatever it is called."""
    if b[:8] == b"\x89PNG\r\n\x1a\n":
        return "image/png"
    if b[:3] == b"\xff\xd8\xff":
        return "image/jpeg"
    if b[:6] in (b"GIF87a", b"GIF89a"):
        return "image/gif"
    if b[:4] == b"RIFF" and b[8:12] == b"WEBP":
        return "image/webp"
    return None


def _get_bytes(url, limit=IMAGE_MAX_BYTES, timeout=20):
    host = ""
    try:
        parts = urllib.parse.urlsplit(url)
        host = parts.hostname or ""
    except ValueError:
        return None
    if parts.scheme != "https" or host not in IMAGE_HOSTS:
        return None
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            # read one byte past the cap: a file AT the cap is fine, one over it
            # is refused rather than silently truncated into a corrupt image.
            b = r.read(limit + 1)
    except Exception:
        return None
    return None if len(b) > limit else b


def fetch_image(row, cfg):
    """(media_type, base64) for the picture on this message, or None.

    None every time anything is not right -- unknown host, wrong bytes, too
    big, no answer. A missing image means the model is told it cannot see one,
    which is the behaviour this replaces and remains the safe fallback."""
    url = None
    if row.get("image_url"):
        url = str(row["image_url"])
    elif row.get("file_id"):
        # The bot token lives in alert.conf, not in this agent's own config --
        # the same place every other Telegram call here reads it from.
        token = cfg.get("TELEGRAM_TOKEN") or conf(ALERT_CONF).get("TELEGRAM_TOKEN", "")
        if not token:
            return None
        meta = _get_bytes("https://api.telegram.org/bot%s/getFile?file_id=%s"
                          % (token, urllib.parse.quote(str(row["file_id"]))), limit=64 * 1024)
        if not meta:
            return None
        try:
            path = json.loads(meta.decode())["result"]["file_path"]
        except Exception:
            return None
        url = "https://api.telegram.org/file/bot%s/%s" % (token, path)
    if not url:
        return None
    b = _get_bytes(url)
    if not b:
        return None
    mt = sniff_image(b)
    if not mt:
        return None
    return mt, base64.b64encode(b).decode()


# Telegram carries a photo's words in `caption`, which the watcher renders into
# `described` as "a photo: <caption>". These are the labels it uses when there is
# no caption at all -- those really are nothing to answer.
MEDIA_ONLY = {"a photo", "a file", "a video", "a voice message", "a sticker",
              "a GIF", "audio"}


def askable_text(r):
    """What the person actually asked, whether they typed it or captioned it.

    Returns "" only when there is genuinely nothing to answer: a bare image with
    no caption, a join/leave line, or something the watcher could not render.

    The "a photo: " prefix is kept on purpose: the model is now shown the image
    when one can be fetched, and the caption is still what the person WROTE.

    A bare photo with no caption used to be unanswerable and is not any more --
    somebody posting a screenshot of an error is asking about it. Stickers,
    voice notes, videos and GIFs stay unanswerable whatever is attached: those
    are not questions, and answering them is noise.
    """
    t = (r.get("text") or "").strip()
    if t:
        return t
    d = (r.get("described") or "").strip()
    if d == "a photo" and r.get("has_image"):
        return "(a screenshot with no caption)"
    if not d or d.startswith("[") or d in MEDIA_ONLY:
        return ""
    return d


def dest_for(chat):
    """Which approval destination a message from `chat` may be answered into.

    Returns None for anything unrecognised, and the caller then does not answer
    at all. Fail closed: an unknown chat is not a reason to guess, and guessing
    means a reply landing in a group it was never meant for.

    A row with NO chat id predates this function. Those can only have come from
    the one group that existed then, so they map to it -- stated here rather
    than left implicit, because it is an assumption and assumptions rot.
    """
    if chat is None:
        return "group"
    if isinstance(chat, str) and chat.startswith("discord:"):
        ch = chat.split(":", 1)[1]
        ids = discord_channel_ids()
        if ch and ch == ids.get("DISCORD_CHAT_CHANNEL_ID"):
            return "dcchat"
        if ch and ch == ids.get("DISCORD_TEST_CHANNEL_ID"):
            return "dctest"
        # Anywhere else in the guild: answer where the question was asked. The id
        # is passed on as a NAME and pcoin-approve checks with Discord that the
        # channel is ours before posting -- this script cannot reach a chat
        # outside the guild however this line is rewritten, and the owner's
        # Telegram Confirm is still what publishes it.
        if ch.isdigit() and 15 <= len(ch) <= 25:
            return "dc:" + ch
        return None
    try:
        chat = int(chat)
    except (TypeError, ValueError):
        return None
    if chat == GROUP_ID:
        return "group"
    if TEST_GROUP_ID and chat == TEST_GROUP_ID:
        return "testgroup"
    return None

