#!/usr/bin/env python3
"""Is every public PCoin surface actually answering? Ask all of them, from outside.

WHY THIS EXISTS

explorer.pc.am returned 502 for ninety minutes on 2026-09-18 and the first
anyone heard of it was a user in the Telegram group, followed by a second in
Discord. Ten monitors were running on that host and every one was green, because
each of them CONSUMED the explorer and correctly modelled an unreadable source
as "I could not check" rather than "it is down". That doctrine is right and it
leaves a hole: the thing everything reads had no monitor of its own.

pcoin-explorer-watch closed that hole for one service. This closes it for the
rest, because the same reasoning applies to every one of them -- price.pc.am is
read by six payment rails, market.pc.am takes money, exchange.pc.am holds
customer balances, and nothing was asking whether any of them answers.

WHY A STATUS CODE IS NOT ENOUGH

The explorer outage would have been caught by a plain 200 check, but the more
common failure is worse: a service that answers 200 with a broken body. A
stalled index answers 200. A price oracle with a dead upstream answers 200 and
serves a null. So every service here declares something that must be TRUE of the
response -- a JSON key that must exist, or a string that must appear. "It
responded" and "it works" are different claims and only the second one matters.

WHAT IT DELIBERATELY DOES NOT DO

It does not restart anything. The 2026-09-18 remedy was a restart, and a monitor
that restarts on its own would have hidden the cause -- a third-party client in
a retry loop, still running afterwards. Alert, name the likely cause, let a human
decide.

Conventions match the rest of contrib/seed-monitoring: decide WHAT is wrong, exit
non-zero, and let OnFailure= + pcoin-notify decide where that goes. No credential
lives here and every endpoint checked is public.
"""
import base64
import datetime
import hashlib
import json
import math
import os
import re
import ssl
import sys
import time
import urllib.error
import urllib.request

# name, url, and what must be true of the body.
#   key=...            a dotted path that must exist and be non-null in the JSON
#   has=...            a substring that must appear in the text
#   expires_field=...  a header-style "Name: <iso date>" line in the body that
#                      must not be expired or within expires_warn_days (30)
#   csp_hash=True      every inline <script> must hash to a value the page's
#                      own Content-Security-Policy header lists
# A service with neither is checked for status only, which is the weakest form
# and is used where there is no machine-readable surface to assert on.
SERVICES = [
    ("pc.am",          "https://pc.am/",                        {"has": "PCoin"}),
    ("explorer",       "https://explorer.pc.am/api/status",     {"key": "chain.height"}),
    ("explorer3",      "https://explorer3.pc.am/",              {}),
    ("market",         "https://market.pc.am/api/ladder/state", {"key": "marginalPrice"}),
    ("price",          "https://price.pc.am/",                  {"key": "sellPriceUsd"}),
    ("exchange",       "https://exchange.pc.am/api/public",     {"key": "limits.minOrderUsd"}),
    ("wrapdesk",       "https://wrapdesk.pc.am/proof",          {"has": "Proof of backing"}),
    ("docs",           "https://docs.pc.am/",                   {}),
    ("pool",           "https://pool.pc.am/",                   {}),
    ("pcnearner",      "https://pcnearner.pc.am/",              {}),
    ("webai",          "https://webai.pc.am/",                  {}),
    ("checker",        "https://checker.pc.am/",                {}),
    # THE THREE RAILS ON ai-bots (116.203.221.42), ADDED 2026-09-20 AFTER THE
    # HOST WAS DOWN FOR HOURS AND NOTHING SAID SO.
    #
    # They were watched only by a pcoin-deposit-watch cron ON THAT SAME HOST, so
    # the watcher died with the thing it was watching and its silence was
    # indistinguishable from health. The outage was found by a USER in the
    # group, who was told twice by the answer bot that "a person will look at
    # it" -- and no person had been told anything.
    #
    # aicontrol also drives the three Windows miners, so when this box is down
    # the fleet is unreachable too, which is worth an alert on its own.
    # webcrafterai.com is @MyWebsiteBuilderBot's own surface: the bot is on
    # Telegram and has no URL of its own, and asking Telegram about it would
    # test Telegram rather than us.
    ("aicontrol",      "https://aicontrol.pc.am/",              {}),
    ("webbuilderbot",  "https://webcrafterai.com/",             {}),
    ("3dmodels",       "https://3dmodels.pc.am/",               {}),
    # NOT A SERVICE -- a PROMISE with a date on it, watched for the same reason
    # everything else here is. Nothing renews security.txt and nothing ever
    # will, so an expiry alarm is the only thing that can stop it rotting into
    # a file that tells a researcher the project is abandoned, which is the
    # exact outcome it exists to prevent. See the expires_field branch below.
    ("security.txt",   "https://pc.am/.well-known/security.txt",
                                                {"expires_field": "Expires"}),
    # THE TWO PAGES WHOSE INLINE SCRIPT IS PINNED BY HASH IN THE CSP. Change
    # the script without recomputing the hash and the browser stops running
    # it -- the page renders and does nothing, which no status check can see.
    ("pc.am/pay",      "https://pc.am/pay/",      {"csp_hash": True}),
    ("pc.am/app",      "https://pc.am/app/",      {"csp_hash": True}),
]

TIMEOUT = float(os.environ.get("SERVICE_TIMEOUT", "20"))
# Consecutive bad rounds before escalating. At a 5-minute timer, 2 means a
# service has to be bad for ~10 minutes. Caddy on 178.105.3.51 is bounced ~11
# times a day by another project's watchdog, so a single blip is not an outage.
FAIL_LIMIT = int(os.environ.get("SERVICE_FAIL_LIMIT", "2"))
STATE = os.environ.get("SERVICE_STATE", "/var/lib/pcoin-service-watch/state.json")
ONLY = [s for s in os.environ.get("SERVICE_ONLY", "").split(",") if s]


def dig(obj, path):
    """Follow a dotted path. Returns None when any step is missing, which is the
    same as the key being null -- both mean the body did not carry the fact."""
    cur = obj
    for part in path.split("."):
        if not isinstance(cur, dict) or part not in cur:
            return None
        cur = cur[part]
    return cur


def probe(url, want):
    """(ok, detail). ok=False means this service is bad, and detail says how."""
    req = urllib.request.Request(url, headers={"User-Agent": "pcoin-service-watch"})
    try:
        # Certificate verification stays ON. An expired certificate takes a
        # service off the internet just as surely as a dead process, and is
        # exactly the kind of thing that fails quietly at 3am.
        with urllib.request.urlopen(req, timeout=TIMEOUT,
                                    context=ssl.create_default_context()) as r:
            body = r.read(400_000).decode("utf-8", "replace")
            code = r.getcode()
            hdrs = r.headers
    except urllib.error.HTTPError as e:
        return False, "HTTP %s" % e.code
    except Exception as e:
        return False, "unreachable (%s)" % type(e).__name__

    if code != 200:
        return False, "HTTP %s" % code
    if "has" in want and want["has"] not in body:
        return False, "answered 200 but %r is missing from the page" % want["has"]
    if "key" in want:
        try:
            d = json.loads(body)
        except Exception:
            return False, "answered 200 but the body is not JSON"
        v = dig(d, want["key"])
        if v is None:
            return False, "answered 200 but %s is missing or null" % want["key"]
        return True, "%s=%s" % (want["key"], str(v)[:24])
    if want.get("csp_hash"):
        # pc.am's CSP pins each inline <script> BY HASH instead of allowing
        # 'unsafe-inline', which is what keeps /pay/ -- the page that builds a
        # payment URI from location.search -- strict. The cost is that the hash
        # and the script must move together: edit the script without
        # recomputing and the browser silently stops executing it. The page
        # still renders, and simply does nothing.
        #
        # Nothing about that is visible to a status check, so this recomputes
        # the hash from the page the public actually gets and asserts the live
        # header still lists it. Recompute with contrib/deploy/csp-hashes.py.
        csp = hdrs.get("Content-Security-Policy") or ""
        if not csp:
            return False, ("answered 200 but sends NO Content-Security-Policy -- "
                           "the vhost header is gone or Apache was not reloaded")
        found = re.findall(r"<script>(.*?)</script>", body, re.S)
        if not found:
            return False, "answered 200 but has no inline <script>; the page changed shape"
        for src in found:
            h = "'sha256-%s'" % base64.b64encode(
                hashlib.sha256(src.encode("utf-8")).digest()).decode()
            if h not in csp:
                return False, (f"its inline script hashes to {h}, which the live CSP "
                               f"does NOT list -- the script will not execute. "
                               f"Recompute with contrib/deploy/csp-hashes.py")
        return True, "%d inline script(s), all hashed in the CSP" % len(found)
    if "expires_field" in want:
        # A DATE INSIDE THE BODY, not a certificate date. RFC 9116 makes
        # Expires mandatory in security.txt, and an expired one reads as an
        # abandoned project -- a researcher who sees it goes public instead of
        # writing to us, which is the exact outcome the file exists to avoid.
        #
        # Nothing renews it automatically and nothing ever will, so the only
        # thing that can stop it rotting is something that complains first.
        # This is the same class as the pc.am price and the fairness figure
        # (CLAUDE.md 8b): a promise on a public page with no expiry alarm.
        m = re.search(r"^%s:\s*(\S+)" % re.escape(want["expires_field"]),
                      body, re.M | re.I)
        if not m:
            return False, "answered 200 but has no %s: field" % want["expires_field"]
        try:
            # Accept the trailing Z that RFC 9116's examples use; fromisoformat
            # only learned it in 3.11 and these hosts are mixed.
            when = datetime.datetime.fromisoformat(
                m.group(1).replace("Z", "+00:00"))
        except ValueError:
            return False, "%s: %r is not a date I can read" % (
                want["expires_field"], m.group(1)[:32])
        # Rounded UP, not truncated. timedelta.days floors, so a file expiring
        # in exactly 31 days reads as 30 the instant any time has passed and
        # alerts a day early -- harmless, but it makes the threshold mean
        # something other than what it says, and a threshold nobody can predict
        # is one people learn to ignore.
        left = (when - datetime.datetime.now(datetime.timezone.utc)).total_seconds()
        days = int(math.ceil(left / 86400.0))
        if days < 0:
            return False, "EXPIRED %d days ago (%s) -- renew it" % (-days, m.group(1))
        if days <= int(want.get("expires_warn_days", 30)):
            return False, "expires in %d days (%s) -- renew it" % (days, m.group(1))
        return True, "expires in %d days" % days
    return True, "200"


def load_state():
    try:
        with open(STATE, encoding="utf-8") as fh:
            s = json.load(fh)
    except Exception:
        s = {}
    # Normalise rather than only handling an unreadable file: a state file that
    # PARSES but lacks a key is how pcoin-wrapdesk-watch died on a fresh install.
    if not isinstance(s, dict):
        s = {}
    s.setdefault("streak", {})
    s.setdefault("last_alert", "")
    return s


def save_state(s):
    try:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        tmp = STATE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(s, fh, indent=1)
        os.replace(tmp, STATE)
    except Exception as e:
        print("  (state not written: %s)" % e)


def main():
    dry = "--dry-run" in sys.argv
    st = load_state()
    bad, good = [], []

    for name, url, want in SERVICES:
        if ONLY and name not in ONLY:
            continue
        ok, detail = probe(url, want)
        if ok:
            st["streak"][name] = 0
            good.append(name)
            print("  %-12s ok    %s" % (name, detail))
        else:
            n = st["streak"].get(name, 0) + 1
            st["streak"][name] = n
            print("  %-12s BAD   %s  (%d/%d)" % (name, detail, n, FAIL_LIMIT))
            if n >= FAIL_LIMIT:
                bad.append((name, url, detail, n))

    if bad:
        lines = ["%d of %d PCoin services are not answering:" % (len(bad), len(good) + len(bad))]
        for name, url, detail, n in bad:
            lines.append("  * %-11s %s" % (name, detail))
            lines.append("    %s  (failing %d checks in a row)" % (url, n))
        lines.append("")
        lines.append("Healthy: %s" % (", ".join(good) or "none"))
        lines.append("")
        # The 2026-09-18 shape, written down so whoever is woken does not have to
        # rediscover it: the process was ALIVE and systemctl said active.
        lines.append("A service can be 'active' and still refuse connections -- on 2026-09-18")
        lines.append("the explorer's accept queue was full (ss -lnt showed Recv-Q above the")
        lines.append("backlog) while the unit looked perfectly healthy. Check the queue before")
        lines.append("concluding the process is fine, and find what filled it before calling")
        lines.append("it fixed.")
        text = "\n".join(lines)
        fp = "|".join(sorted(n for n, _, _, _ in bad))
        print()
        print(text)
        if dry:
            print("\n  (dry run: nothing sent)")
        elif st["last_alert"] != fp:
            st["last_alert"] = fp
        else:
            print("\n  (same services as the last run - not re-sending)")
        if not dry:
            save_state(st)
        return 1

    print("all %d services are answering" % len(good))
    if st["last_alert"] not in ("", "ok"):
        print("  (recovered)")
    st["last_alert"] = "ok"
    if not dry:
        save_state(st)
    return 0


if __name__ == "__main__":
    sys.exit(main())
