# ── plumbing ───────────────────────────────────────────────────────────────
def conf():
    out = {}
    try:
        with open(CONF, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip().strip('"').strip("'")
    except OSError as e:
        # FAIL CLOSED. No config means no token means nothing can be published,
        # and that is the correct outcome -- but say so rather than behaving as
        # though the queue were empty.
        sys.exit("cannot read %s: %s" % (CONF, e))
    return out


def api(token, method, params, files=None, timeout=40):
    """One Telegram call. Returns the parsed body; raises on transport failure.

    Multipart is hand-rolled because sending a photo needs it and this box has no
    requests module. The alternative -- shipping the photo as a URL -- would mean
    the owner approves a picture Telegram fetched from somewhere else, which is
    not the same picture.
    """
    url = "https://api.telegram.org/bot%s/%s" % (token, method)
    if files:
        boundary = "----pcoinapprove%d" % int(time.time() * 1000)
        body = b""
        for k, v in params.items():
            body += ("--%s\r\nContent-Disposition: form-data; name=\"%s\"\r\n\r\n%s\r\n"
                     % (boundary, k, v)).encode()
        for k, (fname, blob) in files.items():
            body += ("--%s\r\nContent-Disposition: form-data; name=\"%s\"; filename=\"%s\"\r\n"
                     "Content-Type: application/octet-stream\r\n\r\n" % (boundary, k, fname)).encode()
            body += blob + b"\r\n"
        body += ("--%s--\r\n" % boundary).encode()
        req = urllib.request.Request(url, data=body, method="POST")
        req.add_header("content-type", "multipart/form-data; boundary=%s" % boundary)
    else:
        req = urllib.request.Request(
            url, data=urllib.parse.urlencode(params).encode(), method="POST")
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode())


def load():
    """Read the queue. An UNREADABLE queue is not an empty queue.

    Returning {} on a parse error would silently drop every pending approval and
    look exactly like a quiet day. This is the CLAUDE.md 7.1 rule applied to the
    one file that decides whether something is published.
    """
    if not os.path.exists(QUEUE):
        return {"items": []}
    try:
        with open(QUEUE, encoding="utf-8") as fh:
            d = json.load(fh)
    except (OSError, ValueError) as e:
        sys.exit("REFUSING to act: %s is unreadable (%s). Nothing is published "
                 "while the queue cannot be read." % (QUEUE, e))
    d.setdefault("items", [])
    return d


def save(d):
    os.makedirs(os.path.dirname(QUEUE), exist_ok=True)
    tmp = QUEUE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(d, fh, indent=2)
    os.replace(tmp, QUEUE)          # atomic: an interrupted write cannot truncate it
    try:
        os.chmod(QUEUE, 0o600)
    except OSError:
        pass


# The current digest scheme. BUMP THIS whenever the set of hashed fields changes,
# and never change what an existing version covers -- an item must always be
# verifiable by the algorithm that stamped it, or a routine upgrade reads as a
# compromise. That has already happened once: parse_mode was added to the hashed
# set while an approved item was in the queue, and the gate refused to publish it
# and paged ops about tampering that had not occurred.
DIGEST_V = 2


def digest(item, version=None):
    """The bytes the owner is agreeing to, under a stated scheme version.

    v1: destination, text, caption, photo content.
    v2: the same, plus parse_mode -- because the same characters rendered as
        Markdown and as plain text are two different messages to a reader, so
        changing it after approval is as much a tamper as changing the words.

    The version is NEVER inferred from the item's contents. It is read from the
    stamp the item carries, defaulting to the current scheme, so an item cannot
    talk the verifier into using a weaker algorithm by omitting a field.
    """
    v = version if version is not None else int(item.get("digest_v") or DIGEST_V)
    parts = [item.get("dest", ""), item.get("text", ""), item.get("caption", "")]
    if v >= 2:
        parts.append(item.get("parse_mode", ""))
    h = hashlib.sha256()
    for part in parts:
        h.update(b"\x00")
        h.update(str(part).encode("utf-8"))
    h.update(b"\x00")
    h.update((item.get("photo_sha") or "").encode())
    return h.hexdigest()


def now():
    return int(time.time())


def stamp(ts):
    return time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(ts)) if ts else "-"


# Set by the selftest. A test that exercises the refusal paths would otherwise
# page the owner every time it runs, and an alert channel that carries drills is
# an alert channel people stop reading -- which is the failure this whole file is
# trying to prevent, one level up.
SELFTEST = False


def notify_ops(subject, body):
    """Best-effort ops alert. Never affects this program's exit code."""
    if SELFTEST:
        print("  (selftest: would have alerted ops -- %s)" % subject)
        return
    n = "/usr/local/bin/pcoin-notify"
    if os.access(n, os.X_OK):
        os.spawnv(os.P_NOWAIT, n, [n, subject, body])


# ── publishing, one side at a time ─────────────────────────────────────────
def tg_publish(token, dest, i):
    """The Telegram side. Returns the message id; raises on ANY failure."""
    pm = i.get("parse_mode") or ""
    if i.get("photo_b64"):
        p = {"chat_id": dest["chat"], "caption": i["text"][:MAX_CAPTION]}
        if pm:
            p["parse_mode"] = pm
        r = api(token, "sendPhoto", p,
                files={"photo": ("card.png", base64.b64decode(i["photo_b64"]))})
    else:
        p = {"chat_id": dest["chat"], "text": i["text"],
             "disable_web_page_preview": "true"}
        if pm:
            p["parse_mode"] = pm
        if i.get("reply_to"):
            p["reply_to_message_id"] = str(i["reply_to"])
        r = api(token, "sendMessage", p)
    if not r.get("ok"):
        raise ValueError(r.get("description") or "telegram said not ok")
    return (r.get("result") or {}).get("message_id")


def dc_conf():
    out = {}
    try:
        with open(DISCORD_CONF, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip().strip('"').strip("'")
    except OSError as e:
        # Raised, not exited: an unreadable Discord config fails the DISCORD
        # side of one item and must never stop Telegram publishing.
        raise ValueError("cannot read %s: %s" % (DISCORD_CONF, e))
    return out


def _escape_plain(t):
    # Plain text from a model reaches Discord as Markdown, so a stray * or _
    # would restyle it. Escape those, but never inside a URL -- a backslash in a
    # link breaks the link.
    out = []
    for tok in re.split(r"(\s+)", t):
        if not tok.strip() or "://" in tok or tok.startswith("discord.gg/"):
            out.append(tok)
        else:
            out.append(re.sub(r"([*_~|`])", r"\\\1", tok))
    return "".join(out)


def to_discord(text, parse_mode, c=None):
    """The same message, in Discord's Markdown. Never Telegram markup passed raw."""
    t = text
    if parse_mode == "HTML":
        t = re.sub(r'<a\s+href="([^"]+)"\s*>(.*?)</a>',
                   lambda m: "[%s](%s)" % (m.group(2), m.group(1)), t, flags=re.S | re.I)
        t = re.sub(r"</?(b|strong)>", "**", t, flags=re.I)
        t = re.sub(r"</?(i|em)>", "*", t, flags=re.I)
        t = re.sub(r"</?(u|ins)>", "__", t, flags=re.I)
        t = re.sub(r"</?(s|strike|del)>", "~~", t, flags=re.I)
        t = re.sub(r"</?code>", "`", t, flags=re.I)
        t = re.sub(r"</?pre>", "```", t, flags=re.I)
        t = re.sub(r"<[^>]+>", "", t)
        t = html.unescape(t)
    elif parse_mode == "Markdown":
        # Telegram legacy: *bold* _italic_. Discord: **bold** *italic*.
        t = re.sub(r"(?<![*\w])\*(?=\S)([^*\n]+?)(?<=\S)\*(?![*\w])", r"**\1**", t)
        t = re.sub(r"(?<![_\w])_(?=\S)([^_\n]+?)(?<=\S)_(?![_\w])", r"*\1*", t)
    else:
        t = _escape_plain(t)
    # allowed_mentions already stops a ping; this stops it READING as one.
    zw = chr(0x200B)
    t = t.replace("@everyone", "@" + zw + "everyone").replace("@here", "@" + zw + "here")
    chan = (c or {}).get("DISCORD_CHAT_CHANNEL_ID", "")
    if chan.isdigit():
        t = t.replace("Ask in the PCoin chat: https://t.me/PCoinPCNChat",
                      "Ask in <#%s> or on Telegram: https://t.me/PCoinPCNChat" % chan)
    return t


def dc_call(url, payload, blob=None, bot_token=None, method="POST"):
    """One Discord call. The URL of a webhook IS its credential, so no error
    raised from here may ever contain it."""
    CRLF = chr(13) + chr(10)
    headers = {"User-Agent": "DiscordBot (https://pc.am, 1.0) pcoin-approve"}
    if bot_token:
        headers["Authorization"] = "Bot " + bot_token
    if blob is not None:
        b = "----pcoindc%d" % int(time.time() * 1000)
        body = ("--" + b + CRLF + 'Content-Disposition: form-data; name="payload_json"' + CRLF
                + "Content-Type: application/json" + CRLF + CRLF).encode()
        body += json.dumps(payload).encode() + CRLF.encode()
        body += ("--" + b + CRLF + 'Content-Disposition: form-data; name="files[0]"; filename="card.png"'
                 + CRLF + "Content-Type: image/png" + CRLF + CRLF).encode()
        body += blob + CRLF.encode() + ("--" + b + "--" + CRLF).encode()
        headers["Content-Type"] = "multipart/form-data; boundary=" + b
    else:
        body = json.dumps(payload).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=body, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=40) as r:
            raw = r.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        try:
            detail = e.read().decode("utf-8", "replace")[:300]
        except Exception:
            detail = ""
        raise ValueError("Discord HTTP %d %s" % (e.code, detail))
    except urllib.error.URLError as e:
        raise ValueError("Discord unreachable (%s)" % type(e.reason).__name__)
    return json.loads(raw) if raw.strip() else {}


def dc_publish(dest, i):
    """The Discord side. Returns the message id; raises on ANY failure."""
    c = dc_conf()
    kind, key = dest["discord"].split(":", 1)
    if kind == "botid":
        # The id was derived from a spooled message, so it is INPUT. Ask Discord
        # whose channel it is; refuse anything that is not in our own guild.
        # Everything dangerous -- the ops channel, another server, a DM -- fails
        # this check, and it fails CLOSED: unreachable is not permission.
        target = key
        guild = c.get("DISCORD_GUILD_ID", "")
        tok0 = c.get("DISCORD_BOT_TOKEN", "")
        if not guild or not tok0:
            raise ValueError("DISCORD_GUILD_ID and DISCORD_BOT_TOKEN are required to post to a derived channel")
        info = dc_channel(target, tok0)
        got = str((info or {}).get("guild_id") or "")
        if got != str(guild):
            raise ValueError("channel %s is not in this guild (guild_id=%r); refusing to post"
                             % (target, got or "none"))
    else:
        target = c.get(key, "")
        if not target:
            raise ValueError("%s is not set in %s" % (key, DISCORD_CONF))
    text = to_discord(i["text"], i.get("parse_mode") or "", c)
    blob = base64.b64decode(i["photo_b64"]) if i.get("photo_b64") else None
    payload = {"allowed_mentions": {"parse": []}}
    if len(text) <= DISCORD_MAX_CONTENT:
        payload["content"] = text
    else:
        payload["embeds"] = [{"description": text[:DISCORD_MAX_EMBED], "color": 0x2DD4BF}]
    if blob is not None:
        payload["attachments"] = [{"id": 0, "filename": "card.png"}]
        if "embeds" in payload:
            payload["embeds"][0]["image"] = {"url": "attachment://card.png"}
    if kind == "webhook":
        if not target.startswith("https://discord.com/api/webhooks/"):
            raise ValueError("%s does not look like a Discord webhook URL" % key)
        r = dc_call(target + "?wait=true", payload, blob)
    elif kind in ("bot", "botid"):
        tok = c.get("DISCORD_BOT_TOKEN", "")
        if not tok:
            raise ValueError("DISCORD_BOT_TOKEN is not set in %s" % DISCORD_CONF)
        if not target.isdigit():
            raise ValueError("%s is not a channel id" % key)
        if i.get("reply_to"):
            payload["message_reference"] = {"message_id": str(i["reply_to"]),
                                            "fail_if_not_exists": False}
            payload["allowed_mentions"]["replied_user"] = True
        r = dc_call("https://discord.com/api/v10/channels/%s/messages" % target,
                    payload, blob, tok)
    else:
        raise ValueError("unknown Discord target kind %r" % kind)
    mid = (r or {}).get("id")
    if not mid:
        raise ValueError("Discord accepted the post but returned no message id")
    return mid


def publish_item(i, send_tg, send_dc):
    """Publish one CONFIRMED item to every side its destination names.

    Each side is recorded the moment it succeeds and is never sent again, so a
    retry after a half-failure re-sends only what is missing. `published` means
    every side. Returns True if the item changed.
    """
    dest = dest_of(i["dest"])
    sides = (["tg"] if dest.get("chat") else []) + (["dc"] if dest.get("discord") else [])
    changed, errors = False, []
    for side, send in (("tg", send_tg), ("dc", send_dc)):
        if side not in sides or i.get("published_%s_at" % side):
            continue
        try:
            mid = send(dest, i)
        except (urllib.error.URLError, OSError, ValueError) as e:
            errors.append("%s: %s" % ("telegram" if side == "tg" else "discord", e))
            continue
        i["published_%s_at" % side] = now()
        if side == "tg":
            i["published_message_id"] = mid
        else:
            i["published_dc_id"] = mid
        changed = True
        print("published %s -> %s on %s (message %s)"
              % (i["id"], i["dest"], "telegram" if side == "tg" else "discord", mid))
    if all(i.get("published_%s_at" % sd) for sd in sides):
        i["state"] = "published"
        i["published_at"] = now()
        # The bytes are kept until EVERY side has them; clearing them after the
        # first side would leave the retry nothing to send.
        i["photo_b64"] = None
        i["error"] = None
        return True
    if errors:
        i["error"] = "publish failed: " + "; ".join(errors)
        changed = True
        print("publish incomplete for %s: %s" % (i["id"], i["error"]))
        done = [i["published_%s_at" % sd] for sd in sides if i.get("published_%s_at" % sd)]
        if done and not i.get("asym_alerted") and now() - min(done) >= DISCORD_ALERT_AFTER:
            i["asym_alerted"] = now()
            notify_ops("posted on ONE platform only",
                       "Item %s (%s) is live on one platform and has failed on the other "
                       "for %d min: %s. It keeps retrying the missing side only; nothing "
                       "will be posted twice." % (i["id"], i["dest"],
                                                  (now() - min(done)) // 60, i["error"]))
    return changed


# ── commands ───────────────────────────────────────────────────────────────
def cmd_submit(a):
    if dest_of(a.dest) is None:
        sys.exit("unknown destination %r. Allowed: %s, or dc:<channel id> for a reply "
                 "in the Discord channel a question was asked in."
                 % (a.dest, ", ".join(sorted(DESTS))))

    text = a.text or ""
    if a.photo and len(text) > MAX_CAPTION:
        sys.exit("a photo caption is capped at %d characters by Telegram and this is %d. "
                 "Split it: photo plus short caption, then the full text as a second "
                 "message." % (MAX_CAPTION, len(text)))
    if not a.photo and len(text) > MAX_TEXT:
        sys.exit("text is %d characters; the limit here is %d." % (len(text), MAX_TEXT))
    if not text.strip():
        sys.exit("refusing to queue an empty message.")
    if not dest_of(a.dest).get("chat") and len(text) > DISCORD_MAX_CONTENT:
        sys.exit("text is %d characters; a Discord-only reply is capped at %d."
                 % (len(text), DISCORD_MAX_CONTENT))

    photo_sha, photo_b64 = None, None
    if a.photo:
        try:
            with open(a.photo, "rb") as fh:
                blob = fh.read()
        except OSError as e:
            sys.exit("cannot read photo %s: %s" % (a.photo, e))
        if len(blob) > 8 * 1024 * 1024:
            sys.exit("photo is %.1f MB; Telegram's own limit is 10 MB and this refuses "
                     "above 8." % (len(blob) / 1048576))
        photo_sha = hashlib.sha256(blob).hexdigest()
        # Carried IN the queue, not as a path. A path is a promise about a file
        # that may be edited, moved or deleted between approval and publication;
        # the bytes cannot be.
        photo_b64 = base64.b64encode(blob).decode()

    d = load()
    pending = [i for i in d["items"] if i["state"] in ("pending", "awaiting")]
    if len(pending) >= MAX_PENDING:
        notify_ops("approval queue FULL",
                   "%d items are waiting for the owner and a new submission from %s was "
                   "REFUSED. A process submitting faster than a human can approve is the "
                   "flooding case this cap exists for. Nothing was published."
                   % (len(pending), a.source or "unknown"))
        sys.exit("REFUSED: %d items already awaiting approval (cap %d)." % (len(pending), MAX_PENDING))

    # Idempotency: the same key never queues twice. pcoin-announce already works
    # this way, and a retry after a lost response must not ask the owner twice.
    if a.key:
        for i in d["items"]:
            if i.get("key") == a.key and i["state"] not in ("cancelled", "expired", "failed"):
                print("already queued as %s (state %s); nothing new submitted" % (i["id"], i["state"]))
                return 0

    item = {
        "id": hashlib.sha256(("%s%s%s" % (now(), text, a.dest)).encode()).hexdigest()[:12],
        "created": now(),
        "source": a.source or os.environ.get("APPROVE_SOURCE") or "unknown",
        "dest": a.dest,
        "text": text,
        "caption": a.caption or "",
        "reply_to": a.reply_to or "",
        "key": a.key or "",
        # Empty means plain text. pcoin-announce sends Markdown; the group answer
        # bot deliberately does not, because a model composing Markdown that has
        # to balance is a model that will eventually emit a lone asterisk and
        # have its message refused by Telegram.
        "parse_mode": ("Markdown" if getattr(a, "markdown", False) else ""),
        "photo_b64": photo_b64,
        "photo_sha": photo_sha,
        "state": "pending",
        "dm_message_id": None,
        "decided_at": None,
        "decided_by": None,
        "published_at": None,
        "published_message_id": None,
        "error": None,
    }
    item["digest_v"] = DIGEST_V
    item["digest"] = digest(item, DIGEST_V)
    d["items"].append(item)
    save(d)
    print(item["id"])
    return 0


def keyboard(item_id):
    return json.dumps({"inline_keyboard": [[
        {"text": "✅ Confirm — publish it", "callback_data": "pa:%s:c" % item_id},
        {"text": "❌ Cancel", "callback_data": "pa:%s:x" % item_id},
    ]]})


def update_prompt(item, note=None):
    """Rewrite the Telegram prompt so it shows the outcome and loses its buttons.

    Called from the ONE function every decision route goes through, plus the
    auto-deliver path. It used to be done by each caller, so a decision made any
    other way left a live "APPROVAL NEEDED" with working buttons for something
    already settled -- which invites a press that does nothing and makes the DM
    an unreliable record of what is outstanding.

    Cosmetic by construction: it must never turn a recorded decision into a
    failure, so every error is swallowed after the state has been saved.
    """
    if not item.get("dm_message_id"):
        return
    if note is None:
        note = ("CONFIRMED - publishing now." if item["state"] == "confirmed"
                else "CANCELLED - nothing will be published.")
    try:
        tok = conf().get("TELEGRAM_TOKEN", "")
        if not tok:
            return
        api(tok, "editMessageText", {
            "chat_id": str(OWNER),
            "message_id": str(item["dm_message_id"]),
            "text": note + NL + "item " + str(item["id"]),
        }, timeout=10)
    except Exception as e:
        print("  (could not update the Telegram prompt: %s)" % type(e).__name__)


def cmd_tick(a):
    """One step of the gate. Run from a timer.

    Order matters: expire first, then ask, then publish. Expiring first means an
    item that aged out while the daemon was down can never be published by the
    tick that notices it.
    """
    c = conf()
    token = c.get("TELEGRAM_TOKEN")
    if not token:
        sys.exit("no TELEGRAM_TOKEN in %s -- refusing to do anything." % CONF)

    d = load()
    changed = False

    # ---- auto-deliver ----------------------------------------------------
    # BEFORE expiry, deliberately: an item that has been waiting long enough to
    # auto-deliver has, by definition, been waiting a while, and the two windows
    # must not race. It is recorded as auto and NEVER merged with a real
    # approval -- the day somebody asks who approved a particular post, that
    # distinction is the whole answer.
    if AUTO_DELIVER_SECONDS > 0:
        for i in d["items"]:
            if i["state"] != "awaiting":
                continue
            waited = now() - int(i.get("dm_at") or i["created"])
            if waited < AUTO_DELIVER_SECONDS:
                continue
            i["state"] = "confirmed"
            i["decided_at"] = now()
            i["decided_by"] = "auto after %d min, NOT reviewed" % (AUTO_DELIVER_SECONDS // 60)
            changed = True
            print("auto-delivering %s -> %s (waited %d s undecided)"
                  % (i["id"], i["dest"], waited))
            update_prompt(i, note=("NO DECISION IN %d MINUTES - publishing anyway."
                                   % (AUTO_DELIVER_SECONDS // 60)))

    # ---- expire ----------------------------------------------------------
    for i in d["items"]:
        if i["state"] in ("pending", "awaiting", "confirmed"):
            age_h = (now() - i["created"]) / 3600.0
            if age_h > EXPIRE_HOURS:
                i["state"] = "expired"
                i["error"] = "not decided within %g hours" % EXPIRE_HOURS
                changed = True
                print("expired %s (%s, age %.1f h)" % (i["id"], i["dest"], age_h))

    # ---- ask -------------------------------------------------------------
    for i in d["items"]:
        if i["state"] != "pending":
            continue
        dest = dest_of(i["dest"])
        if dest.get("auto") or i.get("source") in AUTO_SOURCES:
            # Straight to confirmed, and recorded as such. It still goes through
            # publish, so it is still hash-checked against what was submitted --
            # automatic means nobody is ASKED, not that nothing is verified.
            i["state"] = "confirmed"
            i["decided_at"] = now()
            i["decided_by"] = ("auto (test destination)" if dest.get("auto")
                               else "auto (fixed template from %s, no review asked)"
                                    % i.get("source"))
            changed = True
            print("auto-confirmed %s -> %s" % (i["id"], i["dest"]))
            continue
        header = ("⚠️ APPROVAL NEEDED\n"
                  "Destination: %s\nFrom: %s\nQueued: %s\n"
                  "──────────\n"
                  % (dest["label"], i["source"], stamp(i["created"])))
        try:
            # The REAL thing first -- the exact photo and the exact words that
            # will be published -- so what is approved is what goes out, never a
            # description of it. Then the buttons underneath.
            # The preview MUST render exactly as the publication will, which
            # means the same parse_mode. A preview that renders differently from
            # the post is worse than no preview: it is a preview of something
            # that will not be published.
            pm = i.get("parse_mode") or ""
            body = ""
            if i.get("photo_b64"):
                # A picture stays its own message -- a caption is capped at
                # 1,024 characters and the picture IS what is being approved.
                # The prompt then SAYS which bubble he is agreeing to rather
                # than leaving him to work it out.
                p = {"chat_id": str(OWNER), "caption": i["text"][:MAX_CAPTION]}
                if pm:
                    p["parse_mode"] = pm
                api(token, "sendPhoto", p,
                    files={"photo": ("card.png", base64.b64decode(i["photo_b64"]))})
                body = "The picture above, with that caption, is what will be published." + NL + NL
            else:
                # ONE MESSAGE: header, the full text, then the buttons.
                # Telegram caps a message at 4,096 and a submission at 3,900, so
                # this fits almost always. When it does not, fall back to two
                # messages and say which one is the message.
                tail = NL + "----------" + NL + "Publish this to %s?" % dest["label"]
                if len(header + i["text"] + tail) <= 4000:
                    body = i["text"] + NL + "----------" + NL
                else:
                    p = {"chat_id": str(OWNER), "text": i["text"],
                         "disable_web_page_preview": "true"}
                    if pm:
                        p["parse_mode"] = pm
                    api(token, "sendMessage", p)
                    body = ("The message above is what will be published -- it was "
                            "too long to include here." + NL + NL)
            r = api(token, "sendMessage", {
                "chat_id": str(OWNER),
                "text": header + body + "Publish this to %s?" % dest["label"],
                "reply_markup": keyboard(i["id"]),
                "disable_web_page_preview": "true",
            })
            i["dm_message_id"] = (r.get("result") or {}).get("message_id")
            # WHEN HE WAS ASKED, not when it was queued. The auto-deliver window
            # must start from the moment the question reached him: if the gate
            # was down for an hour, the message he has only just seen must still
            # get its full window rather than publishing itself immediately.
            i["dm_at"] = now()
            i["state"] = "awaiting"
            changed = True
            print("asked %s -> %s" % (i["id"], i["dest"]))
        except (urllib.error.URLError, OSError, ValueError) as e:
            # Stays `pending`. A failed ask resolves nothing and the next tick
            # retries; it must never fall through to publishing.
            i["error"] = "could not ask: %s" % e
            changed = True
            print("could not ask %s: %s" % (i["id"], e))

    # ---- publish ---------------------------------------------------------
    for i in d["items"]:
        if i["state"] != "confirmed":
            continue
        dd = dest_of(i["dest"]) or {}
        if not (dd.get("chat") or dd.get("discord")):
            # A destination in the allow-list with no chat id configured. Refuse
            # rather than send nowhere: an empty chat_id would make Telegram
            # error and the item would look undeliverable for a reason nobody
            # could read.
            i["state"] = "failed"
            i["error"] = ("destination %r has no chat id configured on this host"
                          % i["dest"])
            changed = True
            print("REFUSED %s: %s" % (i["id"], i["error"]))
            continue
        if digest(i) != i.get("digest"):
            # Before calling this a compromise, rule out the boring explanation:
            # this gate was upgraded and the item was stamped by an older scheme.
            # An OLDER scheme matching proves the content is byte-identical to
            # what was approved -- it is only the set of fields covered that
            # moved.
            stale_scheme = any(digest(i, v) == i.get("digest")
                               for v in range(1, DIGEST_V))
            if stale_scheme:
                # Content unchanged, but what it covers has. The owner approved a
                # rendering as well as a string, so this is re-ASKED rather than
                # published or failed. Back to pending; he sees it again with the
                # current scheme stamped on it.
                i["digest_v"] = DIGEST_V
                i["digest"] = digest(i, DIGEST_V)
                i["state"] = "pending"
                i["dm_message_id"] = None
                i["decided_at"] = None
                i["decided_by"] = None
                i["error"] = ("the approval gate was upgraded after you approved this, so "
                              "it is being shown to you again. The words did not change.")
                changed = True
                print("re-asking %s: digest scheme upgraded, content unchanged" % i["id"])
                continue
            # Not a scheme change. Something edited an item AFTER it was
            # approved -- the exact move a compromised or malfunctioning process
            # would make, and the reason this hash exists.
            i["state"] = "failed"
            i["error"] = "CONTENT CHANGED AFTER APPROVAL -- refused"
            changed = True
            notify_ops("approval gate REFUSED a tampered item",
                       "Item %s was approved and then its content changed before it "
                       "could be published. It was NOT published. This should never "
                       "happen; treat it as a compromise until shown otherwise." % i["id"])
            print("REFUSED %s: content changed after approval" % i["id"])
            continue
        if publish_item(i, lambda dst, it: tg_publish(token, dst, it), dc_publish):
            changed = True

    if changed:
        save(d)
    return 0


def cmd_decide(a):
    """Record the owner's decision. Called by pcoin-group-watch, which is the
    estate's only permitted consumer of getUpdates and therefore the only thing
    that can see a button press."""
    if a.decision not in ("confirm", "cancel"):
        sys.exit("decision must be confirm or cancel")
    if int(a.by) != OWNER:
        # Only one account's press counts. Nobody else can see these buttons --
        # they are in a private DM -- but "nobody else can reach it" is an
        # assumption about Telegram, and this is a check.
        notify_ops("approval gate: press from the WRONG account",
                   "Telegram user %s tried to decide approval item %s. Ignored."
                   % (a.by, a.id))
        sys.exit("refusing: user %s is not the owner" % a.by)
    d = load()
    for i in d["items"]:
        if i["id"] != a.id:
            continue
        if i["state"] not in ("pending", "awaiting"):
            # Pressing an old button must not resurrect a published or cancelled
            # item. Telegram keeps buttons alive indefinitely.
            print("%s is already %s; decision ignored" % (i["id"], i["state"]))
            return 0
        i["state"] = "confirmed" if a.decision == "confirm" else "cancelled"
        i["decided_at"] = now()
        i["decided_by"] = int(a.by)
        save(d)
        print("%s -> %s" % (i["id"], i["state"]))
        # The watcher rewrites the DM itself, so it asks us not to: a Telegram
        # call here once took longer than the watcher's whole budget.
        if not getattr(a, "no_prompt", False):
            update_prompt(i)
        return 0
    sys.exit("no such item: %s" % a.id)


def _ingest(path, body):
    """POST to the admin panel's ingest, reusing the jobs reporter's identity."""
    import urllib.request as _u
    c = {}
    try:
        with open("/etc/pcoin/jobs-report.conf", encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    c[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        return None
    url = (c.get("JOBS_REPORT_URL") or "").replace("/ingest/jobs", path)
    token = c.get("JOBS_REPORT_TOKEN", "")
    if not url or not token:
        return None
    req = _u.Request(url, data=json.dumps(body).encode(), method="POST",
                     headers={"content-type": "application/json",
                              "authorization": "Bearer " + token})
    with _u.urlopen(req, timeout=30) as r:
        raw = r.read().decode()
    try:
        return json.loads(raw)
    except ValueError:
        return {"raw": raw}


def cmd_controls(a):
    """Pull what the owner decided in the panel, apply it, acknowledge it.

    FAILS CLOSED in the only direction that matters: if the panel cannot be
    reached, nothing is applied and nothing is acknowledged. An unreachable panel
    must never look like "he approved everything" OR like "he switched everything
    off" -- it looks like nothing happened, because nothing did.
    """
    try:
        ctl = _ingest("/ingest/controls", {})
    except Exception as e:
        print("  could not read panel controls (%s)" % type(e).__name__)
        return 0
    if not ctl:
        return 0

    # ---- agent on/off ---------------------------------------------------
    os.makedirs(AGENT_FLAGS, exist_ok=True)
    for key, want in (ctl.get("agents") or {}).items():
        if not isinstance(want, dict) or "enabled" not in want:
            continue
        safe = "".join(ch for ch in str(key) if ch.isalnum() or ch in "-_")
        if not safe:
            continue
        flag = os.path.join(AGENT_FLAGS, safe + ".disabled")
        on = bool(want.get("enabled"))
        if on and os.path.exists(flag):
            os.unlink(flag)
            print("  agent %s ENABLED (by %s)" % (safe, want.get("by")))
        elif not on and not os.path.exists(flag):
            with open(flag, "w", encoding="utf-8") as fh:
                fh.write("disabled from the admin panel at %s by %s\n"
                         % (want.get("at"), want.get("by")))
            print("  agent %s DISABLED (by %s)" % (safe, want.get("by")))

    # ---- approvals decided in the panel ---------------------------------
    applied = []
    c = conf()
    token = c.get("TELEGRAM_TOKEN", "")
    for d in (ctl.get("decisions") or []):
        item_id, decision = str(d.get("id", "")), str(d.get("decision", ""))
        if decision not in ("confirm", "cancel") or not item_id:
            continue

        class A:
            pass
        A.id, A.decision, A.by = item_id, decision, str(OWNER)
        try:
            # The SAME path a Telegram press takes, state check and all. No
            # privileged route for the panel -- a privileged route is the route
            # worth attacking.
            cmd_decide(A)
            applied.append(item_id)
        except SystemExit as e:
            print("  panel decision %s refused: %s" % (item_id, e))
            # Acknowledge it anyway: a refusal is final, and leaving it
            # unacknowledged would retry it every minute for ever.
            applied.append(item_id)
            continue

        # Update the DM that is still offering live buttons, THEN send one short
        # receipt. Both, for different reasons.
        #
        # The EDIT is what the owner asked for: a prompt still showing Confirm
        # and Cancel for something already decided invites a second,
        # contradictory press days later.
        #
        # The RECEIPT is the security property. Telegram does not push a
        # notification for an edit, so an edit alone can be missed entirely --
        # and the entire point of announcing panel decisions is that a decision
        # he did NOT make reaches his phone.
        d_item = None
        for it in load()["items"]:
            if it["id"] == item_id:
                d_item = it
                break
        if token and d_item and d_item.get("dm_message_id"):
            try:
                api(token, "editMessageText", {
                    "chat_id": str(OWNER),
                    "message_id": str(d_item["dm_message_id"]),
                    "text": ("ALREADY %sED FROM THE ADMIN PANEL\n%s\nitem %s"
                             % (decision.upper(),
                                "Publishing now." if decision == "confirm"
                                else "Nothing will be published.",
                                item_id)),
                })
            except Exception as e:
                print("  could not edit the approval DM (%s)" % type(e).__name__)
        if token:
            try:
                api(token, "sendMessage", {
                    "chat_id": str(OWNER),
                    "text": ("%s from the ADMIN PANEL, not from here (item %s). "
                             "If that was not you, someone has a panel session."
                             % (decision.capitalize() + "ed", item_id)),
                })
            except Exception as e:
                print("  could not notify about the panel decision (%s)" % type(e).__name__)

    if applied:
        try:
            _ingest("/ingest/controls", {"ack": applied})
            print("  applied %d panel decision(s)" % len(applied))
        except Exception as e:
            # NOT acknowledged means it will be retried, and cmd_decide is
            # idempotent -- an item already decided is left alone. Safe to retry.
            print("  applied but could not acknowledge (%s)" % type(e).__name__)
    return 0


def cmd_report(a):
    """Push the queue to the admin panel so the owner can read it on a page.

    The photo bytes are stripped: the panel is a record of WHAT was decided, not
    a second copy of the artwork, and a JSON file carrying several base64 images
    is a file nobody will open twice.

    It reuses the jobs reporter's host identity and token rather than minting a
    second credential -- two copies of a credential is two things to rotate and
    one thing to forget.
    """
    import urllib.request as _u
    c = {}
    try:
        with open("/etc/pcoin/jobs-report.conf", encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    c[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    url = (c.get("JOBS_REPORT_URL") or "").replace("/ingest/jobs", "/ingest/approvals")
    token, host = c.get("JOBS_REPORT_TOKEN", ""), c.get("JOBS_REPORT_HOST", "")
    if not url or not token or not host:
        print("  no ingest config -- queue not reported")
        return 0
    d = load()
    items = []
    for i in d["items"][-200:]:
        j = {k: v for k, v in i.items() if k != "photo_b64"}
        j["has_photo"] = bool(i.get("photo_sha"))
        # The full text IS sent: the whole point of the page is that the owner can
        # read what was published or refused, months later, without opening a
        # server. It is text he wrote or approved, going to a panel only he can
        # reach.
        items.append(j)
    body = json.dumps({"host": host, "items": items,
                       "dests": {k: v["label"] for k, v in DESTS.items()}}).encode()
    req = _u.Request(url, data=body, method="POST",
                     headers={"content-type": "application/json",
                              "authorization": "Bearer " + token})
    try:
        with _u.urlopen(req, timeout=30) as r:
            print("  reported: %s" % r.read().decode().strip())
    except Exception as e:
        # Never fatal. Failing to REPORT the queue must not stop the gate
        # running the queue.
        print("  could not report the queue (%s)" % type(e).__name__)
    return 0


def cmd_list(a):
    d = load()
    items = d["items"] if a.all else [i for i in d["items"]
                                      if i["state"] in ("pending", "awaiting", "confirmed")]
    if not items:
        print("nothing waiting")
        return 0
    print("%-13s %-10s %-9s %-22s %s" % ("id", "state", "dest", "queued", "source"))
    for i in sorted(items, key=lambda x: x["created"], reverse=True):
        print("%-13s %-10s %-9s %-22s %s"
              % (i["id"], i["state"], i["dest"], stamp(i["created"]), i["source"]))
    return 0


def cmd_show(a):
    for i in load()["items"]:
        if i["id"] == a.id:
            out = dict(i)
            if out.get("photo_b64"):
                out["photo_b64"] = "<%d bytes, not shown>" % len(out["photo_b64"])
            print(json.dumps(out, indent=2))
            return 0
    sys.exit("no such item: %s" % a.id)


def cmd_selftest(a):
    """Exercise the state machine with no network at all.

    Proves the three things that would be catastrophic if wrong: that an
    unapproved item cannot publish, that a tampered approved item is refused,
    and that a press from the wrong account is ignored. A gate only ever
    observed refusing nothing has not been tested.
    """
    global QUEUE, SELFTEST
    SELFTEST = True
    QUEUE = "/tmp/pcoin-approve-selftest.json"
    if os.path.exists(QUEUE):
        os.unlink(QUEUE)
    ok = True

    class A:
        dest, text, caption, photo, key, reply_to, source = "selftest", "hello", "", None, "", "", "selftest"
    cmd_submit(A)
    d = load()
    item = d["items"][0]
    print("  1. submitted, state=%s  (must be 'pending', never publishable)" % item["state"])
    ok &= item["state"] == "pending"

    class B:
        id, decision, by = item["id"], "confirm", "1"
    try:
        cmd_decide(B)
        print("  2. a press from the WRONG account was ACCEPTED -- FAIL")
        ok = False
    except SystemExit:
        print("  2. press from the wrong account: refused  OK")

    class C:
        id, decision, by = item["id"], "confirm", str(OWNER)
    cmd_decide(C)
    d = load()
    print("  3. owner confirmed, state=%s  (must be 'confirmed')" % d["items"][0]["state"])
    ok &= d["items"][0]["state"] == "confirmed"

    d["items"][0]["text"] = "something else entirely"
    save(d)
    d = load()
    tampered = digest(d["items"][0]) != d["items"][0]["digest"]
    print("  4. content changed after approval -> digest mismatch detected: %s" % tampered)
    ok &= tampered

    # A REAL tamper must not be excusable as a scheme change. If changing the
    # text could be explained away by trying an older algorithm, the versioning
    # added above would have quietly destroyed the guarantee it was meant to
    # preserve -- so prove no older scheme accepts the edited item.
    excusable = any(digest(d["items"][0], v) == d["items"][0]["digest"]
                    for v in range(1, DIGEST_V))
    print("  5. an older digest scheme excuses that tamper: %s  (must be False)" % excusable)
    ok &= not excusable


    # 6-9: Discord. Formatting first, then the property that matters most.
    got = to_discord("*bold* and _it_ https://a.b/x_y_z", "Markdown")
    print("  6. Telegram Markdown -> Discord: %r" % got)
    ok &= got == "**bold** and *it* https://a.b/x_y_z"
    got = to_discord('<b>Hi</b> <a href="https://x.y">link</a> &amp; more', "HTML")
    print("  7. Telegram HTML -> Discord: %r" % got)
    ok &= got == "**Hi** [link](https://x.y) & more"
    got = to_discord("a*b @everyone https://x.y/a_b", "")
    print("  8. plain text escaped, mention defused, URL intact: %r" % got)
    ok &= got == "a\\*b @" + chr(0x200B) + "everyone https://x.y/a_b"

    calls = {"tg": 0, "dc": 0}

    def ftg(dst, it):
        calls["tg"] += 1
        return 111

    def fdc_down(dst, it):
        calls["dc"] += 1
        raise ValueError("simulated Discord outage")

    def fdc_up(dst, it):
        calls["dc"] += 1
        return "999"

    it = {"id": "fanout", "dest": "channel", "text": "t", "state": "confirmed", "photo_b64": "AAAA"}
    publish_item(it, ftg, fdc_down)
    half = (it["state"] == "confirmed" and it.get("published_tg_at") and it["photo_b64"] == "AAAA")
    print("  9a. Discord down: Telegram posted, item NOT published, picture kept: %s" % bool(half))
    ok &= bool(half)
    publish_item(it, ftg, fdc_up)
    healed = it["state"] == "published" and calls["tg"] == 1 and calls["dc"] == 2
    print("  9b. retry sent ONLY Discord (telegram sends=%d, must be 1), now published: %s"
          % (calls["tg"], healed))
    ok &= healed

    os.unlink(QUEUE)
    print("selftest %s" % ("PASSED" if ok else "FAILED"))
    return 0 if ok else 1


def main():
    p = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("submit")
    # No `choices=`: dc:<id> is valid too. dest_of() above is the gate.
    s.add_argument("--dest", required=True)
    s.add_argument("--text", required=True)
    s.add_argument("--caption", default="")
    s.add_argument("--photo", default=None)
    s.add_argument("--key", default="")
    s.add_argument("--reply-to", dest="reply_to", default="")
    s.add_argument("--source", default="")
    s.add_argument("--markdown", action="store_true",
                   help="render with Telegram's legacy Markdown. Off by default: "
                        "unbalanced Markdown is REFUSED by Telegram, and a message "
                        "composed by a model will eventually contain a lone asterisk.")
    s.set_defaults(fn=cmd_submit)

    s = sub.add_parser("tick"); s.set_defaults(fn=cmd_tick)

    s = sub.add_parser("decide")
    s.add_argument("--id", required=True)
    s.add_argument("--decision", required=True)
    s.add_argument("--by", required=True)
    s.add_argument("--no-prompt", dest="no_prompt", action="store_true",
                   help="record only; the caller edits the Telegram prompt itself")
    s.set_defaults(fn=cmd_decide)

    s = sub.add_parser("list")
    s.add_argument("--all", action="store_true")
    s.set_defaults(fn=cmd_list)

    s = sub.add_parser("show")
    s.add_argument("id")
    s.set_defaults(fn=cmd_show)

    s = sub.add_parser("report"); s.set_defaults(fn=cmd_report)

    s = sub.add_parser("controls"); s.set_defaults(fn=cmd_controls)

    s = sub.add_parser("selftest"); s.set_defaults(fn=cmd_selftest)

    a = p.parse_args()
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
