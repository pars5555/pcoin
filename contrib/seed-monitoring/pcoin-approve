# Destination allow-list. A name maps to a chat id here and nowhere else, so a
# caller can never name a chat that is not on this list -- including, especially,
# the private ops channel, which must never receive a public announcement.
# A destination the answer bot DERIVES: "dc:<channel id>", the channel a question
# was actually asked in. It is a name like any other and the id in it is NOT
# trusted -- dc_publish asks Discord whose channel it is and refuses anything
# outside our guild before posting. See the header note on allow-lists.
DYNAMIC_DC = re.compile(r"^dc:(\d{15,25})$")


def dc_channel(channel_id, bot_token):
    """Ask Discord what a channel IS. A plain GET: dc_call would put a body on it.

    Raises on anything that is not a clean answer, because this is the check that
    stands between a derived id and a post, and "we could not tell" must never
    read as "go ahead".
    """
    req = urllib.request.Request(
        "https://discord.com/api/v10/channels/%s" % channel_id,
        headers={"Authorization": "Bot " + bot_token,
                 "User-Agent": "DiscordBot (https://pc.am, 1.0) pcoin-approve"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.loads(r.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as e:
        raise ValueError("cannot read channel %s from Discord (HTTP %d)" % (channel_id, e.code))
    except Exception as e:
        raise ValueError("cannot read channel %s from Discord (%s)" % (channel_id, type(e).__name__))


def dest_of(name):
    """The destination for a name, or None. The ONLY place a name becomes a target."""
    if name in DESTS:
        return DESTS[name]
    m = DYNAMIC_DC.match(str(name or ""))
    if m:
        return {"discord": "botid:" + m.group(1),
                "label": "the Discord channel this was asked in (%s)" % m.group(1)}
    return None


