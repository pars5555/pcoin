[Unit]
OnFailure=pcoin-alert@%n.service
Description=PCoin -- is every public service answering?
Documentation=https://github.com/pars5555/pcoin
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pcoin-service-watch
TimeoutStartSec=300

# The check failing IS the alert. price.pc.am is read by six payment rails and
# exchange.pc.am holds customer balances -- these are not cosmetic pages.
