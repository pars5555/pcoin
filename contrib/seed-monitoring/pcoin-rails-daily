WEBAI_JS = r"""
(async () => {
  const db = require('/app/src/db.js');
  await db.init();
  const pool = db.getPool();
  const one = async (sql) => { const [r] = await pool.query(sql); const k = Object.keys(r[0] || {})[0]; return r[0] ? r[0][k] : null; };
  const o = {};
  o.pcn_n   = await one("SELECT COUNT(*) v FROM pcn_deposits WHERE status='credited' AND credited_at >= NOW() - INTERVAL 24 HOUR");
  o.pcn_usd = await one("SELECT COALESCE(SUM(credited_usd),0) v FROM pcn_deposits WHERE status='credited' AND credited_at >= NOW() - INTERVAL 24 HOUR");
  // status IN ('seen','confirming') is the exact non-terminal complement of the
  // enum. NOT confirmations < 3: that column is a STALE SNAPSHOT on this rail --
  // it stops refreshing once a deposit passes the gate, so credited rows sit at
  // 2 with confirmations_at_credit = 3 and would be falsely flagged as stuck.
  o.pending_n = await one("SELECT COUNT(*) v FROM pcn_deposits WHERE status IN ('seen','confirming')");
  o.pending_oldest_h = await one("SELECT ROUND(TIMESTAMPDIFF(SECOND, MIN(first_seen_at), NOW())/3600,2) v FROM pcn_deposits WHERE status IN ('seen','confirming')");
  o.wpcn_n   = await one("SELECT COUNT(*) v FROM wpcn_payments WHERE credited_at >= NOW() - INTERVAL 24 HOUR");
  o.wpcn_usd = await one("SELECT COALESCE(SUM(credited_usd),0) v FROM wpcn_payments WHERE credited_at >= NOW() - INTERVAL 24 HOUR");
  o.last_credit_h = await one("SELECT ROUND(TIMESTAMPDIFF(SECOND, MAX(credited_at), NOW())/3600,2) v FROM pcn_deposits WHERE status='credited'");
  // a row in `users` is not a signup: a genuine one gets a signup_bonus.
  // Publishing the raw count as growth is how test rows become a metric.
  o.users_new = await one("SELECT COALESCE(SUM(EXISTS (SELECT 1 FROM payment_transactions t WHERE t.user_id = u.id AND t.type='signup_bonus')),0) v FROM users u WHERE u.created_at >= NOW() - INTERVAL 24 HOUR");
  o.users_rows_24h = await one("SELECT COUNT(*) v FROM users WHERE created_at >= NOW() - INTERVAL 24 HOUR");
  o.users_active = await one("SELECT COUNT(DISTINCT user_id) v FROM usage_records WHERE created_at >= NOW() - INTERVAL 24 HOUR");
  // rejections have a real timestamp in system_logs even though pcn_deposits
  // has no rejected_at, so this window is honest
  o.rejected_24h = await one("SELECT COUNT(*) v FROM system_logs WHERE category='PCOIN_REJECTED' AND created_at >= NOW() - INTERVAL 24 HOUR");
  o.rejected_lifetime = await one("SELECT COUNT(*) v FROM pcn_deposits WHERE status='rejected'");
  o.watcher_age_min = await one("SELECT ROUND((UNIX_TIMESTAMP() - JSON_EXTRACT(value,'$.at'))/60,1) v FROM settings WHERE `key`='pcoin_watcher_heartbeat'");
  // THE BILLING GAP. Cost incurred vs money actually taken. These are supposed
  // to agree and do not; the delta is work given away. Reported daily so the
  // trend is visible rather than discovered once a quarter.
  o.usage_cost_24h = await one("SELECT COALESCE(SUM(cost_usd),0) v FROM usage_records WHERE created_at >= NOW() - INTERVAL 24 HOUR");
  o.usage_reqs_24h = await one("SELECT COUNT(*) v FROM usage_records WHERE created_at >= NOW() - INTERVAL 24 HOUR");
  o.charges_24h = await one("SELECT COALESCE(-SUM(amount_usd),0) v FROM payment_transactions WHERE type='usage_charge' AND created_at >= NOW() - INTERVAL 24 HOUR");
  o.invoices_pending = await one("SELECT COALESCE(SUM(type='deposit_pending'),0) v FROM payment_transactions");
  console.log(JSON.stringify(o));
  process.exit(0);
})().catch(e => { console.error('ERR ' + e.message); process.exit(1); });
"""


