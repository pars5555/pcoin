AICONTROL_JS = r"""
// The job file runs from /tmp, and node resolves modules relative to the
// SCRIPT's directory, not the working directory -- process.chdir() does not
// change that. Both requires are therefore absolute, and .env is named
// explicitly rather than being found by walking up from the script.
const APP = '/var/www/ai-control-server';
require(APP + '/node_modules/dotenv').config({ path: APP + '/.env' });
const { pool } = require(APP + '/src/db-pool');
(async () => {
  const one = async (sql) => { const [r] = await pool.query(sql); const k = Object.keys(r[0] || {})[0]; return r[0] ? r[0][k] : null; };
  const o = {};
  o.pcn_n   = await one("SELECT COUNT(*) v FROM pcn_deposits WHERE status='credited' AND credited_at >= NOW() - INTERVAL 24 HOUR");
  o.pcn_usd = await one("SELECT COALESCE(SUM(credited_usd),0) v FROM pcn_deposits WHERE status='credited' AND credited_at >= NOW() - INTERVAL 24 HOUR");
  o.pending_n = await one("SELECT COUNT(*) v FROM pcn_deposits WHERE status IN ('seen','confirming')");
  // NULL when nothing is pending
  o.pending_oldest_h = await one("SELECT ROUND(TIMESTAMPDIFF(SECOND, MIN(first_seen_at), NOW())/3600,2) v FROM pcn_deposits WHERE status IN ('seen','confirming')");
  o.wpcn_n   = await one("SELECT COUNT(*) v FROM wpcn_payments WHERE credited_at >= NOW() - INTERVAL 24 HOUR");
  o.wpcn_usd = await one("SELECT COALESCE(SUM(credited_usd),0) v FROM wpcn_payments WHERE credited_at >= NOW() - INTERVAL 24 HOUR");
  o.last_credit_h = await one("SELECT ROUND(TIMESTAMPDIFF(SECOND, MAX(credited_at), NOW())/3600,2) v FROM pcn_deposits WHERE status='credited'");
  o.users_new = await one("SELECT COUNT(*) v FROM users WHERE created_at >= NOW() - INTERVAL 24 HOUR");
  // LIFETIME: the min-amount rejection fires AFTER the 100-block coinbase gate,
  // so a rejected coinbase deposit can never land inside a 24h first_seen window
  o.rejected_lifetime = await one("SELECT COUNT(*) v FROM pcn_deposits WHERE status='rejected'");
  o.watcher_age_min = await one("SELECT ROUND((UNIX_TIMESTAMP() - JSON_EXTRACT(value,'$.at'))/60,1) v FROM settings WHERE `key`='pcoin_watcher_heartbeat'");
  // the only figure that says "we paid USD for PCN that may no longer exist".
  // A reorg-flagged row stays status='credited', so the stuck query cannot see it.
  o.reorg_flagged = await one("SELECT COALESCE(SUM(reorg_flagged=1),0) v FROM pcn_deposits WHERE status='credited'");
  o.reorg_usd = await one("SELECT COALESCE(SUM(CASE WHEN reorg_flagged=1 THEN credited_usd END),0) v FROM pcn_deposits WHERE status='credited'");
  // one filter applied consistently: without it, 'online' and 'seen' disagree
  // by a dozen devices because only one of them excluded revoked ones
  o.devices_online = await one("SELECT COALESCE(SUM(last_active >= NOW() - INTERVAL 5 MINUTE AND is_revoked=0 AND is_disabled=0),0) v FROM device_sessions");
  o.devices_24h = await one("SELECT COALESCE(SUM(last_active >= NOW() - INTERVAL 24 HOUR AND is_revoked=0 AND is_disabled=0),0) v FROM device_sessions");
  o.users_active = o.devices_24h;
  // a second money rail nothing else in the estate reads. status is
  // ('pending','paid','failed','expired') -- 'paid', not 'completed'.
  o.invoices_paid_24h = await one("SELECT COALESCE(SUM(status='paid' AND completed_at >= NOW() - INTERVAL 24 HOUR),0) v FROM payments");
  o.invoices_paid_usd_24h = await one("SELECT COALESCE(SUM(CASE WHEN status='paid' AND completed_at >= NOW() - INTERVAL 24 HOUR THEN amount_usd END),0) v FROM payments");
  o.invoices_pending = await one("SELECT COALESCE(SUM(status='pending'),0) v FROM payments");
  console.log(JSON.stringify(o));
  process.exit(0);
})().catch(e => { console.error('ERR ' + e.message); process.exit(1); });
"""


