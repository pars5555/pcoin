CHECKER_SQL = """
SELECT
 (SELECT COUNT(*) FROM pcn_deposits
    WHERE status='credited' AND credited_at >= NOW() - INTERVAL 24 HOUR),
 (SELECT COALESCE(SUM(credited_usd),0) FROM pcn_deposits
    WHERE status='credited' AND credited_at >= NOW() - INTERVAL 24 HOUR),
 (SELECT COALESCE(SUM(credited_credits),0) FROM pcn_deposits
    WHERE status='credited' AND credited_at >= NOW() - INTERVAL 24 HOUR),
 -- stuck = every NON-TERMINAL value of ENUM('seen','confirming','credited','rejected')
 (SELECT COUNT(*) FROM pcn_deposits WHERE status IN ('seen','confirming')),
 -- NULL, not 0, when nothing is pending: 0 reads as "stuck for zero hours"
 (SELECT ROUND(TIMESTAMPDIFF(SECOND, MIN(first_seen_at), NOW())/3600,2)
    FROM pcn_deposits WHERE status IN ('seen','confirming')),
 (SELECT COUNT(*) FROM wpcn_payments WHERE credited_at >= NOW() - INTERVAL 24 HOUR),
 (SELECT COALESCE(SUM(credited_usd),0) FROM wpcn_payments
    WHERE credited_at >= NOW() - INTERVAL 24 HOUR),
 -- NULL, not -1, when it has never credited anything
 (SELECT ROUND(TIMESTAMPDIFF(SECOND, MAX(credited_at), NOW())/3600,2)
    FROM pcn_deposits WHERE status='credited'),
 (SELECT COUNT(*) FROM users WHERE created_at       >= NOW() - INTERVAL 24 HOUR),
 (SELECT COUNT(*) FROM users WHERE last_activity_at >= NOW() - INTERVAL 24 HOUR),
 -- LIFETIME: pcn_deposits has no rejected_at, so a 24h window on first_seen_at
 -- would miss a deposit discovered days ago and rejected today
 (SELECT COUNT(*) FROM pcn_deposits WHERE status='rejected'),
 -- the watcher's own heartbeat: what makes "0 stuck" mean anything
 (SELECT ROUND((UNIX_TIMESTAMP() - JSON_EXTRACT(value,'$.last_poll_at'))/60,1)
    FROM settings WHERE `key`='pcoin'),
 -- credits issued by deposits vs credits the ledger recorded. Must be 0.
 (SELECT COALESCE(SUM(credited_credits),0) FROM pcn_deposits WHERE status='credited')
  - (SELECT COALESCE(SUM(delta),0) FROM credit_ledger WHERE reason='topup_pcoin'),
 (SELECT COALESCE(-SUM(delta),0) FROM credit_ledger
    WHERE reason='debit' AND created_at >= NOW() - INTERVAL 24 HOUR)
"""

CHECKER_COLS = ["pcn_n", "pcn_usd", "credits_24h", "pending_n", "pending_oldest_h",
                "wpcn_n", "wpcn_usd", "last_credit_h", "users_new", "users_active",
                "rejected_lifetime", "watcher_age_min", "credit_drift", "credits_spent_24h"]


def collect_checker():
    r = blank("checker.pc.am", "local")
    ok, out = run(["mysql", "checker_pc_am", "-N", "-B", "-e", CHECKER_SQL])
    if not ok:
        r["error"] = out
        return r
    line = (out or "").strip().split("\n")[0] if out.strip() else ""
    parts = line.split("\t")
    if len(parts) != len(CHECKER_COLS):
        r["error"] = "expected %d columns, got %d" % (len(CHECKER_COLS), len(parts))
        return r
    d = dict(zip(CHECKER_COLS, parts))
    for k in CHECKER_COLS:
        d[k] = num(d[k])
    r.update({k: d[k] for k in ("pcn_n", "pcn_usd", "wpcn_n", "wpcn_usd", "pending_n",
                                "pending_oldest_h", "rejected_lifetime", "users_new",
                                "users_active", "last_credit_h", "watcher_age_min")})
    r["ok"] = True
    if d["credits_24h"]:
        r["extra"]["credits issued"] = "%d" % d["credits_24h"]
    if d["credits_spent_24h"]:
        r["extra"]["credits spent"] = "%d" % d["credits_spent_24h"]
    if d["credit_drift"]:
        r["extra"]["LEDGER DRIFT"] = "%d credits" % d["credit_drift"]
    return r


