    if cost is not None and charged is not None:
        gap = cost - charged
        r["extra"]["AI usage"] = "%d reqs, cost $%.2f, charged $%.2f" % (
            num(d.get("usage_reqs_24h")) or 0, cost, charged)
        if gap > 0.005:
            r["extra"]["UNBILLED"] = "$%.2f given away in 24h" % gap
    rows = num(d.get("users_rows_24h"))
    if rows is not None and r["users_new"] is not None and rows > r["users_new"]:
        r["extra"]["user rows without a signup bonus"] = "%d" % (rows - r["users_new"])
    if num(d.get("rejected_24h")):
        r["extra"]["rejected in 24h"] = "%d" % num(d["rejected_24h"])
    if num(d.get("invoices_pending")):
        r["extra"]["card invoices pending"] = "%d" % num(d["invoices_pending"])
    return r


COLLECTORS = [collect_checker, collect_webbuilder, collect_aicontrol, collect_webai]


# ===========================================================================
def fmt_usd(v):
    return "-" if v is None else "$%.2f" % v


def fmt_int(v):
    return "-" if v is None else "%d" % int(v)


def fmt_age(h):
    if h is None:
        return "never"
    if h < 1:
        return "%dm" % int(h * 60)
    if h < 48:
        return "%.0fh" % h
    return "%.0fd" % (h / 24.0)


def build_message(day, rows):
    lines, problems, quiet = [], [], []
    total_n, total_usd, any_unknown = 0, 0.0, False

    for r in rows:
        if not r["ok"]:
            any_unknown = True
            lines.append("%-15s UNKNOWN -- %s" % (r["name"], r["error"] or "no reason given"))
            problems.append("%s could not be read at all" % r["name"])
            continue

        got = []
        if r["pcn_n"] is not None:
            got.append("PCN %s/%s" % (fmt_int(r["pcn_n"]), fmt_usd(r["pcn_usd"])))
            total_n += int(r["pcn_n"] or 0)
            total_usd += float(r["pcn_usd"] or 0)
        if r["wpcn_n"]:
            got.append("wPCN %s/%s" % (fmt_int(r["wpcn_n"]), fmt_usd(r["wpcn_usd"])))
            total_n += int(r["wpcn_n"] or 0)
            total_usd += float(r["wpcn_usd"] or 0)
        if not got:
            got = ["no deposits"]

        bits = [" ".join(got)]
        if r["users_new"] is not None or r["users_active"] is not None:
            bits.append("users +%s / %s active" % (fmt_int(r["users_new"]),
                                                   fmt_int(r["users_active"])))
        bits.append("last credit %s" % fmt_age(r["last_credit_h"]))

        flag = "ok"
        # A dead watcher writes no rows, so "0 pending" would read as healthy.
        # This is the check that gives every other number on the line meaning.
        if r["watcher_age_min"] is None:
            flag = "WATCHER?"
            problems.append("%s: no watcher heartbeat could be read, so its "
                            "'0 pending' means nothing" % r["name"])
        elif r["watcher_age_min"] > WATCHER_STALE_MIN:
            flag = "WATCHER"
            problems.append("%s: watcher last ticked %s ago -- deposits are not being "
                            "seen, and the figures on this line are stale"
                            % (r["name"], fmt_age(r["watcher_age_min"] / 60.0)))
        elif r["pending_n"] and r["pending_oldest_h"] is not None \
                and r["pending_oldest_h"] >= STUCK_HOURS:
            flag = "STUCK"
            problems.append("%s: %d deposit(s) waiting, oldest %s"
                            % (r["name"], int(r["pending_n"]),
                               fmt_age(r["pending_oldest_h"])))
        elif r["pending_n"]:
            bits.append("%s pending" % fmt_int(r["pending_n"]))

        if r["last_credit_h"] is not None and r["last_credit_h"] > QUIET_DAYS * 24:
            quiet.append("%s has credited nothing for %s"
                         % (r["name"], fmt_age(r["last_credit_h"])))
        elif r["last_credit_h"] is None:
            quiet.append("%s has never credited a deposit" % r["name"])

        lines.append("%-15s %-8s %s" % (r["name"], flag, "  ".join(bits)))
        for k, v in (r.get("extra") or {}).items():
            lines.append("%-15s %-8s %s: %s" % ("", "", k, v))

    subject = "PCN rails -- daily activity %s" % day
    body = ["", "\n".join(lines), ""]
    body.append("24h across all four: %d deposit(s), $%.2f credited" % (total_n, total_usd))
    if any_unknown:
        body.append("")
        body.append("SOME RAILS COULD NOT BE READ, so the total above is a FLOOR, not a "
                    "total. Treat the missing ones as unknown, never as zero.")
    if problems:
        body.append("")
        body.append("Needs attention:")
        body += ["  - " + p for p in problems]
    if quiet:
        body.append("")
        body.append("Quiet, which is not an error:")
        body += ["  - " + q for q in quiet]
    return subject, "\n".join(body)


def main():
    day = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    rows = []
    for c in COLLECTORS:
        try:
            rows.append(c())
        except Exception as e:
            # A collector that throws must still produce a line. A rail that
            # vanishes from the report is the exact failure this file exists
            # to prevent.
            r = blank(getattr(c, "__name__", "unknown"), "?")
            r["error"] = "collector raised: %s" % str(e)[:150]
            rows.append(r)

    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        snap = os.path.join(STATE_DIR, "%s.json" % day)
        tmp = snap + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"day": day, "collected_at": int(time.time()), "rails": rows},
                      f, indent=1, default=str)
        os.replace(tmp, snap)
    except Exception as e:
        log("could not write the daily snapshot: %s" % e)

    subject, body = build_message(day, rows)

    if DRY:
        print(subject)
        print(body)
        return 0

    if not os.access(NOTIFY, os.X_OK):
        log("no executable notifier at %s -- report NOT delivered" % NOTIFY)
        print(subject)
        print(body)
        return 0

    # REPEAT_HOURS=0 plus a dated subject. This must never be deduped away: a
    # missing daily message is itself the signal that something broke, so the
    # report must not be able to go quiet on a slow day.
    env = dict(os.environ, REPEAT_HOURS="0")
    p = subprocess.run([NOTIFY, subject, body], env=env, capture_output=True, text=True)
    if p.returncode != 0:
        log("notifier exited %d: %s" % (p.returncode, (p.stderr or "")[:200]))
    return 0


if __name__ == "__main__":
    sys.exit(main())
