def log(msg):
    try:
        subprocess.run(["logger", "-t", "pcoin-rails-daily", "--", msg], check=False)
    except Exception:
        pass
    print(msg, file=sys.stderr)


def run(cmd, stdin_text=None, timeout=None):
    """Run a command. Returns (ok, output_or_error). Never raises."""
    try:
        p = subprocess.run(cmd, input=stdin_text, capture_output=True, text=True,
                           timeout=timeout or SSH_TIMEOUT)
        if p.returncode != 0:
            return False, (p.stderr or p.stdout or "").strip()[:250]
        return True, p.stdout
    except subprocess.TimeoutExpired:
        # NEVER interpolate cmd into this message. TimeoutExpired.__str__
        # embeds the full argv, which is exactly how a database password
        # reached three separate logs on this estate.
        return False, "timed out after %ds" % (timeout or SSH_TIMEOUT)
    except Exception as e:
        return False, str(e)[:250]


def remote(host, interpreter, body, timeout=None):
    """Ship a script over SSH ON STDIN and run it.

    Not as an argument: four different interpreters with four different quoting
    rules, wrapped in ssh's own layer, is how a query silently changes meaning
    in transit. Stdin has no quoting rules.
    """
    tmp = "/tmp/pcoin-rails-daily.$$.job"
    cmd = "cat > %s && %s %s; rc=$?; rm -f %s; exit $rc" % (tmp, interpreter, tmp, tmp)
    return run(["ssh", "-i", PANEL_KEY, "-o", "BatchMode=yes",
                "-o", "ConnectTimeout=10", "-o", "StrictHostKeyChecking=no",
                host, cmd], stdin_text=body, timeout=timeout)


def num(v):
    """A float, or None for UNKNOWN. None must survive all the way to the
    message: it is never allowed to become 0."""
    if v is None or v == "" or v == "NULL":
        return None
    try:
        return float(v)
    except (TypeError, ValueError):
        return None


