#!/usr/bin/env python3
"""Post an unconditional chain-health digest to the private ops channel, every
run, no matter what it finds.

THIS IS DELIBERATELY NOT AN ALERT SCRIPT. Every other monitor in this
directory (pcoin-seed-watch, pcoin-fork-watch, pcoin-concentration-watch)
fires through pcoin-notify, which hashes the message text and suppresses a
repeat of the same text for REPEAT_HOURS -- because a channel that gets the
same failure 144 times a day gets muted, taking the one alert that mattered
with it. That is the right behaviour for a failure.

It is the WRONG behaviour here. The owner asked for a heartbeat: "I need to
know chain health every 10 minutes", not "tell me when it changes". A quiet
10 minutes with no new block produces byte-identical text on two consecutive
runs, and pcoin-notify would silently eat the second one -- which is exactly
backwards for a liveness signal, where an unexplained gap in the channel is
the failure mode. So this posts to the Telegram Bot API directly, every
single run, and skips pcoin-notify's dedupe entirely.

It still reads TELEGRAM_TOKEN and ALERT_CHAT out of /etc/pcoin/alert.conf, for
the same reason every other script here does: no credential belongs in a
script, and ALERT_CHAT must be the PRIVATE destination -- this is operational
volume, not a human-authored announcement, and must never reach @PCoinPCN.

TWO DIFFERENT "HOW MANY MINERS" NUMBERS, ON PURPOSE.

  * RECENT (last --window blocks, default 100): who is winning blocks RIGHT
    NOW. Cheap, but a short window is noisy and a quiet miner who hasn't won
    anything recently is invisible.
  * ACTUAL COUNT (last --hours, default 48): every distinct payout address
    that got paid ANYTHING in the window -- this is what the owner actually
    asked for ("the actual miners count"), and a short window undercounts it
    badly (see pcoin-concentration-watch's own history of one address
    swinging from invisible to 70% inside a day).

Both use the SAME classifier as pcoin-concentration-watch, so none of these
monitors ever disagree with each other: a coinbase paying >=3 addresses is a
pool's payout run (each recipient is a real worker and gets counted --
COLLAPSING the pool to "one entity", which the short-window view still does
for readability, would throw away information that is sitting right there
on-chain); 1-2 payees is a solo miner, counted by its first payout address.

Both numbers are a FLOOR, not a headcount, in opposite directions:
  - undercounts when one operator points several machines at one address
    (confirmed on this chain -- see the fleet's own "Linux miners (x2)")
  - overcounts (rarely) if an operator rotates addresses across blocks

ONE RPC PASS COVERS BOTH. The --hours window is a superset of --window
blocks, so this fetches full block data (getblock verbosity 2, which
includes the timestamp) walking backward from the tip exactly once, stops as
soon as a block's time crosses the --hours cutoff, and slices the newest
--window blocks of that same data for the recent view. The first version of
this script did a separate header-only walk to find the cutoff height before
re-fetching every block a second time for the census -- double the RPC calls
for no reason, since getblock already carries the time field.

Runs entirely off local RPC plus one outbound HTTPS call to Telegram. No
dependency on explorer.pc.am or the ops dashboard on purpose: this host
already runs the node, and a heartbeat that depends on another PCoin service
being healthy is not a heartbeat, it is one more thing that can go dark
silently (see CLAUDE.md's cron-chain incident, §7.13).
"""

import argparse
import collections
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.request
import urllib.parse

CLI_CANDIDATES = [
    ["/opt/pcoin/bin/bitcoin-cli", "-conf=/etc/pcoin/pcoin.conf"],
    ["docker", "exec", "pcoin-seed", "bitcoin-cli"],
    ["bitcoin-cli"],
]
CONF = "/etc/pcoin/alert.conf"


def find_cli():
    for cand in CLI_CANDIDATES:
        exe = cand[0]
        if exe == "docker":
            if not shutil.which("docker"):
                continue
        elif not (os.path.isfile(exe) or shutil.which(exe)):
            continue
        try:
            subprocess.run(cand + ["getblockcount"], capture_output=True,
                            timeout=20, check=True)
            return cand
        except Exception:
            continue
    return None


def rpc(cli, *args):
    r = subprocess.run(cli + list(args), capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        raise RuntimeError((r.stderr or r.stdout).strip()[:200])
    out = r.stdout.strip()
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return out


def classify(block):
    """Same rule as pcoin-concentration-watch -- keep them in lockstep."""
    txs = block.get("tx") or []
    if not txs:
        return None, []
    cb = txs[0]
    paying = []
    for o in cb.get("vout") or []:
        if float(o.get("value") or 0) <= 0:
            continue
        spk = o.get("scriptPubKey") or {}
        addr = spk.get("address")
        if not addr:
            addrs = spk.get("addresses") or []
            addr = addrs[0] if addrs else None
        if addr:
            paying.append(addr)
    if not paying:
        return None, []
    return ("pool" if len(paying) >= 3 else "solo"), paying


def short(addr, head=10, tail=6):
    if not addr or len(addr) <= head + tail + 1:
        return addr or "?"
    return f"{addr[:head]}…{addr[-tail:]}"


def fmt_hashrate(hps):
    for unit, div in (("TH/s", 1e12), ("GH/s", 1e9), ("MH/s", 1e6), ("kH/s", 1e3)):
        if hps >= div:
            return f"{hps/div:.1f} {unit}"
    return f"{hps:.0f} H/s"


def collect_window(cli, hours):
    """Walk back from the tip, one getblock(verbosity=2) per height, until a
    block's time crosses the --hours cutoff. Returns blocks newest-first.

    Deliberately anchored on real block timestamps, not blocks-per-hour
    arithmetic -- this chain's spacing is documented as noisy and NOT
    monotonic in height, so an average-spacing guess would size the window
    wrong in either direction.
    """
    tip = int(rpc(cli, "getblockcount"))
    cutoff = None
    blocks = []
    h = tip
    while h >= 1:
        bh = rpc(cli, "getblockhash", str(h))
        block = rpc(cli, "getblock", bh, "2")
        if cutoff is None:
            cutoff = block["time"] - hours * 3600
        blocks.append(block)
        if block["time"] <= cutoff:
            blocks.pop()  # the boundary block itself is outside the window
            break
        h -= 1
    return tip, blocks  # newest-first; oldest may be short of `hours` near genesis


def census(blocks):
    """(solo_counter, pool_worker_counter, pool_blocks, unreadable) over an
    already-fetched block list."""
    solo = collections.Counter()
    pool_workers = collections.Counter()
    pool_blocks = 0
    unreadable = 0
    for block in blocks:
        try:
            kind, paying = classify(block)
        except Exception:
            kind, paying = None, []
        if kind == "solo":
            solo[paying[0]] += 1
        elif kind == "pool":
            pool_blocks += 1
            for a in set(paying):
                pool_workers[a] += 1
        else:
            unreadable += 1
    return solo, pool_workers, pool_blocks, unreadable


def build_report(cli, window, hours):
    info = rpc(cli, "getblockchaininfo")
    mempool = rpc(cli, "getmempoolinfo")
    peers = rpc(cli, "getpeerinfo")
    tip = int(info["blocks"])

    try:
        hashps = float(rpc(cli, "getnetworkhashps"))
    except Exception:
        hashps = None

    tip_h, blocks = collect_window(cli, hours)
    actual_hours = ((blocks[0]["time"] - blocks[-1]["time"]) / 3600.0) if blocks else 0.0

    lines = []
    lines.append(f"height {tip:,} · {'IBD' if info.get('initialblockdownload') else 'synced'}"
                 f" · {len(peers)} peers · mempool {mempool.get('size', 0)} tx")
    diff = info.get("difficulty")
    hr = fmt_hashrate(hashps) if hashps is not None else "unknown"
    lines.append(f"difficulty {diff:.4g} · network hashrate ~{hr} (getnetworkhashps)")
    lines.append("LWMA active since height 2,800")

    # -- recent snapshot: who is winning blocks right now --
    recent = blocks[:window]
    r_solo, r_pool_workers, r_pool_blocks, r_unreadable = census(recent)
    r_n = len(recent) - r_unreadable
    if r_n < len(recent) * 0.5:
        lines.append(f"\nrecent census skipped: only {r_n}/{len(recent)} blocks were readable")
    else:
        distinct = len(r_solo) + (1 if r_pool_blocks else 0)
        lines.append(f"\nlast {r_n} blocks — who's winning right now:")
        lines.append(f"  {distinct} distinct payee(s): {len(r_solo)} solo + "
                     f"{'the pool' if r_pool_blocks else 'no pool blocks'}")
        if r_solo:
            top_addr, top_n = r_solo.most_common(1)[0]
            top_pct = 100.0 * top_n / r_n
            flag = "  ⚠ MAJORITY RISK" if top_pct >= 50 else (" ⚠" if top_pct >= 40 else "")
            lines.append(f"  top solo: {short(top_addr)} — {top_pct:.0f}% ({top_n}/{r_n}){flag}")
        if r_pool_blocks:
            lines.append(f"  pool share: {100.0*r_pool_blocks/r_n:.0f}% ({r_pool_blocks}/{r_n})")

    # -- actual miners count: every distinct payee over the full window --
    f_solo, f_pool_workers, f_pool_blocks, f_unreadable = census(blocks)
    f_n = len(blocks) - f_unreadable
    if f_n == 0:
        lines.append(f"\nactual miners (last ~{hours:.0f}h): no readable blocks")
    else:
        total = len(f_solo) + len(f_pool_workers)
        lines.append(f"\nactual miners, last {actual_hours:.0f}h ({f_n} blocks) — "
                     f"every address paid at least once:")
        lines.append(f"  {total} distinct payout addresses total")
        lines.append(f"    {len(f_solo)} solo-mining addresses")
        lines.append(f"    {len(f_pool_workers)} pool-worker addresses "
                     f"(harvested from on-chain payout splits, not the pool's own log)")
        if f_unreadable:
            lines.append(f"  ({f_unreadable} block(s) in the window were unreadable and excluded)")
        lines.append("  this is a FLOOR: one address can be several machines "
                     "(undercounts), the chain only shows who got PAID")

    return "\n".join(lines)


def send_telegram(token, chat, text):
    url = f"https://api.telegram.org/bot{token}/sendMessage"
    data = urllib.parse.urlencode({
        "chat_id": chat,
        "text": text,
        "parse_mode": "Markdown",
        "disable_web_page_preview": "true",
    }).encode()
    req = urllib.request.Request(url, data=data)
    with urllib.request.urlopen(req, timeout=25) as r:
        resp = json.load(r)
    if not resp.get("ok"):
        raise RuntimeError(f"telegram rejected the message: {resp}")


def load_conf(path):
    conf = {}
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                conf[k.strip()] = v.strip()
    except FileNotFoundError:
        pass
    return conf


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--window", type=int, default=100,
                     help="recent-snapshot block count (default 100)")
    ap.add_argument("--hours", type=float, default=48.0,
                     help="lookback window in hours for the actual-miners count (default 48)")
    ap.add_argument("--conf", default=CONF)
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args()

    cli = find_cli()
    if not cli:
        print("no usable bitcoin-cli on this host", file=sys.stderr)
        return 0

    try:
        body = build_report(cli, a.window, a.hours)
    except Exception as e:
        body = f"heartbeat could not read the chain: {type(e).__name__}: {e}"

    host = subprocess.run(["hostname"], capture_output=True, text=True).stdout.strip()
    stamp = time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime())
    text = f"*PCoin chain heartbeat*\n{body}\n\n_{host} — {stamp}_"

    print(text)
    if a.dry_run:
        return 0

    conf = load_conf(a.conf)
    token = conf.get("TELEGRAM_TOKEN")
    chat = conf.get("ALERT_CHAT")
    if not token or not chat:
        print(f"no TELEGRAM_TOKEN/ALERT_CHAT in {a.conf} -- heartbeat not delivered",
              file=sys.stderr)
        return 0

    try:
        send_telegram(token, chat, text)
    except Exception as e:
        print(f"delivery failed: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
