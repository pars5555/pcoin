def read_conf(path, required=True):
    out = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                out[k.strip()] = v.strip().strip('"').strip("'")
    except OSError as e:
        if required:
            sys.exit("cannot read %s: %s" % (path, e))
    return out


def load_state():
    try:
        with open(STATE, encoding="utf-8") as fh:
            s = json.load(fh)
        if not isinstance(s, dict):
            s = {}
    except (OSError, ValueError):
        s = {}
    s.setdefault("cursors", {})
    s.setdefault("seen", 0)
    s.setdefault("last_run", 0)
    s.setdefault("empty_alerted", 0)
    if not isinstance(s.get("members"), dict):
        s["members"] = {}
    return s


def save_state(s):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(s, fh, indent=2)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, STATE)


class TransientError(RuntimeError):
    """Discord said 5xx or 429, or could not be reached. Worth retrying, and
    worth waking somebody only if it lasts."""


# How long Discord may keep failing before it is an alert rather than a blip.
# First seen 2026-09-15 18:16 UTC: one "500: Internal Server Error" from
# Discord's own API paged the ops channel. The timer fires again in 25 s.
QUIET_SECONDS = int(os.environ.get("DISCORD_WATCH_QUIET_SECONDS", "900"))


def dc_get_soft(token, path):
    """dc_get, but a channel we cannot read is skipped rather than fatal.

    Returns None on failure, which callers must treat as "unknown, try again
    next run" -- never as "no messages". The cursor is not advanced on a None,
    so nothing is lost, it is only delayed by 25 seconds.
    """
    try:
        return dc_get(token, path)
    except Exception as e:                                   # noqa: BLE001
        print("  %s unreadable (%s)" % (path.split("?")[0], type(e).__name__), file=sys.stderr)
        return None


def dc_get(token, path, tries=3):
    req = urllib.request.Request(API + path, headers={
        "Authorization": "Bot " + token,
        "User-Agent": "DiscordBot (https://pc.am, 1.0) pcoin-discord-watch"})
    last = None
    for attempt in range(tries):
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                return json.loads(r.read().decode("utf-8", "replace"))
        except urllib.error.HTTPError as e:
            try:
                detail = e.read().decode("utf-8", "replace")[:200]
            except Exception:
                detail = ""
            msg = "Discord HTTP %d on %s %s" % (e.code, path.split("?")[0], detail)
            if e.code < 500 and e.code != 429:
                # 401/403/404 are configuration, not weather: alert at once.
                raise RuntimeError(msg)
            last = TransientError(msg)
        except urllib.error.URLError as e:
            last = TransientError("Discord unreachable (%s)" % type(e.reason).__name__)
        time.sleep(2 ** attempt)
    raise last


def snowflake_time(sf):
    return ((int(sf) >> 22) + DISCORD_EPOCH_MS) // 1000


def who(m):
    a = m.get("author") or {}
    name = a.get("global_name") or a.get("username") or "someone"
    if a.get("username") and a.get("username") != name:
        name = "%s (@%s)" % (name, a["username"])
    return name


def describe(m):
    text = m.get("content") or ""
    extra = []
    for att in m.get("attachments") or []:
        extra.append("[attachment: %s]" % (att.get("filename") or "file"))
    if m.get("sticker_items"):
        extra.append("[sticker]")
    return (text + (" " if text and extra else "") + " ".join(extra)).strip()


IMAGE_HOSTS = ("cdn.discordapp.com", "media.discordapp.net")


def image_url(m):
    """The first attachment that claims to be an image, if it is on Discord's
    own CDN. Claims are not trusted -- the answer bot sniffs the real bytes --
    but an off-CDN URL is refused outright so nothing can point this at an
    arbitrary host."""
    for att in m.get("attachments") or []:
        url = str(att.get("url") or "")
        ct = str(att.get("content_type") or "")
        name = str(att.get("filename") or "").lower()
        looks_image = ct.startswith("image/") or name.endswith((".png", ".jpg", ".jpeg", ".gif", ".webp"))
        if not looks_image:
            continue
        try:
            host = urllib.parse.urlsplit(url).hostname or ""
        except ValueError:
            continue
        if url.startswith("https://") and host in IMAGE_HOSTS:
            return url
    return None


def relay(tg_token, alert_chat, guild, channel, m, urgent):
    """Tell the private ops channel, exactly as the Telegram watcher does."""
    if DRY:
        print("  (dry-run: would relay %s)" % m["id"])
        return True
    head = ("🆘 <b>PCoin Discord — someone needs help</b>" if urgent
            else "💬 <b>PCoin Discord</b>")
    body = ("%s\n<b>%s</b>\n%s\n\n<a href=\"https://discord.com/channels/%s/%s/%s\">open the message</a>"
            % (head, html.escape(who(m)), html.escape(describe(m)[:1200]), guild, channel, m["id"]))
    data = urllib.parse.urlencode({"chat_id": alert_chat, "parse_mode": "HTML",
                                   "disable_web_page_preview": "true", "text": body}).encode()
    try:
        with urllib.request.urlopen(urllib.request.Request(
                "https://api.telegram.org/bot%s/sendMessage" % tg_token, data=data), timeout=30) as r:
            return bool(json.load(r).get("ok"))
    except (urllib.error.URLError, OSError, ValueError) as e:
        print("  relay failed: %s" % type(e).__name__, file=sys.stderr)
        return False


def notify_ops(subject, body):
    n = "/usr/local/bin/pcoin-notify"
    if not DRY and os.access(n, os.X_OK):
        os.spawnv(os.P_NOWAIT, n, [n, subject, body])


def spool(row):
    os.makedirs(os.path.dirname(SPOOL), exist_ok=True)
    with open(SPOOL, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(row, ensure_ascii=False) + "\n")
    if os.path.getsize(SPOOL) > SPOOL_MAX_BYTES:
        with open(SPOOL, encoding="utf-8") as fh:
            keep = fh.readlines()[-1000:]
        tmp = SPOOL + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.writelines(keep)
        os.replace(tmp, SPOOL)


# ── moderation: the same rule as @PCoinPCNChat ───────────────────────────────
# OWNER, 2026-09-15: remove adverts and outside links, report each removal to
# the private ops channel -- "same ad and link filter on Discord". This is the
# deterministic half (links). The model half (adverts with no link) already
# covers Discord rows in pcoin-group-answer, which can delete on either platform.
#
# Discord gives no link entities, so links are found by pattern -- but only
# unambiguous ones (a scheme, www., or an invite host). A bare "node.js" or
# "e.g." is never treated as a link, because a false positive here deletes an
# honest question.
OUR_TG = {"pcoinpcn", "pcoinpcnchat", "pcoinpcnbot", "pcoinaibot", "mywebsitebuilderbot"}
OUR_INVITE = "dgmdwjkb9f"
URL_RE = re.compile(
    r"(?i)(?:https?://|www\.|\b(?:t\.me|telegram\.me|discord\.gg|discord\.com/invite)/)[^\s<>]+"
    # a stratum endpoint: host:port
    r"|\b[a-z0-9-]+(?:\.[a-z0-9-]+)+:\d{2,5}\b"
    # a bare host with a TLD people actually use for this
    r"|\b[a-z0-9-]+(?:\.[a-z0-9-]+)*\.(?:com|net|org|io|app|xyz|pro|ai|me|co|gg|top|site|online|shop|"
    r"live|cash|fund|finance|capital|exchange|cloud|dev|tech|info|biz|ru|cn|in|uk|de)\b(?:/[^\s<>]*)?")
MOD_PERMS = 0x8 | 0x2000          # ADMINISTRATOR | MANAGE_MESSAGES
MOD_TTL = 3600


# Words that make a link a MINING link rather than an advert.
# Miner SOFTWARE names count too. SRBMiner-Multi and XMRig forks are how
# people actually mine this chain, so a link naming one is a mining link even
# when the poster wrote no sentence around it.
POOL_WORDS = re.compile(r"(?i)\b(pool|stratum|mining|miner|hashrate|hash rate|randompcn|worker|rig|solo|xmrig|srbminer|hiveos|cpuminer|randomx)\b")
# Words that make a "PCoin" link dangerous no matter how it is dressed up. A
# drainer site calls itself pcoin-something; a pool does not need any of these.
SCAM_WORDS = re.compile(r"(?i)\b(airdrop|claim|giveaway|free (coins?|tokens?|pcn)|bonus|double|presale|"
                        r"whitelist|seed phrase|recovery phrase|private key|connect (your )?wallet|"
                        r"validate|sync wallet|restore wallet|x2|2x)\b")
# A stratum endpoint: host:port, or a host that names the coin.
POOLISH = re.compile(r"(?i)(:\d{2,5}\b)|(\bpcoin\b)|(\bpcn\b)|(\bpool\b)")


# A bare host:port, ported from pcoin-group-watch. Telegram learned on
# 2026-09-17 (message 220) that requiring a pool WORD deletes a real pool
# share when the whole message is the endpoint. Discord never got that fix,
# so the same message was treated differently depending on where it landed.
HOSTPORT = re.compile(r"(?i)^(?:https?://)?[a-z0-9.\-]+:(\d{2,5})(?:[/?#]|$)")


def is_hostport(url):
    m = HOSTPORT.match((url or "").strip())
    if not m:
        return False
    try:
        port = int(m.group(1))
    except ValueError:
        return False
    return 1024 <= port <= 65535


def is_pool_link(text, url):
    """True when this looks like somebody sharing a PCoin pool or mining setup,
    and nothing about it looks like a scam. Used to REPORT instead of delete."""
    if SCAM_WORDS.search(text or "") or SCAM_WORDS.search(url or ""):
        return False
    # THE URL COUNTS AS WORDS, not only the sentence around it.
    #
    # Rabid Mining posted gitlab.com/rabidmining/xmrig-rabid-pcoin on BOTH
    # platforms. On Telegram he wrote "here is the miner I was using" and it was
    # correctly kept for a human to judge. On Discord he posted the bare URL,
    # the sentence had no mining word in it, and the identical link from the
    # identical person was DELETED -- twice. He noticed: "posted it before but
    # think the server auto deleted it".
    #
    # Splitting the URL on / and - turns "xmrig-rabid-pcoin" into words, so a
    # link that NAMES a miner counts as one whether or not the poster described
    # it. Deleting a contributor's own work because he was terse is the false
    # positive this filter can least afford.
    hay = "%s %s" % (text or "", (url or "").replace("/", " ").replace("-", " "))
    if POOL_WORDS.search(hay) and POOLISH.search(url or ""):
        return True
    # We pay 500 PCN for somebody standing up an independent pool, so a
    # stratum-shaped endpoint is REPORTED, never removed. Being wrong this
    # way costs the owner one manual delete; being wrong the other way costs
    # a contributor who believes we censored them.
    return is_hostport(url)


# INDEPENDENT PCoin POOLS run by people in this chat (owner, 2026-09-25). We pay
# a bounty for somebody standing up a pool that is not ours; deleting the link to
# one is deleting the thing we asked for. Alec's UI link was removed twice on
# Discord that morning because it named no pool word.
INDEPENDENT_POOLS = ("chatlab.rocks", "aioncore.pro")

# A REGULAR is somebody first seen at least a day before this message, with a
# few messages behind them. An outside link from a regular is REPORTED, not
# deleted: DangoMango had chatted and mined for two days when "Would it be
# alright if I get PCoin listed on www.fathom.cx ?" was removed as an advert.
# Spam comes from accounts whose first message is the link, and a silent member
# has no first-seen at all, so they are still removed.
REGULAR_AFTER = 24 * 3600
REGULAR_MIN_MSGS = 3
MEMBERS_KEEP = 5000


def is_regular(st, uid, at):
    m = (st.get("members") or {}).get(str(uid))
    if not m:
        return False
    try:
        return at - int(m[0]) >= REGULAR_AFTER and int(m[1]) >= REGULAR_MIN_MSGS
    except (TypeError, ValueError, IndexError):
        return False


def note_member(st, uid, at):
    """Remember when somebody was first seen and how many messages they have
    sent. Only messages that were NOT removed count."""
    if uid is None:
        return
    mem = st.setdefault("members", {})
    m = mem.get(str(uid))
    if not isinstance(m, list) or len(m) != 2:
        m = [int(at), 0]
    m[1] = int(m[1]) + 1
    mem[str(uid)] = m
    if len(mem) > MEMBERS_KEEP:
        # Drop the newest first-seen, never the oldest: the old ones are the
        # regulars, and forgetting one would start deleting their links again.
        for k, _ in sorted(mem.items(), key=lambda kv: -kv[1][0])[:len(mem) - MEMBERS_KEEP]:
            del mem[k]


def is_unroutable(host):
    """An address nobody outside the poster's own machine can reach cannot
    advertise anything. Tony pasted his pool's JSON config on 2026-09-22 to help
    debug, Telegram marked its bind address 0.0.0.0 as a link, and the whole
    message was deleted as "outside link: 0.0.0.0"."""
    if host == "localhost":
        return True
    try:
        return not ipaddress.ip_address(host).is_global
    except ValueError:
        return False


def link_allowed(url, guild=""):
    u = url.strip().lower()
    for pre in ("https://", "http://"):
        if u.startswith(pre):
            u = u[len(pre):]
    if u.startswith("www."):
        u = u[4:]
    host, _, path = u.partition("/")
    host = host.split(":")[0].rstrip(".")
    parts = [p for p in path.split("?")[0].split("/") if p]
    first = parts[0] if parts else ""
    if host == "pc.am" or host.endswith(".pc.am"):
        return True
    if is_unroutable(host):
        return True
    if any(host == d or host.endswith("." + d) for d in INDEPENDENT_POOLS):
        return True
    if host in ("t.me", "telegram.me"):
        return first in OUR_TG
    if host == "github.com":
        return first == "pars5555"
    if host == "discord.gg":
        return first == OUR_INVITE
    if host in ("discord.com", "discordapp.com"):
        if first == "invite":
            return len(parts) > 1 and parts[1] == OUR_INVITE
        # a link to a message in THIS server is how people point at each other
        return first == "channels" and len(parts) > 1 and parts[1] == guild
    if host == "play.google.com":
        return "am.pc.pcoin" in u
    if host == "webcrafterai.com" or host.endswith(".webcrafterai.com"):
        return True
    if host in ("bscscan.com", "pancakeswap.finance"):
        return True
    return False


def moderation_reason(m, guild="", regular=False):
    """(reason, delete) -- delete=False means report only and leave it. An outside
    link from a regular is reported, not deleted, unless it carries scam words."""
    text = m.get("content") or ""
    for raw in URL_RE.findall(text):
        url = raw.rstrip(").,!?>'\"")
        if url and not link_allowed(url, guild):
            if is_pool_link(text, url):
                return ("PCoin pool / mining link: %s -- LEFT IN THE CHAT for you to judge"
                        % url[:120], False)
            if regular and not SCAM_WORDS.search(text) and not SCAM_WORDS.search(url):
                return ("outside link from a regular: %s -- LEFT IN THE CHAT for you to judge"
                        % url[:120], False)
            return ("outside link: %s" % url[:120], True)
    return (None, False)


def is_moderator(token, guild, uid, st):
    """True for the server owner and anyone holding a role with Administrator or
    Manage Messages. Raises RuntimeError when it cannot tell -- and the caller
    then removes NOTHING, because an unknown must not collapse into "not staff"."""
    cache = st.setdefault("mod_cache", {})
    if time.time() - cache.get("at", 0) > MOD_TTL:
        g = dc_get(token, "/guilds/%s" % guild)
        roles = dc_get(token, "/guilds/%s/roles" % guild)
        cache.update(at=int(time.time()), owner=g.get("owner_id"),
                     mod_roles=[r["id"] for r in roles if int(r.get("permissions") or 0) & MOD_PERMS])
    if uid and uid == cache.get("owner"):
        return True
    mem = dc_get(token, "/guilds/%s/members/%s" % (guild, uid))
    return any(r in cache.get("mod_roles", []) for r in mem.get("roles") or [])


REMOVED_LOG = "/var/lib/pcoin-group-watch/removed.jsonl"


