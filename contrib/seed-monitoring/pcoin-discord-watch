def _discord_gone(e):
    """True when a DELETE failed because the message no longer exists.

    Discord answers 404 with code 10008 (Unknown Message) once the author,
    another moderator or Discord's own filter has removed it first. That is
    the outcome a removal wanted -- reporting it as "It is still visible."
    sent a false alarm on 2026-09-20. Any OTHER 404 (a wrong channel, say)
    still counts as a failure.
    """
    if getattr(e, "code", None) != 404:
        return False
    try:
        return json.loads(e.read().decode("utf-8", "replace")).get("code") == 10008
    except Exception:
        return False


def remove_and_report(token, tg_token, alert_chat, guild, channel, m, reason, do_delete=True):
    """Report WHO and WHY to the private channel first, then delete.
    Returns True once the report is delivered (deleted or not); False means
    nothing was deleted and the message is re-read next run."""
    a = m.get("author") or {}
    uid = a.get("id", "?")
    try:
        created = time.strftime("%Y-%m-%d", time.gmtime(snowflake_time(uid)))
        age_days = int((time.time() - snowflake_time(uid)) / 86400)
    except (TypeError, ValueError):
        created, age_days = "?", "?"
    when = time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(snowflake_time(m["id"])))
    link = "https://discord.com/channels/%s/%s/%s" % (guild, channel, m["id"])
    if DRY:
        print("  (dry-run: would report, then remove %s: %s)" % (m["id"], reason))
        return True
    head = ("🧹 <b>PCoin Discord — removing a message</b>" if do_delete
            else "⛏ <b>PCoin Discord — a mining link, left in place</b>")
    body = ("%s\n" % head +
            "<b>Why:</b> %s\n<b>Display name:</b> %s\n<b>Username:</b> %s\n<b>User id:</b> <code>%s</code>\n"
            "<b>Account created:</b> %s (%s days old)\n<b>Sent:</b> %s\n<b>Message:</b> %s\n<b>Text:</b>\n%s"
            % (html.escape(reason), html.escape(a.get("global_name") or "?"), html.escape(a.get("username") or "?"),
               uid, created, age_days, when, link, html.escape(describe(m)[:2500])))
    data = urllib.parse.urlencode({"chat_id": alert_chat, "parse_mode": "HTML",
                                   "disable_web_page_preview": "true", "text": body[:4000]}).encode()
    try:
        with urllib.request.urlopen(urllib.request.Request(
                "https://api.telegram.org/bot%s/sendMessage" % tg_token, data=data), timeout=30) as r:
            reported = bool(json.load(r).get("ok"))
    except (urllib.error.URLError, OSError, ValueError):
        reported = False
    if not reported:
        print("  report for %s failed -- nothing removed; retried next run" % m["id"], file=sys.stderr)
        return False
    if not do_delete:
        removed_log({"at": int(time.time()), "by": "pcoin-discord-watch", "platform": "discord",
                     "channel": channel, "message_id": m["id"], "sent": when,
                     "display_name": a.get("global_name"), "username": a.get("username"), "user_id": uid,
                     "reason": reason, "text": describe(m), "deleted": False,
                     "kept": "pool/mining link reported to the owner"})
        print("  reported (kept) %s: %s" % (m["id"], reason))
        return True
    deleted, gone, why_not = False, False, ""
    req = urllib.request.Request(API + "/channels/%s/messages/%s" % (channel, m["id"]), method="DELETE",
                                 headers={"Authorization": "Bot " + token,
                                          "User-Agent": "DiscordBot (https://pc.am, 1.0) pcoin-discord-watch"})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            deleted = r.status in (200, 204)
    except urllib.error.HTTPError as e:
        why_not = "HTTP %d" % e.code
        if _discord_gone(e):
            gone, why_not = True, "already gone (HTTP 404, Unknown Message)"
    except urllib.error.URLError as e:
        why_not = type(e.reason).__name__
    removed_log({"at": int(time.time()), "by": "pcoin-discord-watch", "platform": "discord", "channel": channel,
                 "message_id": m["id"], "sent": when, "display_name": a.get("global_name"),
                 "username": a.get("username"), "user_id": uid, "account_created": created,
                 "reason": reason, "text": describe(m), "deleted": deleted, "delete_error": why_not})
    if not deleted and not gone:
        data = urllib.parse.urlencode({"chat_id": alert_chat,
                                       "text": "⚠️ Could NOT delete Discord message %s (%s). It is still visible." % (m["id"], why_not)}).encode()
        try:
            urllib.request.urlopen(urllib.request.Request(
                "https://api.telegram.org/bot%s/sendMessage" % tg_token, data=data), timeout=30).close()
        except Exception:
            pass
    return True


# Channels that exist to be READ, not written to: bot feeds, stats tickers and
# the write-protected reference channels. Everything else in the guild is a place
# somebody might ask something, so everything else is watched.
SKIP_NAMES = re.compile(
    r"block-feed|live-stats|^\u23cf|^\U0001f4c8|^\u26cf|announcements|^rules$|^welcome$",
    re.I)


def discover_channels(token, guild, always):
    """Every channel a person could ask a question in, found rather than listed.

    ALWAYS INCLUDES THE CONFIGURED IDS. Discovery that silently replaced them
    would make a Discord permission change look like a working watcher.

    Forum posts are threads with their own ids, so a forum channel on its own
    reads as empty -- which is exactly how the question that prompted this went
    unseen for five hours. Active threads are listed guild-wide in one call;
    archived ones are fetched per forum, newest first.
    """
    found = list(always)
    seen = set(always)

    def add(cid):
        cid = str(cid)
        if cid not in seen:
            seen.add(cid)
            found.append(cid)

    try:
        chans = dc_get(token, "/guilds/%s/channels" % guild)
    except Exception as e:                                   # noqa: BLE001
        # Discovery failing is not "there are no channels": keep what we were
        # told and carry on, rather than quietly watching nothing.
        print("  channel discovery failed (%s); using the configured ids only" % type(e).__name__,
              file=sys.stderr)
        return found

    forums = []
    for c in chans:
        name = str(c.get("name") or "")
        if c.get("type") == 15:
            forums.append(c)
            continue
        if c.get("type") not in (0, 5):
            continue
        if SKIP_NAMES.search(name):
            continue
        add(c["id"])

    try:
        for t in (dc_get(token, "/guilds/%s/threads/active" % guild) or {}).get("threads", []):
            add(t["id"])
    except Exception as e:                                   # noqa: BLE001
        print("  active threads unreadable (%s)" % type(e).__name__, file=sys.stderr)

    for f in forums:
        try:
            arch = dc_get(token, "/channels/%s/threads/archived/public?limit=20" % f["id"])
            for t in (arch or {}).get("threads", []):
                add(t["id"])
        except Exception as e:                               # noqa: BLE001
            print("  archived threads in %s unreadable (%s)" % (f.get("name"), type(e).__name__), file=sys.stderr)

    return found


def main():
    dc = read_conf(DISCORD_CONF)
    token = dc.get("DISCORD_BOT_TOKEN", "")
    guild = dc.get("DISCORD_GUILD_ID", "")
    configured = [c for c in (dc.get("DISCORD_CHAT_CHANNEL_ID", ""),
                              dc.get("DISCORD_TEST_CHANNEL_ID", "")) if c.isdigit()]
    st = load_state()
    channels = discover_channels(token, guild, configured) if (token and guild) else configured

    if "--status" in sys.argv:
        print("  token       : %s" % ("set" if token else "MISSING"))
        print("  configured  : %s" % (", ".join(configured) or "NONE"))
        print("  watching    : %d channel(s) and thread(s), discovered from the guild" % len(channels))
        for c in channels:
            print("  cursor %s : %s" % (c, st["cursors"].get(c, "not started")))
        print("  seen        : %d" % st["seen"])
        print("  last run    : %s" % (time.strftime("%Y-%m-%d %H:%M:%S UTC", time.gmtime(st["last_run"]))
                                     if st["last_run"] else "never"))
        return 0

    if not token or not channels:
        sys.exit("DISCORD_BOT_TOKEN and at least one channel id are required in %s" % DISCORD_CONF)

    al = read_conf(ALERT_CONF)
    tg_token, alert_chat = al.get("TELEGRAM_TOKEN", ""), al.get("ALERT_CHAT", "")
    if not tg_token or not alert_chat:
        sys.exit("no TELEGRAM_TOKEN / ALERT_CHAT in %s -- cannot relay, refusing to advance" % ALERT_CONF)

    blank_bodies = 0
    for ch in channels:
        cursor = st["cursors"].get(ch)
        if not cursor:
            # First run for this channel: start from NOW, answer nothing old.
            latest = dc_get_soft(token, "/channels/%s/messages?limit=1" % ch)
            if latest is None:
                continue                      # cannot read it yet; do not seed a cursor
            st["cursors"][ch] = latest[0]["id"] if latest else "0"
            print("  %s: started at %s, history ignored" % (ch, st["cursors"][ch]))
            continue
        msgs = dc_get_soft(token, "/channels/%s/messages?after=%s&limit=50" % (ch, cursor))
        if msgs is None:
            continue                          # unreadable this run; cursor stays put
        msgs.sort(key=lambda m: int(m["id"]))
        delivered = cursor
        for m in msgs:
            a = m.get("author") or {}
            # Bots and webhooks -- including our own announcements and replies --
            # are consumed and never answered. A bot answering a bot is a loop.
            if a.get("bot") or m.get("webhook_id") or m.get("type") not in (0, 19):
                delivered = m["id"]
                continue
            # ---- moderation, BEFORE spool and relay ----------------------------
            reason, do_delete = moderation_reason(
                m, guild, regular=is_regular(st, a.get("id"), int(snowflake_time(m["id"]))))
            if reason and guild:
                try:
                    staff = is_moderator(token, guild, a.get("id"), st)
                except RuntimeError as e:
                    print("  cannot tell if %s is staff (%s) -- not removed" % (a.get("id"), e), file=sys.stderr)
                    staff = True
                if not staff:
                    if not remove_and_report(token, tg_token, alert_chat, guild, ch, m, reason, do_delete):
                        break               # the report may not be lost: retry next run
                    if do_delete:
                        delivered = m["id"]
                        continue
                    # Reported but kept: fall through and treat it as a normal message.
            note_member(st, a.get("id"), int(snowflake_time(m["id"])))
            text = m.get("content") or ""
            if not text and not m.get("attachments") and not m.get("sticker_items"):
                blank_bodies += 1
            urgent = bool(text and TRIGGERS.search(text))
            print("  %s %s: %s" % (m["id"], who(m), describe(m)[:120]))
            if DRY:
                delivered = m["id"]
                continue
            try:
                with open(LOG, "a", encoding="utf-8") as fh:
                    fh.write("%s\t%s\t%s\t%s\n" % (
                        time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(snowflake_time(m["id"]))),
                        who(m), describe(m).replace("\n", " ")[:600], m["id"]))
            except OSError as e:
                print("  log write failed: %s" % e, file=sys.stderr)
            try:
                spool({
                    "platform": "discord",
                    # "discord:<channel>" -- pcoin-group-answer maps this to a
                    # Discord destination and never to a Telegram one.
                    "chat": "discord:%s" % ch,
                    "message_id": m["id"],
                    "date": snowflake_time(m["id"]),
                    "from": "%s (on Discord)" % who(m),
                    "from_id": "dc:%s" % a.get("id", "?"),
                    "text": text,
                    "described": describe(m),
                    # THE PICTURE ITSELF, so the answer bot can look at it.
                    # Only the URL is carried; nothing is downloaded here and
                    # nothing is ever written to disk. Discord's own CDN is the
                    # only host it may come from, and the answer bot re-checks
                    # that plus the file's real bytes before showing it to a
                    # model -- a content_type is what the SENDER claims.
                    "image_url": image_url(m),
                    "has_image": bool(image_url(m)),
                    "urgent": urgent,
                })
            except OSError as e:
                print("  spool write failed: %s" % e, file=sys.stderr)
            if not relay(tg_token, alert_chat, guild, ch, m, urgent):
                break                       # retry from here next run
            delivered = m["id"]
            st["seen"] += 1
        st["cursors"][ch] = delivered

    if blank_bodies and time.time() - st["empty_alerted"] > 6 * 3600:
        st["empty_alerted"] = int(time.time())
        notify_ops("Discord messages arrive EMPTY",
                   "%d Discord message(s) came back with no text. That is the Message "
                   "Content intent being off in the Developer Portal, not quiet users: the "
                   "answer bot cannot read Discord until it is enabled." % blank_bodies)

    st["last_run"] = int(time.time())
    # Reached Discord for the whole pass: any run of transient failures is over.
    st.pop("down_since", None)
    if not DRY:
        save_state(st)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except TransientError as e:
        # A failed read resolves nothing: cursors are not advanced either way.
        # Whether it pages anyone depends on HOW LONG Discord has been failing.
        st = load_state()
        now = time.time()
        since = st.get("down_since")
        if not isinstance(since, (int, float)) or since <= 0:
            since = now
            st["down_since"] = int(now)
            if not DRY:
                save_state(st)
        if now - since < QUIET_SECONDS:
            print("  %s -- down %.0fs, staying quiet until %ds" % (e, now - since, QUIET_SECONDS),
                  file=sys.stderr)
            sys.exit(0)
        sys.exit("%s -- Discord has been failing for %.0f minutes" % (e, (now - since) / 60.0))
    except RuntimeError as e:
        # Not transient (bad token, missing access): alert at once.
        sys.exit(str(e))
