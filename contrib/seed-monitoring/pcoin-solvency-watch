#!/usr/bin/env python3
"""Watch the one number that decides whether wPCN is honest: is the PCN reserve
still at least as large as the wPCN people can redeem?

The 2026-09-04 audit found this unmonitored. The ratio was computed for display
on wrapdesk.pc.am/proof and never alarmed on, so a reserve that started draining
would have been visible to anyone who happened to load a web page and to nobody
else.

FIVE INDEPENDENT CHECKS. Each is its own alert, because "solvency" failing is not
one event -- a spend from the core reserve and an unexpected mint are different
emergencies needing different responses.

  A  the CORE reserve (pool index 0) must never DECREASE. It has held a single
     UTXO, unspent since height 5765. Any spend at all is an emergency, even one
     that leaves the ratio above 1.
  B  total reserve >= wPCN totalSupply. totalSupply is what holders can redeem
     RIGHT NOW, so this is the invariant that actually protects customers.
  C  total reserve >= wPCN issuedSupply. The conservative figure the public
     proof page shows. Breaching C while B holds is a warning, not an emergency.
  D  wPCN totalSupply must never INCREASE. There has been exactly one mint, in
     the constructor, and the contract has no mint path. Supply can only fall,
     via burns. An increase would mean the chain audit was wrong.
  E  the reads themselves must work.

DOCTRINE, learned the hard way on this project:
  * A failed or timed-out read RESOLVES NOTHING. It is never a zero balance and
    never a passing check. Checks A-D are simply NOT EVALUATED unless both sides
    were read. Only after FAIL_STREAK consecutive failures does E alert, and it
    says "cannot verify", never "insolvent".
  * Re-alerts are gated on CHANGE, not on time. pcoin-concentration-watch once
    sent the same figure 24 times in 8 hours and taught everyone to ignore it.
  * Settings live in the systemd unit's Environment= lines, so running this by
    hand silently loses them. If SOLVENCY_RESERVE is unset it says so LOUDLY on
    stderr before doing anything (runbook 7.14: a bare run of pcoin-wrapdesk-watch
    once paged the owner with a fabricated 50,000 PCN wrap request).
  * --dry-run must actually send nothing. It never invokes the notifier at all.
"""
import argparse
import json
import os
import subprocess
import sys
import time
import urllib.request

NOTIFY = os.environ.get("PCOIN_NOTIFY", "/usr/local/bin/pcoin-notify")
STATE_FILE = os.environ.get("SOLVENCY_STATE", "/var/lib/pcoin-wrapdesk/solvency.json")
POOL_FILE = os.environ.get("WRAP_POOL", "/opt/wrapdesk/reserve-pool.txt")
REQ_FILE = os.environ.get("WRAP_REQUESTS", "/var/lib/wrapdesk/requests.json")
TOKEN = os.environ.get("WPCN_TOKEN", "0x290A5779a419Cb9cB22fa087CDD1CD16dA2D95F1")
ISSUED = float(os.environ.get("WPCN_ISSUED", "50000"))
FAIL_STREAK = int(os.environ.get("SOLVENCY_FAIL_STREAK", "3"))
# PLANNED MOVES (2026-09-24). The owner moves reserve surplus to market-hot now
# and then, and check A paged "wPCN solvency: CRITICAL" every time -- correctly
# for a theft, wrongly for his own transfer, and an alarm that cries wolf is one
# people stop reading. So he registers a move BEFORE making it, in the admin
# panel (Reserve moves page, authenticator code required): amount, a window,
# a note. A later drop of the core reserve that MATCHES an unused plan -- same
# amount within PLAN_TOLERANCE (the network fee), inside the window, and with
# backing still whole -- is reported as a planned move instead of CRITICAL.
# Anything else still pages exactly as before, including any move that breaks
# backing, planned or not. The file is written only by the panel; which plans
# have been used is recorded HERE, in this watcher's own state.
PLANS_FILE = os.environ.get("SOLVENCY_PLANS", "/etc/pcoin/control/reserve-planned-moves.json")
PLAN_TOLERANCE = float(os.environ.get("SOLVENCY_PLAN_TOLERANCE", "0.01"))

RESERVE = os.environ.get("SOLVENCY_RESERVE", "")
if not RESERVE:
    RESERVE = "pc1q7hhzmdkkx0zjtzj6qkwmuvhlgwfqjrc6j2dk52"
    sys.stderr.write(
        "\n*** SOLVENCY_RESERVE is not set. ***\n"
        "This setting lives in the systemd unit's Environment= lines, so a run by\n"
        "hand does not inherit it and has fallen back to a COMPILED-IN default.\n"
        "If that default is not the live reserve address, every number below is\n"
        "about the wrong wallet. Do not reason about production from this run.\n\n")

EXPLORERS = [e for e in (os.environ.get("SOLVENCY_EXPLORER", ""),
                         "http://127.0.0.1:8080", "https://explorer.pc.am") if e]
BSC_RPCS = ["https://bsc-dataseed.binance.org", "https://bsc-dataseed1.defibit.io",
            "https://bsc.rpc.blxrbdn.com", "https://bsc-rpc.publicnode.com"]


class Unknown(Exception):
    """Raised when something could not be read. Never caught into a number."""


def jget(url, timeout=25):
    req = urllib.request.Request(url, headers={"User-Agent": "pcoin-solvency-watch/1"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def addr_balance(addr):
    """Confirmed mature PCN, plus lifetime sent. Raises Unknown rather than
    returning 0 -- a zero balance and an unreachable explorer look identical in
    a number and could not be more different in meaning."""
    last = None
    for base in EXPLORERS:
        try:
            d = jget("%s/api/address/%s" % (base, addr))
            c = d["balance"]["confirmed"]
            lt = d.get("balance", {}).get("lifetime", {})
            return float(c["mature_pcn"]), float(lt.get("sent_pcn", 0) or 0)
        except Exception as e:
            last = "%s: %s" % (base, e)
    raise Unknown("reserve address %s unreadable (%s)" % (addr, last))


def total_supply():
    last = None
    for u in BSC_RPCS:
        try:
            body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": "eth_call",
                               "params": [{"to": TOKEN, "data": "0x18160ddd"},
                                          "latest"]}).encode()
            req = urllib.request.Request(
                u, data=body, headers={"Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=25) as r:
                d = json.load(r)
            if "result" in d:
                return int(d["result"], 16) / 1e8
            last = str(d.get("error"))[:90]
        except Exception as e:
            last = "%s: %s" % (u.split("//")[1][:20], e)
    raise Unknown("wPCN totalSupply unreadable on every BSC endpoint (%s)" % last)


def allocated_addresses():
    """Deposit addresses the desk has handed out. Unreadable ones are SKIPPED,
    which can only undercount the surplus -- the safe direction to be wrong in.
    The core reserve is handled separately and is never allowed to be unknown."""
    try:
        pool = {}
        for line in open(POOL_FILE, encoding="utf-8"):
            p = line.rstrip("\n").split("\t")
            if len(p) == 2 and p[0].isdigit():
                pool[int(p[0])] = p[1]
        req = json.load(open(REQ_FILE, encoding="utf-8")).get("requests", {})
        return [pool[v["index"]] for v in req.values()
                if isinstance(v, dict) and v.get("index") in pool]
    except Exception:
        return []


def load_plans():
    """Unused, unexpired plans. An unreadable file is NO plans: it can only make
    the watcher stricter, never quieter."""
    try:
        j = json.load(open(PLANS_FILE, encoding="utf-8"))
        plans = j.get("plans", []) if isinstance(j, dict) else []
        return [x for x in plans if isinstance(x, dict) and x.get("id")]
    except FileNotFoundError:
        return []
    except Exception as e:
        print("  planned-moves file unreadable (%s) -- treating as NO plans" % e)
        return []


def match_plan(plans, drop, now, used):
    for x in plans:
        try:
            if x["id"] in used or x.get("cancelled"):
                continue
            if float(x.get("until", 0)) < now:
                continue
            if abs(float(x["pcn"]) - drop) <= PLAN_TOLERANCE:
                return x
        except (KeyError, TypeError, ValueError):
            continue
    return None


def load_state():
    """Normalise, never merely 'handle unreadable'. A file that parses but lacks
    a key once killed pcoin-wrapdesk-watch with KeyError on its first real
    event, so every key is defaulted here rather than assumed present."""
    try:
        s = json.load(open(STATE_FILE, encoding="utf-8"))
        if not isinstance(s, dict):
            s = {}
    except Exception:
        s = {}
    s.setdefault("core_pcn", None)
    s.setdefault("core_sent", None)
    s.setdefault("total_pcn", None)
    s.setdefault("supply", None)
    s.setdefault("fails", 0)
    s.setdefault("last_alert", "")
    s.setdefault("last_digest_day", "")
    s.setdefault("plans_used", {})
    return s


def save_state(s):
    d = os.path.dirname(STATE_FILE)
    if d:
        os.makedirs(d, exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(s, f, indent=1)
    os.replace(tmp, STATE_FILE)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--dry-run", action="store_true",
                    help="evaluate and print; notify nobody, at all")
    ap.add_argument("--digest", action="store_true",
                    help="send one healthy summary per UTC day (for a daily timer)")
    ap.add_argument("--force-supply", type=float,
                    help="TEST ONLY: pretend totalSupply is this, to prove the alarm fires")
    ap.add_argument("--force-reserve", type=float,
                    help="TEST ONLY: pretend the core reserve is this")
    a = ap.parse_args()

    def notify(subject, body):
        if a.dry_run:
            print("\n--- DRY RUN: would have sent this, and did NOT ---")
            print("SUBJECT: %s\n%s" % (subject, body))
            return
        subprocess.run([NOTIFY, subject, body], timeout=60)

    st = load_state()
    alerts, warns = [], []

    try:
        core_pcn, core_sent = addr_balance(RESERVE)
        if a.force_reserve is not None:
            core_pcn = a.force_reserve
        alloc = allocated_addresses()
        extra, skipped = 0.0, 0
        for ad in alloc:
            try:
                b, _ = addr_balance(ad)
                extra += b
            except Unknown:
                skipped += 1
        total = core_pcn + extra
        supply = a.force_supply if a.force_supply is not None else total_supply()
    except Unknown as e:
        st["fails"] += 1
        print("  UNREADABLE: %s (streak %d)" % (e, st["fails"]))
        if st["fails"] >= FAIL_STREAK and st["last_alert"] != "unreadable":
            notify("\U0001F7E1 wPCN backing could not be checked",
                   "The check could not read the reserve or the wPCN supply (%d tries in a "
                   "row). This does NOT mean the reserve is short -- only that it was not "
                   "checked.\n"
                   "What to do: nothing if the next check works; if it repeats, check that "
                   "explorer.pc.am loads.\n"
                   "\u2014\ntech: wPCN solvency CANNOT VERIFY: %s" % (st["fails"], e))
            st["last_alert"] = "unreadable"
        save_state(st)
        return 0

    st["fails"] = 0
    ratio_out = total / supply if supply else None
    ratio_iss = total / ISSUED if ISSUED else None

    print("  core reserve (index 0) : %.8f PCN   (lifetime sent %.8f)" % (core_pcn, core_sent))
    print("  allocated deposits     : %.8f PCN   (%d addresses, %d unreadable)"
          % (extra, len(alloc), skipped))
    print("  TOTAL RESERVE          : %.8f PCN" % total)
    print("  wPCN totalSupply       : %.8f" % supply)
    print("  wPCN issuedSupply      : %.8f" % ISSUED)
    print("  backing vs outstanding : %.4f%%" % (ratio_out * 100 if ratio_out else 0))
    print("  backing vs issued      : %.4f%%" % (ratio_iss * 100 if ratio_iss else 0))

    # A0 - a move the owner registered in advance. Only a drop that matches an
    # unused plan AND leaves backing whole qualifies; it then replaces the two A
    # items below for this run. It is never silent: it sends its own notice.
    planned, planned_note = None, ""
    if (st["core_pcn"] is not None and core_pcn < st["core_pcn"] - 1e-8
            and total + 1e-8 >= ISSUED):
        drop = st["core_pcn"] - core_pcn
        planned = match_plan(load_plans(), drop, time.time(), st["plans_used"])
        if planned is not None:
            info = ("A. PLANNED MOVE: the core reserve moved %.8f PCN (%.8f -> %.8f). It matches "
                    "the plan registered %s UTC for %.8f PCN (\"%s\"), inside its window, and "
                    "backing is still whole. Record it in PCOIN-WPCN-RUNBOOK.md."
                    % (drop, st["core_pcn"], core_pcn,
                       time.strftime("%Y-%m-%d %H:%M", time.gmtime(float(planned.get("created", 0)))),
                       float(planned["pcn"]), str(planned.get("note", ""))[:120]))
            print("  " + info)
            planned_note = info
            if not a.dry_run and a.force_supply is None and a.force_reserve is None:
                st["plans_used"][planned["id"]] = {"at": int(time.time()), "moved": round(drop, 8)}

    # A - the core reserve must never shrink, and must never have spent anything
    if planned is None and st["core_pcn"] is not None and core_pcn < st["core_pcn"] - 1e-8:
        alerts.append("A. The main reserve wallet went DOWN by %.8f PCN (%.8f -> %.8f). "
                      "It has held one untouched coin since height 5765, so nothing should "
                      "leave it without you."
                      % (st["core_pcn"] - core_pcn, st["core_pcn"], core_pcn))
    # A NEW spend, never the lifetime total.
    #
    # `core_sent` only ever counts UP, so gating on "> 0" meant the first
    # legitimate surplus withdrawal pinned this alert on permanently: the
    # monitor could never return to ok, and a monitor that is always red hides
    # every alert after it. That is the same mistake `blocks_unwound == 0` made
    # when one ordinary reorg stopped all six PCN rails for three and a half
    # days -- a cumulative counter is not a health flag.
    #
    # It fired for real on 2026-09-18, on a surplus withdrawal that was correct,
    # documented in PCOIN-WPCN-RUNBOOK.md, and left backing at 100.0025%.
    #
    # What is worth waking someone for is a spend NOBODY EXPECTED, so the
    # question is whether it MOVED since the last look -- and whether backing
    # survived it, which is what separates a withdrawal from a theft.
    if st["core_sent"] is None:
        if core_sent > 0:
            warns.append("A. First look at this reserve: %.8f PCN has left it over its "
                         "lifetime. That is history, not evidence -- compare it with "
                         "PCOIN-WPCN-RUNBOOK.md." % core_sent)
    elif planned is None and core_sent > st["core_sent"] + 1e-8:
        moved = core_sent - st["core_sent"]
        if total + 1e-8 >= ISSUED:
            warns.append("A. %.8f PCN left the main reserve wallet since the last check, "
                         "and every wPCN is still backed -- that looks like a withdrawal of "
                         "the surplus. Confirm it was you. (Lifetime out: %.8f PCN.)"
                         % (moved, core_sent))
        else:
            alerts.append("A. %.8f PCN left the main reserve wallet since the last check "
                          "AND the reserve no longer covers every wPCN. (Lifetime out: "
                          "%.8f PCN.)" % (moved, core_sent))

    # B - the invariant that protects holders
    if total + 1e-8 < supply:
        alerts.append("B. The reserve (%.8f PCN) is SMALLER than the wPCN in circulation "
                      "(%.8f): %.8f PCN short, so not every holder could be paid."
                      % (total, supply, supply - total))

    # C - the conservative public figure
    if total + 1e-8 < ISSUED:
        warns.append("C. The reserve (%.8f PCN) is below the %.0f wPCN ever issued, so "
                     "wrapdesk.pc.am/proof will show under 100 percent. It still covers "
                     "every wPCN actually in circulation." % (total, ISSUED))

    # D - supply can only ever fall
    if st["supply"] is not None and supply > st["supply"] + 1e-8:
        alerts.append("D. The number of wPCN went UP: %.8f -> %.8f (+%.8f). The "
                      "contract cannot mint, so this should be impossible -- verify the "
                      "token address now."
                      % (st["supply"], supply, supply - st["supply"]))

    # The owner's line first -- how many PCN back how many wPCN, as one
    # percentage -- and the exact figures after it for whoever checks the math.
    summary = ("The reserve holds %s PCN for %s wPCN in circulation: %.2f%% backed "
               "(%.2f%% of the %s wPCN ever issued)."
               % (f"{total:,.2f}", f"{supply:,.2f}",
                  ratio_out * 100 if ratio_out else 0,
                  ratio_iss * 100 if ratio_iss else 0, f"{ISSUED:,.0f}"))
    body = ("tech:\n"
            "Reserve (core)      %.8f PCN\n"
            "Reserve (total)     %.8f PCN\n"
            "wPCN outstanding    %.8f\n"
            "wPCN issued         %.8f\n"
            "Backing/outstanding %.4f percent\n"
            "Backing/issued      %.4f percent\n"
            "Reserve address     %s\n"
            % (core_pcn, total, supply, ISSUED,
               ratio_out * 100 if ratio_out else 0,
               ratio_iss * 100 if ratio_iss else 0, RESERVE))
    # The codes ("A.", "B." ...) stay on the stored strings because the change
    # gate fingerprints them; they are dropped from what the owner reads.
    plain = lambda x: x[3:] if len(x) > 3 and x[1:3] == ". " else x

    # Sent once: the plan is recorded as used below, and the reserve figure it
    # compared against moves on with the state.
    if planned_note:
        notify("\U0001F7E2 wPCN reserve: your planned move happened",
               plain(planned_note) + "\n" + summary
               + "\nWhat to do: nothing -- it matched the move you registered."
               + "\n\u2014\n" + body)

    if alerts or warns:
        sev = "CRITICAL" if alerts else "warning"
        codes = {x[:2] for x in alerts}
        if "B." in codes:
            todo = ("close the wrap desk and find where the reserve PCN went -- "
                    "PCOIN-WPCN-RUNBOOK.md has the steps.")
        elif "D." in codes:
            todo = "check the wPCN token contract on BscScan now: no new wPCN should ever appear."
        elif "A." in codes:
            todo = ("if you did not move reserve PCN yourself, treat it as theft and check "
                    "the reserve wallet now. If you did, record it in PCOIN-WPCN-RUNBOOK.md "
                    "(next time register it first on admin.pc.am, Reserve moves).")
        else:
            todo = ("confirm the reserve move was yours and record it in PCOIN-WPCN-RUNBOOK.md; "
                    "nothing else -- backing is still whole.")
        subj = ("\U0001F534 wPCN backing: CRITICAL -- act now" if alerts
                else "\U0001F7E1 wPCN backing: please confirm a reserve move")
        text = ("\n".join(plain(x) for x in alerts + warns) + "\n" + summary
                + "\nWhat to do: " + todo + "\n\u2014\n" + body)
        fp = "|".join(x[:2] for x in alerts + warns)
        if st["last_alert"] != fp:          # re-alert on CHANGE, not on a timer
            notify(subj, text)
            st["last_alert"] = fp
        else:
            print("  (same condition as the last run - not re-sending)")
        for x in alerts + warns:
            print("  !! " + x)
    else:
        print("  OK - every invariant holds")
        if st["last_alert"] not in ("", "ok"):
            notify("\U0001F7E2 wPCN backing is whole again",
                   "Every check passes again. " + summary
                   + "\nWhat to do: nothing.\n\u2014\n" + body)
        st["last_alert"] = "ok"
        day = time.strftime("%Y-%m-%d", time.gmtime())
        if a.digest and st["last_digest_day"] != day:
            # The date goes in the BODY, not just the state file. pcoin-notify
            # dedupes on the message text for REPEAT_HOURS, and a healthy digest
            # is byte-identical from one day to the next -- so the 2026-09-05
            # digest was logged "suppressed" and never reached the channel. A
            # daily heartbeat that silently stops is worse than none, because
            # its absence is what you would watch for.
            notify("\U0001F7E2 wPCN is fully backed (%.1f%%) -- daily check"
                   % (ratio_out * 100 if ratio_out else 0),
                   "%s\nWhat to do: nothing.\n\u2014\nchecked %s UTC\n%s"
                   % (summary, time.strftime("%Y-%m-%d %H:%M", time.gmtime()), body))
            st["last_digest_day"] = day

    if not a.dry_run and a.force_supply is None and a.force_reserve is None:
        st["core_pcn"], st["core_sent"] = core_pcn, core_sent
        st["total_pcn"], st["supply"] = total, supply
        save_state(st)
    else:
        print("  (state NOT written: dry-run or forced test values)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
