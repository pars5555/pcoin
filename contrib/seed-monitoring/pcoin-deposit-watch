#!/bin/bash
# Watch the PCN deposit watchers.
#
# Every payment integration already reports whether it WOULD credit. None of
# them reported whether they were RUNNING, and that is the gap this closes.
#
# The failure this exists for actually happened, twice, in one session:
#
#   * A previous session inspected checker, webbuilderbot and aicontrol, found
#     no scheduler in the place it looked, and recorded all three as having no
#     watcher. All three were running. That error was harmless -- it
#     under-reported health.
#   * 3dmodels' watcher ran every minute, logged a clean tick, and could not
#     credit anything at all: /tx/{txid} returns an envelope it did not unwrap,
#     so an internal consistency check compared height 0 against the real one
#     and held every deposit forever. `enabled: true`, fresh pool, valid xpub,
#     cron firing -- every observable signal said healthy. It was found only
#     because the owner sent real money and watched nothing happen.
#
# So this checks LIVENESS and PROGRESS, not configuration. Configuration is
# what already looked fine in both cases.
#
# Checks, per integration present on this host:
#   1. heartbeat age            -- is the watcher ticking at all?
#   2. heartbeat ok flag        -- is it ticking but erroring? (different fault)
#   3. deposits stuck confirming -- is it ticking, healthy, and still not paying?
#   4. reorg-flagged credits    -- did a credited deposit leave the chain?
#
# Check 3 is the one that would have caught 3dmodels. A watcher can be alive and
# still never settle anything; only the age of an unsettled deposit shows that.
#
# Credentials are read from each app's own config at run time. They are
# deliberately NOT copied into a config of their own: a second copy is a second
# thing to rotate and the first one to go stale.
#
# Alerting is delegated to pcoin-notify, which owns the destination and the
# dedupe window. Nothing here contains a token. If pcoin-notify is missing this
# still runs and logs -- a monitor that dies because it cannot report is worse
# than one that reports nowhere.
#
# Exit code is 0 unless the script itself broke. A detected problem is an alert,
# not a non-zero exit: cron mail on top of a Telegram alert is just noise.

set -u

# All three are overridable so the detection paths can be exercised without
# waiting for a real outage -- and, in the case of NOTIFY, without firing a
# false "watcher STOPPED" at whoever reads the alert channel. A monitor that has
# only ever been observed saying "healthy" has not been tested; that is the
# exact mistake this script exists to catch, and it applies to the script too.
#   STALE_SECONDS=0 ./pcoin-deposit-watch          -> every heartbeat reads stale
#   NOTIFY=/tmp/echo-notify ./pcoin-deposit-watch  -> alerts go nowhere real
# Optional per-host settings. Holds the portrait2video bearer token (mode 600)
# and, on a host that is only responsible for some rails, a narrowed
# RAILS_EXPECTED. Sourced rather than parsed so a host can override any
# threshold in here too.
CONF=${CONF:-/etc/pcoin-deposit-watch.conf}
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"

NOTIFY="${NOTIFY:-/usr/local/bin/pcoin-notify}"
STALE_SECONDS="${STALE_SECONDS:-900}"      # 15 min; watchers tick every 60 s
HOLD_TICKS="${HOLD_TICKS:-30}"             # how many ticks the holding check judges
HOLD_MIN_TICKS="${HOLD_MIN_TICKS:-10}"     # fewer than this is UNKNOWN, not healthy
HOLD_PCT="${HOLD_PCT:-80}"                 # alert when this % of them credited nothing
STUCK_HOURS="${STUCK_HOURS:-6}"            # 6 conf is ~1 h, so 6 h is well past
PROBLEMS=0

log() { logger -t pcoin-deposit-watch -- "$*" 2>/dev/null || printf '%s\n' "$*"; }

alert() {   # alert <subject> <body>
    PROBLEMS=$((PROBLEMS + 1))
    log "ALERT: $1 -- $2"
    [ -x "$NOTIFY" ] && "$NOTIFY" "$1" "$2" >/dev/null 2>&1
}

# ---------------------------------------------------- coverage manifest ----
#
# EVERY RAIL THAT TAKES PCN IS NAMED HERE, and the run is not complete until
# each one has been positively checked.
#
# Why this exists: every rail below is guarded by `if [ -r <its config> ]` with
# no else. That is fine on the host where the rail lives and silently fatal
# anywhere else -- the check does not fail, it VANISHES, and the script exits 0
# having examined nothing. Measured 2026-08-29 on this host: four of the five
# then-declared rails had no readable config here, so the run produced no output
# at all. Silence from a monitor is indistinguishable from health, and this one
# had been reporting nothing for weeks while reading as "all healthy".
#
# The rule this enforces is the one the estate already learned twice: a check
# that only prints is not a check, and a rail nobody checked is not a rail that
# is fine. An unreachable rail now ALERTS as unmonitored rather than disappearing.
# Overridable per host: no single machine can read every rail's evidence, so
# each one declares the rails it is RESPONSIBLE for and the union is what
# covers the estate. That union is written down in this directory's README --
# a per-host list nobody adds up is how a rail ends up owned by nobody.
RAILS_EXPECTED="${RAILS_EXPECTED:-checker webbuilderbot aicontrol 3dmodels.pc.am 3dmodel.oonak.ai portrait2video webai pcnaibot}"
RAILS_SEEN=""
seen_rail() { RAILS_SEEN="$RAILS_SEEN $1"; }

now=$(date +%s)

# mysql_q <user> <pass> <db> <sql>  -- one scalar, empty on any failure.
mysql_q() {
    mysql -h127.0.0.1 -u"$1" -p"$2" "$3" -N -B --raw -e "$4" 2>/dev/null
}

# sqlite_q <dbfile> <sql>  -- one scalar, empty on any failure.
#
# The MySQL twin above cannot serve every rail: pcnaibot runs on a host with no
# mysql client and no server, and MariaDB must not be installed there. Without
# this, that rail would get heartbeat-only monitoring -- exactly "asked 'is it
# ticking', not 'is it settling anything'", which is the 2026-08-30 outage.
#
# -readonly so a monitor can never write to a money database, and the SAME
# CONTRACT as mysql_q: EMPTY MEANS THE QUERY FAILED, never "zero rows".
sqlite_q() {
    [ -r "$1" ] || return 0
    sqlite3 -readonly -noheader -batch "$1" "$2" 2>/dev/null
}

# ---------------------------------------------------------------- checks ----

# check_heartbeat <label> <age_seconds|empty> <extra>
#
# An UNREADABLE heartbeat is not a healthy one and not a dead one -- it is
# unknown, and it gets its own message. Collapsing it into either direction is
# the mistake this whole codebase is written against.
check_heartbeat() {
    local label="$1" age="$2" extra="${3:-}"
    if [ -z "$age" ]; then
        alert "PCN watcher unreadable: $label" \
              "Could not read $label's heartbeat. This is NOT proof the watcher is down, and NOT proof it is up -- the check itself failed. $extra"
        return
    fi
    if [ "$age" -gt "$STALE_SECONDS" ]; then
        alert "PCN watcher STOPPED: $label" \
              "No tick for $((age / 60)) min (threshold $((STALE_SECONDS / 60)) min). Deposits are not being credited. $extra"
    fi
}

# check_holding <label> <logfile>
#
# "Alive and crediting nothing" -- the watcher ticks, exits clean, and settles
# no money. A stopped watcher is loud; this is silent, and it is what a real
# credit outage looks like from outside.
#
# Count TICKS, not log lines. A refusing tick writes three lines here (a
# [WARNING], a bare echo, and the summary), so the previous `tail -n 30 |
# grep -c skipped=` spanned only ten ticks and could never reach its own
# threshold of 25. It stayed quiet for the whole 2026-08-30 outage. The summary
# line is the one carrying `seen=`, so that is what a tick is counted by.
check_holding() {
    local label="$1" logf="$2" ticks held reason
    [ -r "$logf" ] || return 0          # readability is already alerted on by check_heartbeat
    local recent
    recent=$(tail -n 400 "$logf" 2>/dev/null | grep 'seen=' | tail -n "$HOLD_TICKS")
    ticks=$(printf '%s\n' "$recent" | grep -c 'seen=')
    held=$(printf '%s\n' "$recent" | grep -c 'skipped=')
    # Too few ticks to judge is UNKNOWN, not healthy: say nothing rather than pass.
    [ "${ticks:-0}" -ge "$HOLD_MIN_TICKS" ] || return 0
    if [ "$held" -ge $(( ticks * HOLD_PCT / 100 )) ]; then
        reason=$(printf '%s\n' "$recent" | grep -o 'skipped=[^ ]*' | tail -1)
        alert "PCN watcher HOLDING: $label" \
              "$held of the last $ticks ticks credited nothing ($reason). The watcher is alive, exiting clean, and settling no money -- this is what a silent credit outage looks like, not a healthy rail."
    fi
}

# check_deposits <label> <user> <pass> <db> <deposits_table> <seen_col>
# Watches 'seen' as well as 'confirming'.
#
# 'seen' is a mempool sighting: recorded, owed to a user, and not yet credited.
# A transaction that never confirms -- dropped, replaced, or simply never mined
# -- leaves the row in 'seen' forever, and every held-money check in this
# estate looked only at 'confirming', so that money was invisible. The two
# states differ in how far a deposit got, not in whether somebody is waiting
# for it.
check_deposits() {
    local label="$1" u="$2" p="$3" db="$4" tbl="$5" seen="$6"

    local stuck
    stuck=$(mysql_q "$u" "$p" "$db" \
        "SELECT COUNT(*) FROM \`$tbl\` WHERE status IN ('seen','confirming') AND \`$seen\` < (NOW() - INTERVAL $STUCK_HOURS HOUR);")
    if [ -z "$stuck" ]; then
        # An empty result is a FAILED query, not "no stuck deposits". Saying
        # nothing here would be the monitor reproducing the bug it is watching
        # for: a check that cannot run reported as a check that passed.
        alert "PCN monitor BROKEN: $label" \
              "The stuck-deposit query returned nothing against $db.$tbl. Assume deposits are UNMONITORED on $label until this is fixed."
    elif [ "$stuck" -gt 0 ]; then
        local detail
        detail=$(mysql_q "$u" "$p" "$db" \
            "SELECT GROUP_CONCAT(CONCAT(LEFT(txid,12),' h',IFNULL(block_height,'?'),' conf',confirmations) SEPARATOR '; ')
               FROM \`$tbl\` WHERE status IN ('seen','confirming') AND \`$seen\` < (NOW() - INTERVAL $STUCK_HOURS HOUR) LIMIT 5;")
        alert "PCN deposit STUCK: $label" \
              "$stuck deposit(s) held for over ${STUCK_HOURS}h (status seen or confirming). The watcher may be running and still not settling -- check its log for a hold reason. $detail"
    fi

    # The three integrations mark a post-credit reorg THREE different ways, and
    # none of them is wrong -- but a monitor that knows only one of them reports
    # "no reorgs" on the other two forever:
    #
    #   checker, 3dmodels : column reorg_flagged_at (timestamp, NULL = clean)
    #   aicontrol         : column reorg_flagged    (tinyint)
    #   webbuilderbot     : NO column -- it writes note LIKE 'REORG %' and
    #                       pings its admin directly (PcoinWatcher::recheckCredited)
    #
    # So try each, and if NOT ONE of them can be evaluated, say so loudly rather
    # than returning a comfortable zero.
    local reorged=""
    for q in "reorg_flagged_at IS NOT NULL" "reorg_flagged = 1" "note LIKE 'REORG %'"; do
        reorged=$(mysql_q "$u" "$p" "$db" \
            "SELECT COUNT(*) FROM \`$tbl\` WHERE status='credited' AND $q;")
        [ -n "$reorged" ] && break
    done

    if [ -z "$reorged" ]; then
        alert "PCN monitor BROKEN: $label" \
              "No reorg marker on $db.$tbl could be evaluated (tried reorg_flagged_at, reorg_flagged, note LIKE 'REORG %'). A credited deposit could leave the chain on $label and nothing would notice."
    elif [ "$reorged" -gt 0 ]; then
        alert "PCN REORG on credited deposit: $label" \
              "$reorged credited deposit(s) flagged as reorged. Credit was NOT reversed automatically -- a human decides. Review before the balance is spent."
    fi
}

# check_deposits_sqlite <label> <dbfile> <table> <first_seen_col>
#
# The SQLite twin of check_deposits, carrying the SAME THREE ALARMS: an empty
# result is BROKEN, a stuck deposit is loud, and an unevaluable reorg marker is
# BROKEN rather than a comfortable zero.
#
# Two differences from the MySQL version, both forced by the schema:
#   * first_seen is an INTEGER UNIX EPOCH here, not a DATETIME, so the stuck
#     predicate is arithmetic rather than `NOW() - INTERVAL n HOUR`;
#   * the open set is `status NOT IN ('credited','rejected')` rather than an
#     explicit ('seen','confirming'). That is deliberate and WIDER: this rail
#     also has 'held' and 'dropped', and 'dropped' is NOT terminal -- the
#     watcher keeps re-driving it. A monitor listing only two states would be
#     blind to exactly the rows most likely to be stuck.
check_deposits_sqlite() {
    local label="$1" dbf="$2" tbl="$3" seen="$4"

    if [ ! -r "$dbf" ]; then
        alert "PCN monitor BROKEN: $label"               "Cannot read $label's deposit database at $dbf. Assume deposits are UNMONITORED on $label until this is fixed."
        return
    fi

    local cutoff stuck
    cutoff=$(( now - STUCK_HOURS * 3600 ))
    stuck=$(sqlite_q "$dbf"         "SELECT COUNT(*) FROM $tbl WHERE status NOT IN ('credited','rejected') AND $seen < $cutoff;")
    if [ -z "$stuck" ]; then
        # An empty result is a FAILED query, not "no stuck deposits". Saying
        # nothing here would be the monitor reproducing the bug it watches for.
        alert "PCN monitor BROKEN: $label"               "The stuck-deposit query returned nothing against $dbf. Assume deposits are UNMONITORED on $label until this is fixed."
    elif [ "$stuck" -gt 0 ]; then
        local detail
        detail=$(sqlite_q "$dbf"             "SELECT group_concat(s, '; ') FROM (SELECT substr(txid,1,12) || ' h' || COALESCE(block_height,'?') || ' ' || status AS s
               FROM $tbl WHERE status NOT IN ('credited','rejected') AND $seen < $cutoff ORDER BY $seen ASC LIMIT 5);")
        alert "PCN deposit STUCK: $label"               "$stuck deposit(s) open for over ${STUCK_HOURS}h (status not credited or rejected). The watcher may be running and still not settling -- check its log for a hold reason. $detail"
    fi

    # This rail marks a post-credit reorg with reorg_flagged_at -- the cleanest
    # of the three shapes the MySQL twin accepts. Still: if it cannot be
    # evaluated, SAY SO rather than returning a comfortable zero.
    local reorged
    reorged=$(sqlite_q "$dbf" "SELECT COUNT(*) FROM $tbl WHERE status='credited' AND reorg_flagged_at IS NOT NULL;")
    if [ -z "$reorged" ]; then
        alert "PCN monitor BROKEN: $label"               "The reorg marker on $dbf ($tbl.reorg_flagged_at) could not be evaluated. A credited deposit could leave the chain on $label and nothing would notice."
    elif [ "$reorged" -gt 0 ]; then
        alert "PCN REORG on credited deposit: $label"               "$reorged credited deposit(s) flagged as reorged. Credit was NOT reversed automatically -- a human decides. Review before the balance is spent."
    fi

    # Money that arrived at an address whose user is gone. The watcher records
    # and holds it; nothing else would ever surface it.
    local orphan
    orphan=$(sqlite_q "$dbf" "SELECT COUNT(*) FROM $tbl WHERE chat_id IS NULL AND status NOT IN ('credited','rejected');")
    if [ -n "$orphan" ] && [ "$orphan" -gt 0 ]; then
        alert "PCN deposit ORPHANED: $label"               "$orphan deposit(s) arrived at an issued address with no user bound to it. The money is on chain and cannot be credited to anybody until a human decides whose it is."
    fi

    # A deposit credited over a 30-day cap, uncorroborated, or while floor
    # parity was breached, is CREDITED AND FLAGGED by design -- the coins are
    # already ours and refusing them is the worst of both outcomes. But a flag
    # nobody reads is the same as no flag.
    local flagged
    flagged=$(sqlite_q "$dbf" "SELECT COUNT(*) FROM $tbl WHERE flagged_reason IS NOT NULL AND credited_at > $(( now - 86400 ));")
    if [ -n "$flagged" ] && [ "$flagged" -gt 0 ]; then
        alert "PCN deposit FLAGGED: $label"               "$flagged deposit(s) were credited WITH A FLAG in the last 24h (over-cap, uncorroborated or floor-parity). They were credited on purpose; a human should look at why."
    fi
}

# ------------------------------------------------------------- checker ------
CHK=/var/www/checker_pc_am/config/config.json
if [ -r "$CHK" ]; then
    seen_rail checker
    eval "$(python3 -c "
import json;d=json.load(open('$CHK'))
print('u=%r;p=%r;db=%r' % (d['db_user'],d['db_pass'],d['db_name']))
" 2>/dev/null)"
    if [ -n "${u:-}" ]; then
        last=$(mysql_q "$u" "$p" "$db" \
            "SELECT JSON_UNQUOTE(JSON_EXTRACT(value,'\$.last_poll_at')) FROM settings WHERE \`key\`='pcoin';")
        age=""; [ -n "$last" ] && [ "$last" != "null" ] && age=$((now - last))
        check_heartbeat "checker.pc.am" "$age" "Cron: /etc/cron.d/checker_pc_am hits /cron every minute."
        check_deposits  "checker.pc.am" "$u" "$p" "$db" pcn_deposits first_seen_at
    fi
    unset u p db
fi

# -------------------------------------------------------- webbuilderbot -----
WBB=/var/www/ai-bots/bots/webbuilderbot/config.json
if [ -r "$WBB" ]; then
    seen_rail webbuilderbot
    eval "$(python3 -c "
import json;d=json.load(open('$WBB'))
print('u=%r;p=%r;db=%r' % (d['db_user'],d['db_pass'],d['db_name']))
" 2>/dev/null)"
    if [ -n "${u:-}" ]; then
        last=$(mysql_q "$u" "$p" "$db" \
            "SELECT JSON_UNQUOTE(JSON_EXTRACT(value,'\$.last_poll_at')) FROM settings WHERE name='pcoin';")
        [ -z "$last" ] && last=$(mysql_q "$u" "$p" "$db" \
            "SELECT JSON_UNQUOTE(JSON_EXTRACT(value,'\$.last_poll_at')) FROM settings WHERE \`key\`='pcoin';")
        age=""; [ -n "$last" ] && [ "$last" != "null" ] && age=$((now - last))
        check_heartbeat "webbuilderbot" "$age" "Cron: pars crontab runs cron/1min.php every minute."
        check_deposits  "webbuilderbot" "$u" "$p" "$db" pcn_deposits first_seen_at
    fi
    unset u p db
fi

# ------------------------------------------------------------ aicontrol -----
AIC=/var/www/ai-control-server/.env
if [ -r "$AIC" ]; then
    seen_rail aicontrol
    u=$(grep -E '^DB_USER=' "$AIC" | head -1 | cut -d= -f2-)
    p=$(grep -E '^DB_PASS=' "$AIC" | head -1 | cut -d= -f2-)
    db=$(grep -E '^DB_NAME=' "$AIC" | head -1 | cut -d= -f2-)
    if [ -n "${u:-}" ]; then
        hb=$(mysql_q "$u" "$p" "$db" \
            "SELECT value FROM settings WHERE \`key\`='pcoin_watcher_heartbeat';")
        last=$(printf '%s' "$hb" | python3 -c "import json,sys;print(json.load(sys.stdin).get('at',''))" 2>/dev/null)
        okflag=$(printf '%s' "$hb" | python3 -c "import json,sys;print(json.load(sys.stdin).get('ok'))" 2>/dev/null)
        err=$(printf '%s' "$hb" | python3 -c "import json,sys;print(json.load(sys.stdin).get('last_error') or '')" 2>/dev/null)
        age=""; [ -n "$last" ] && age=$((now - last))
        check_heartbeat "aicontrol" "$age" "In-process setInterval in pm2 'ai-control-server' -- pm2 restart revives it."
        if [ "$okflag" = "False" ]; then
            alert "PCN watcher ERRORING: aicontrol" \
                  "aicontrol's watcher is ticking but its last tick threw: $err. Running-and-failing is a different fault from stopped."
        fi
        check_deposits "aicontrol" "$u" "$p" "$db" pcn_deposits first_seen_at
    fi
    unset u p db
fi

# ---------------------------------------------------------------- webai -----
# webai.pc.am. Same shape as aicontrol: Node, MySQL on the host, an in-process
# watcher writing settings.pcoin_watcher_heartbeat. Runs in Docker, so the
# heartbeat is the only pulse visible from outside the container.
WEBAI=/var/www/webai-server/.env
if [ -r "$WEBAI" ]; then
    seen_rail webai
    u=$(grep -E '^DB_USER=' "$WEBAI" | head -1 | cut -d= -f2-)
    p=$(grep -E '^DB_PASS=' "$WEBAI" | head -1 | cut -d= -f2-)
    db=$(grep -E '^DB_NAME=' "$WEBAI" | head -1 | cut -d= -f2-)
    if [ -n "${u:-}" ]; then
        hb=$(mysql_q "$u" "$p" "$db" \
            "SELECT value FROM settings WHERE \`key\`='pcoin_watcher_heartbeat';")
        last=$(printf '%s' "$hb" | python3 -c "import json,sys;print(json.load(sys.stdin).get('at',''))" 2>/dev/null)
        okflag=$(printf '%s' "$hb" | python3 -c "import json,sys;print(json.load(sys.stdin).get('ok'))" 2>/dev/null)
        err=$(printf '%s' "$hb" | python3 -c "import json,sys;print(json.load(sys.stdin).get('last_error') or '')" 2>/dev/null)
        skipped=$(printf '%s' "$hb" | python3 -c "import json,sys;print(','.join(json.load(sys.stdin).get('summary',{}).get('skipped',[])))" 2>/dev/null)
        age=""; [ -n "$last" ] && age=$((now - last))

        # `at` is UNIX SECONDS here. It was milliseconds until 2026-09-06, which
        # made age about -1.8e12 -- never greater than STALE_SECONDS, so the
        # staleness alert could not fire and a dead watcher read as healthy.
        # If age is wildly negative the unit has regressed; say so rather than
        # silently passing, because that is the failure mode being guarded.
        if [ -n "$age" ] && [ "$age" -lt -86400 ]; then
            alert "PCN monitor BROKEN: webai" \
                  "webai's heartbeat 'at' is $last, which is $((0 - age)) s in the future. It is almost certainly milliseconds instead of seconds, and while that is true the staleness check CANNOT fire. Treat webai as unmonitored until fixed."
        else
            check_heartbeat "webai" "$age" "In-process setInterval in docker container 'webai' -- 'docker compose restart' in /var/www/webai-server revives it."
        fi

        if [ "$okflag" = "False" ]; then
            alert "PCN watcher ERRORING: webai" \
                  "webai's watcher is ticking but its last tick threw: $err. Running-and-failing is a different fault from stopped."
        fi

        # A deliberately-off rail is not a crash, but it is also not fine once
        # users hold addresses: their deposits land and are never credited.
        # Before any address is issued the rail simply has not launched, and
        # alerting every five minutes about that is how people learn to ignore
        # this channel. So the pool decides which it is.
        case ",$skipped," in
            *,disabled,*)
                issued=$(mysql_q "$u" "$p" "$db" "SELECT COUNT(*) FROM pcn_addresses WHERE user_id IS NOT NULL;")
                if [ -n "$issued" ] && [ "$issued" -gt 0 ]; then
                    alert "PCN watcher DISABLED: webai" \
                          "webai's watcher reports itself disabled while $issued user(s) already hold a deposit address. Anything they send is landing on chain and is NOT being credited. Re-enable it in the admin Payments page, or take webai out of RAILS_EXPECTED."
                else
                    log "webai: watcher disabled and no address issued yet -- rail not launched, not a fault"
                fi
                ;;
        esac

        check_deposits "webai" "$u" "$p" "$db" pcn_deposits first_seen_at
    fi
    unset u p db
fi

# ------------------------------------------------------------- 3dmodels -----
# No DB heartbeat: its watcher is a CLI script under cron that appends a line
# per tick. The log's mtime is therefore a true external pulse, and needs no
# rebuild of the image to obtain.
M3D_LOG=/var/www/3dmodels.pc.am/logs/pcn.log
M3D_DIR=/var/www/3dmodels.pc.am/code
if [ -d "$M3D_DIR" ]; then
    seen_rail 3dmodels.pc.am
    if [ -r "$M3D_LOG" ]; then
        mtime=$(stat -c %Y "$M3D_LOG" 2>/dev/null)
        age=""; [ -n "$mtime" ] && age=$((now - mtime))
        check_heartbeat "3dmodels.pc.am" "$age" "Cron: root crontab runs scripts/pcn-watch.php --once every minute."
    else
        check_heartbeat "3dmodels.pc.am" "" "Log $M3D_LOG is unreadable."
    fi

    # A hold reason repeating every tick is the 3dmodels signature: alive,
    # clean exit, crediting nothing. Worth an alert on its own.
    check_holding "3dmodels.pc.am" "$M3D_LOG"

    # HELD MONEY on 3dmodels, which nothing checked until now.
    #
    # Every other rail gets check_deposits() against its database. 3dmodels did
    # not, because its MariaDB lives inside a container with no host-reachable
    # port -- so the one service whose silent credit outage this whole script was
    # written for was the one service whose deposits table was never read. The
    # log heartbeat above proves the watcher RAN; it cannot prove a deposit was
    # settled, and those are exactly the two things the 3dmodels incident showed
    # are different.
    #
    # Reached the only way it can be: through the db container, with the root
    # password read from the secret file INSIDE that container so it never
    # appears here or in a process list.
    if command -v docker >/dev/null 2>&1; then
        m3dbc=$(cd "$M3D_DIR" 2>/dev/null && docker compose ps -q db 2>/dev/null)
        if [ -n "$m3dbc" ]; then
            m3pwf=$(docker inspect "$m3dbc" --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null | sed -n 's/^MARIADB_ROOT_PASSWORD_FILE=//p')
            m3db=$(docker inspect "$m3dbc" --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null | sed -n 's/^MARIADB_DATABASE=//p')
            if [ -n "$m3pwf" ] && [ -n "$m3db" ]; then
                m3stuck=$(docker exec -i "$m3dbc" sh -lc "mariadb -N -uroot -p\"\$(cat $m3pwf)\" \"$m3db\" -e \"SELECT COUNT(*) FROM pcn_deposits WHERE status IN ('seen','confirming') AND first_seen_at < (NOW() - INTERVAL $STUCK_HOURS HOUR);\"" 2>/dev/null | tr -d '[:space:]')
                if [ -z "$m3stuck" ]; then
                    # Same rule as everywhere else: a query that did not run is
                    # not a clean result.
                    alert "PCN monitor BROKEN: 3dmodels.pc.am"                           "The held-deposit query returned nothing against the 3dmodels db container. Assume its deposits are UNMONITORED until this is fixed."
                elif [ "$m3stuck" -gt 0 ]; then
                    m3detail=$(docker exec -i "$m3dbc" sh -lc "mariadb -N -uroot -p\"\$(cat $m3pwf)\" \"$m3db\" -e \"SELECT GROUP_CONCAT(CONCAT(LEFT(txid,12),' ',FORMAT(amount_sat/1e8,2),'PCN ',status) SEPARATOR '; ') FROM pcn_deposits WHERE status IN ('seen','confirming') AND first_seen_at < (NOW() - INTERVAL $STUCK_HOURS HOUR) LIMIT 5;\"" 2>/dev/null)
                    alert "PCN deposit STUCK: 3dmodels.pc.am"                           "$m3stuck deposit(s) held for over ${STUCK_HOURS}h. Money is recorded and not credited. $m3detail"
                fi
            fi
        fi
    fi
fi

# ------------------------------------------------------- 3dmodel.oonak.ai ----
# THE FIFTH RAIL, AND THE ONE NOTHING WATCHED.
#
# It went dark for nearly two hours on 2026-08-21 with nobody noticing, and the
# reason is structural rather than an oversight in the checks below: this script
# only ever ran on the two hosts that do NOT host it. 3dmodel.oonak.ai lives on
# its own box (it migrated there on 2026-08-21, which is the same day it went
# quiet), so every check in this file was blind to it by construction. The fix
# is therefore two things -- this section, and installing the script on that
# host at all.
#
# It is FILE-BASED, not SQL. There is no database to query, so both checks read
# the filesystem:
#   * the pulse is the rail log's mtime -- cron appends one line per tick, the
#     same shape as the 3dmodels check above, and it needs nothing from the app;
#   * the money is in deposits.json, a dict keyed "txid:address" (the correct
#     key -- vout is always 0 for these, so keying on it silently drops a second
#     deposit to the same address).
OON_LOG=${OON_LOG:-/var/log/3dmodel-pcn.log}
OON_DIR=${OON_DIR:-/var/www/3dmodel/data/pcn}
if [ -d "$OON_DIR" ]; then
    seen_rail 3dmodel.oonak.ai
    if [ -r "$OON_LOG" ]; then
        mtime=$(stat -c %Y "$OON_LOG" 2>/dev/null)
        age=""; [ -n "$mtime" ] && age=$((now - mtime))
        check_heartbeat "3dmodel.oonak.ai" "$age" \
            "Cron: /etc/cron.d/3dmodel-pcn runs app/api/pcn-watch.php --once every minute as www-data."
    else
        check_heartbeat "3dmodel.oonak.ai" "" "Log $OON_LOG is unreadable."
    fi

    # Same holding check as 3dmodels: this rail logs in the identical format and
    # had none, so it refused every deposit from 2026-08-30 onward in silence.
    check_holding "3dmodel.oonak.ai" "$OON_LOG"

    # HELD MONEY, read straight out of deposits.json.
    #
    # Same rule as every other rail: a read that did not happen is NOT a clean
    # result. If the file is missing, unparseable, or python is absent, that is
    # an alert saying the deposits are unmonitored -- never a silent pass. The
    # 3dmodels incident was precisely a rail that looked healthy while settling
    # nothing, and the only thing that shows it is the age of an unsettled row.
    oon_dep="$OON_DIR/deposits.json"
    if ! command -v python3 >/dev/null 2>&1; then
        alert "PCN monitor BROKEN: 3dmodel.oonak.ai" \
              "python3 is not installed on this host, so deposits.json cannot be read. Assume 3dmodel.oonak.ai deposits are UNMONITORED until this is fixed."
    elif [ ! -r "$oon_dep" ]; then
        alert "PCN monitor BROKEN: 3dmodel.oonak.ai" \
              "$oon_dep is missing or unreadable. Assume 3dmodel.oonak.ai deposits are UNMONITORED until this is fixed."
    else
        oon_out=$(STUCK_HOURS="$STUCK_HOURS" python3 - "$oon_dep" <<'PYEOF' 2>/dev/null
import json, os, sys, time
path = sys.argv[1]
cutoff = time.time() - float(os.environ.get("STUCK_HOURS", "6")) * 3600
try:
    with open(path, encoding="utf-8") as fh:
        deps = json.load(fh)
except Exception as exc:                      # unparseable == unknown, not clean
    print("ERR %s" % str(exc)[:120])
    raise SystemExit(0)
if not isinstance(deps, dict):
    print("ERR deposits.json is %s, expected an object" % type(deps).__name__)
    raise SystemExit(0)
stuck = []
reorged = []
for key, d in deps.items():
    if not isinstance(d, dict):
        continue
    # Reorg flag is set on CREDITED rows, so scan for it before the
    # seen/confirming filter or it can never be seen.
    if d.get("reorg_flagged_at"):
        reorged.append(str(d.get("txid", key))[:12])
    if d.get("status") not in ("seen", "confirming"):
        continue
    # `created` is a unix timestamp. A row with no timestamp cannot be aged, so
    # it counts as stuck rather than being quietly skipped.
    ts = d.get("created")
    try:
        ts = float(ts)
    except (TypeError, ValueError):
        ts = 0.0
    if ts < cutoff:
        stuck.append("%s %.2fPCN %s" % (str(d.get("txid", key))[:12],
                                        (d.get("amount_sat") or 0) / 1e8,
                                        d.get("status")))
print("OK %d %d %s" % (len(stuck), len(reorged),
                       "; ".join(stuck[:5]) or "-"))
PYEOF
)
        case "${oon_out:-}" in
            OK*)
                oon_n=$(printf '%s' "$oon_out" | awk '{print $2}')
                oon_r=$(printf '%s' "$oon_out" | awk '{print $3}')
                oon_detail=$(printf '%s' "$oon_out" | cut -d' ' -f4-)
                if [ "${oon_n:-0}" -gt 0 ]; then
                    alert "PCN deposit STUCK: 3dmodel.oonak.ai" \
                          "$oon_n deposit(s) held for over ${STUCK_HOURS}h. Money is recorded and not credited. $oon_detail"
                fi
                # Symmetry with every other rail, all of which get a reorg
                # check. The rail FLAGS and never reverses -- a human decides.
                if [ "${oon_r:-0}" -gt 0 ]; then
                    alert "PCN reorg on credited deposit: 3dmodel.oonak.ai"                           "$oon_r credited deposit(s) flagged as reorged. Credit was NOT reversed automatically -- a human decides. Review before the balance is spent."
                fi
                ;;
            *)
                alert "PCN monitor BROKEN: 3dmodel.oonak.ai" \
                      "Could not read held deposits from $oon_dep (${oon_out:-no output}). Assume 3dmodel.oonak.ai deposits are UNMONITORED until this is fixed."
                ;;
        esac
    fi
fi

# ------------------------------------------------------- portrait2video ----
#
# The first rail that is NOT on a watcher host: SQLite on its own box, with no
# config here to read and no database to query. Granting this host SSH to the
# machine that takes payments, to answer three integers, is a worse trade than
# asking over HTTP -- so it exposes a read-only status endpoint carrying
# heartbeat age, stuck count and reorg count, and nothing else. No money, no
# addresses, no user data.
#
# An unset URL is NOT a pass. A rail nobody configured is a rail nobody is
# watching, and it says so.
P2V_URL=${P2V_MONITOR_URL:-}
P2V_TOKEN=${P2V_MONITOR_TOKEN:-}
if [ -n "$P2V_URL" ] && [ -n "$P2V_TOKEN" ]; then
    seen_rail portrait2video
    # The token is a PATH segment, not a header, and a wrong one answers 404 --
    # deliberately indistinguishable from "no such route", so a leaked URL
    # cannot be probed for whether the token half is close.
    p2v_out=$(curl -fsS --max-time 20 "${P2V_URL%/}/$P2V_TOKEN" 2>/dev/null || true)
    if [ -z "$p2v_out" ]; then
        check_heartbeat "portrait2video" ""             "Status endpoint $P2V_URL did not answer. The rail may be fine and the endpoint down; nothing here can tell."
    else
        p2v_age=$(printf '%s' "$p2v_out" | python3 -c "import json,sys
try:
    d = json.load(sys.stdin)
except Exception:
    raise SystemExit
a = d.get('heartbeat_age_s', d.get('heartbeat_age_seconds', d.get('age_seconds')))
print(int(a) if isinstance(a, (int, float)) else '')" 2>/dev/null)
        # enabled:false means the rail turned its own watcher off. That is not a
        # fault and not health -- it is a deliberate state somebody chose, and it
        # must not read as "fine" just because the endpoint answered.
        p2v_en=$(printf '%s' "$p2v_out" | python3 -c "import json,sys
try:
    print('1' if json.load(sys.stdin).get('enabled', True) else '0')
except Exception:
    pass" 2>/dev/null)
        if [ "$p2v_en" = "0" ]; then
            alert "PCN watcher DISABLED: portrait2video"                   "The rail reports its own deposit watcher as disabled. Deposits are not being credited. This is a chosen state, not a crash -- re-enable it there, or take the rail out of RAILS_EXPECTED."
        else
            check_heartbeat "portrait2video" "$p2v_age"                 "systemd timer portrait2video-pcn-watch on that host runs the watcher."
        fi
        p2v_stuck=$(printf '%s' "$p2v_out" | python3 -c "import json,sys
try:
    print(int(json.load(sys.stdin).get('stuck', 0)))
except Exception:
    pass" 2>/dev/null)
        if [ -n "$p2v_stuck" ] && [ "$p2v_stuck" -gt 0 ]; then
            alert "PCN deposits HELD: portrait2video"                   "$p2v_stuck deposit(s) seen but not credited for over $STUCK_HOURS h. Somebody paid and is holding nothing."
        fi
        p2v_reorg=$(printf '%s' "$p2v_out" | python3 -c "import json,sys
try:
    print(int(json.load(sys.stdin).get('reorged', 0)))
except Exception:
    pass" 2>/dev/null)
        if [ -n "$p2v_reorg" ] && [ "$p2v_reorg" -gt 0 ]; then
            alert "PCN REORG on credited deposit: portrait2video"                   "$p2v_reorg credited deposit(s) flagged as reorged. Credit was NOT reversed automatically -- a human decides."
        fi
    fi
fi
# ------------------------------------------------------------ pcnaibot -----
# The PCN AI bot: a Telegram bot selling paid AI models for PCN.
#
# The only SQLite rail in the estate. It lives on a host with no mysql client
# and no server, and MariaDB must not be installed there -- hence sqlite_q()
# and check_deposits_sqlite() above.
#
# Guarded by `[ -r ... ]` with no else, like every other rail here, which means
# on any host where this rail does not live the check VANISHES rather than
# failing. That is exactly why the rail must ALSO appear in that host's
# RAILS_EXPECTED: the block and the RAILS_EXPECTED entry are two separate
# obligations, and the second is what makes the first one's absence loud.
# Overridable for the same reason CONF, NOTIFY and STATE_DIR are (see the
# header): a check nobody can exercise against known-bad input is a check
# nobody has tested, and "prove it FIRES" is a launch gate, not a nicety.
PCNAI_CONF="${PCNAI_CONF:-/etc/pcoin/pcnaibot.conf}"
PCNAI_DB="${PCNAI_DB:-/var/lib/pcnaibot/pcnaibot.db}"
PCNAI_HB="${PCNAI_HB:-/var/lib/pcnaibot/heartbeat.json}"
PCNAI_LOG="${PCNAI_LOG:-/var/log/pcnaibot/watcher.log}"
if [ -r "$PCNAI_CONF" ] || [ -r "$PCNAI_DB" ]; then
    seen_rail pcnaibot

    # The heartbeat is a FILE written tmp+fsync+rename by the watcher unit, so
    # a torn write can never be read as a stale one.
    hb=""; [ -r "$PCNAI_HB" ] && hb=$(cat "$PCNAI_HB" 2>/dev/null)
    last=""; okflag=""; err=""; skipped=""
    if [ -n "$hb" ]; then
        last=$(printf '%s' "$hb" | python3 -c "import json,sys;print(json.load(sys.stdin).get('at',''))" 2>/dev/null)
        okflag=$(printf '%s' "$hb" | python3 -c "import json,sys;print(json.load(sys.stdin).get('ok'))" 2>/dev/null)
        err=$(printf '%s' "$hb" | python3 -c "import json,sys;print(json.load(sys.stdin).get('last_error') or '')" 2>/dev/null)
        skipped=$(printf '%s' "$hb" | python3 -c "import json,sys;print(','.join(json.load(sys.stdin).get('summary',{}).get('skipped',[])))" 2>/dev/null)
    fi
    age=""; [ -n "$last" ] && age=$((now - last))

    # `at` is UNIX SECONDS. If it is ever milliseconds, age goes hugely negative
    # and the staleness check CANNOT FIRE -- a dead watcher then reads as
    # healthy. That is webai's 2026-09-06 bug; refuse to be quiet about it.
    if [ -n "$age" ] && [ "$age" -lt -86400 ]; then
        alert "PCN monitor BROKEN: pcnaibot"               "pcnaibot's heartbeat 'at' is $last, which is $((0 - age)) s in the future. It is almost certainly milliseconds instead of seconds, and while that is true the staleness check CANNOT fire. Treat pcnaibot as unmonitored until fixed."
    else
        check_heartbeat "pcnaibot" "$age" "systemd timer pcnaibot-watch.timer on this host -- 'systemctl start pcnaibot-watch.service' runs one tick."
    fi

    if [ "$okflag" = "False" ]; then
        alert "PCN watcher ERRORING: pcnaibot"               "pcnaibot's watcher is ticking but its last tick threw: $err. Running-and-failing is a different fault from stopped."
    fi

    # A deliberately-off rail is not a crash, but it is also not fine once users
    # hold addresses: their deposits land and are never credited. Before any
    # address is issued the rail simply has not launched, and alerting every
    # five minutes about that is how people learn to ignore this channel. So the
    # POOL decides which it is -- issued means assigned_at IS NOT NULL, never
    # chat_id IS NOT NULL, because a deleted user nulls chat_id and their
    # address can still receive coin forever.
    case ",$skipped," in
        *,disabled,*)
            issued=$(sqlite_q "$PCNAI_DB" "SELECT COUNT(*) FROM pcn_addresses WHERE assigned_at IS NOT NULL;")
            if [ -n "$issued" ] && [ "$issued" -gt 0 ]; then
                alert "PCN watcher DISABLED: pcnaibot"                       "pcnaibot's watcher reports itself disabled while $issued user(s) already hold a deposit address. Anything they send is landing on chain and is NOT being credited. Re-enable it, or take pcnaibot out of RAILS_EXPECTED."
            else
                log "pcnaibot: watcher disabled and no address issued yet -- rail not launched, not a fault"
            fi
            ;;
    esac

    # "Alive and crediting nothing." This rail gets a real log FILE for exactly
    # this reason: check_holding is file-based (`[ -r "$logf" ] || return 0`)
    # and journald is not a file, so every DB-heartbeat rail in this estate --
    # checker, webbuilderbot, aicontrol, webai, portrait2video -- has NO holding
    # check at all. That gap is the 2026-08-30 three-and-a-half-day outage.
    check_holding "pcnaibot" "$PCNAI_LOG"

    check_deposits_sqlite "pcnaibot" "$PCNAI_DB" pcn_deposits first_seen_at
fi




# ------------------------------------------------------ coverage report ----
#
# A rail that was never examined is not a healthy rail. Anything declared in
# RAILS_EXPECTED that no check reached gets said out loud here.
#
# Change-gated, not time-gated: the concentration watcher taught this estate
# that repeating an identical alert every few minutes is how people learn to
# ignore it. The state file holds the last set reported, so a steady state is
# silent -- but the set is re-asserted once a day, because a gap that scrolled
# past weeks ago is exactly the one nobody remembers.
RAILS_MISSING=""
for r in $RAILS_EXPECTED; do
    case " $RAILS_SEEN " in
        *" $r "*) : ;;
        *) RAILS_MISSING="$RAILS_MISSING $r" ;;
    esac
done
RAILS_MISSING="${RAILS_MISSING# }"

if [ -n "$RAILS_MISSING" ]; then
    STATE_DIR=${STATE_DIR:-/var/lib/pcoin-deposit-watch}
    mkdir -p "$STATE_DIR" 2>/dev/null || true
    STATE_FILE="$STATE_DIR/unmonitored"
    stamp="$(date -u +%Y-%m-%d) $RAILS_MISSING"
    prev=$(cat "$STATE_FILE" 2>/dev/null || true)
    if [ "$stamp" != "$prev" ]; then
        printf '%s
' "$stamp" > "$STATE_FILE" 2>/dev/null || true
        n=$(printf '%s' "$RAILS_MISSING" | wc -w)
        alert "PCN rails NOT MONITORED: $n of $(printf '%s' "$RAILS_EXPECTED" | wc -w)"               "No check ran for:$(printf '%s' " $RAILS_MISSING") -- their evidence is not readable from $(hostname 2>/dev/null || echo "this host"). This is NOT a report that those rails are broken, and NOT a report that they are fine: nothing looked. Deposits there could be stuck or uncredited and this watcher would still have said nothing."
    fi
else
    rm -f "${STATE_DIR:-/var/lib/pcoin-deposit-watch}/unmonitored" 2>/dev/null || true
fi

if [ "$PROBLEMS" -eq 0 ] && [ -z "$RAILS_MISSING" ]; then
    log "all PCN deposit watchers healthy ($(printf '%s' "$RAILS_EXPECTED" | wc -w) rails checked)"
elif [ "$PROBLEMS" -eq 0 ]; then
    log "no faults found, but coverage is incomplete -- unchecked:$RAILS_MISSING"
fi
exit 0