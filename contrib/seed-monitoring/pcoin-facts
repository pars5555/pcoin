    "mining_page": "https://pc.am/mining/",
}
# These change on a release, not by the minute: read them at most every 10 min.
TEXT_CACHE_SECONDS = 600

# One transaction, looked up by its own id. NOT in SOURCES because it is asked
# per question rather than collected on a timer.
WITHDRAWAL_STATUS = "https://exchange.pc.am/api/withdrawal-status?txid=%s"
# The same id on the PCoin chain, when the exchange has no record of it. A 404
