# Public pages that are TEXT, not JSON. Each is reduced to a few parsed values at
# collect time -- the page itself is never cached or printed. A marker that is not
# found gives None (UNKNOWN), never a guessed value.
TEXT_SOURCES = {
    # The wrap desk's front page. On 2026-09-23 the bot told a member wrapping was
