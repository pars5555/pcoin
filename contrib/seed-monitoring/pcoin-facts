def get(url):
    req = urllib.request.Request(url, headers={"User-Agent": "pcoin-facts"})
    # ONE retry. A single dropped connection from a busy box is not an outage,
    # but a source that fails twice really is unreadable and must say so rather
    # than be retried forever into silence.
    last = None
    for attempt in (1, 2):
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
                return json.load(r), None
        except Exception as e:
            last = e
            if attempt == 1:
                time.sleep(1)
    return None, "%s: %s" % (type(last).__name__, str(last)[:80])


def get_text(url):
    """A public page as text -> (text, None) or (None, error). Same retry as get()."""
    req = urllib.request.Request(url, headers={"User-Agent": "pcoin-facts"})
    last = None
    for attempt in (1, 2):
        try:
            with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
                return r.read(400000).decode("utf-8", "replace"), None
        except Exception as e:
            last = e
            if attempt == 1:
                time.sleep(1)
    return None, "%s: %s" % (type(last).__name__, str(last)[:80])


def parse_text(name, t):
    """Reduce one TEXT_SOURCES page to the few values we use. None = not found."""
    if name == "wrapdesk":
        # Both strings come from the desk's own template (wrapdesk-server.mjs,
        # home()): the paused card replaces the sign-in button entirely.
        if "New wrap requests are paused" in t:
            return {"intake": "paused"}
        if "Sign in to wrap" in t:
            return {"intake": "open"}
        return {"intake": None}
    if name in ("win_miner", "win_wallet"):
        m = re.search(r"\[string\]\$Version\s*=\s*'([0-9.]+)'", t)
        return {"version": m.group(1) if m else None}
    if name == "linux":
        m = re.search(r'^VER="?v?([0-9.]+)"?', t, re.M)
        return {"version": m.group(1) if m else None}
    if name == "mining_page":
        m = re.search(r"releases/download/v([0-9.]+)/pcoin-android-miner\.apk", t)
        return {"android_miner_release": m.group(1) if m else None}
    return {}


def collect(prev=None):
    out, errs = {}, {}
    for name, url in SOURCES.items():
        d, err = get(url)
        if err:
            errs[name] = err
        else:
            out[name] = d
    # Slow sources: reuse the previous reading while it is fresh enough.
    prev = prev or {}
    if prev.get("text") and time.time() - prev.get("text_at", 0) < TEXT_CACHE_SECONDS:
        text, text_errs, text_at = prev["text"], prev.get("text_unreadable", {}), prev["text_at"]
    else:
        text, text_errs, text_at = {}, {}, int(time.time())
        for name, url in TEXT_SOURCES.items():
            t, err = get_text(url)
            if err:
                text_errs[name] = err
            else:
                text[name] = parse_text(name, t)
    return {"at": int(time.time()), "data": out, "unreadable": errs,
            "text": text, "text_unreadable": text_errs, "text_at": text_at}


def cached(refresh=False):
    prev = None
    try:
        prev = json.load(open(CACHE, encoding="utf-8"))
    except Exception:
        prev = None
    if not refresh and prev and time.time() - prev.get("at", 0) < CACHE_SECONDS:
        return prev
    c = collect(None if refresh else prev)
    try:
        os.makedirs(os.path.dirname(CACHE), exist_ok=True)
        tmp = CACHE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(c, fh)
        os.replace(tmp, CACHE)
    except Exception:
        pass
    return c


def _epoch(v):
    """Seconds since the epoch from whatever the pool API gave us.

    It returns an ISO-8601 string ("2026-09-22T01:12:05.858Z") but a millisecond
    integer is the other plausible shape and has appeared in this codebase
    before, so both are accepted. Anything else RAISES rather than returning a
    zero -- a bad timestamp read as 1970 would render as "480,000 hours ago",
    which looks like data instead of the parse failure it is.
    """
    if isinstance(v, (int, float)):
        return float(v) / 1000.0 if float(v) > 1e11 else float(v)
    import datetime
    return datetime.datetime.strptime(
        str(v)[:19], "%Y-%m-%dT%H:%M:%S").replace(
            tzinfo=datetime.timezone.utc).timestamp()


def n(v, dp=None):
    """Render a number without inventing precision, and never render None as 0."""
    if v is None:
        return "unknown"
    try:
        f = float(v)
    except Exception:
        return str(v)
    return ("%%.%df" % dp) % f if dp is not None else ("%g" % f)


def explorer_health(timeout=8):
    """Are the explorer's PAGES serving? -> (state, detail).

    state is "ok", "bad" or None for unknown. Deliberately probes the HTML that
    people open rather than /api/status: on 2026-09-18 the API answered 200 for
    hours while a third of page loads returned 500, and every monitor on the
    estate called that healthy. Two probes, because that fault was intermittent.
    """
    import urllib.request as _u
    codes = []
    for path in ("/", "/blocks"):
        try:
            req = _u.Request("https://explorer.pc.am" + path,
                             headers={"User-Agent": "pcoin-facts"})
            with _u.urlopen(req, timeout=timeout) as r:
                codes.append(r.status)
        except Exception as e:
            code = getattr(e, "code", None)
            if code is None:
                # Could not reach it AT ALL from this box. That is UNKNOWN, not
                # "down" -- our network and the user's are different things.
                return None, type(e).__name__
            codes.append(code)
    if all(c == 200 for c in codes):
        return "ok", ""
    return "bad", "/ -> %s, /blocks -> %s" % tuple(codes + ["?"])[:2]


# LAST BLOCK -- how long ago, and whether that is odd. Added 2026-09-24 after a
# gap of 2 h 19 min (9378 -> 9379): a user asked twice whether something was
# wrong, and the bot -- which knew the HEIGHT but not WHEN that block came --
# answered "gaps happen, the chain corrects itself". The age of the tip is the
# number that question needs, and at a 600 s target its odds are exact:
# P(gap > t) = e^(-t / 10 min).
LONG_GAP_MIN = 45   # e^-4.5: about one gap in 90
STALL_MIN = 90      # e^-9:   about one gap in 8,100


def last_block(c):
    """{height, time, age_min, state, pool_height, agree} or None if unknown.

    The explorer gives the tip and its timestamp; the pool's API reports the
    height its OWN node is at -- a second, independent node. `agree` is None
    when the pool could not be read: unknown, never "they agree"."""
    d = c.get("data") or {}
    ch = (d.get("chain") or {}).get("chain") or {}
    bt, h = ch.get("block_time"), ch.get("height")
    if not isinstance(bt, (int, float)) or bt <= 0:
        return None
    age = (time.time() - bt) / 60.0
    pool = d.get("pool") or {}
    ns = (pool.get("pool") or pool).get("networkStats") or {}
    ph = ns.get("blockHeight")
    return {"height": h, "time": int(bt), "age_min": round(age, 1),
            "state": "stalled" if age >= STALL_MIN else "long" if age >= LONG_GAP_MIN else "normal",
            "pool_height": ph, "agree": (ph == h) if isinstance(ph, int) and isinstance(h, int) else None}


def block(c):
    d, bad = c["data"], c["unreadable"]
    out = []
    age = int(time.time() - c["at"])
    out.append("LIVE FACTS (read %ds ago -- these OVERRIDE any figure written in this prompt)" % age)

    if "chain" in bad:
        out.append("CHAIN: UNREADABLE (%s) -- do not state a height or a difficulty." % bad["chain"])
    else:
        ch = d["chain"]
        cc, ix = ch.get("chain", {}), ch.get("index", {})
        out.append("CHAIN: height %s, difficulty %s, %s transactions so far, node peers %s."
                   % (cc.get("height"), n(cc.get("difficulty")), cc.get("tx_count"),
                      ix.get("node_connections")))
        lb = last_block(c)
        if lb is None:
            out.append("LAST BLOCK: its time could not be read -- do not say how long ago it was.")
        else:
            line = ("LAST BLOCK: height %s at %s, %d minutes ago."
                    % (lb["height"], time.strftime("%H:%M UTC", time.gmtime(lb["time"])), round(lb["age_min"])))
            if lb["agree"] is True:
                line += " The pool's own node is at the same height, so two independent nodes agree."
            elif lb["agree"] is False:
                line += (" The pool's node reports height %s, which DIFFERS -- say a person is checking, "
                         "and do not guess why." % lb["pool_height"])
            if lb["state"] == "stalled":
                line += (" THAT IS A STALL: at a 10-minute target a gap this long happens by chance about once "
                         "in 8,000 blocks. Do NOT call it normal variance and do NOT say the chain corrects "
                         "itself. Say exactly how long it has been, that it has been reported to the team and is "
                         "being checked now, and give no cause you have not been given.")
            elif lb["state"] == "long":
                line += (" That is a LONG gap -- by chance about once in 90 blocks. Say so with these numbers "
                         "and say it is being watched; do not wave it away as normal.")
            else:
                line += " That is within normal variation at a 10-minute target."
            out.append(line)

    # The explorer as a WEBSITE, which is a different question from the chain.
    st, detail = explorer_health()
    if st == "ok":
        out.append("EXPLORER WEBSITE: the pages are serving normally right now "
                   "(checked just now, not from memory). If somebody says it is down for them, "
                   "it is worth asking what they see -- do not tell them they are wrong.")
    elif st == "bad":
        out.append("EXPLORER WEBSITE: IT IS BROKEN RIGHT NOW (%s). If somebody reports it is "
                   "down, THEY ARE RIGHT -- say it is a known problem being worked on, and do "
                   "not ask them to try again as though it were their side." % detail)
    else:
        out.append("EXPLORER WEBSITE: could not be checked from here (%s). That is UNKNOWN -- "
                   "do not say it is up and do not say it is down." % detail)

    # ── the pools ──────────────────────────────────────────────────────────
    # BOTH pools, and each one's HEALTH, not just its size. On 2026-09-21
    # pool.pc.am stopped recording shares for 7h15m; miners asked about it in
    # the group and the bot answered "I can't see the pool's share of the
    # network from here" and filed it for a human, because the only pool facts
    # it had were miner count and hashrate -- neither of which changes when the
    # pool goes deaf. The signature it needed was right there in the same API
    # and nobody had passed it on: miners still connected, shares per second
    # ZERO. That pair is the fault, and it is now stated outright.
    for key, label in (("pool", "pool.pc.am"), ("pool2", "pool2.pc.am")):
        if key in bad:
            out.append("POOL %s: UNREADABLE (%s) -- say you cannot see this pool right "
                       "now. Do NOT say it is down and do NOT give a miner count."
                       % (label, bad[key]))
            continue
        p = (d[key].get("pool") or d[key])
        ps = p.get("poolStats") or {}
        ns = p.get("networkStats") or {}
        ph, nh = ps.get("poolHashrate"), ns.get("networkHashrate")
        miners, sps = ps.get("connectedMiners"), ps.get("sharesPerSecond")
        share = ("%.0f%%" % (100.0 * float(ph) / float(nh))
                 if ph and nh and float(nh) > 0 else "unknown")
        out.append(
            "POOL %s: %s miners connected, pool hashrate %s H/s, network %s H/s, "
            "so it is about %s of the network. Blocks found in total: %s."
            % (label, miners, n(ph), n(nh), share, p.get("totalBlocks")))

        # How long since this pool last found a block, and whether that is odd.
        # A pool with a small share of the network legitimately goes hours
        # between blocks, so the gap alone proves nothing and must not be read
        # as a fault -- which is why the share of the network is quoted with it.
        age_h = None
        try:
            lb = p.get("lastPoolBlockTime")
            if lb:
                age_h = (time.time() - _epoch(lb)) / 3600.0
        except Exception:
            age_h = None
        if age_h is not None:
            out.append("  %s last found a block %.1f hours ago." % (label, age_h))

        # THE STALL SIGNATURE. Miners attached and no shares arriving is not a
        # quiet patch; it is the pool failing to record work. Say so plainly,
        # because a miner seeing "pool could not record the share; retry" is
        # RIGHT and must never be told to check their own setup.
        if isinstance(miners, int) and miners > 0 and isinstance(sps, (int, float)):
            if sps <= 0:
                out.append(
                    "  *** %s IS NOT RECORDING SHARES RIGHT NOW: %s miners are connected "
                    "and shares per second is %s. This is a REAL FAULT on our side and it "
                    "is already known. If someone reports \"pool is behind: retry this "
                    "share\" or \"pool could not record the share\", CONFIRM it, say it is "
                    "being worked on, do NOT ask them to change anything on their end, and "
                    "suggest the other pool as somewhere to hash meanwhile. ***"
                    % (label, miners, n(sps, 2)))
            else:
                out.append("  %s is recording shares normally (%s shares/second)."
                           % (label, n(sps, 2)))
    # WHAT pool2 IS FOR. Kept from the server-only version of this file
    # (added 2026-09-19, never committed) because it answers a question that
    # was asked in the group on 2026-09-19 and never got a reply: "no
    # explanation anywhere about pool2.pc.am yet, what is the purpose of that
    # second pool", and "is the PCoin Windows miner one that supports a
    # failover". Both are answered here.
    if "pool2" not in bad:
        out.append(
            "WHAT pool2.pc.am:3333 IS FOR: it is OUR second pool -- same 2% fee, same PPLNS, "
            "on a DIFFERENT server -- and it exists so mining continues if pool.pc.am is "
            "unreachable. A miner may use either, and a miner that supports a failover pool "
            "should list both, pool.pc.am first. Adding it changes nothing about payouts: "
            "each pool pays its own blocks from its own coinbase, to the same address.")

    # UNCONDITIONAL. This paragraph is static text about somebody else's pool
    # -- it needs no reading of ours to be true. It used to sit behind
    # `if "pool" not in bad or "pool2" not in bad`, which withheld it exactly
    # when BOTH our pools were unreadable: the one moment a miner most needs
    # somewhere else to point their hashrate.
    # Corrected 2026-09-25: this said the pool's "web stats page does not
    # answer" long after https://pcoin.aioncore.pro/ went live (it is linked from
    # the pc.am home page), and it gave only the raw IP -- so on 2026-09-21 the
    # bot told a miner "I don't know aioncore" about the one pool pc.am lists.
    out.append(
        "AN INDEPENDENT POOL, AIONCORE, is run by somebody outside the project: "
        "stratum pcoin.aioncore.pro:3333 (the same server as 198.244.169.49:3333), "
        "stats at https://pcoin.aioncore.pro/, RandomX, no registration. It is listed on "
        "the pc.am home page and was paid the 500 PCN independent-pool bounty on "
        "24 September 2026. We do not run it and cannot vouch for its payouts. If a "
        "miner asks for an alternative, give them that address: a chain where most "
        "blocks come from one pool is less secure, and pointing people elsewhere is "
        "genuinely good for PCoin.")

    if "price" in bad:
        out.append("PRICE: UNREADABLE (%s) -- say you cannot read the rate right now." % bad["price"])
    else:
        p = d["price"]
        pool = p.get("pool") or {}
        # THE PCN INDEX, as price.pc.am relays it (the source is
        # exchange.pc.am/api/index; both are public). Since 2026-09-25 it IS the
        # PCN price. It may be quoted only when price.pc.am says it is not stale
        # AND its state is a price -- held is a price, unknown is not. Anything
        # else is UNKNOWN and must never become a number (CLAUDE.md 7.1).
        ix = p.get("index") if isinstance(p.get("index"), dict) else {}
        ist = ix.get("state") or "missing"
        in_use = ix.get("inUse") is True
        ix_ok = ix.get("stale") is False and ist in ("live", "held", "frozen") and ix.get("usd") is not None
        if ix_ok:
            w = ix.get("window") if isinstance(ix.get("window"), dict) else {}
            evidence = ""
            if w.get("hours"):
                evidence = ("; its window is the last %s hours, with %s counted trades from %s people"
                            % (w.get("hours"), w.get("trades"), w.get("entities")))
            try:
                moved = "last moved %s" % time.strftime("%Y-%m-%d %H:%M UTC",
                                                        time.gmtime(_epoch(ix.get("lastMoveAt"))))
            except Exception:
                moved = "it has not moved since it started"
            gloss = (" (too little new qualifying trading to move it; a held index is still the price)"
                     if ist == "held" else "")
            if in_use:
                credit = " It is what PCoin services CREDIT one PCN at (creditRateUsd $%s)." % n(p.get("creditRateUsd"), 6)
            else:
                credit = (" price.pc.am says it is NOT yet the credit rate: services credit $%s per PCN."
                          % n(p.get("creditRateUsd"), 6))
            out.append("PRICE: the PCN index is $%s per PCN, state %s%s%s; %s. It is the "
                       "volume-weighted median of qualifying user-to-user trades on exchange.pc.am, "
                       "not a valuation.%s"
                       % (n(ix.get("usd"), 6), ist, gloss, evidence, moved, credit))
        elif in_use:
            out.append("PRICE: the PCN index is UNKNOWN right now (state %s, stale %s) -- do NOT quote "
                       "any PCN price. The services hold new credits until it is readable again; "
                       "nothing is lost." % (ist, ix.get("stale")))
        else:
            out.append("PRICE: the PCN index cannot be read (state %s). Services credit $%s per PCN."
                       % (ist, n(p.get("creditRateUsd"), 6)))
        if ix_ok or not in_use:
            out.append("MARKET SELL PRICE (what market.pc.am charges; it never credits anything): $%s. "
                       "wPCN pool spot $%s -- the pool is NOT an input to the PCN price."
                       % (n(p.get("sellPriceUsd"), 6), n(pool.get("spotUsd"), 6)))
        else:
            # market.pc.am closes when the index is unknown; a remembered sale
            # price here would contradict the MARKET.PC.AM line below.
            out.append("MARKET SELL PRICE: not quoted while the PCN index is unknown -- market.pc.am "
                       "does not sell without it.")
        out.append("BUYBACK: %s. The project itself does not buy PCN back at price.pc.am."
                   % ("OPEN" if p.get("buybackOpen") else "closed"))

    if "exchange" in bad:
        out.append("EXCHANGE: UNREADABLE (%s) -- do not quote a fee, a limit or a cap." % bad["exchange"])
    else:
        x = d["exchange"]
        f = x.get("fees", {})
        lim = x.get("limits", {})
        w = x.get("withdrawals", {})
        hb = x.get("houseBid", {})
        st = x.get("stats", {})
        ref = x.get("referral", {})
        out.append("EXCHANGE exchange.pc.am is %s. This is where PCN can actually be sold for "
                   "dollars. Trading fee %s%% per side. Order size $%s to $%s, at most %s PCN."
                   % ("OPEN" if x.get("exchangeOpen") else "CLOSED",
                      f.get("tradePercentEachSide"), n(lim.get("minOrderUsd"), 2),
                      n(lim.get("maxOrderUsd"), 2), n(lim.get("maxOrderPcn"), 0)))
        # Two floors since 2026-09-23 -- BNB Smart Chain's is lower. An exchange
        # that does not send the second one has only the first.
        mins = "$%s" % n(w.get("minimumUsd"), 2)
        if (w.get("minimumBep20Usd") is not None
                and n(w.get("minimumBep20Usd"), 2) != n(w.get("minimumUsd"), 2)):
            mins = "$%s for USDT on BNB Smart Chain, $%s for USDT on TRON and for PCN" % (
                n(w.get("minimumBep20Usd"), 2), n(w.get("minimumUsd"), 2))
        # The daily USDT cap comes from the aggregator feed. null there means the
        # cap is OFF; an unreadable feed means UNKNOWN -- never "no cap".
        if "assets" in bad or not isinstance(d.get("assets"), dict):
            cap = " The daily USDT cap could not be read just now -- do not quote one."
        else:
            mx = (d["assets"].get("USDT") or {}).get("max_withdraw")
            cap = (" USDT withdrawals are capped at $%s per account per UTC day; PCN has no daily cap."
                   % n(mx, 2) if mx is not None else
                   " There is no daily cap on USDT withdrawals right now.")
        out.append("WITHDRAWALS: minimum %s, paid by hand within %s hours. Fees: USDT on TRON "
                   "$%s, USDT on BNB Smart Chain $%s, PCN %s. Two-factor is required first.%s"
                   % (mins, w.get("turnaroundHours"),
                      n(w.get("feeTrc20Usd"), 2), n(w.get("feeBep20Usd"), 2),
                      "free" if str(w.get("feePcn")) in ("0", "0.0") else w.get("feePcn"), cap))
        out.append("ORDER BOOK NOW: best bid $%s, best ask $%s, last trade $%s, 24h volume %s PCN "
                   "across %s trades."
                   % (n(st.get("bestBidUsd"), 6), n(st.get("bestAskUsd"), 6),
                      n(st.get("lastPriceUsd"), 6), n(st.get("volumePcn"), 0),
                      st.get("trades24h")))
        # What the house bots quote from: the PCN index, or price.pc.am before
        # the switch. Named by the exchange itself (referenceSource).
        ref_name = "the PCN index" if x.get("referenceSource") == "index" else "the price.pc.am rate"
        sl = hb.get("slots") if isinstance(hb.get("slots"), dict) else None
        rounds = ""
        if sl:
            try:
                nxt = "%d min" % (int(sl.get("nextInSeconds")) // 60)
            except Exception:
                nxt = "unknown"
            rounds = (" in %s rounds of $%s ($%s left in this round; the next round opens in %s)"
                      % (sl.get("perDay"), n(sl.get("slotUsd"), 2), n(sl.get("leftThisSlotUsd"), 2), nxt))
        spent = ""
        if hb.get("spentOut"):
            spent = ", spent out for this round" if hb.get("spentFor") == "slot" else ", spent out for today"
        out.append("HOUSE BID BOT: %s, buys at %s%% below %s, budget $%s a day%s, $%s left today%s."
                   % ("on" if hb.get("enabled") else "off", n(hb.get("discountPercent")), ref_name,
                      n(hb.get("dailyBudgetUsd"), 2), rounds, n(hb.get("leftTodayUsd"), 2), spent))
        if ref.get("enabled"):
            out.append("REFERRAL: %s PCN, paid once the person you introduced deposits at least "
                       "$%s and buys, held %s days."
                       % (n(ref.get("rewardPcn"), 0), n(ref.get("minDepositUsd"), 2),
                          ref.get("holdDays")))

    if "ladder" in bad:
        out.append("MARKET.PC.AM: UNREADABLE (%s)" % bad["ladder"])
    else:
        la = d["ladder"]
        if la.get("pricingMode") == "index":
            # Since 2026-09-25: one flat price, the PCN index plus a premium. No
            # price (index unknown or stale) means the market is closed, and that
            # must never be rendered as a number.
            if la.get("priceUnavailable") or la.get("marginalPrice") is None:
                out.append("MARKET.PC.AM: no sale price right now (%s) -- do not quote one."
                           % (la.get("priceUnavailable") or "nothing left to sell"))
            else:
                out.append("MARKET.PC.AM sells at $%s per PCN, one flat price for any order size "
                           "(the PCN index plus %s%%), %s PCN left of %s, orders $%s to $%s."
                           % (n(la.get("marginalPrice"), 6), n(la.get("premiumPct")),
                              n(la.get("remainingPcn"), 0), n(la.get("totalPcn"), 0),
                              n(la.get("minOrderUsd"), 0), n(la.get("maxOrderUsdNow"), 0)))
        else:
            out.append("MARKET.PC.AM ladder: $%s per PCN, %s PCN left of %s, orders $%s to $%s."
                       % (n(la.get("marginalPrice"), 6), n(la.get("remainingPcn"), 0),
                          n(la.get("totalPcn"), 0), n(la.get("minOrderUsd"), 0),
                          n(la.get("maxOrderUsdNow"), 0)))

    wd = d.get("withdrawals")
    if isinstance(wd, dict):
        # The gap between "we paid it" and "the chain agrees" is the number that
        # matters; reporting only the first would hide the failure it catches.
        unver = wd.get("paidButUnverified")
        oldest = wd.get("queueOldestSeconds")
        out.append("WITHDRAWALS PAID SO FAR: %s, of which %s are confirmed on the chain%s. "
                   "%s"
                   % (wd.get("paid"), wd.get("verifiedOnChain"),
                      "" if not unver else " (%s not yet confirmed)" % unver,
                      "Nothing is waiting in the payout queue."
                      if oldest is None else
                      "The oldest request still waiting is %d hours old." % (oldest // 3600)))
        # No contract address here any more: the output guard holds every draft
        # containing an 0x address, so a bot that obeyed this line by quoting it
        # would have been silenced -- the same feed-vs-guard contradiction that
        # killed the pool answers on 2026-09-21.
        out.append("If somebody says a withdrawal failed: every payout the exchange has sent has "
                   "confirmed successfully so far. Ask them for the transaction id and which "
                   "network, and say it will be checked -- do NOT tell them it failed, and do "
                   "NOT guess. USDT on BNB Smart Chain is a TOKEN: a wallet that has not added "
                   "USDT on BNB Smart Chain from its own token list shows nothing, which is the "
                   "usual cause of 'it never arrived'. Do not give a contract address.")

    # ── supply ────────────────────────────────────────────────────────────
    su = d.get("supply")
    if "supply" in bad or not isinstance(su, dict):
        out.append("SUPPLY: UNREADABLE -- do not state a supply figure.")
    else:
        h = su.get("height")
        left = (210000 - h % 210000) if isinstance(h, int) else None
        out.append("SUPPLY: %s PCN mined so far (%s of it still immature) of the %s cap; no premine. "
                   "The block reward halves every 210,000 blocks; the next halving is %s blocks "
                   "from now (do not turn that into a date)."
                   % (n(su.get("total_supply_pcn"), 0), n(su.get("immature_pcn"), 0),
                      n(su.get("max_supply_pcn"), 0), left if left is not None else "an unknown number of"))

    # ── what the install lines install, and the wrap desk ─────────────────
    tx, tbad = c.get("text") or {}, c.get("text_unreadable") or {}
    def ver(key, field="version"):
        v = (tx.get(key) or {}).get(field)
        return ("v" + v) if v else "UNKNOWN"
    out.append("RELEASES (what the install lines install right now -- the only versions you may "
               "quote): Windows miner %s, Windows PCoin Wallet %s, Linux node and miner %s, "
               "Android miner APK from release %s. The Android wallet's version is whatever "
               "Google Play shows. An UNKNOWN here means: say you cannot check it right now."
               % (ver("win_miner"), ver("win_wallet"), ver("linux"),
                  ver("mining_page", "android_miner_release")))
    intake = (tx.get("wrapdesk") or {}).get("intake")
    if intake == "open":
        out.append("WRAP DESK: OPEN -- wrapdesk.pc.am is taking new PCN -> wPCN requests "
                   "(read from its own page within the last 10 minutes).")
    elif intake == "paused":
        out.append("WRAP DESK: PAUSED -- wrapdesk.pc.am says new wrap requests are paused right "
                   "now. Anything already sent is still paid or returned, and redeeming wPCN back "
                   "to PCN still works. Do not guess when it reopens.")
    else:
        out.append("WRAP DESK: could not be read just now (%s) -- do not say whether it is open."
                   % (tbad.get("wrapdesk") or "no marker found"))

    if bad:
        out.append("NOTE: %d source(s) could not be read this time. For anything they cover, say "
                   "you cannot check it right now. Do NOT fall back on a number from memory."
                   % len(bad))
    return "\n".join(out)


def txid_line(t):
    """One transaction, in a sentence the assistant can repeat.

    The id is shape-checked HERE as well as on the server, so a junk string
    never becomes a request. And an unknown id says "no record", never
    "it failed" -- somebody pasting a hash from another service must not be
    told their money is gone.
    """
    t = str(t or "").strip().lower()
    if not re.fullmatch(r"(0x)?[0-9a-f]{64}", t):
        return "THAT IS NOT A TRANSACTION ID. Ask for the full hash."
    d, err = get(WITHDRAWAL_STATUS % urllib.parse.quote(t, safe=""))
    if err:
        return "UNREADABLE: the exchange could not be asked about that transaction just now. "                "Say you will check it, and do not guess."
    if not d.get("found"):
        base = ("NO EXCHANGE RECORD: the exchange has no withdrawal paid with that transaction. "
                "That does NOT mean it failed. Never tell them their money is lost.")
        # A 0x id is a BNB Smart Chain hash and cannot be on the PCoin chain.
        if t.startswith("0x"):
            return base + " It is a BNB Smart Chain hash, which the PCoin explorer cannot see."
        return base + " " + chain_tx_line(t)
    return ("WITHDRAWAL FOUND: %s %s on %s, status %s, requested %s, paid %s. Chain check: %s"
            % (d.get("amount"), d.get("asset"), d.get("network"), d.get("status"),
               time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime(d.get("requestedAt") or 0)),
               time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime(d.get("paidAt") or 0))
               if d.get("paidAt") else "not yet",
               d.get("verifyDetail") or "not verified yet"))


def chain_tx_line(t):
    """Is this id a transaction on the PCoin chain? Status and confirmations ONLY.

    Deliberately prints no address and no amount: those are public on the
    explorer, but the bot posts into a public group and the guard holds any
    draft containing an address anyway. A 404 is an ANSWER (the explorer does
    not know it); any other failure is UNKNOWN and says so.
    """
    req = urllib.request.Request(CHAIN_TX % urllib.parse.quote(t, safe=""),
                                 headers={"User-Agent": "pcoin-facts"})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            tx = (json.load(r) or {}).get("tx") or {}
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return ("ON THE PCOIN CHAIN: not found. It may be a TRON or BNB Smart Chain "
                    "transaction, not yet broadcast, or mistyped -- ask them to check it.")
        return "ON THE PCOIN CHAIN: could not be checked just now. Say it will be checked."
    except Exception:
        return "ON THE PCOIN CHAIN: could not be checked just now. Say it will be checked."
    if tx.get("status") == "confirmed":
        return ("ON THE PCOIN CHAIN: confirmed in block %s, %s confirmations%s."
                % (tx.get("height"), tx.get("confirmations"),
                   " (a mining reward: spendable after 100)" if tx.get("is_coinbase") else ""))
    if tx.get("status") == "unconfirmed":
        return ("ON THE PCOIN CHAIN: seen and waiting in the mempool, not yet in a block. "
                "That is normal for a few minutes; blocks are random, about 10 minutes apart.")
    return "ON THE PCOIN CHAIN: its status could not be read. Say it will be checked."


def main():
    # Asked about ONE transaction: answer that and nothing else.
    if "--txid" in sys.argv:
        i = sys.argv.index("--txid")
        print(txid_line(sys.argv[i + 1] if len(sys.argv) > i + 1 else ""))
        return 0
    c = cached(refresh="--refresh" in sys.argv)
    if "--json" in sys.argv:
        # `derived` is computed at print time, never cached: an age read from
        # the cache would be up to a minute stale, and for "how long since the
        # last block" that is the whole answer.
        print(json.dumps(dict(c, derived={"last_block": last_block(c)}), indent=1))
    else:
        print(block(c))
    # Exit 1 when nothing at all could be read, so a caller that checks only the
    # status can tell "every source is down" from "here are the facts".
    return 1 if not c["data"] else 0


if __name__ == "__main__":
    sys.exit(main())
