[Unit]
Description=Post the PCoin chain heartbeat every hour

[Timer]
# Deliberately NOT randomized by minutes like the other watch timers here --
# this posts unconditionally (see pcoin-chain-heartbeat's module docstring),
# so a wide random delay would make gaps in the channel ambiguous between
# "quiet chain" and "timer slipped". Changed from every 10 minutes to hourly
# at the owner's request 2026-08-23.
OnBootSec=2min
OnUnitActiveSec=1h
RandomizedDelaySec=30s
Persistent=true

[Install]
WantedBy=timers.target
