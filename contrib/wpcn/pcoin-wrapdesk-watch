#!/usr/bin/env python3
"""Tell the operator what to DO about the wrap desk, hourly, until it is done.

This is not a health check. It is a task list that nags. Every wrap has manual
steps spread over hours -- wait for confirmations, send wPCN, sell the PCN, buy
wPCN back -- and a step forgotten halfway is how a desk ends up with a customer
paid nothing or a pool left un-rebalanced.

WHAT "DONE" MEANS HERE, AND WHY THERE IS NO BUTTON.

Nothing is marked complete by a human saying so. Each step is derived from what
is observable on a chain:

    PCN arrived at the reserve        -> explorer.pc.am / the node
    it has 100 confirmations          -> same
    wPCN was sent to the requester    -> their BSC balance rose
    wPCN was bought back              -> the pool's wPCN reserve fell

A button would let the operator mark a step done that did not happen. Reading
the chain cannot. This is the same doctrine the rest of the project uses: an
unreadable answer is UNKNOWN, and unknown never becomes done.

That cuts both ways, deliberately. If a read FAILS, the task stays open and gets
nagged again. Better to be told twice about something finished than to have a
half-finished wrap go quiet.

Alerts go to the PRIVATE ops channel via pcoin-notify. Never the public one.
"""
import json
import os
import subprocess
import sys
import time
import urllib.request

STATE = os.environ.get("WRAPDESK_STATE", "/var/lib/pcoin-wrapdesk/state.json")
NOTIFY = os.environ.get("PCOIN_NOTIFY", "/usr/local/bin/pcoin-notify")
NAG_SECONDS = int(os.environ.get("NAG_SECONDS", 3600))      # hourly, per the owner
CONFIRMATIONS = int(os.environ.get("WRAP_CONFIRMATIONS", 100))
PER_PERSON = float(os.environ.get("WRAP_PER_PERSON", 250))
TOTAL_ALLOC = float(os.environ.get("WRAP_TOTAL_ALLOC", 1500))

# The wrap fee, taken in wPCN withheld rather than PCN returned.
#
# It is FRICTION, not revenue. At the current limits 5% of the entire 1,500 wPCN
# allocation is about $1.37, which pays for nothing -- its actual job is to slow
# a rush of miners wrapping in order to dump on PancakeSwap, which is the risk
# the per-person limit also exists for.
#
# Know the cost before changing it: a fee of F% means arbitrage only closes gaps
# WIDER than F%, so the PCN and wPCN prices can sit that far apart before anyone
# is paid to fix it. Since connecting the two prices is the whole point of the
# desk, a large fee works against its own purpose. 5% is a deliberate trade of
# peg tightness for a brake on dumping, not a considered revenue decision.
FEE_PCT = float(os.environ.get("WRAP_FEE_PCT", 5.0))

EXPLORER = "https://explorer.pc.am"
RESERVE = os.environ.get("WRAP_RESERVE", "pc1q7hhzmdkkx0zjtzj6qkwmuvhlgwfqjrc6j2dk52")

# wrapdesk.pc.am writes every allocated deposit address here, with the BSC
# address that asked for it. Without this the watcher can see that PCN arrived
# but not who is owed the wPCN, which makes an alert unactionable.
REQUESTS = os.environ.get("WRAPDESK_REQUESTS", "/var/lib/wrapdesk/requests.json")

# Deposits at or below this height are NOT wrap requests. The reserve was funded
# with 50,000 PCN before the desk existed, and without this the watcher reads that
# as a customer owed 50,000 wPCN -- which is exactly what the first dry run did.
# Set it to the chain height at the moment the desk opens.
OPENED_AT_HEIGHT = int(os.environ.get("WRAP_OPENED_AT_HEIGHT", "0"))


def get(url, timeout=25):
    """JSON GET, or None. None is UNKNOWN and must never be treated as a value."""
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            return json.load(r)
    except Exception:
        return None


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except Exception:
        return {"seen": {}, "nagged": {}}


def save_state(s):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(s, f, indent=1)
    os.replace(tmp, STATE)          # atomic; a torn state file loses the queue


def notify(subject, body):
    if not os.path.exists(NOTIFY):
        print(f"[no notifier] {subject}\n{body}")
        return
    subprocess.run([NOTIFY, subject, body], timeout=60)


def pool_price():
    """{'price': float} from the pair contract, or None if unreadable.

    Read from getReserves() rather than any API: it is the source of truth and
    cannot be stale. None means UNKNOWN and the caller must not assume a side.
    """
    try:
        # Installed to /usr/local/bin, but deploy.py lives with the deployment
        # in /opt/wpcn. Inserting the script's own directory finds nothing.
        sys.path.insert(0, os.environ.get("WPCN_DIR", "/opt/wpcn"))
        sys.path.insert(1, os.path.dirname(os.path.abspath(__file__)))
        from web3 import Web3
        from deploy import load, connect
        cfg = load()
        w3, _ = connect(cfg)
        abi = [{"constant": True, "inputs": [], "name": "getReserves",
                "outputs": [{"name": "_r0", "type": "uint112"},
                            {"name": "_r1", "type": "uint112"},
                            {"name": "_t", "type": "uint32"}], "type": "function"},
               {"constant": True, "inputs": [], "name": "token0",
                "outputs": [{"name": "", "type": "address"}], "type": "function"}]
        pair = w3.eth.contract(address=Web3.to_checksum_address(cfg["PAIR"]), abi=abi)
        r0, r1, _ = pair.functions.getReserves().call()
        t0 = pair.functions.token0().call()
        tok = Web3.to_checksum_address(cfg["TOKEN"])
        wp, us = (r0 / 1e8, r1 / 1e18) if t0 == tok else (r1 / 1e8, r0 / 1e18)
        return {"price": us / wp, "wpcn": wp, "usdt": us}
    except Exception:
        return None


def main() -> int:
    st = load_state()
    now = int(time.time())
    tasks = []          # (key, urgency, text)

    # ---- 1. incoming wraps, and how far along they are --------------------
    #
    # WATCH THE ALLOCATED ADDRESSES, NOT JUST THE RESERVE.
    #
    # wrapdesk.pc.am hands every requester their own deposit address derived
    # from the reserve xpub. Those deposits land in the reserve WALLET, so the
    # backing is never at risk -- but they do NOT land on the reserve's index-0
    # address. A watcher looking only at index 0 sees nothing, and a customer
    # who paid is never paid back. The money is safe and the person is not.
    #
    # So: read the desk's own request file and check every address it has
    # handed out, plus index 0 for anyone who sent there directly.
    watch = {RESERVE: None}                 # address -> requester BSC address
    try:
        with open(REQUESTS) as f:
            for r in (json.load(f).get("requests") or {}).values():
                if r.get("address"):
                    watch[r["address"]] = r.get("bsc")
    except FileNotFoundError:
        pass                                # desk not deployed here; reserve only
    except Exception as e:
        # The file exists and could not be read. That is NOT "no requests" --
        # every allocated address becomes invisible, which is the exact failure
        # this block exists to prevent.
        tasks.append(("requests_unreadable", "warn",
                      f"Could not read the wrap desk request file ({REQUESTS}): {e}\n"
                      f"Deposits to allocated addresses cannot be seen right now. "
                      f"This is UNKNOWN, not 'nothing pending'."))

    used_total = 0.0        # allocation consumed, summed across ALL addresses
    # Rebuilt from the chain every run, never accumulated -- it is what
    # --released resolves an abbreviated txid against.
    st["outstanding"] = {}
    for watch_addr, requester in watch.items():
        addr = get(f"{EXPLORER}/api/address/{watch_addr}")
        who = (f"\nRequester BSC address: {requester}" if requester
               else "\n(sent to the main reserve address directly)")
        if addr is None:
            # Cannot read this address. That is not "no wraps pending" -- say so
            # and keep every existing task open.
            tasks.append((f"unreadable:{watch_addr}", "warn",
                          f"Could not read {watch_addr} on explorer.pc.am. "
                          f"Wrap deposits there cannot be checked right now. "
                          f"This is UNKNOWN, not 'nothing pending'.{who}"))
            continue
        conf_items = (addr.get("history") or {}).get("items") or []
        pend_items = (addr.get("unconfirmed_history") or {}).get("items") or []

        for it in pend_items:
            txid = it.get("txid", "?")
            amt = it.get("received_pcn", "?")
            tasks.append((f"pending:{txid}", "info",
                          f"WRAP REQUEST arriving: {amt} PCN, tx {txid[:16]}...\n"
                          f"Unconfirmed. Nothing to do yet -- needs {CONFIRMATIONS} "
                          f"confirmations before any wPCN is released."))

        for it in conf_items:
            txid = it.get("txid", "?")
            confs = it.get("confirmations", 0)
            amt = float(it.get("received_pcn") or 0)
            if amt <= 0:
                continue
            h = it.get("height")
            if not isinstance(h, int) or h <= OPENED_AT_HEIGHT:
                continue          # pre-dates the desk: reserve funding, not a wrap
            key = f"wrap:{txid}"
            if st["seen"].get(key, {}).get("released"):
                continue
            if confs < CONFIRMATIONS:
                tasks.append((key, "info",
                              f"WRAP {amt:.2f} PCN, tx {txid[:16]}...\n"
                              f"{confs}/{CONFIRMATIONS} confirmations. "
                              f"Do NOT release wPCN yet -- the depth is the whole "
                              f"defence against a reorg."))
            else:
                over = ""
                eligible = amt
                if amt > PER_PERSON:
                    eligible = PER_PERSON
                    over = (f"\n*** {amt:.0f} PCN EXCEEDS the {PER_PERSON:.0f} per-person "
                            f"limit. Wrap only {PER_PERSON:.0f} and return the rest, "
                            f"or decide deliberately to exceed it. ***")
                # The fee is taken in wPCN NOT SENT, never in PCN returned. The
                # reserve keeps the full deposit while fewer wPCN go out, so
                # backing moves ABOVE 1:1 -- the only direction it may ever move.
                fee = eligible * FEE_PCT / 100.0
                net = eligible - fee
                # Computed outside the f-string: nesting quotes inside an
                # f-string expression is a syntax error before Python 3.12.
                pay_to = requester or ("(NO REQUEST ON FILE -- sent straight to "
                                       "the reserve. Find out who before paying.)")
                st["outstanding"][txid] = {"pcn": amt, "send_wpcn": net,
                                           "to": requester, "address": watch_addr}
                tasks.append((key, "action",
                              f"ACTION: send {net:.2f} wPCN\n"
                              f"{amt:.2f} PCN confirmed ({confs} confs), tx {txid[:16]}...\n"
                              f"  eligible : {eligible:.2f} PCN\n"
                              f"  fee {FEE_PCT:g}%  : {fee:.2f} wPCN (kept, not sent)\n"
                              f"  SEND     : {net:.2f} wPCN\n"
                              f"  TO       : {pay_to}\n"
                              f"Send from the inventory wallet.{over}\n"
                              f"Then: sell the {amt:.2f} PCN on market.pc.am, and use the "
                              f"proceeds to buy wPCN back from the pool -- but ONLY while "
                              f"the pool trades BELOW price.pc.am.\n"
                              f"WHEN SENT, close it out or this repeats hourly forever:\n"
                              f"  pcoin-wrapdesk-watch --released {txid} <bsc_txhash>"))

        # accumulate this address's share of the allocation; reported once,
        # after every address has been read, or the figure would be partial.
        for it in conf_items:
            h = it.get("height")
            a = float(it.get("received_pcn") or 0)
            if isinstance(h, int) and h > OPENED_AT_HEIGHT and a > 0:
                used_total += min(a, PER_PERSON) * (1 - FEE_PCT / 100.0)

    if used_total > 0:
        left = TOTAL_ALLOC - used_total
        tasks.append(("allocation", "action" if left <= 0 else "info",
                      f"Allocation: {used_total:.2f} of {TOTAL_ALLOC:.0f} wPCN used, "
                      f"{left:.2f} left."
                      + ("\n*** THE ALLOCATION IS EXHAUSTED. Do not wrap more "
                         "without deciding deliberately to raise it. ***"
                         if left <= 0 else "")))

    # ---- 2. is the cycle worth running right now? -------------------------
    price = get("https://price.pc.am")
    pool = pool_price()
    rate = (price or {}).get("serviceRate")
    if rate is None:
        tasks.append(("rate_unreadable", "warn",
                      "Could not read price.pc.am. Cannot tell whether the buy-back "
                      "cycle should be running. Do not guess -- check by hand before "
                      "buying wPCN."))
    elif pool and pool.get("price") is not None:
        pp = float(pool["price"])
        if pp < float(rate):
            tasks.append(("cycle_open", "info",
                          f"Cycle is OPEN: pool ${pp:.6f} is below price.pc.am "
                          f"${float(rate):.6f}. Buying wPCN back is profitable and "
                          f"pushes the peg the right way."))
        else:
            tasks.append(("cycle_shut", "info",
                          f"Cycle is SHUT: pool ${pp:.6f} is at or above price.pc.am "
                          f"${float(rate):.6f}. Do NOT buy wPCN back -- it would cost "
                          f"more than the PCN you sold."))
    else:
        # THIS BRANCH IS LOAD-BEARING. Without it, a readable rate plus an
        # unreadable pool appended NOTHING -- the script printed only "nothing
        # outstanding" and looked perfectly healthy while it was blind. That is
        # exactly the failure this project has a rule against: unknown must be
        # its own state, never silence that reads as fine.
        tasks.append(("pool_unreadable", "warn",
                      "Could not read the PancakeSwap pair reserves, so the pool "
                      "price is UNKNOWN. Cannot say whether the buy-back cycle "
                      "should be running -- do not assume either direction. "
                      "Check the pair by hand before buying or selling wPCN."))

    # ---- 3. report, nagging only what is actionable -----------------------
    actions = [t for t in tasks if t[1] == "action"]
    warns = [t for t in tasks if t[1] == "warn"]

    for key, urgency, text in tasks:
        print(f"[{urgency}] {text}\n")

    due = []
    for key, urgency, text in actions + warns:
        last = st["nagged"].get(key, 0)
        if now - last >= NAG_SECONDS:
            due.append((key, text))

    if due:
        body = "\n\n".join(t for _, t in due)
        body += (f"\n\n---\nThis repeats every {NAG_SECONDS//60} minutes until the "
                 f"chain shows it done. Nothing here is marked complete by hand.")
        notify(f"wrap desk: {len(due)} thing(s) need you", body)
        for key, _ in due:
            st["nagged"][key] = now

    save_state(st)

    if actions:
        print(f"UNHEALTHY: {len(actions)} wrap action(s) outstanding")
        return 1
    if warns:
        print(f"UNVERIFIED: {len(warns)} thing(s) could not be checked")
        return 2
    print("wrap desk: nothing outstanding")
    return 0


if __name__ == "__main__":
    # --released is the ONE manual override, and it has to exist.
    #
    # The docstring above says nothing is marked done by a human saying so, and
    # for every step that a chain can answer, that holds. This step it cannot:
    # the wPCN goes out on BNB Smart Chain from a wallet this script has no
    # view of, and even seeing that balance fall would not prove WHICH wrap it
    # settled. So a person records it -- with the BSC transaction hash, so the
    # claim stays checkable afterwards.
    #
    # Without this the loop never closes: a confirmed wrap is re-reported every
    # hour forever, including after it is paid. That is how pcoin-concentration
    # -watch taught everyone to ignore the channel, and an alert nobody reads is
    # worse than no alert, because it looks like coverage.
    if len(sys.argv) >= 3 and sys.argv[1] == "--released":
        s = load_state()
        txid = sys.argv[2]
        if txid.startswith("wrap:"):
            txid = txid[5:]

        # RESOLVE A PREFIX, AND REFUSE WHAT DOES NOT MATCH.
        #
        # The alert header abbreviates the txid ("tx 9727cf9b4ecdf5e8..."), so
        # an operator copying from the wrong line records a key that matches no
        # wrap at all. That writes cleanly, prints success, and changes nothing
        # -- the wrap keeps being reported hourly and the operator believes it
        # is closed. A silent no-op that looks like success is the worst of the
        # available failures, so this resolves prefixes and refuses the rest.
        outstanding = list((s.get("outstanding") or {}).keys())
        hits = [t for t in outstanding if t.startswith(txid)]
        if len(hits) == 1:
            txid = hits[0]
        elif len(hits) > 1:
            print(f"AMBIGUOUS: {txid!r} matches {len(hits)} outstanding wraps.")
            for t in hits:
                print(f"  {t}")
            sys.exit(2)
        elif outstanding and txid not in outstanding:
            print(f"NO MATCH: {txid!r} is not an outstanding wrap. Nothing changed.")
            print("Outstanding right now:")
            for t in outstanding:
                print(f"  {t}")
            sys.exit(2)

        key = f"wrap:{txid}"
        s.setdefault("seen", {}).setdefault(key, {})
        s["seen"][key]["released"] = True
        s["seen"][key]["at"] = int(time.time())
        s["seen"][key]["bsc_txhash"] = sys.argv[3] if len(sys.argv) > 3 else None
        save_state(s)
        print(f"marked released: {key}")
        if len(sys.argv) <= 3:
            print("NOTE: no BSC txhash recorded. Re-run with it so the payment "
                  "can be verified later.")
        sys.exit(0)
    sys.exit(main())
