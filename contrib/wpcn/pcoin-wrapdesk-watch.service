[Unit]
Description=PCoin wrap desk — what the operator still has to do
Documentation=https://github.com/pars5555/pcoin/blob/main/contrib/wpcn/WRAP-DESK.md
# Fires ONLY on a real failure. Exit 1 (action outstanding) and exit 2 are
# declared clean below, so this never doubles the script's own hourly alerts;
# what it catches is exit 3 (un-migrated ledger, refusing to run), a traceback,
# a timeout, or a MemoryMax kill -- every one of which was previously silent,
# and every one of which means NO wrap is being reported until someone notices.
OnFailure=pcoin-alert@%n.service

[Service]
Type=oneshot
# Run under the wPCN virtualenv, NOT bare python3. The system python has no
# web3, and every web3 import in these scripts sits inside a try/except that
# degrades to None -- so a bare python3 does not crash, it silently loses the
# on-chain reads and reports a healthy-looking nothing. That happened.
ExecStart=/opt/wpcn/.venv/bin/python /usr/local/bin/pcoin-wrapdesk-watch
Environment=NAG_SECONDS=3600

# The desk opened at this height. Deposits at or below it are NOT wrap
# requests -- the reserve was funded with 50,000 PCN before the desk
# existed, and without this floor the watcher reads that as a customer
# owed 50,000 wPCN. That is exactly what the first dry run did.
Environment=WRAP_OPENED_AT_HEIGHT=5868
Environment=WRAP_FEE_PCT=5

# Exit 1 = an action is outstanding. That is the NORMAL state while a wrap is in
# flight, and the script does its own notifying about it hourly -- so 1 and 2
# are declared SUCCESS here, which is what lets the OnFailure= above fire only
# for the failures nobody else reports (see the [Unit] comment).
Nice=10
MemoryMax=64M
TimeoutStartSec=120
SuccessExitStatus=1 2
