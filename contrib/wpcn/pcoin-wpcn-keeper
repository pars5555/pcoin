# The index states that carry a price (plan section 2.4). `held` is not a fault:
# it means too few new qualifying fills to move, and "a held price is still the
# price". `frozen` is the owner's brake, and also still the price. `unknown`,
# `disabled`, and any state this code has never heard of carry NO price, and
# they collapse to "do nothing" -- never to the ladder, never to the last value.
INDEX_PRICED_STATES = ("live", "held", "frozen")


def _real(x):
    """A finite float from a JSON number or a numeric string, else None.

    bool is refused on purpose: in Python True == 1, so a flag in the wrong
    field would otherwise read as a price of one dollar.
    """
    if x is None or isinstance(x, bool):
        return None
    try:
        v = float(x)
    except (TypeError, ValueError):
        return None
    if v != v or v in (float("inf"), float("-inf")):
        return None
    return v


def index_block(d):
    """The PCN index from a price.pc.am body of EITHER shape, or None. Pure.

    The owner, 2026-09-25: "simplify the price.pc.am json response ... check
    every service which field is using ... fix all". The root body becomes
        {creditRateUsd, sellPriceUsd, poolUsd, floorUsd,
         state, seq, stale, ageSeconds, at}
    and the `index` / `ladder` / `pool` blocks move to /detail, which the keeper
    must never read -- it spends the float. price.pc.am adds the new fields
    first (phase 1: the old body plus the nine, with ONE unified top-level
    `stale`) and removes the old ones later (phase 2), so there are three bodies:

      today's     -> the `index` block, as before
      phase 1     -> STILL the `index` block, and the top-level `stale` holds
                     too. Not the top level's creditRateUsd: with the rails
                     rolled back ({"useIndex":0}) that is the pool-follow
                     serviceRate, not the index -- and the keeper aims at the
                     INDEX, so the block that IS the index wins while it exists
      minimal     -> the TOP LEVEL is the index: creditRateUsd is its usd

    EVERY published freshness flag must say fresh: a top-level `stale` that is
    present and not literally False holds, whatever the block says. Nothing
    here judges the values -- index_verdict() does, on whichever block this
    returns, so every rule applies to every shape unchanged.
    """
    if not isinstance(d, dict):
        return None
    ix = d.get("index")
    if isinstance(ix, dict):
        if "stale" in d and d.get("stale") is not False and ix.get("stale") is False:
            ix = dict(ix, stale=True)
        return ix
    if isinstance(d.get("state"), str):
        return {"usd": d.get("creditRateUsd"), "state": d.get("state"), "seq": d.get("seq"),
                "ageSeconds": d.get("ageSeconds"), "stale": d.get("stale")}
    return None


def index_verdict(d, max_age_s=None, max_target_usd=None):
    """(usd, None) when price.pc.am's PCN index -- the `index` block, or the top
    level of the minimal body (index_block()) -- is a price the keeper may aim
    at, else (None, why). Pure, no I/O: the body is handed in.

    Every test is unknown-shaped (CLAUDE.md 7.2). A field that is missing, null
    or the wrong type rejects exactly as a bad value does -- `stale` must be
    literally false, not merely absent, and an age that cannot be read is not a
    young age. The age is price.pc.am's, measured on ITS clock against the
    exchange's computedAt; the keeper's own bound is tighter than price.pc.am's
    600 s `stale`, because the keeper now acts every minute and a three-minute-
    old index is already three missed chances to notice it stopped.

    It deliberately does NOT look at `inUse`. That field says whether the RAILS
    credit at the index (Step 4); the keeper moves first, at Step 2.
    """
    max_age_s = MAX_INDEX_AGE_S if max_age_s is None else max_age_s
    max_target_usd = MAX_TARGET_USD if max_target_usd is None else max_target_usd
    if not isinstance(d, dict):
        return None, "price.pc.am's answer is not a JSON object"
    ix = index_block(d)
    if not isinstance(ix, dict):
        return None, "price.pc.am carries no index (no top-level state, no index block)"
    # While the `ladder` block is still published (today's body and the
    # transition), its `stale` is the flag every PCN rail holds on, and in index
    # mode it follows the index. Honour it too; absent in the minimal body.
    if "ladder" in d and not (isinstance(d.get("ladder"), dict)
                              and d["ladder"].get("stale") is False):
        return None, "price.pc.am's ladder block says the rate is stale"
    state = ix.get("state")
    if state not in INDEX_PRICED_STATES:
        return None, "index state is %r, not live, held or frozen" % (state,)
    if ix.get("stale") is not False:
        return None, ("price.pc.am marks the index stale" if ix.get("stale") is True
                      else "index 'stale' is %r, not false" % (ix.get("stale"),))
    age = _real(ix.get("ageSeconds"))
    if age is None:
        return None, "index ageSeconds is %r, not a number" % (ix.get("ageSeconds"),)
    if age > max_age_s:
        return None, "index is %.0f s old, over max_index_age_s %.0f" % (age, max_age_s)
    usd = _real(ix.get("usd"))
    if usd is None:
        return None, "index usd is %r, not a number" % (ix.get("usd"),)
    if not (usd > 0):
        return None, "index $%s is not above zero" % (usd,)
    if usd > max_target_usd:
        return None, ("index $%.8f is above the max_target_usd sanity bound $%.8f"
                      % (usd, max_target_usd))
    return usd, None


def index_from_body(d, max_age_s=None, max_target_usd=None):
    """The PCN index in USD from a price.pc.am body, or None for UNKNOWN.
    index_verdict() says why; this is the shape the rest of the keeper uses."""
    return index_verdict(d, max_age_s, max_target_usd)[0]


def target_from_body(d):
    """(target, info) from a price.pc.am body. Pure. target None = UNKNOWN.

    info always names the anchor in force ("index" or "ladder"), and when the
    target is None it says why -- so the log line and the alert can say what
    the keeper is NOT doing, which from the outside looks the same as "nothing
    to do".
    """
    if ANCHOR_INDEX:
        ix = index_block(d)
        info = {"anchor": "index",
                "index": ({k: ix.get(k) for k in ("usd", "state", "seq", "ageSeconds", "stale")}
                          if isinstance(ix, dict) else None)}
        anchor, why = index_verdict(d)
        if anchor is None:
            # UNKNOWN collapses to DO NOTHING. sellPriceUsd is sitting right
            # there in the same body and is perfectly readable -- which is
            # exactly why this line has to exist: falling back to it would put
            # the keeper back on the ladder the moment the index hiccups, and
            # the owner switched it off the ladder on purpose.
            info["why"] = why + " -- NOT falling back to the ladder price"
            return None, info           # UNKNOWN: hold. Never the ladder.
    else:
        # NOT serviceRate. serviceRate = min(ladder, pool) while the oracle
        # follows the pool down, so it equals the pool whenever the pool is
        # under the ladder -- and a keeper aimed at that is aimed at its own
        # reflection. Every run printed `+0.00% -- within dead band` because of
        # it. `sellPriceUsd` is the oracle's `postedPrice()`: the ladder's
        # marginal price, set by our order book and never by the pool.
        #
        # The minimal body (2026-09-25) keeps sellPriceUsd under the same name,
        # so this rollback path reads both shapes unchanged -- deliberately
        # "exactly as before", freshness flags included (test_keeper_anchor.py
        # "anchor off" cases).
        info = {"anchor": "ladder"}
        anchor = _real(d.get("sellPriceUsd")) if isinstance(d, dict) else None
        if anchor is None or not (anchor > 0):
            info["why"] = "sellPriceUsd is %r" % (d.get("sellPriceUsd") if isinstance(d, dict) else d,)
            return None, info
    info["anchor_usd"] = anchor
    target = anchor * (1.0 - TARGET_DISCOUNT_PCT / 100.0)
    if not (0 < target <= MAX_TARGET_USD):
        # Loud, because silence here looks identical to "nothing to do".
        info["why"] = ("%s $%.8f gives target $%.8f, above the max_target_usd sanity "
                       "bound of $%.8f" % (info["anchor"], anchor, target, MAX_TARGET_USD))
        print("REFUSING: %s. Not trading." % info["why"], file=sys.stderr)
        return None, info
    return target, info


def posted_rate():
    """The target pool price and what it came from: (target, info).

    The anchor is the LADDER ask (`sellPriceUsd`), or with anchor_index on the
    PCN INDEX -- either way less TARGET_DISCOUNT_PCT, and either way a number
    the pool cannot move, which is exactly what an anchor has to be. The choice
    itself is target_from_body(), which is pure and tested
    (test_keeper_anchor.py); this only fetches.

    Returns target None for UNKNOWN, and None must never trade.
    """
    anchor = "index" if ANCHOR_INDEX else "ladder"
    try:
        with urllib.request.urlopen("https://price.pc.am", timeout=25) as r:
            d = json.load(r)
    except Exception as e:
        return None, {"anchor": anchor, "why": "price.pc.am unreadable: %s" % e}
    try:
        return target_from_body(d)
    except Exception as e:
        return None, {"anchor": anchor, "why": "price.pc.am's answer unusable: %s" % e}


def decide(pool, ladder, buy_floor, dead_band):
    """What should the keeper do at this pair of prices? Pure, no I/O.

    It lives out here, and not inline in main(), for one reason: main() cannot
    be run against a pool that is sitting on the floor, so an inline decision
    could only ever be tested by re-typing it into a test -- which tests the
    copy and not the code. See test_decide.py, which drives THIS function.

    TWO TARGETS, NOT ONE. sell_target is the ladder, always: wPCN must never
    trade ABOVE PCN, or buying PCN from us, wrapping it and selling the wPCN is
    free money. buy_target is the only price the keeper will DEFEND with USDT.

    At buy_floor = 0 the two are equal and this is exactly the behaviour the
    keeper always had -- parity, held from both sides. Above 0 the buy target is
    the floor, and the whole band between the floor and the ladder is left
    alone: ordinary selling is allowed to move the price, and the ask follows it
    down separately through cap-policy.mjs. Before this, every dump was answered
    with the keeper's own money, so the desk paid to keep PCN expensive while
    wPCN was being sold.

    min(), not the floor alone: the keeper must never buy the pool up past the
    ask. If the ladder is ever below the floor, the ladder wins.

    Returns (action, target, buy_target, sell_target); action is "buy", "sell"
    or None, and target is the one the action aims at.
    """
    sell_target = ladder
    buy_target = ladder if buy_floor <= 0 else min(ladder, buy_floor)
    if pool > sell_target * (1.0 + dead_band):
        return "sell", sell_target, buy_target, sell_target
    if pool < buy_target * (1.0 - dead_band):
        return "buy", buy_target, buy_target, sell_target
    return None, None, buy_target, sell_target


def amount_out(amount_in, reserve_in, reserve_out):
    """Constant product with PancakeSwap's fee. The exact router formula."""
    ain = amount_in * FEE_NUM
    return (ain * reserve_out) / (reserve_in * FEE_DEN + ain)


def solve_trade(reserve_in, reserve_out, target_price, buying_out):
    """Input size that moves the pool to target_price, and no further.

    Solved by bisection on the exact swap formula rather than the closed form.
    The closed form has to be re-derived whenever the fee changes and is easy to
    get subtly wrong; bisection over a monotonic function cannot be.

    buying_out=True  -> paying USDT, receiving wPCN (price rises)
    buying_out=False -> paying wPCN, receiving USDT (price falls)
    """
    def price_after(x):
        out = amount_out(x, reserve_in, reserve_out)
        ri, ro = reserve_in + x, reserve_out - out
        return (ri / ro) if buying_out else (ro / ri)

    lo, hi = 0.0, reserve_in * 10
    for _ in range(200):
        mid = (lo + hi) / 2
        if mid <= 0:
            break
        p = price_after(mid)
        if (p < target_price) if buying_out else (p > target_price):
            lo = mid
        else:
            hi = mid
    return lo


def run_budget(buying, want, spent_today, have):
    """How much THIS run may trade, and which limit decided it. Pure, no I/O.

    The per-run caps came with the every-minute timer (D11). At ten minutes the
    daily cap was the only pacing, and one run could spend all of it on a single
    read of the pool. At one minute the right shape is small steps: a run trades
    at most max_*_per_run, the next run re-reads the pool, and carries on only
    if the gap is still there. A correction that somebody else's trade finishes
    for us costs us nothing, and a wrong read costs one step, not the day.

    Returns (budget, bound_by). bound_by names the term that set the budget --
    "daily cap", "float floor", "per-run cap", or "gap" when the whole trade
    fits -- so a blocked or partial run says WHICH limit to look at. Ties go to
    the limits before the gap, and to the daily cap first: that is the order
    the blocked-run message always used.
    """
    if buying:
        run_cap = MAX_USDT_PER_RUN
        day_left = DAILY_USDT_CAP - spent_today
        float_left = max(0.0, have - MIN_USDT_FLOOR)
    else:
        run_cap = MAX_WPCN_PER_RUN
        day_left = DAILY_WPCN_CAP - spent_today
        float_left = max(0.0, have - MIN_WPCN_FLOOR)
    budget = min(want,
                 run_cap,
                 day_left,
                 float_left)
    for name, v in (("daily cap", day_left), ("float floor", float_left),
                    ("per-run cap", run_cap), ("gap", want)):
        if v == budget:
            return budget, name
    return budget, "gap"


def main() -> int:
    live = "--live" in sys.argv

    # A broken tuning file stops everything, BEFORE a key is loaded or a price
    # is read. Falling back to defaults here would mean trading on settings
    # nobody chose, which is worse than not trading at all.
    if TUNING_ERROR:
        write_effective()
        notify_throttled("tuning_broken", "\U0001F534 wPCN keeper stopped: its settings file is broken",
                         "The keeper that holds the wPCN pool next to the PCN price is not "
                         "trading, because its settings file cannot be read. It will not guess "
                         "settings nobody chose.\n"
                         "What to do: fix it in the admin panel (Keeper settings), or delete the "
                         "file to go back to the defaults.\n"
                         f"\u2014\ntech: {md_plain(TUNING_ERROR)} ({md_plain(TUNING_FILE)})")
        print(f"REFUSING: {TUNING_ERROR}", file=sys.stderr)
        return 2

    # Say what is in force, every run. Two identical-looking runs with different
    # settings is the failure this line exists to make impossible.
    print("tuning               : " + ", ".join(
        f"{k}={_TUNE[k]}[{_TUNE_SRC[k]}]" for k in
        ("anchor_index", "dead_band", "target_discount_pct", "buy", "buy_floor_usd",
         "sell", "max_usdt_per_run", "max_wpcn_per_run", "daily_usdt_cap",
         "daily_wpcn_cap", "min_wpcn", "max_index_age_s")))
    write_effective()
    sys.path.insert(0, os.environ.get("WPCN_DIR", "/opt/wpcn"))
    sys.path.insert(1, os.path.dirname(os.path.abspath(__file__)))

    from web3 import Web3
    from deploy import load, connect, send, ROUTER, USDT, USDT_DECIMALS

    cfg = load()
    conf = load_conf()
    w3, _ = connect(cfg)

    key = conf.get("KEEPER_PRIVATE_KEY")
    if not key:
        print(f"No KEEPER_PRIVATE_KEY in {CONF}. Run: pcoin-wpcn-keeper --init")
        return 2
    acct = w3.eth.account.from_key(key)

    # ---- read both prices; either unreadable means DO NOTHING --------------
    posted, pinfo = posted_rate()
    anchor = pinfo.get("anchor", "ladder")        # "index" or "ladder", for every message
    if posted is None:
        why = pinfo.get("why") or "no reason recorded"
        # Replace what the panel shows: a target from an earlier run displayed
        # beside "held" would read as the keeper aiming at it.
        write_effective({"anchor": anchor, "hold": why, "index": pinfo.get("index")})
        if anchor == "index":
            notify_throttled("index_unusable",
                   "\U0001F7E1 wPCN keeper paused: it cannot read the PCN price",
                   "The keeper aims the wPCN pool at the PCN price only, and that price is "
                   "unreadable or unknown right now, so it is not trading. It starts again by "
                   "itself as soon as the price is back.\n"
                   "What to do: nothing, unless the PCN price stays unknown -- then look at "
                   "admin.pc.am, Exchange, PCN index.\n"
                   f"\u2014\ntech: PCN index unusable: {md_plain(why)}")
            print(f"UNVERIFIED: {why} -- holding, nothing traded")
        else:
            notify_throttled("posted_unreadable",
                   "\U0001F7E1 wPCN keeper paused: price.pc.am unreadable",
                   "It could not read the PCN price from price.pc.am, so it does not know what "
                   "to aim at and is not trading. This is a pause, not a sign the pool is fine.\n"
                   "What to do: nothing if it clears; if it lasts, check that price.pc.am loads.\n"
                   f"\u2014\ntech: posted rate unreadable: {md_plain(why)}")
            print(f"UNVERIFIED: posted rate unreadable ({why}) -- holding")
        return 2

    pair_abi = [
        {"constant": True, "inputs": [], "name": "getReserves",
         "outputs": [{"name": "_r0", "type": "uint112"},
                     {"name": "_r1", "type": "uint112"},
                     {"name": "_t", "type": "uint32"}], "type": "function"},
        {"constant": True, "inputs": [], "name": "token0",
         "outputs": [{"name": "", "type": "address"}], "type": "function"}]
    try:
        pair = w3.eth.contract(
            address=Web3.to_checksum_address(cfg["PAIR"]), abi=pair_abi)
        r0, r1, _ = pair.functions.getReserves().call()
        t0 = pair.functions.token0().call()
        token = Web3.to_checksum_address(cfg["TOKEN"])
        if t0 == token:
            w_res, u_res = r0 / 1e8, r1 / 10 ** USDT_DECIMALS
        else:
            w_res, u_res = r1 / 1e8, r0 / 10 ** USDT_DECIMALS
    except Exception as e:
        notify_throttled("pool_unreadable",
               "\U0001F7E1 wPCN keeper paused: it cannot read the pool",
               "It could not read the PancakeSwap wPCN/USDT pool, so it does not know the "
               "pool price and is not trading.\n"
               "What to do: nothing if it clears; it usually is a BSC node hiccup.\n"
               f"\u2014\ntech: getReserves() failed: {md_plain(e)}")
        print(f"UNVERIFIED: pool unreadable: {e}")
        return 2

    pool = u_res / w_res
    gap = pool / posted - 1.0

    # The decision itself is `decide()` above -- pure, and tested there. It
    # calls its second argument `ladder`; with anchor_index on it is the index,
    # and the rule does not change: sell above it, buy below it, and at
    # buy_floor_usd = 0 that is parity from both sides.
    action, target, buy_target, sell_target = decide(
        pool, posted, BUY_FLOOR_USD, DEAD_BAND)
    floor_mode = BUY_FLOOR_USD > 0
    buy_gap = pool / buy_target - 1.0

    # Publish the live pair alongside the settings, so the admin panel can answer
    # "is it about to trade?" from what the keeper itself last saw, rather than
    # from its own second read of a moving price.
    write_effective({"pool_price": pool, "target_price": posted,
                     "buy_target": buy_target, "sell_target": sell_target,
                     "floor_mode": floor_mode, "anchor": anchor,
                     "anchor_usd": pinfo.get("anchor_usd"), "index": pinfo.get("index")})
    if anchor == "index":
        ix = pinfo.get("index") or {}
        print(f"target (PCN index)   : ${posted:.8f}   (index ${pinfo.get('anchor_usd')}, "
              f"{ix.get('state')}, seq {ix.get('seq')}, {ix.get('ageSeconds')} s old, "
              f"via price.pc.am)")
    else:
        print(f"posted (price.pc.am) : ${posted:.8f}")
    print(f"pool   (pancakeswap) : ${pool:.8f}   ({gap*100:+.2f}%)")
    print(f"reserves             : {w_res:,.2f} wPCN / {u_res:,.2f} USDT")
    if floor_mode:
        print(f"FLOOR MODE           : buys below ${buy_target:.8f} "
              f"({buy_gap*100:+.2f}%), sells above ${sell_target:.8f}. "
              f"Between the two it does nothing.")

    # ---- refuse implausible gaps ------------------------------------------
    ratio = max(pool, posted) / min(pool, posted)
    if ratio > SANITY_RATIO:
        notify_throttled("implausible_gap",
               "\U0001F534 wPCN keeper stopped: pool and PCN price are %.1fx apart" % ratio,
               f"The pool says ${pool:.6f} and the PCN price is ${posted:.6f}. A gap that big is "
               f"more likely a broken price feed than a real market, so it traded nothing.\n"
               f"What to do: compare price.pc.am with the pool on PancakeSwap by hand.\n"
               f"\u2014\ntech: pool ${pool:.8f} vs posted ${posted:.8f} (sanity ratio {SANITY_RATIO})")
        print(f"HOLD: gap {ratio:.1f}x exceeds sanity ratio {SANITY_RATIO}")
        return 1

    # decide() judged each side against ITS OWN target. The single `abs(gap) <
    # DEAD_BAND` test this replaced could not express floor mode at all: it made
    # a pool 55% below the ladder and a pool 1% below the floor the same number.
    if action is not None:
        buying = action == "buy"
    else:
        if floor_mode and pool < posted * (1.0 - DEAD_BAND):
            print(f"pool ${pool:.8f} is {abs(gap)*100:.2f}% below the {anchor} "
                  f"${posted:.8f} -- and that is ALLOWED. Floor mode defends "
                  f"${buy_target:.8f}, not parity, and the pool is "
                  f"{buy_gap*100:+.2f}% against it. Nothing to do.")
        else:
            # Report BOTH gaps. Choosing one by `pool > posted` named the floor
            # whenever the pool sat exactly on the ladder, and then said the
            # pool was inside a +/-3% band of a price it was 124% above.
            print(f"HOLD: pool is {buy_gap*100:+.2f}% against the buy target "
                  f"${buy_target:.8f} and {gap*100:+.2f}% against the {anchor} "
                  f"${sell_target:.8f}. Neither side is outside its "
                  f"+/-{DEAD_BAND*100:.1f}% dead band -- nothing to do.")
        return 0

    # ---- daily budget ------------------------------------------------------
    st = load_state()
    today = time.strftime("%Y-%m-%d")
    if st.get("day") != today:
        st = {"day": today, "usdt_spent": 0.0, "wpcn_spent": 0.0,
              "trades": st.get("trades", [])[-50:],
              # carried across the day boundary on purpose: a condition that
              # has persisted since yesterday is still not news at midnight.
              "nagged": st.get("nagged", {})}

    erc20 = [{"constant": True, "inputs": [{"name": "o", "type": "address"}],
              "name": "balanceOf", "outputs": [{"name": "", "type": "uint256"}],
              "type": "function"},
             {"constant": False, "inputs": [{"name": "s", "type": "address"},
                                            {"name": "v", "type": "uint256"}],
              "name": "approve", "outputs": [{"name": "", "type": "bool"}],
              "type": "function"},
             {"constant": True, "inputs": [{"name": "o", "type": "address"},
                                           {"name": "s", "type": "address"}],
              "name": "allowance", "outputs": [{"name": "", "type": "uint256"}],
              "type": "function"}]
    usdt_c = w3.eth.contract(address=Web3.to_checksum_address(USDT), abi=erc20)
    wpcn_c = w3.eth.contract(address=token, abi=erc20)
    have_usdt = usdt_c.functions.balanceOf(acct.address).call() / 10 ** USDT_DECIMALS
    have_wpcn = wpcn_c.functions.balanceOf(acct.address).call() / 1e8
    print(f"keeper wallet        : {acct.address}")
    print(f"float                : {have_usdt:,.4f} USDT / {have_wpcn:,.2f} wPCN")

    # `buying` and `target` were decided by the dead-band test above.
    if buying and not BUY_ON:
        print("BUYING IS OFF (KEEPER_BUY=off) -- the pool is allowed to fall.")
        print(f"pool ${pool:.8f} is {abs(pool/target - 1.0) * 100:.2f}% below its buy "
              f"target ${target:.8f}. Nothing bought."
              + (" Selling into strength is still enabled." if SELL_ON
                 else " Selling is off too: the keeper is neutral."))
        return 0
    if (not buying) and not SELL_ON:
        print("SELLING IS OFF (KEEPER_SELL=off) -- the pool is allowed to RISE.")
        print(f"pool ${pool:.8f} is {abs(gap) * 100:.2f}% above the {anchor} ${posted:.8f}. "
              "Nothing sold. A buyer moving the price up is the point, not a fault "
              "to correct -- and min(ladder, pool) already caps what the rails credit.")
        return 0
    if buying and floor_mode:
        # The pool has reached the floor. That is the event this mode exists for
        # and it is worth saying once, not every ten minutes -- notify_throttled
        # reports the onset and the clearing, never the persistence.
        notify_throttled("floor_defence",
               "\U0001F7E1 wPCN keeper is defending the $%.4f floor" % buy_target,
               f"The wPCN pool fell to ${pool:.6f} ({buy_gap*100:+.2f}% against the ${buy_target:.4f} "
               f"floor), so the keeper is buying wPCN to lift it back. The PCN price is "
               f"${posted:.6f}; above the floor it leaves the pool alone on purpose.\n"
               f"This spends the keeper's USDT. When that runs out, nothing holds the floor "
               f"in the pool (PCN itself is still never credited or sold below it).\n"
               f"What to do: watch the keeper's USDT; top it up if you want the floor held.\n"
               f"\u2014\ntech: pool ${pool:.8f}, floor ${buy_target:.8f}, {anchor} ${posted:.8f}")
    # The budget, per-run cap included, is `run_budget()` -- pure, and tested
    # in test_keeper_anchor.py.
    if buying:
        want = solve_trade(u_res, w_res, target, True)
        budget, bound_by = run_budget(True, want, st["usdt_spent"], have_usdt)
        unit, need_label = "USDT", "USDT"
    else:
        want = solve_trade(w_res, u_res, target, False)
        budget, bound_by = run_budget(False, want, st["wpcn_spent"], have_wpcn)
        unit, need_label = "wPCN", "wPCN"

    print(f"to reach ${target:.8f} : trade {want:,.6f} {unit}")
    print(f"allowed this run     : {budget:,.6f} {unit}"
          + ("" if bound_by == "gap" or budget <= 0 else
             f"   (held to this by the {bound_by}"
             + ("; the next run carries on from a fresh read of the pool)"
                if bound_by == "per-run cap" else ")")))

    if budget <= 0:
        # Name the term that ACTUALLY bound the budget. Choosing the reason by
        # "have we spent anything today" blamed the daily cap on every run after
        # the first trade, including when the cap had plenty left and the float
        # was sitting on its floor -- which sends the reader to raise a limit
        # that was not binding while the wallet stays empty. run_budget() names
        # it now, the per-run cap included.
        if buying:
            cap_left = DAILY_USDT_CAP - st["usdt_spent"]
            cap_txt = f"{cap_left:,.4f} of {DAILY_USDT_CAP:,.0f} USDT/day left"
            floor_txt = f"float {have_usdt:,.4f} USDT against a {MIN_USDT_FLOOR:,.2f} floor"
        else:
            cap_left = DAILY_WPCN_CAP - st["wpcn_spent"]
            cap_txt = f"{cap_left:,.2f} of {DAILY_WPCN_CAP:,.0f} wPCN/day left"
            floor_txt = f"float {have_wpcn:,.2f} wPCN against a {MIN_WPCN_FLOOR:,.2f} floor"
        if bound_by == "daily cap":
            why = "daily cap reached"
            fix = ("Raise daily_%s_cap (admin panel, or keeper-tune), or wait for the "
                   "daily reset." % unit.lower())
        elif bound_by == "float floor":
            why = f"{need_label} float at or below floor"
            fix = f"Top the float up -- send {need_label} to {acct.address}."
        elif bound_by == "per-run cap":
            why = f"max_{unit.lower()}_per_run is 0"
            fix = (f"Raise max_{unit.lower()}_per_run (admin panel, or keeper-tune). "
                   f"At 0 this side of the keeper is switched off.")
        else:
            why = "nothing to trade"
            fix = "No action: the gap is already inside the dead band."
        plain_why = {"daily cap reached": "today's spending limit is used up",
                     f"{need_label} float at or below floor": f"it has run out of {need_label}",
                     f"max_{unit.lower()}_per_run is 0": f"its per-run {unit} limit is set to 0",
                     "nothing to trade": "nothing needs trading"}.get(why, why)
        notify_throttled("blocked",
               f"\U0001F7E1 wPCN keeper cannot hold the price: {plain_why}",
               f"The pool is at ${pool:.6f}, {gap*100:+.2f}% against the PCN price ${posted:.6f}. "
               f"Closing that needs {want:,.2f} {unit}, and the keeper cannot spend it: {plain_why}.\n"
               f"Customers affected: no -- only the pool price drifts.\n"
               f"What to do: {md_plain(fix)}\n"
               f"\u2014\ntech: {md_plain(why)}; cap {md_plain(cap_txt)}; {md_plain(floor_txt)}")
        print(f"BLOCKED: {why}  (cap: {cap_txt}; {floor_txt})")
        return 1

    if not live:
        print("\nDRY RUN -- nothing sent. Re-run with --live to trade.")
        return 0

    # ---- execute -----------------------------------------------------------
    router_abi = [{"name": "swapExactTokensForTokens", "type": "function",
                   "inputs": [{"name": "amountIn", "type": "uint256"},
                              {"name": "amountOutMin", "type": "uint256"},
                              {"name": "path", "type": "address[]"},
                              {"name": "to", "type": "address"},
                              {"name": "deadline", "type": "uint256"}],
                   "outputs": [{"name": "amounts", "type": "uint256[]"}]}]
    router = w3.eth.contract(address=Web3.to_checksum_address(ROUTER), abi=router_abi)

    if buying:
        amt_in = int(budget * 10 ** USDT_DECIMALS)
        expect = amount_out(budget, u_res, w_res)
        min_out = int(expect * (1 - SLIPPAGE) * 1e8)
        path = [Web3.to_checksum_address(USDT), token]
        spend_c, decimals = usdt_c, 10 ** USDT_DECIMALS
    else:
        amt_in = int(budget * 1e8)
        expect = amount_out(budget, w_res, u_res)
        min_out = int(expect * (1 - SLIPPAGE) * 10 ** USDT_DECIMALS)
        path = [token, Web3.to_checksum_address(USDT)]
        spend_c, decimals = wpcn_c, 1e8

    allowance = spend_c.functions.allowance(
        acct.address, Web3.to_checksum_address(ROUTER)).call()
    if allowance < amt_in:
        # Approve EXACTLY this trade, not 2**255. An unlimited allowance means
        # a compromised or buggy router could drain the keeper's whole USDT
        # float in one call; an exact one caps the blast radius at a single
        # trade, and the keeper already worked that way for wPCN. It costs one
        # extra approve() per trade -- a few cents of gas against the float.
        # The 2**255 USDT approval this replaced was revoked on 2026-09-05.
        send(w3, acct, spend_c.functions.approve(
            Web3.to_checksum_address(ROUTER), amt_in).build_transaction(
                {"from": acct.address}), "approve")

    r = send(w3, acct, router.functions.swapExactTokensForTokens(
        amt_in, min_out, path, acct.address, int(time.time()) + 600
    ).build_transaction({"from": acct.address}),
        f"swap {budget:,.6f} {unit}")

    if buying:
        st["usdt_spent"] += budget
    else:
        st["wpcn_spent"] += budget
    st["trades"].append({"at": int(time.time()), "dir": "buy" if buying else "sell",
                         "amount": budget, "unit": unit,
                         "pool_before": pool, "posted": posted, "target": target,
                         "floor_mode": floor_mode, "anchor": anchor,
                         "bound_by": bound_by,
                         "block": r.blockNumber})
    save_state(st)

    r0, r1, _ = pair.functions.getReserves().call()
    if t0 == token:
        w2, u2 = r0 / 1e8, r1 / 10 ** USDT_DECIMALS
    else:
        w2, u2 = r1 / 1e8, r0 / 10 ** USDT_DECIMALS
    after = u2 / w2
    print(f"\npool ${pool:.8f} -> ${after:.8f}  (target ${target:.8f})")
    notify(("\U0001F7E2 wPCN keeper bought wPCN for %s USDT" % f"{budget:,.2f}") if buying
           else ("\U0001F7E2 wPCN keeper sold %s wPCN" % f"{budget:,.2f}"),
           ("It bought wPCN on PancakeSwap" if buying else "It sold wPCN on PancakeSwap")
           + f" to keep the pool next to the PCN price: pool ${pool:.6f} -> ${after:.6f} "
           f"(aiming at ${target:.6f}).\n"
           + (f"That was its per-run limit; the next run re-reads the pool and carries on "
              f"only if the gap is still there.\n" if bound_by == "per-run cap" else "")
           + f"Its money before this trade: {have_usdt:,.2f} USDT and {have_wpcn:,.2f} wPCN.\n"
           "What to do: nothing.\n"
           f"\u2014\ntech: {'spent' if buying else 'sold'} {budget:,.6f} {unit}; pool ${pool:.8f} -> "
           f"${after:.8f}, target ${target:.8f}, {anchor} ${posted:.8f}")
    return 0


def cmd_init():
    """Create the keeper key ON THIS MACHINE and never print it.

    The deployer key was generated on a server and delivered through a chat
    transcript, which is why it had to be treated as burned and swept. This one
    is written straight to a 0600 file and only its ADDRESS is ever shown.
    """
    sys.path.insert(0, os.environ.get("WPCN_DIR", "/opt/wpcn"))
    from web3 import Web3
    if os.path.exists(CONF) and "KEEPER_PRIVATE_KEY" in open(CONF).read():
        cfg = load_conf()
        acct = Web3().eth.account.from_key(cfg["KEEPER_PRIVATE_KEY"])
        print(f"already initialised. keeper address: {acct.address}")
        return 0
    acct = Web3().eth.account.create()
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    fd = os.open(CONF, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("# wPCN keeper key. MODE 0600. NEVER in git, never printed.\n")
        f.write(f"KEEPER_PRIVATE_KEY={acct.key.hex()}\n")
    print(f"keeper address: {acct.address}")
    print(f"key written to {CONF} (0600). It was NOT printed and must not be.")
    print("\nFund this address with:")
    print("  * a little BNB for gas")
    print("  * USDT   -- so it can buy wPCN when the pool is cheap")
    print("  * wPCN   -- so it can sell when the pool is expensive")
    return 0


def print_tuning():
    print(f"tuning file : {TUNING_FILE}"
          f"{'' if os.path.exists(TUNING_FILE) else '   (absent -- unit and defaults apply)'}")
    if TUNING_ERROR:
        print(f"ERROR       : {TUNING_ERROR}")
        print("The keeper will REFUSE to trade until this is fixed.")
        return 2
    w = max(len(k) for k in TUNABLES)
    for k, (kind, lo, hi, env, dflt, doc) in TUNABLES.items():
        bounds = "on/off" if kind == "bool" else f"{lo} .. {hi}"
        print(f"  {k:<{w}}  {str(_TUNE[k]):>10}  [{_TUNE_SRC[k]:<7}]  {bounds:<16} {env}")
    print("\nsource: panel = the tuning file, unit = the service's Environment=, "
          "default = built in.")
    return 0


if __name__ == "__main__":
    if "--init" in sys.argv:
        sys.exit(cmd_init())
    if "--tuning" in sys.argv:
        sys.exit(print_tuning())
    sys.exit(main())
