    _TUNE = {k: (v[4] if v[0] != "bool" else v[4]) for k, v in TUNABLES.items()}
    _TUNE_SRC = {k: "UNUSED -- tuning is broken" for k in TUNABLES}

DEAD_BAND = _TUNE["dead_band"]
SANITY_RATIO = _TUNE["sanity_ratio"]
DAILY_USDT_CAP = _TUNE["daily_usdt_cap"]
DAILY_WPCN_CAP = _TUNE["daily_wpcn_cap"]
MIN_USDT_FLOOR = _TUNE["min_usdt"]
MIN_WPCN_FLOOR = _TUNE["min_wpcn"]
BUY_ON = _TUNE["buy"]
SELL_ON = _TUNE["sell"]
BUY_FLOOR_USD = _TUNE["buy_floor_usd"]

SLIPPAGE = _TUNE["slippage"]
# A persistent condition is not new information every 10 minutes. Only its
# onset and its clearing are, so repeat alerts are throttled to this.
NAG_SECONDS = int(os.environ.get("KEEPER_NAG_SECONDS", 21600))  # 6 hours
FEE_NUM, FEE_DEN = 9975, 10000                                  # PancakeSwap 0.25%


def notify(subject, body):
    if not os.path.exists(NOTIFY):
        print(f"[no notifier] {subject}\n{body}")
        return
    subprocess.run([NOTIFY, subject, body], timeout=60)


def notify_throttled(key, subject, body, seconds=NAG_SECONDS):
    """Alert at most once per `seconds` for this condition.

    The timer runs every 10 minutes, so an unfunded float or a stuck price feed
    would otherwise page 144 times a day and teach everyone to ignore the
    channel -- which is exactly what happened to pcoin-concentration-watch when
    it sent the same figure twenty-four times in eight hours. A condition that
    persists is not new information; only its onset and its clearing are.
    """
    st = load_state()
    last = (st.get("nagged") or {}).get(key, 0)
    if time.time() - last < seconds:
        print(f"[throttled, already alerted] {subject}")
        return
    notify(subject, body)
    st.setdefault("nagged", {})[key] = int(time.time())
    save_state(st)


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except Exception:
        return {"day": "", "usdt_spent": 0.0, "wpcn_spent": 0.0,
                "trades": [], "nagged": {}}


def save_state(s):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(s, f, indent=1)
    os.replace(tmp, STATE)


def load_conf():
    cfg = {}
    if os.path.exists(CONF):
        for line in open(CONF):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                cfg[k.strip()] = v.strip()
    return cfg


# How far BELOW the ladder ask the pool is held, and a hard ceiling on the
# result. Both are tunables now; see TUNABLES above for what each one is for.
# The ceiling exists because sellPriceUsd is raw where serviceRate arrived
# pre-braked, and the oracle's own serviceCeiling is 10.00 -- without it one
# corrupted ladder read would have the keeper chase $9.50 and spend the float.
TARGET_DISCOUNT_PCT = _TUNE["target_discount_pct"]
MAX_TARGET_USD = _TUNE["max_target_usd"]


def write_effective(extra=None):
    """Publish what this run ACTUALLY used, for the admin panel to display.

    The panel showing the tuning file would only show what somebody INTENDED.
    This is what the process read, including anything still coming from the unit
    or a default, so drift between the two is visible instead of assumed.
    """
    try:
        out = {"at": int(time.time()),
               "tuning_file": TUNING_FILE,
               "error": TUNING_ERROR,
               "values": {k: _TUNE.get(k) for k in TUNABLES},
               "sources": {k: _TUNE_SRC.get(k) for k in TUNABLES},
               "docs": {k: v[5] for k, v in TUNABLES.items()},
               "bounds": {k: [v[1], v[2]] for k, v in TUNABLES.items()},
               "env_var": {k: v[3] for k, v in TUNABLES.items()}}
        if extra:
            out.update(extra)
        os.makedirs(os.path.dirname(EFFECTIVE_FILE), exist_ok=True)
        tmp = EFFECTIVE_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(out, f, indent=1)
        os.replace(tmp, EFFECTIVE_FILE)
    except Exception as e:
        print(f"[warn] could not write {EFFECTIVE_FILE}: {e}", file=sys.stderr)


def posted_rate():
    """The target pool price: the LADDER ask, less TARGET_DISCOUNT_PCT.

    NOT serviceRate. serviceRate = min(ladder, pool) while the oracle follows the
    pool down, so it equals the pool whenever the pool is under the ladder --
    and a keeper aimed at that is aimed at its own reflection. Every run printed
    `+0.00% -- within dead band` because of it.

    `sellPriceUsd` is the oracle's `postedPrice()`: the ladder's marginal price,
    set by our order book and never by the pool. It is the only field here that
    the pool cannot move, which is exactly what an anchor has to be.

    Returns None for UNKNOWN, and None must never trade.
    """
    try:
        with urllib.request.urlopen("https://price.pc.am", timeout=25) as r:
            d = json.load(r)
        v = d.get("sellPriceUsd")
        if v is None:
            return None
        ladder = float(v)
        if not (ladder > 0):
            return None
        target = ladder * (1.0 - TARGET_DISCOUNT_PCT / 100.0)
        if not (0 < target <= MAX_TARGET_USD):
            # Loud, because silence here looks identical to "nothing to do".
            print("REFUSING: ladder $%.8f gives target $%.8f, above the "
                  "KEEPER_MAX_TARGET_USD sanity bound of $%.8f. Not trading."
                  % (ladder, target, MAX_TARGET_USD), file=sys.stderr)
            return None
        return target
    except Exception:
        return None


def decide(pool, ladder, buy_floor, dead_band):
    """What should the keeper do at this pair of prices? Pure, no I/O.

    It lives out here, and not inline in main(), for one reason: main() cannot
    be run against a pool that is sitting on the floor, so an inline decision
    could only ever be tested by re-typing it into a test -- which tests the
    copy and not the code. See test_decide.py, which drives THIS function.

    TWO TARGETS, NOT ONE. sell_target is the ladder, always: wPCN must never
    trade ABOVE PCN, or buying PCN from us, wrapping it and selling the wPCN is
    free money. buy_target is the only price the keeper will DEFEND with USDT.

    At buy_floor = 0 the two are equal and this is exactly the behaviour the
    keeper always had -- parity, held from both sides. Above 0 the buy target is
    the floor, and the whole band between the floor and the ladder is left
    alone: ordinary selling is allowed to move the price, and the ask follows it
    down separately through cap-policy.mjs. Before this, every dump was answered
    with the keeper's own money, so the desk paid to keep PCN expensive while
    wPCN was being sold.

    min(), not the floor alone: the keeper must never buy the pool up past the
    ask. If the ladder is ever below the floor, the ladder wins.

    Returns (action, target, buy_target, sell_target); action is "buy", "sell"
    or None, and target is the one the action aims at.
    """
    sell_target = ladder
    buy_target = ladder if buy_floor <= 0 else min(ladder, buy_floor)
    if pool > sell_target * (1.0 + dead_band):
        return "sell", sell_target, buy_target, sell_target
    if pool < buy_target * (1.0 - dead_band):
        return "buy", buy_target, buy_target, sell_target
    return None, None, buy_target, sell_target


def amount_out(amount_in, reserve_in, reserve_out):
    """Constant product with PancakeSwap's fee. The exact router formula."""
    ain = amount_in * FEE_NUM
    return (ain * reserve_out) / (reserve_in * FEE_DEN + ain)


def solve_trade(reserve_in, reserve_out, target_price, buying_out):
    """Input size that moves the pool to target_price, and no further.

    Solved by bisection on the exact swap formula rather than the closed form.
    The closed form has to be re-derived whenever the fee changes and is easy to
    get subtly wrong; bisection over a monotonic function cannot be.

    buying_out=True  -> paying USDT, receiving wPCN (price rises)
    buying_out=False -> paying wPCN, receiving USDT (price falls)
    """
    def price_after(x):
        out = amount_out(x, reserve_in, reserve_out)
        ri, ro = reserve_in + x, reserve_out - out
        return (ri / ro) if buying_out else (ro / ri)

    lo, hi = 0.0, reserve_in * 10
    for _ in range(200):
        mid = (lo + hi) / 2
        if mid <= 0:
            break
        p = price_after(mid)
        if (p < target_price) if buying_out else (p > target_price):
            lo = mid
        else:
            hi = mid
    return lo


def main() -> int:
    live = "--live" in sys.argv

    # A broken tuning file stops everything, BEFORE a key is loaded or a price
    # is read. Falling back to defaults here would mean trading on settings
    # nobody chose, which is worse than not trading at all.
    if TUNING_ERROR:
        write_effective()
        notify_throttled("tuning_broken", "keeper: TUNING FILE IS BROKEN -- not trading",
                         f"{TUNING_ERROR}\n\nThe keeper will not trade until this is "
                         f"fixed. It has NOT fallen back to defaults: running a bot that "
                         f"spends money on settings nobody chose is worse than it standing "
                         f"still. Fix or delete {TUNING_FILE}.")
        print(f"REFUSING: {TUNING_ERROR}", file=sys.stderr)
        return 2

    # Say what is in force, every run. Two identical-looking runs with different
    # settings is the failure this line exists to make impossible.
    print("tuning               : " + ", ".join(
        f"{k}={_TUNE[k]}[{_TUNE_SRC[k]}]" for k in
        ("dead_band", "target_discount_pct", "buy", "buy_floor_usd", "sell",
         "daily_usdt_cap", "daily_wpcn_cap")))
    write_effective()
    sys.path.insert(0, os.environ.get("WPCN_DIR", "/opt/wpcn"))
    sys.path.insert(1, os.path.dirname(os.path.abspath(__file__)))

    from web3 import Web3
    from deploy import load, connect, send, ROUTER, USDT, USDT_DECIMALS

    cfg = load()
    conf = load_conf()
    w3, _ = connect(cfg)

    key = conf.get("KEEPER_PRIVATE_KEY")
    if not key:
        print(f"No KEEPER_PRIVATE_KEY in {CONF}. Run: pcoin-wpcn-keeper --init")
        return 2
    acct = w3.eth.account.from_key(key)

    # ---- read both prices; either unreadable means DO NOTHING --------------
    posted = posted_rate()
    if posted is None:
        notify_throttled("posted_unreadable",
               "keeper: price.pc.am unreadable",
               "Could not read the posted rate, so the target price is UNKNOWN. "
               "Not trading. This is a hold, not a decision that the pool is fine.")
        print("UNVERIFIED: posted rate unreadable -- holding")
        return 2

    pair_abi = [
        {"constant": True, "inputs": [], "name": "getReserves",
         "outputs": [{"name": "_r0", "type": "uint112"},
                     {"name": "_r1", "type": "uint112"},
                     {"name": "_t", "type": "uint32"}], "type": "function"},
        {"constant": True, "inputs": [], "name": "token0",
         "outputs": [{"name": "", "type": "address"}], "type": "function"}]
    try:
        pair = w3.eth.contract(
            address=Web3.to_checksum_address(cfg["PAIR"]), abi=pair_abi)
        r0, r1, _ = pair.functions.getReserves().call()
        t0 = pair.functions.token0().call()
        token = Web3.to_checksum_address(cfg["TOKEN"])
        if t0 == token:
            w_res, u_res = r0 / 1e8, r1 / 10 ** USDT_DECIMALS
        else:
            w_res, u_res = r1 / 1e8, r0 / 10 ** USDT_DECIMALS
    except Exception as e:
        notify_throttled("pool_unreadable",
               "keeper: pool unreadable",
               f"getReserves() failed: {e}\nNot trading. UNKNOWN, not 'no gap'.")
        print(f"UNVERIFIED: pool unreadable: {e}")
        return 2

    pool = u_res / w_res
    gap = pool / posted - 1.0

    # The decision itself is `decide()` above -- pure, and tested there.
    action, target, buy_target, sell_target = decide(
        pool, posted, BUY_FLOOR_USD, DEAD_BAND)
    floor_mode = BUY_FLOOR_USD > 0
    buy_gap = pool / buy_target - 1.0

    # Publish the live pair alongside the settings, so the admin panel can answer
    # "is it about to trade?" from what the keeper itself last saw, rather than
    # from its own second read of a moving price.
    write_effective({"pool_price": pool, "target_price": posted,
                     "buy_target": buy_target, "sell_target": sell_target,
                     "floor_mode": floor_mode})
    print(f"posted (price.pc.am) : ${posted:.8f}")
    print(f"pool   (pancakeswap) : ${pool:.8f}   ({gap*100:+.2f}%)")
    print(f"reserves             : {w_res:,.2f} wPCN / {u_res:,.2f} USDT")
    if floor_mode:
        print(f"FLOOR MODE           : buys below ${buy_target:.8f} "
              f"({buy_gap*100:+.2f}%), sells above ${sell_target:.8f}. "
              f"Between the two it does nothing.")

    # ---- refuse implausible gaps ------------------------------------------
    ratio = max(pool, posted) / min(pool, posted)
    if ratio > SANITY_RATIO:
        notify_throttled("implausible_gap",
               "keeper: IMPLAUSIBLE GAP -- holding",
               f"pool ${pool:.8f} vs posted ${posted:.8f} ({ratio:.1f}x apart).\n"
               f"That is more likely a broken price feed than a real market, so "
               f"nothing was traded. Check price.pc.am and the pair by hand.")
        print(f"HOLD: gap {ratio:.1f}x exceeds sanity ratio {SANITY_RATIO}")
        return 1

    # decide() judged each side against ITS OWN target. The single `abs(gap) <
    # DEAD_BAND` test this replaced could not express floor mode at all: it made
    # a pool 55% below the ladder and a pool 1% below the floor the same number.
    if action is not None:
        buying = action == "buy"
    else:
        if floor_mode and pool < posted * (1.0 - DEAD_BAND):
            print(f"pool ${pool:.8f} is {abs(gap)*100:.2f}% below the ladder "
                  f"${posted:.8f} -- and that is ALLOWED. Floor mode defends "
                  f"${buy_target:.8f}, not parity, and the pool is "
                  f"{buy_gap*100:+.2f}% against it. Nothing to do.")
        else:
            # Report BOTH gaps. Choosing one by `pool > posted` named the floor
            # whenever the pool sat exactly on the ladder, and then said the
            # pool was inside a +/-3% band of a price it was 124% above.
            print(f"HOLD: pool is {buy_gap*100:+.2f}% against the buy target "
                  f"${buy_target:.8f} and {gap*100:+.2f}% against the ladder "
                  f"${sell_target:.8f}. Neither side is outside its "
                  f"+/-{DEAD_BAND*100:.1f}% dead band -- nothing to do.")
        return 0

    # ---- daily budget ------------------------------------------------------
    st = load_state()
    today = time.strftime("%Y-%m-%d")
    if st.get("day") != today:
        st = {"day": today, "usdt_spent": 0.0, "wpcn_spent": 0.0,
              "trades": st.get("trades", [])[-50:],
              # carried across the day boundary on purpose: a condition that
              # has persisted since yesterday is still not news at midnight.
              "nagged": st.get("nagged", {})}

    erc20 = [{"constant": True, "inputs": [{"name": "o", "type": "address"}],
              "name": "balanceOf", "outputs": [{"name": "", "type": "uint256"}],
              "type": "function"},
             {"constant": False, "inputs": [{"name": "s", "type": "address"},
                                            {"name": "v", "type": "uint256"}],
              "name": "approve", "outputs": [{"name": "", "type": "bool"}],
              "type": "function"},
             {"constant": True, "inputs": [{"name": "o", "type": "address"},
                                           {"name": "s", "type": "address"}],
              "name": "allowance", "outputs": [{"name": "", "type": "uint256"}],
              "type": "function"}]
    usdt_c = w3.eth.contract(address=Web3.to_checksum_address(USDT), abi=erc20)
    wpcn_c = w3.eth.contract(address=token, abi=erc20)
    have_usdt = usdt_c.functions.balanceOf(acct.address).call() / 10 ** USDT_DECIMALS
    have_wpcn = wpcn_c.functions.balanceOf(acct.address).call() / 1e8
    print(f"keeper wallet        : {acct.address}")
    print(f"float                : {have_usdt:,.4f} USDT / {have_wpcn:,.2f} wPCN")

    # `buying` and `target` were decided by the dead-band test above.
    if buying and not BUY_ON:
        print("BUYING IS OFF (KEEPER_BUY=off) -- the pool is allowed to fall.")
        print(f"pool ${pool:.8f} is {abs(pool/target - 1.0) * 100:.2f}% below its buy "
              f"target ${target:.8f}. Nothing bought."
              + (" Selling into strength is still enabled." if SELL_ON
                 else " Selling is off too: the keeper is neutral."))
        return 0
    if (not buying) and not SELL_ON:
        print("SELLING IS OFF (KEEPER_SELL=off) -- the pool is allowed to RISE.")
        print(f"pool ${pool:.8f} is {abs(gap) * 100:.2f}% above the ladder ${posted:.8f}. "
              "Nothing sold. A buyer moving the price up is the point, not a fault "
              "to correct -- and min(ladder, pool) already caps what the rails credit.")
        return 0
    if buying and floor_mode:
        # The pool has reached the floor. That is the event this mode exists for
        # and it is worth saying once, not every ten minutes -- notify_throttled
        # reports the onset and the clearing, never the persistence.
        notify_throttled("floor_defence",
               "keeper: DEFENDING THE $%.4f FLOOR" % buy_target,
               f"pool ${pool:.8f} has fallen to {buy_gap*100:+.2f}% of the "
               f"${buy_target:.8f} floor, so the keeper is buying wPCN back up to "
               f"it.\nThe ladder is ${posted:.8f}; everything above the floor was "
               f"left alone deliberately.\nThis spends the USDT float. Watch it: "
               f"when it is gone nothing holds the floor IN THE POOL, and only "
               f"the code floors (rateFloorUsd, ladderMinPriceUsd) still hold "
               f"what PCN itself is credited and sold at.")
    if buying:
        want = solve_trade(u_res, w_res, target, True)
        budget = min(want,
                     DAILY_USDT_CAP - st["usdt_spent"],
                     max(0.0, have_usdt - MIN_USDT_FLOOR))
        unit, need_label = "USDT", "USDT"
    else:
        want = solve_trade(w_res, u_res, target, False)
        budget = min(want,
                     DAILY_WPCN_CAP - st["wpcn_spent"],
                     max(0.0, have_wpcn - MIN_WPCN_FLOOR))
        unit, need_label = "wPCN", "wPCN"

    print(f"to reach ${target:.8f} : trade {want:,.6f} {unit}")
    print(f"allowed this run     : {budget:,.6f} {unit}")

    if budget <= 0:
        # Name the term that ACTUALLY bound the budget. Choosing the reason by
        # "have we spent anything today" blamed the daily cap on every run after
        # the first trade, including when the cap had plenty left and the float
        # was sitting on its floor -- which sends the reader to raise a limit
        # that was not binding while the wallet stays empty.
        if buying:
            cap_left = DAILY_USDT_CAP - st["usdt_spent"]
            floor_left = max(0.0, have_usdt - MIN_USDT_FLOOR)
            cap_txt = f"{cap_left:,.4f} of {DAILY_USDT_CAP:,.0f} USDT/day left"
            floor_txt = f"float {have_usdt:,.4f} USDT against a {MIN_USDT_FLOOR:,.2f} floor"
        else:
            cap_left = DAILY_WPCN_CAP - st["wpcn_spent"]
            floor_left = max(0.0, have_wpcn - MIN_WPCN_FLOOR)
            cap_txt = f"{cap_left:,.2f} of {DAILY_WPCN_CAP:,.0f} wPCN/day left"
            floor_txt = f"float {have_wpcn:,.2f} wPCN against a {MIN_WPCN_FLOOR:,.2f} floor"
        if cap_left <= 0:
            why = "daily cap reached"
            fix = "Raise KEEPER_DAILY_%s_CAP, or wait for the daily reset." % unit.upper()
        elif floor_left <= 0:
            why = f"{need_label} float at or below floor"
            fix = f"Top the float up -- send {need_label} to {acct.address}."
        else:
            why = "nothing to trade"
            fix = "No action: the gap is already inside the dead band."
        notify_throttled("blocked",
               f"keeper: cannot close the gap -- {why}",
               f"pool ${pool:.8f} vs posted ${posted:.8f} ({gap*100:+.2f}%).\n"
               f"Needs {want:,.4f} {unit}, none available: {why}.\n"
               f"cap: {cap_txt}\n"
               f"floor: {floor_txt}\n"
               f"{fix}")
        print(f"BLOCKED: {why}  (cap: {cap_txt}; {floor_txt})")
        return 1

    if not live:
        print("\nDRY RUN -- nothing sent. Re-run with --live to trade.")
        return 0

    # ---- execute -----------------------------------------------------------
    router_abi = [{"name": "swapExactTokensForTokens", "type": "function",
                   "inputs": [{"name": "amountIn", "type": "uint256"},
                              {"name": "amountOutMin", "type": "uint256"},
                              {"name": "path", "type": "address[]"},
                              {"name": "to", "type": "address"},
                              {"name": "deadline", "type": "uint256"}],
                   "outputs": [{"name": "amounts", "type": "uint256[]"}]}]
    router = w3.eth.contract(address=Web3.to_checksum_address(ROUTER), abi=router_abi)

    if buying:
        amt_in = int(budget * 10 ** USDT_DECIMALS)
        expect = amount_out(budget, u_res, w_res)
        min_out = int(expect * (1 - SLIPPAGE) * 1e8)
        path = [Web3.to_checksum_address(USDT), token]
        spend_c, decimals = usdt_c, 10 ** USDT_DECIMALS
    else:
        amt_in = int(budget * 1e8)
        expect = amount_out(budget, w_res, u_res)
        min_out = int(expect * (1 - SLIPPAGE) * 10 ** USDT_DECIMALS)
        path = [token, Web3.to_checksum_address(USDT)]
        spend_c, decimals = wpcn_c, 1e8

    allowance = spend_c.functions.allowance(
        acct.address, Web3.to_checksum_address(ROUTER)).call()
    if allowance < amt_in:
        # Approve EXACTLY this trade, not 2**255. An unlimited allowance means
        # a compromised or buggy router could drain the keeper's whole USDT
        # float in one call; an exact one caps the blast radius at a single
        # trade, and the keeper already worked that way for wPCN. It costs one
        # extra approve() per trade -- a few cents of gas against the float.
        # The 2**255 USDT approval this replaced was revoked on 2026-09-05.
        send(w3, acct, spend_c.functions.approve(
            Web3.to_checksum_address(ROUTER), amt_in).build_transaction(
                {"from": acct.address}), "approve")

    r = send(w3, acct, router.functions.swapExactTokensForTokens(
        amt_in, min_out, path, acct.address, int(time.time()) + 600
    ).build_transaction({"from": acct.address}),
        f"swap {budget:,.6f} {unit}")

    if buying:
        st["usdt_spent"] += budget
    else:
        st["wpcn_spent"] += budget
    st["trades"].append({"at": int(time.time()), "dir": "buy" if buying else "sell",
                         "amount": budget, "unit": unit,
                         "pool_before": pool, "posted": posted, "target": target,
                         "floor_mode": floor_mode,
                         "block": r.blockNumber})
    save_state(st)

    r0, r1, _ = pair.functions.getReserves().call()
    if t0 == token:
        w2, u2 = r0 / 1e8, r1 / 10 ** USDT_DECIMALS
    else:
        w2, u2 = r1 / 1e8, r0 / 10 ** USDT_DECIMALS
    after = u2 / w2
    print(f"\npool ${pool:.8f} -> ${after:.8f}  (target ${target:.8f})")
    notify("keeper: traded",
           (f"Spent {budget:,.6f} USDT buying wPCN." if buying
            else f"Sold {budget:,.6f} wPCN for USDT.") + "\n"
           f"pool ${pool:.8f} -> ${after:.8f}, target ${target:.8f}, "
           f"ladder ${posted:.8f}\n"
           f"float before this trade {have_usdt:,.4f} USDT / {have_wpcn:,.2f} wPCN.")
    return 0


def cmd_init():
    """Create the keeper key ON THIS MACHINE and never print it.

    The deployer key was generated on a server and delivered through a chat
    transcript, which is why it had to be treated as burned and swept. This one
    is written straight to a 0600 file and only its ADDRESS is ever shown.
    """
    sys.path.insert(0, os.environ.get("WPCN_DIR", "/opt/wpcn"))
    from web3 import Web3
    if os.path.exists(CONF) and "KEEPER_PRIVATE_KEY" in open(CONF).read():
        cfg = load_conf()
        acct = Web3().eth.account.from_key(cfg["KEEPER_PRIVATE_KEY"])
        print(f"already initialised. keeper address: {acct.address}")
        return 0
    acct = Web3().eth.account.create()
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    fd = os.open(CONF, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("# wPCN keeper key. MODE 0600. NEVER in git, never printed.\n")
        f.write(f"KEEPER_PRIVATE_KEY={acct.key.hex()}\n")
    print(f"keeper address: {acct.address}")
    print(f"key written to {CONF} (0600). It was NOT printed and must not be.")
    print("\nFund this address with:")
    print("  * a little BNB for gas")
    print("  * USDT   -- so it can buy wPCN when the pool is cheap")
    print("  * wPCN   -- so it can sell when the pool is expensive")
    return 0


def print_tuning():
    print(f"tuning file : {TUNING_FILE}"
          f"{'' if os.path.exists(TUNING_FILE) else '   (absent -- unit and defaults apply)'}")
    if TUNING_ERROR:
        print(f"ERROR       : {TUNING_ERROR}")
        print("The keeper will REFUSE to trade until this is fixed.")
        return 2
    w = max(len(k) for k in TUNABLES)
    for k, (kind, lo, hi, env, dflt, doc) in TUNABLES.items():
        bounds = "on/off" if kind == "bool" else f"{lo} .. {hi}"
        print(f"  {k:<{w}}  {str(_TUNE[k]):>10}  [{_TUNE_SRC[k]:<7}]  {bounds:<16} {env}")
    print("\nsource: panel = the tuning file, unit = the service's Environment=, "
          "default = built in.")
    return 0


if __name__ == "__main__":
    if "--init" in sys.argv:
        sys.exit(cmd_init())
    if "--tuning" in sys.argv:
        sys.exit(print_tuning())
    sys.exit(main())
