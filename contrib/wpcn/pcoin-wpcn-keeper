_TRUE = ("1", "on", "true", "yes")
_FALSE = ("0", "off", "false", "no")


def _coerce(key, raw, where):
    """Value or ValueError. Bounds apply to EVERY source, including the default."""
    kind, lo, hi, _env, _dflt, _doc = TUNABLES[key]
    if kind == "bool":
        if isinstance(raw, bool):
            return raw
        s = str(raw).strip().lower()
        if s in _TRUE:
            return True
        if s in _FALSE:
            return False
        raise ValueError(f"{key} from {where}: {raw!r} is not on/off")
    try:
        v = float(raw)
    except (TypeError, ValueError):
        raise ValueError(f"{key} from {where}: {raw!r} is not a number")
    if v != v or v in (float("inf"), float("-inf")):
        raise ValueError(f"{key} from {where}: {raw!r} is not finite")
    if not (lo <= v <= hi):
        raise ValueError(f"{key} from {where}: {v} is outside {lo}..{hi}")
    return v


def load_tuning():
    """(values, sources, error). error is a string and means DO NOT TRADE."""
    vals, srcs = {}, {}
    filedata, fileerr = None, None
    if os.path.exists(TUNING_FILE):
        try:
            with open(TUNING_FILE) as f:
                filedata = json.load(f)
            if not isinstance(filedata, dict):
                raise ValueError("top level is not an object")
            # A file that only holds junk keys is a typo, not a config. Say so
            # rather than silently running on defaults the owner did not choose.
            unknown = [k for k in filedata if k not in TUNABLES and k != "_note"]
            if unknown:
                raise ValueError("unknown setting(s): " + ", ".join(sorted(unknown)))
        except Exception as e:
            fileerr = f"{TUNING_FILE} exists but could not be used: {e}"
    if fileerr:
        return {}, {}, fileerr
    for key, (_k, _lo, _hi, env, dflt, _doc) in TUNABLES.items():
        try:
            if filedata is not None and key in filedata:
                vals[key] = _coerce(key, filedata[key], "the tuning file")
                srcs[key] = "panel"
            elif os.environ.get(env) is not None:
                vals[key] = _coerce(key, os.environ[env], f"${env}")
                srcs[key] = "unit"
            else:
                vals[key] = _coerce(key, dflt, "the built-in default")
                srcs[key] = "default"
        except ValueError as e:
            return {}, {}, str(e)
    return vals, srcs, None


_TUNE, _TUNE_SRC, TUNING_ERROR = load_tuning()
