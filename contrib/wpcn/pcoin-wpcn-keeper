def md_plain(text):
    """Escape the four characters that start Markdown in pcoin-notify's send.

    Setting names like daily_usdt_cap carry underscores, and one unpaired
    underscore makes Telegram refuse the message -- pcoin-notify then resends
    it as plain text, so it still arrives, just without the bold headline."""
    return "".join("\\" + c if c in "_*`[" else c for c in str(text))


def notify(subject, body):
    if not os.path.exists(NOTIFY):
        print(f"[no notifier] {subject}\n{body}")
        return
    subprocess.run([NOTIFY, subject, body], timeout=60)


def notify_throttled(key, subject, body, seconds=NAG_SECONDS):
    """Alert at most once per `seconds` for this condition.

    The timer runs every 10 minutes (every minute with the index drop-in), so an
    unfunded float or a stuck price feed would otherwise page 144 -- or 1,440 --
    times a day and teach everyone to ignore the channel -- which is exactly
    what happened to pcoin-concentration-watch when
    it sent the same figure twenty-four times in eight hours. A condition that
    persists is not new information; only its onset and its clearing are.
    """
    st = load_state()
    last = (st.get("nagged") or {}).get(key, 0)
    if time.time() - last < seconds:
        print(f"[throttled, already alerted] {subject}")
        return
    notify(subject, body)
    st.setdefault("nagged", {})[key] = int(time.time())
    save_state(st)


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except Exception:
        return {"day": "", "usdt_spent": 0.0, "wpcn_spent": 0.0,
                "trades": [], "nagged": {}}


def save_state(s):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(s, f, indent=1)
    os.replace(tmp, STATE)


def load_conf():
    cfg = {}
    if os.path.exists(CONF):
        for line in open(CONF):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                cfg[k.strip()] = v.strip()
    return cfg


