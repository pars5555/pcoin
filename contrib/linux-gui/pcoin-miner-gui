    def _card(self, pad=16):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        box.add_css_class("card")
        box.set_margin_top(pad)
        box.set_margin_bottom(pad)
        box.set_margin_start(pad)
        box.set_margin_end(pad)
        return box

    def _hide(self, *_args):
        self.set_visible(False)
        return True

    def _copy(self, _btn):
        if not self.addr_text:
            return
        clip = Gdk.Display.get_default().get_clipboard()
        try:
            clip.set(self.addr_text)
        except Exception:
            clip.set_content(Gdk.ContentProvider.new_for_value(self.addr_text))

    def _draw(self, _area, cr, width, height):
        cr.set_source_rgb(0.043, 0.047, 0.067)
        cr.paint()
        hist = self.history
        if len(hist) < 2:
            return
        low, high = min(hist), max(hist)
        span = high - low
        # A steady hashrate is the normal case, and a chart pinned to zero would
        # draw it as a featureless block. Zoom to the range actually seen, with
        # a floor so tiny jitter is not magnified into drama.
        pad = max(span * 0.15, high * 0.02, 0.5)
        low, high = low - pad, high + pad
        rng = max(high - low, 1e-6)
        step = width / float(max(len(hist) - 1, 1))

        def ypos(value):
            return height - 2 - ((value - low) / rng) * (height - 6)

        cr.move_to(0, height)
        for i, value in enumerate(hist):
            cr.line_to(i * step, ypos(value))
        cr.line_to((len(hist) - 1) * step, height)
        cr.close_path()
        cr.set_source_rgba(0.176, 0.831, 0.749, 0.16)
        cr.fill()

        cr.set_line_width(1.8)
        cr.set_source_rgb(0.176, 0.831, 0.749)
        for i, value in enumerate(hist):
            (cr.move_to if i == 0 else cr.line_to)(i * step, ypos(value))
        cr.stroke()

    # ---- the slider -------------------------------------------------------
    def show_cores(self, cores):
        """Reflect the machine's real core count into the slider WITHOUT acting.

        The handler is blocked for the duration. A busy flag is not enough: this
        control both displays state and changes it, and any flag guarding that
        is one reordering away from the display path silently RE-APPLYING a
        setting. It did exactly that once, taking this box to every core on its
        own. Blocking the handler makes it structurally impossible.
        """
        self.scale.handler_block(self.scale_handler)
        self.scale.set_value(cores)
        self.scale.handler_unblock(self.scale_handler)
        self._label(cores)

    def _label(self, cores):
        if cores <= 0:
            self.cores_lab.set_text("Off")
        else:
            self.cores_lab.set_text(
                "%d of %d  -  %.0f%%" % (cores, CORES, share_pct(cores)))

    def _slid(self, scale):
        """Dragging fires continuously, so settle first and act once."""
        cores = int(round(scale.get_value()))
        self._label(cores)
        self.phint.set_text("release to apply")
        if self.debounce:
            GLib.source_remove(self.debounce)
        self.debounce = GLib.timeout_add(700, self._settled, cores)

    def _settled(self, cores):
        self.debounce = None
        if self.busy:
            return False
        self.busy = True
        print("cores: slider set to %d" % cores, flush=True)
        self.phint.set_text("applying...")
        threading.Thread(target=self._apply, args=(cores,), daemon=True).start()
        return False

    def _pool_preset(self, _btn, url):
        self.pool_entry.set_text(url)
        self._pool(None)

    def _pool(self, _btn):
        if self.busy:
            return
        self.busy = True
        url = self.pool_entry.get_text().strip()
        self.phint.set_text("applying...")
        threading.Thread(target=self._apply_pool, args=(url,),
                         daemon=True).start()

    def _apply_pool(self, url):
        try:
            msg = apply_pool(url)
        except Exception as exc:
            msg = "failed: %s" % exc
        GLib.idle_add(self._applied, msg)

    def _onoff(self, _btn):
        if self.busy:
            return
        self.busy = True
        going_on = self.onoff.get_label().startswith("Start")
        self.phint.set_text("applying...")
        threading.Thread(target=self._run,
                         args=(start_mining if going_on else stop_mining,),
                         daemon=True).start()

    def _addr(self, _btn):
        if self.busy:
            return
        self.busy = True
        wanted = self.addr.get_text().strip()
        self.ahint.set_text("checking the address with the node...")
        threading.Thread(target=self._run_addr, args=(wanted,),
                         daemon=True).start()

    def _run_addr(self, wanted):
        try:
            msg = apply_address(wanted)
        except Exception as exc:
            msg = "failed: %s" % exc
        GLib.idle_add(self._addr_done, msg)

    def _addr_done(self, msg):
        self.ahint.set_text(msg)
        self.busy = False
        return False

    def show_fast(self, on):
        """Reflect the node's setting WITHOUT acting on it -- see show_cores."""
        self.fast.handler_block(self.fast_handler)
        self.fast.set_active(on)
        self.fast.handler_unblock(self.fast_handler)

    def _fast(self, chk):
        if self.busy:
            return
        self.busy = True
        want = chk.get_active()
        self.fhint.set_text("restarting the node to %s fast mode..."
                            % ("turn on" if want else "turn off"))
        threading.Thread(target=self._run_fast, args=(want,),
                         daemon=True).start()

    def _run_fast(self, want):
        try:
            msg = set_fast(want)
        except Exception as exc:
            msg = "failed: %s" % exc
        GLib.idle_add(self._fast_done, msg)

    def _fast_done(self, msg):
        self.fhint.set_text(msg)
        self.busy = False
        return False

    def _run(self, fn):
        try:
            msg = fn()
        except Exception as exc:
            msg = "failed: %s" % exc
        GLib.idle_add(self._applied, msg)

    def _apply(self, cores):
        try:
            msg = apply_cores(cores)
        except Exception as exc:
            msg = "failed: %s" % exc
        GLib.idle_add(self._applied, msg)

    def _applied(self, msg):
        self.phint.set_text(msg)
        self.busy = False
        return False


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.win = None
        self.tray = None

    def do_activate(self):
        if self.win is None:
            prov = Gtk.CssProvider()
            try:
                prov.load_from_string(CSS)
            except AttributeError:
                prov.load_from_data(CSS.encode())
            Gtk.StyleContext.add_provider_for_display(
                Gdk.Display.get_default(), prov,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            Gtk.Window.set_default_icon_name("pcoin-miner")
            self.win = Win(self)
            self.hold()          # stay alive with the window hidden
            try:
                self.tray = Tray(self.toggle)
            except Exception as exc:
                print("no tray:", exc, flush=True)
            GLib.timeout_add_seconds(2, self.tick)
            self.tick()
        self.win.set_visible(True)
        self.win.present()

    def toggle(self):
        if self.win.get_visible():
            self.win.set_visible(False)
        else:
            self.win.set_visible(True)
            self.win.present()
        return False

    def tick(self):
        threading.Thread(target=self._read, daemon=True).start()
        return True

    def _read(self):
        # NOTE: getcpuminerinfo refreshes the node's dead-man's switch. Harmless
        # here, because the supervisor is the real keep-alive -- but it means
        # this app is never EVIDENCE that mining is running. The unit state is
        # what decides Mining versus Paused below.
        miner = cli("getcpuminerinfo") or {}
        chain = cli("getblockchaininfo") or {}
        peers = cli("getconnectioncount")
        GLib.idle_add(self._paint, miner, chain, peers, read_conf(),
                      unit_active("pcoin-miner"), quota_cores())

    def _paint(self, miner, chain, peers, conf, unit_on, qcores):
        win = self.win
        if win is None:
            return False
        rate = miner.get("hashespersec")
        mining = bool(miner.get("mining")) and unit_on
        ibd = chain.get("initialblockdownload")
        win.addr_text = conf.get("PAYOUT_ADDRESS", "")

        if mining and isinstance(rate, (int, float)):
            win.hero.set_text("{:,.1f}".format(rate))
            win.history.append(rate)
            del win.history[:-90]
        else:
            win.hero.set_text("-")
        win.chart.queue_draw()

        for cls in ("on", "off", "sync"):
            win.pill.remove_css_class(cls)
        if mining:
            win.pill.add_css_class("on")
            win.pill.set_text("MINING")
        elif ibd:
            win.pill.add_css_class("sync")
            win.pill.set_text("SYNCING")
        else:
            win.pill.add_css_class("off")
            win.pill.set_text("PAUSED")

        threads = miner.get("threads") or 0
        win.rows["Threads"].set_text("%d of %d" % (threads, CORES))
        win.rows["CPU ceiling"].set_text(
            "-" if qcores is None
            else "%.0f%% of this PC" % share_pct(qcores))
        win.rows["Pool"].set_text(conf.get("POOL_URL") or "solo")
        # Never overwrite what someone is typing.
        if not win.busy and not win.pool_entry.has_focus():
            current = conf.get("POOL_URL") or ""
            if win.pool_entry.get_text() != current:
                win.pool_entry.set_text(current)
        win.rows["Pool state"].set_text(str(miner.get("poolstate") or "-"))
        acc, rej = miner.get("sharesaccepted"), miner.get("sharesrejected")
        win.rows["Shares"].set_text(
            "-" if acc is None else "%d accepted, %d rejected" % (acc, rej))
        win.rows["Blocks found"].set_text(str(miner.get("blocksfound", "-")))
        blocks, headers = chain.get("blocks"), chain.get("headers")
        if blocks is None:
            win.rows["Chain"].set_text("-")
        elif ibd and headers:
            win.rows["Chain"].set_text("{:,} of {:,}".format(blocks, headers))
        else:
            win.rows["Chain"].set_text("{:,}".format(blocks))
        win.rows["Peers"].set_text("-" if peers is None else str(peers))
        diff = chain.get("difficulty")
        win.rows["Difficulty"].set_text(
            "-" if diff is None else ("%.4f" % diff))
        mode = miner.get("mode") or "-"
        win.rows["Mode"].set_text(
            mode + ("  (large pages)" if miner.get("largepages") else ""))

        # Never overwrite an address somebody is part way through typing.
        if not win.busy and not win.addr.has_focus():
            current = conf.get("PAYOUT_ADDRESS") or ""
            if win.addr.get_text() != current:
                win.addr.set_text(current)

        # The button says what pressing it will DO, and the unit decides which.
        if not win.busy:
            want = "Stop mining" if unit_on else "Start mining"
            if win.onoff.get_label() != want:
                win.onoff.set_label(want)
            win.show_fast(fast_requested())
            if mode == "light" and miner.get("modereason"):
                win.fhint.set_text(miner.get("modereason"))
            elif mode == "fast" and not miner.get("largepages") \
                    and miner.get("largepagesreason"):
                win.fhint.set_text(miner.get("largepagesreason"))

        # Only ever mirror a value we actually know. An UNKNOWN ceiling leaves
        # the slider alone rather than guessing a position.
        if not win.busy and win.debounce is None:
            if not mining:
                win.show_cores(0)
            elif qcores is not None:
                win.show_cores(qcores)

        if self.tray:
            self.tray.set_tip(
                "{:,.0f} H/s".format(rate)
                if mining and isinstance(rate, (int, float)) else "not mining")
        return False


if __name__ == "__main__":
    App().run(None)
