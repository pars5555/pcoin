def cli(*args, timeout=8):
    """One bitcoin-cli call.

    Any failure returns None, which means UNKNOWN and is rendered as a dash --
    never as a zero. A read that did not happen resolves nothing.
    """
    try:
        proc = subprocess.run([CLI, "-datadir=" + DATADIR, *args],
                              capture_output=True, text=True, timeout=timeout)
        if proc.returncode != 0:
            return None
        try:
            return json.loads(proc.stdout.strip())
        except json.JSONDecodeError:
            return proc.stdout.strip()
    except Exception:
        return None


def sysctl(*args, timeout=25):
    try:
        return subprocess.run(["systemctl", "--user", *args],
                              capture_output=True, text=True, timeout=timeout)
    except Exception:
        return None


def unit_active(unit):
    res = sysctl("is-active", unit, timeout=6)
    return bool(res and res.stdout.strip() == "active")


def read_conf():
    vals = {}
    try:
        with open(MINCONF) as fh:
            for line in fh:
                if "=" in line and not line.lstrip().startswith("#"):
                    key, _, val = line.strip().partition("=")
                    vals[key] = val
    except OSError:
        pass
    return vals


def write_conf(conf):
    """The one writer for miner.conf, so no caller drops a key another set."""
    with open(MINCONF, "w") as fh:
        fh.write("# PCoin miner. Written by the PCoin Miner app.\n")
        for key in ("PAYOUT_ADDRESS", "THREADS", "POOL_URL"):
            fh.write("%s=%s\n" % (key, conf.get(key, "")))


def start_mining():
    sysctl("start", "pcoin-miner")
    return "Mining."


def stop_mining():
    # systemctl stop, NOT just stopmining: the supervisor polls every 30 s and
    # would restart mining within half a minute.
    sysctl("stop", "pcoin-miner")
    cli("stopmining")
    return "Stopped. The node stays up and connected."


def apply_address(addr):
    """Change where rewards are paid.

    THE NODE decides whether the address is usable, and a failed check is not a
    pass: rewards paid to a mistyped address go to a key nobody has, and nothing
    anywhere says so.
    """
    addr = (addr or "").strip()
    if not addr:
        return "An address is required."
    check = cli("validateaddress", addr)
    if check is None:
        return "Could not reach the node to check that address - not changing it."
    if not check.get("isvalid"):
        return "The node says that is not a valid PCoin address."
    conf = read_conf()
    conf["PAYOUT_ADDRESS"] = addr
    write_conf(conf)
    sysctl("restart", "pcoin-miner")
    return "Rewards now go to %s" % addr


def fast_requested():
    """Is fast mode ASKED FOR in the node's config? Intent, not observation."""
    try:
        with open(PCONF) as fh:
            for line in fh:
                s = line.strip()
                if s.startswith("randomxfastmode"):
                    return s.partition("=")[2].strip() not in ("0", "false", "no")
    except OSError:
        pass
    return False


def set_fast(on):
    """Fast mode is a NODE setting, so it costs a node restart.

    It goes in pcoin.conf and not in the systemd drop-in, because this app
    rewrites that drop-in on every core change and would silently lose it.
    """
    try:
        lines = open(PCONF).read().splitlines()
    except OSError:
        lines = []
    lines = [l for l in lines if not l.strip().startswith("randomxfastmode")]
    if on:
        lines += ["# Mining only: keeps a 2080 MiB table in memory, 2.3 GiB with",
                  "# the verification cache. Block VERIFICATION stays in light",
                  "# mode, so this changes nothing about what the node accepts.",
                  "randomxfastmode=1"]
    with open(PCONF, "w") as fh:
        fh.write("\n".join(lines) + "\n")
    sysctl("restart", "pcoind")
    for _ in range(60):
        if cli("getblockcount") is not None:
            break
        time.sleep(2)
    sysctl("restart", "pcoin-miner")
    return ("Fast mode on. The table takes a few seconds to build."
            if on else "Fast mode off - back to the slower light mode.")


def apply_pool(url):
    """Point the miner at a pool, or at nothing for solo. Returns a message."""
    url = (url or "").strip()
    conf = read_conf()
    conf["POOL_URL"] = url
    write_conf(conf)
    sysctl("restart", "pcoin-miner")
    if not url:
        return ("Solo. This machine mines its own blocks and keeps the whole "
                "reward on the rare occasions it finds one.")
    return "Pool set to %s." % url


def quota_cores():
    """How many cores the node's ceiling currently allows, or None if unknown.

    None means UNKNOWN and must never be rendered as a number or acted upon.
    """
    res = sysctl("show", "pcoind.service", "-p", "CPUQuotaPerSecUSec",
                 "--value", timeout=6)
    raw = (res.stdout or "").strip() if res else ""
    if not raw or raw == "infinity":
        return None
    try:
        if raw.endswith("ms"):
            secs = float(raw[:-2]) / 1000.0
        elif raw.endswith("us"):
            secs = float(raw[:-2]) / 1e6
        elif raw.endswith("s"):
            secs = float(raw[:-1])
        else:
            return None
    except ValueError:
        return None
    return max(0, int(round((secs * 100 - NODE_HEADROOM) / 100.0)))


def share_pct(cores):
    """What a given core count costs this machine, ceiling included."""
    return (cores * 100 + NODE_HEADROOM) / float(CORES)


def apply_cores(cores):
    """Mine on `cores` cores, or stop when 0. Returns what happened.

    Module level rather than a method so the exact path the slider takes can be
    exercised without a display.
    """
    if cores <= 0:
        # systemctl stop, NOT just stopmining: the supervisor polls every 30 s
        # and would restart mining within half a minute.
        sysctl("stop", "pcoin-miner")
        cli("stopmining")
        return "Stopped. The node stays up and connected."

    cores = min(cores, CORES)
    quota = cores * 100 + NODE_HEADROOM
    conf = read_conf()
    conf["THREADS"] = str(cores)
    write_conf(conf)
    os.makedirs(os.path.dirname(DROPIN), exist_ok=True)
    with open(DROPIN, "w") as fh:
        fh.write("# Written by the PCoin Miner app.\n[Service]\n")
        fh.write("# %d mining core%s plus %d%% of a core of headroom for the\n"
                 "# node itself; systemd counts one whole core as 100%%.\n"
                 % (cores, "" if cores == 1 else "s", NODE_HEADROOM))
        fh.write("CPUQuota=%d%%\nCPUWeight=20\nNice=15\n"
                 "IOSchedulingClass=idle\nMemoryHigh=4G\n" % quota)
    sysctl("daemon-reload")
    # Applies the new ceiling live, so the node is never restarted and never
    # drops the peers it has.
    sysctl("set-property", "pcoind.service", "CPUQuota=%d%%" % quota)
    sysctl("restart", "pcoin-miner")
    return "%d of %d cores  -  %.0f%% of this machine." % (
        cores, CORES, share_pct(cores))


class Tray:
    """StatusNotifierItem, spoken directly to KDE's systray over GDBus."""

    XML = """
    <node><interface name='org.kde.StatusNotifierItem'>
      <property name='Category' type='s' access='read'/>
      <property name='Id' type='s' access='read'/>
      <property name='Title' type='s' access='read'/>
      <property name='Status' type='s' access='read'/>
      <property name='WindowId' type='i' access='read'/>
      <property name='IconName' type='s' access='read'/>
      <property name='IconThemePath' type='s' access='read'/>
      <property name='OverlayIconName' type='s' access='read'/>
      <property name='AttentionIconName' type='s' access='read'/>
      <property name='ToolTip' type='(sa(iiay)ss)' access='read'/>
      <property name='ItemIsMenu' type='b' access='read'/>
      <method name='Activate'>
        <arg type='i' name='x' direction='in'/>
        <arg type='i' name='y' direction='in'/></method>
      <method name='SecondaryActivate'>
        <arg type='i' name='x' direction='in'/>
        <arg type='i' name='y' direction='in'/></method>
      <method name='ContextMenu'>
        <arg type='i' name='x' direction='in'/>
        <arg type='i' name='y' direction='in'/></method>
      <method name='Scroll'>
        <arg type='i' name='delta' direction='in'/>
        <arg type='s' name='orientation' direction='in'/></method>
      <signal name='NewIcon'/>
      <signal name='NewStatus'><arg type='s' name='status'/></signal>
      <signal name='NewToolTip'/>
    </interface></node>"""

    def __init__(self, on_activate):
        self.on_activate = on_activate
        self.tip = "PCoin Miner"
        self.registered = False
        self.conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        node = Gio.DBusNodeInfo.new_for_xml(self.XML)
        self.conn.register_object("/StatusNotifierItem", node.interfaces[0],
                                  self._call, self._get, None)
        self.name = "org.kde.StatusNotifierItem-%d-1" % os.getpid()
        Gio.bus_own_name_on_connection(self.conn, self.name,
                                       Gio.BusNameOwnerFlags.NONE,
                                       self._acquired, None)

    def _acquired(self, conn, name):
        try:
            conn.call_sync("org.kde.StatusNotifierWatcher",
                           "/StatusNotifierWatcher",
                           "org.kde.StatusNotifierWatcher",
                           "RegisterStatusNotifierItem",
                           GLib.Variant("(s)", (name,)), None,
                           Gio.DBusCallFlags.NONE, 5000, None)
            self.registered = True
            print("tray registered as", name, flush=True)
        except Exception as exc:
            print("tray registration failed:", exc, flush=True)

    def _call(self, conn, sender, path, iface, method, params, invocation):
        if method in ("Activate", "SecondaryActivate", "ContextMenu"):
            GLib.idle_add(self.on_activate)
        invocation.return_value(None)

    def _get(self, conn, sender, path, iface, prop):
        simple = {
            "Category": ("s", "ApplicationStatus"),
            "Id": ("s", "pcoin-miner"),
            "Title": ("s", "PCoin Miner"),
            "Status": ("s", "Active"),
            "WindowId": ("i", 0),
            "IconName": ("s", "pcoin-miner"),
            "IconThemePath": ("s", ICONDIR),
            "OverlayIconName": ("s", ""),
            "AttentionIconName": ("s", ""),
            "ItemIsMenu": ("b", False),
        }.get(prop)
        if simple:
            return GLib.Variant(simple[0], simple[1])
        if prop == "ToolTip":
            return GLib.Variant("(sa(iiay)ss)",
                                ("pcoin-miner", [], "PCoin Miner", self.tip))
        return None

    def set_tip(self, text):
        if text == self.tip:
            return
        self.tip = text
        try:
            self.conn.emit_signal(None, "/StatusNotifierItem",
                                  "org.kde.StatusNotifierItem",
                                  "NewToolTip", None)
        except Exception:
            pass


