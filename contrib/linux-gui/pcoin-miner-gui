#!/usr/bin/env python3
"""PCoin Miner - a tray app and window for the Linux miner.

The Linux counterpart of the Windows tray. It does not mine anything itself and
holds no key: it reads the node over RPC and drives the two systemd --user
units, so closing this window -- or killing this process -- never stops mining.

No dependency beyond what a KDE or GNOME desktop already has. GTK4 through
PyGObject draws the window, and GLib's own GDBus speaks to the tray. There is no
AppIndicator typelib on this machine, so the StatusNotifierItem interface that
KDE's systray actually speaks is implemented directly below -- one D-Bus object
and one registration call.
"""
import json
import os
import subprocess
import threading
import time

