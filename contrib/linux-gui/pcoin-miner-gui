# Headroom, in percent of one core, added to the node's CPU ceiling on top of
# whatever the mining threads want. Without it the miners eat the entire quota
# and bitcoind's own net and message-handling threads live on the remainder --
# which took this machine to ZERO peers while it still reported mining fine.
NODE_HEADROOM = 20

