#!/usr/bin/env bash
# Bound the growth of pool.sqlite by dropping shares nobody can still read.
#
# WHY THIS EXISTS: the shares table had no retention of any kind. It held every
# share since 2026-08-13 -- 7.57 million rows, 2.3 GB, growing by ~513,000 rows
# (~100 MB) a day. Against 27 GB free that is roughly nine months to a full disk,
# and a full disk stops the pool AND the node on the same box.
#
# WHY IT IS NOW HOURS AND NOT DAYS -- READ THIS BEFORE WIDENING IT AGAIN.
# On 2026-09-21 the disk was never the problem. Retention was 7 days, the table
# settled at ~7.6M rows after each nightly run and climbed to ~8.7M before the
# next one, and crossing that every store call began exceeding the pool's 15s
# RUN_TIMEOUT_MS. Share recording stopped dead at 17:50 UTC, the pool found no
# block for 7h15m (8975 -> 8997), and miners saw "pool could not record the
# share; retry". store.mjs:284-297 had predicted exactly this and says the
# answer is FEWER ROWS, not a bigger timeout.
#
# So the window is now set by what actually READS a share, measured against the
# code rather than guessed:
#   * pplnsWindow  -- newest rows back to 2x a block's work. MINUTES.
#   * shareSummary from pool.mjs, the public hashrate -- last 600 SECONDS.
#   * shareSummary from payouts.mjs, a report a human runs by hand -- 24 HOURS.
#     This is the widest automatic-or-manual reader in the tree, and it is the
#     only reason the window is not one hour.
#   * the dedup index (job_id, nonce) -- a job lives seconds; a replay of a job
#     from yesterday cannot be validated at all.
# NOTHING reads a share older than 24 hours. The permanent record of who is
# owed what is the `payouts` table, which this script never touches, and no
# payout is ever recomputed from shares.
#
# AND IT RUNS HOURLY, NOT NIGHTLY. That matters as much as the number: a daily
# prune means the table sawtooths from its floor up by a whole day's intake, and
# the 2026-09-21 stall happened at the TOP of that sawtooth, 13 hours after a
# run that had reported success. Hourly keeps it flat, so the peak and the floor
# are the same number and there is no daily excursion to be caught out by.
#
# WHY IT DOES NOT VACUUM: auto_vacuum is 0, so deleted pages are not returned to
# the OS -- but SQLite reuses them, which is what actually matters: the file stops
# GROWING. A real VACUUM rewrites the file under an exclusive lock, and the pool
# writes ~11 shares a second; blocking that means miners doing real work whose
# shares are dropped. Growth is the problem, not the current size, so the
# dangerous half is deliberately not done. Run one by hand in a maintenance
# window if the file size itself ever matters.
set -uo pipefail

DB=${DB:-/opt/pcoin-pool/pool.sqlite}
# RETAIN_HOURS is the knob. RETAIN_DAYS is still honoured so an old unit file
# that sets it keeps working, but it is NOT the default any more -- a unit that
# sets neither gets 24 hours, not 7 days.
RETAIN_HOURS=${RETAIN_HOURS:-}
if [ -z "$RETAIN_HOURS" ]; then
    if [ -n "${RETAIN_DAYS:-}" ]; then
        # A SHIM THAT SILENTLY RESTORES THE BROKEN SETTING IS NOT COMPATIBILITY.
        # An un-updated unit still saying RETAIN_DAYS=7 would quietly get 168h
        # back -- the exact configuration that stopped the pool -- while this
        # script's header claims the window is 24h. So it is honoured, and it
        # SAYS SO loudly, every run, naming the number it actually used.
        RETAIN_HOURS=$(( RETAIN_DAYS * 24 ))
        printf '%s WARNING: this unit still sets RETAIN_DAYS=%s, so the window is %sh, not the 24h default. Switch it to RETAIN_HOURS. Above ~8.7M rows the pool stops recording shares.\n' \
            "$(date -u +%FT%TZ)" "$RETAIN_DAYS" "$RETAIN_HOURS" >&2
    else
        RETAIN_HOURS=24
    fi
fi
BATCH=${BATCH:-50000}
MAX_BATCHES=${MAX_BATCHES:-400}

say() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*"; }

[ -r "$DB" ] || { say "prune: cannot read $DB -- resolving nothing, no rows touched"; exit 0; }

q() { sqlite3 -cmd '.timeout 15000' "$DB" "$1" 2>/dev/null; }

BEFORE_ROWS=$(q "SELECT COUNT(*) FROM shares;")
[ -n "$BEFORE_ROWS" ] || { say "prune: cannot count shares -- refusing to delete"; exit 0; }

CUTOFF=$(q "SELECT (strftime('%s','now') - ${RETAIN_HOURS}*3600)*1000;")

# Belt and braces: never delete past the oldest block that is not yet mature,
# even if it is older than the retention window. A block still in flight is the
# one case where anything might conceivably want to look at its shares again.
GUARD=$(q "SELECT IFNULL(MIN(found_at),0) FROM blocks WHERE state NOT IN ('mature','orphaned');")
if [ -n "$GUARD" ] && [ "$GUARD" -gt 0 ] 2>/dev/null; then
    GUARD=$((GUARD - 3600000))           # a further hour of margin
    if [ "$GUARD" -lt "$CUTOFF" ]; then
        say "prune: cutoff pulled back to the oldest in-flight block (minus 1h)"
        CUTOFF=$GUARD
    fi
fi

DOOMED=$(q "SELECT COUNT(*) FROM shares WHERE at < ${CUTOFF};")
if [ -z "$DOOMED" ] || [ "$DOOMED" -eq 0 ] 2>/dev/null; then
    say "prune: nothing older than ${RETAIN_HOURS}h (rows=${BEFORE_ROWS}) -- nothing to do"
    exit 0
fi

say "prune: ${DOOMED} of ${BEFORE_ROWS} shares are older than ${RETAIN_HOURS}h; deleting in batches of ${BATCH}"

# Batched so each write lock is short. The pool records roughly eleven shares a
# second and must not be blocked; a single DELETE of millions of rows would hold
# the lock for the whole operation.
n=0
while [ "$n" -lt "$MAX_BATCHES" ]; do
    got=$(q "DELETE FROM shares WHERE id IN (SELECT id FROM shares WHERE at < ${CUTOFF} LIMIT ${BATCH}); SELECT changes();")
    [ -z "$got" ] && { say "prune: a batch failed -- stopping early, $((n*BATCH)) or so removed"; break; }
    [ "$got" -eq 0 ] 2>/dev/null && break
    n=$((n+1))
    sleep 0.4
done

AFTER_ROWS=$(q "SELECT COUNT(*) FROM shares;")
say "prune: shares ${BEFORE_ROWS} -> ${AFTER_ROWS} (removed $((BEFORE_ROWS-AFTER_ROWS)), ${n} batches), file $(du -h "$DB" 2>/dev/null | cut -f1), freelist $(q 'PRAGMA freelist_count;') pages reusable"
