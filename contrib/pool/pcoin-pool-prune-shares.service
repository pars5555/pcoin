[Unit]
Description=Prune pool shares older than the retention window
After=pcoin-pool.service

[Service]
Type=oneshot
# 72 HOURS, and the unit is in the repo so this number is reviewable.
#
# Raised 48 -> 72 on 2026-10-20. `pcoin-pool-window-watch` measures how much
# share-weight the pool holds against the PPLNS window it must pay, and pool2's
# coverage fell from 2.41x to 1.96x in eight hours as outside hashrate joined
# the network (2% of the network, so its share of the window shrinks as the
# network grows). Below 1.00x the window is truncated and miners are underpaid
# with nothing logging it; the script's own remedy is to raise RETAIN_HOURS.
# The table was 103,727 rows at 48h, so 72h is ~155k -- three orders of
# magnitude below the 8.7M that broke the pool in September.
#
# The 48 in force since 2026-09-22 was set on the server and never committed;
# this file said 24 against a server running 48 until 2026-10-20.
#
# It was RETAIN_DAYS=7 until 2026-09-21, when the shares table reached ~8.7M
# rows, every store call began exceeding the pool's 15s RUN_TIMEOUT_MS, and
# share recording stopped dead for 7h15m (blocks 8975 -> 8997). The window is
# now set by what actually READS a share: PPLNS is minutes, the public
# hashrate is the last 600 seconds, and the widest reader in the tree is a
# hand-run 24h report. Nothing reads one older than that.
#
# Do NOT set RETAIN_DAYS here. The script still honours it for an un-updated
# host, but warns loudly on every run, because 7 days is the setting that
# broke the pool.
Environment=RETAIN_HOURS=72
ExecStart=/usr/local/bin/pcoin-pool-prune-shares
Nice=15
IOSchedulingClass=idle
StandardOutput=append:/var/log/pcoin-pool-prune.log
StandardError=append:/var/log/pcoin-pool-prune.log
