[Unit]
Description=Generate last month's PCoin pool-distribution report on the 1st

[Timer]
# 03:30 UTC on the 1st: the month that just ended is complete on any node that is in sync.
OnCalendar=*-*-01 03:30:00 UTC
RandomizedDelaySec=10min
# If the host was down at 03:30, run once when it is back, so a missed month still
# produces its report instead of silently skipping.
Persistent=true

[Install]
WantedBy=timers.target
